+  have : Fact (IsCusp ∞ Γ) := ⟨Γ.isCusp_of_mem_strictPeriods hh hΓ⟩
+  exp_decay_atImInfty_of_coeff_eq_zero hh (periodic_comp_ofComplex f hΓ) (holo f)
