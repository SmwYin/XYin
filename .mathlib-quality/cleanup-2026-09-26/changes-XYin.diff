+@[simp]
+theorem toFun_one : toFun (1 : MeromorphicField) = 1 :=
+  toFun_ofMeromorphic (f := 1) (analyticOnNhd_const (v := (1 : ℂ))).meromorphicNFOn
+
+/-- The canonical representative of a constant is the constant function. -/
