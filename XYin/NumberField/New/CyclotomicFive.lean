import Mathlib

/-!
# The cyclotomic field `ℚ(ζ₅)`

The fifth cyclotomic field `K = ℚ(ζ₅)` and its main arithmetic invariants:

* degree `4 = φ(5)`, integral basis `1, ζ, ζ², ζ³`, ring of integers `ℤ[ζ]` (sections 1–2);
* discriminant `125 = 5³` (section 3);
* norms of the distinguished elements: `N(1 - ζ) = 5`, `N(1 + ζ) = 1` (section 4);
* splitting of rational primes, governed by the order of `p` mod `5`: `5` is totally
  ramified as `(1 - ζ)⁴`, `2` is inert, `19` splits into two quadratic primes, `11` splits
  completely (section 5);
* unit group `μ₁₀ × (1 + ζ)^ℤ`: torsion of order `10` generated by `-ζ`, signature `(0, 2)`,
  unit rank `1`, fundamental (cyclotomic) unit `1 + ζ`, regulator `2·log φ` with `φ` the
  golden ratio (section 6);
* class number one (section 7);
* the Gauss sum: `(1 + 2ζ + 2ζ⁴)² = 5`, exhibiting `ℚ(√5)` as the unique quadratic subfield
  (section 8);
* abelian Galois theory: `Gal(ℚ(ζ₅)/ℚ) ≅ (ℤ/5)ˣ ≅ ℤ/4`, cyclic, generated by `ζ ↦ ζ²`
  (section 9).
-/

noncomputable section

open Module
open scoped NumberField nonZeroDivisors

namespace XYin.NumberField.New.CyclotomicFive

/-! ## 1. Basics -/

/-- The fifth cyclotomic field over `ℚ`. -/
abbrev K : Type := CyclotomicField 5 ℚ

/-- The cyclotomic-extension structure on `K = ℚ(ζ₅)`. -/
instance : IsCyclotomicExtension {5} ℚ K :=
  CyclotomicField.isCyclotomicExtension 5 ℚ

/-- A chosen primitive fifth root of unity. -/
abbrev ζ : K := IsCyclotomicExtension.zeta 5 ℚ K

/-- `ζ` is a primitive fifth root of unity. -/
theorem zeta_isPrimitiveRoot : IsPrimitiveRoot ζ 5 := by
  sorry

/-- `ζ⁵ = 1`. -/
theorem zeta_pow_five : ζ ^ 5 = 1 := by
  sorry

/-- The vanishing of the fifth cyclotomic polynomial at `ζ`:
`1 + ζ + ζ² + ζ³ + ζ⁴ = 0`. -/
theorem zeta_sum_eq_zero : 1 + ζ + ζ ^ 2 + ζ ^ 3 + ζ ^ 4 = 0 := by
  sorry

/-- The extension degree of `K = ℚ(ζ₅)` over `ℚ` is `φ(5) = 4`. -/
theorem degree_eq_four : Module.finrank ℚ K = 4 := by
  sorry

/-! ## 2. Integral basis and ring of integers -/

/-- `ζ` is integral over `ℤ` (a root of the monic `X⁵ - 1`), hence lies in `𝓞 K`. -/
theorem zeta_integral : ζ ∈ integralClosure ℤ K := by
  sorry

/-- `ζ` as an element of the ring of integers `𝓞 K`. -/
noncomputable def zetaInt : 𝓞 K := ⟨ζ, zeta_integral⟩

/-- The integral generator also satisfies `ζ⁵ = 1` in `𝓞 K`. -/
theorem zetaInt_pow_five : zetaInt ^ 5 = 1 := by
  sorry

/-- The displayed integral-basis vectors `1, ζ, ζ², ζ³` (as elements of `K`). -/
def integralBasisVectors : Fin 4 → K := ![1, ζ, ζ ^ 2, ζ ^ 3]

/-- `1, ζ, ζ², ζ³` is an integral basis of `ℚ(ζ₅)`: their `ℤ`-span in `K` is exactly the
ring of integers `𝓞 K`. -/
theorem span_integralBasisVectors_eq :
    Submodule.span ℤ (Set.range integralBasisVectors) =
      Subalgebra.toSubmodule (integralClosure ℤ K) := by
  sorry

/-- The integral basis `1, ζ, ζ², ζ³` packaged as a genuine `ℤ`-basis of `𝓞 K`. -/
noncomputable def concreteIntegralBasis : Basis (Fin 4) ℤ (𝓞 K) := by
  sorry

/-- The packaged integral basis is, vector by vector, the displayed family `1, ζ, ζ², ζ³`. -/
theorem concreteIntegralBasis_apply (i : Fin 4) :
    (algebraMap (𝓞 K) K) (concreteIntegralBasis i) = integralBasisVectors i := by
  sorry

/-- The displayed integral basis spans the same `ℤ`-lattice in `K` as mathlib's
`NumberField.integralBasis K` (the correct form of "the two integral bases agree": equality
of lattices, not a mere reindexing). -/
theorem span_integralBasisVectors_eq_integralBasis :
    Submodule.span ℤ (Set.range integralBasisVectors) =
      Submodule.span ℤ (Set.range (NumberField.integralBasis K)) := by
  sorry

/-- The concrete order `ℤ[ζ]` inside `K`. -/
abbrev concreteRingOfIntegers : Subalgebra ℤ K := Algebra.adjoin ℤ ({ζ} : Set K)

/-- The full ring of integers of `ℚ(ζ₅)` is `ℤ[ζ]`: cyclotomic fields are monogenic. -/
theorem ringOfIntegers_eq : integralClosure ℤ K = concreteRingOfIntegers := by
  sorry

/-! ## 3. Discriminant -/

/-- The number-field discriminant of `ℚ(ζ₅)` is `125 = 5³` (for an odd prime `p` the
discriminant of `ℚ(ζ_p)` is `(-1)^((p-1)/2) p^(p-2)`). In particular `5` is the only
ramified prime, cf. `ramified_iff_eq_five`. -/
theorem numberField_discr_eq : NumberField.discr K = (125 : ℤ) := by
  sorry

/-! ## 4. Norms of distinguished elements -/

/-- The norm of `1 - ζ` is `Φ₅(1) = 5`: the standard generator of the unique prime above
`5`. -/
theorem norm_one_sub_zeta : Algebra.norm ℚ (1 - ζ) = 5 := by
  sorry

/-- The norm of `1 + ζ` is `Φ₅(-1) = 1`: hence `1 + ζ` is a unit of `ℤ[ζ]` (a *cyclotomic
unit*). -/
theorem norm_one_add_zeta : Algebra.norm ℚ (1 + ζ) = 1 := by
  sorry

/-! ## 5. Splitting of primes -/

/-- `5` is totally ramified: `(5) = (1 - ζ)⁴` as ideals of `𝓞 K` — ramification index
`e = 4` equals the full degree. -/
theorem span_five_eq : Ideal.span {(5 : 𝓞 K)} = Ideal.span {1 - zetaInt} ^ 4 := by
  sorry

/-- `(1 - ζ)` is a prime ideal — the unique prime of `𝓞 K` above `5`. -/
theorem isPrime_span_one_sub_zeta : (Ideal.span {1 - zetaInt}).IsPrime := by
  sorry

/-- The prime `(1 - ζ)` above `5` has norm `5` (residue degree `f = 1`). -/
theorem absNorm_span_one_sub_zeta : Ideal.absNorm (Ideal.span {1 - zetaInt}) = 5 := by
  sorry

/-- `2` is inert in `ℚ(ζ₅)`: `2` has order `4` in `(ℤ/5)ˣ`, so `Φ₅` is irreducible mod `2`. -/
theorem isPrime_span_two : (Ideal.span {(2 : 𝓞 K)}).IsPrime := by
  sorry

/-- The inert prime `(2)` has norm `2⁴ = 16` (residue degree `f = 4`). -/
theorem absNorm_span_two : Ideal.absNorm (Ideal.span {(2 : 𝓞 K)}) = 16 := by
  sorry

/-- `19` splits into two primes of degree `2`: `19 ≡ -1 (mod 5)` has order `2` in `(ℤ/5)ˣ`,
and `Φ₅ ≡ (X² + 5X + 1)(X² + 15X + 1) (mod 19)`. -/
theorem span_nineteen_eq :
    Ideal.span {(19 : 𝓞 K)} =
      Ideal.span {(19 : 𝓞 K), zetaInt ^ 2 + 5 * zetaInt + 1} *
        Ideal.span {(19 : 𝓞 K), zetaInt ^ 2 + 15 * zetaInt + 1} := by
  sorry

/-- Both primes above `19` are prime ideals of norm `19² = 361`. -/
theorem isPrime_primesAboveNineteen :
    (Ideal.span {(19 : 𝓞 K), zetaInt ^ 2 + 5 * zetaInt + 1}).IsPrime ∧
      (Ideal.span {(19 : 𝓞 K), zetaInt ^ 2 + 15 * zetaInt + 1}).IsPrime := by
  sorry

/-- `11` splits completely: `11 ≡ 1 (mod 5)`, and the roots of `Φ₅` mod `11` are
`3, 4, 5, 9` (the elements of order `5` in `(ℤ/11)ˣ`). -/
theorem span_eleven_eq :
    Ideal.span {(11 : 𝓞 K)} =
      Ideal.span {(11 : 𝓞 K), zetaInt - 3} * Ideal.span {(11 : 𝓞 K), zetaInt - 4} *
        Ideal.span {(11 : 𝓞 K), zetaInt - 5} * Ideal.span {(11 : 𝓞 K), zetaInt - 9} := by
  sorry

/-- Each ideal `(11, ζ - r)` for `r ∈ {3, 4, 5, 9}` is a prime of norm `11`. -/
theorem isPrime_primeAboveEleven (r : ℤ) (hr : r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 9) :
    (Ideal.span {(11 : 𝓞 K), zetaInt - (r : 𝓞 K)}).IsPrime := by
  sorry

/-- The splitting law for `ℚ(ζ₅)`: a prime `p` splits completely iff `p ≡ 1 (mod 5)`. -/
theorem splits_completely_iff (p : ℕ) (hp : p.Prime) (hp5 : p ≠ 5) :
    (∃ P : Ideal (𝓞 K), P.IsPrime ∧ Ideal.span {(p : 𝓞 K)} ≤ P ∧ Ideal.absNorm P = p) ↔
      p % 5 = 1 := by
  sorry

/-- A rational prime `p` ramifies in `ℚ(ζ₅)` iff `p = 5`, i.e. iff `p` divides the
discriminant `125`. -/
theorem ramified_iff_eq_five (p : ℕ) (hp : p.Prime) :
    (∃ P : Ideal (𝓞 K), P.IsPrime ∧ Ideal.span {(p : 𝓞 K)} ≤ P ^ 2) ↔ p = 5 := by
  sorry

/-! ## 6. Ring of units -/

/-- A torsion generator of `𝓞 Kˣ`: the primitive tenth root of unity `-ζ`, with explicit
inverse `-ζ⁴` (since `(-ζ)(-ζ⁴) = ζ⁵ = 1`). -/
noncomputable def torsionGenerator : (𝓞 K)ˣ where
  val := -zetaInt
  inv := -zetaInt ^ 4
  val_inv := by sorry
  inv_val := by sorry

/-- The concrete torsion units: the ten roots of unity `(-ζ)^k = ±ζ^j`. -/
def torsionUnits : Set ((𝓞 K)ˣ) := {u | ∃ k : Fin 10, u = torsionGenerator ^ k.val}

/-- The torsion subgroup of `𝓞 Kˣ` is exactly `μ₁₀ = {±ζ^j}`, generated by `-ζ`. -/
theorem torsionUnits_eq : {u : (𝓞 K)ˣ | IsOfFinOrder u} = torsionUnits := by
  sorry

/-- The torsion subgroup of `𝓞 Kˣ` has order `10` — the largest `m` with `φ(m) ∣ 4` and
`ℚ(ζₘ) ⊆ ℚ(ζ₅)`. -/
theorem torsionOrder_eq_ten : NumberField.Units.torsionOrder K = 10 := by
  sorry

/-- `ℚ(ζ₅)` is totally complex: the signature is `(0, 2)`. -/
theorem nrRealPlaces_eq_zero : NumberField.InfinitePlace.nrRealPlaces K = 0 := by
  sorry

/-- `ℚ(ζ₅)` has exactly two (conjugate pairs of) complex places. -/
theorem nrComplexPlaces_eq_two : NumberField.InfinitePlace.nrComplexPlaces K = 2 := by
  sorry

/-- The Dirichlet unit rank of `ℚ(ζ₅)` is `1`: the signature is `(0, 2)`, so the rank is
`r₁ + r₂ - 1 = 1`. -/
theorem unitRank_eq_one : NumberField.Units.rank K = 1 := by
  sorry

/-- The fundamental unit of `𝓞 K`: the cyclotomic unit `1 + ζ`, with explicit inverse
`-(ζ + ζ³)` (from `(1 + ζ)(ζ + ζ³) = ζ + ζ² + ζ³ + ζ⁴ = -1`). -/
noncomputable def fundamentalUnit : (𝓞 K)ˣ where
  val := 1 + zetaInt
  inv := -(zetaInt + zetaInt ^ 3)
  val_inv := by sorry
  inv_val := by sorry

/-- The system of fundamental units for the rank-`1` unit group: the single unit `1 + ζ`. -/
noncomputable def fundamentalUnitSystem : Fin (NumberField.Units.rank K) → (𝓞 K)ˣ :=
  fun _ => fundamentalUnit

/-- The displayed family is a system of fundamental units: together with the roots of unity
`μ₁₀`, the cyclotomic unit `1 + ζ` generates all units of `ℤ[ζ]` (an instance of the index
formula `[𝓞ˣ : cyclotomic units] = h⁺ = 1`). -/
theorem fundamentalUnitSystem_isFundamental :
    Subgroup.closure (Set.range fundamentalUnitSystem) ⊔ NumberField.Units.torsion K = ⊤ := by
  sorry

/-- Equivalently, every unit of `ℤ[ζ]` is `±ζ^j (1 + ζ)ⁿ`. -/
theorem unit_eq_torsion_mul_fundamentalUnit_zpow (u : (𝓞 K)ˣ) :
    ∃ ζ' : (𝓞 K)ˣ, ζ' ∈ NumberField.Units.torsion K ∧ ∃ n : ℤ, u = ζ' * fundamentalUnit ^ n := by
  sorry

/-- The unit group is `μ₁₀ × ℤ` as an abstract abelian group. -/
theorem unitGroupStructure :
    Nonempty ((𝓞 K)ˣ ≃* (Multiplicative (ZMod 10) × Multiplicative (Fin 1 → ℤ))) := by
  sorry

/-- The regulator of `ℚ(ζ₅)` is `2·log φ ≈ 0.9624`, where `φ = (1 + √5)/2`: the two complex
places each contribute weight `2`, and `|1 + ζ| = φ` at one of them. -/
theorem regulator_eq :
    NumberField.Units.regulator K = 2 * Real.log ((1 + Real.sqrt 5) / 2) := by
  sorry

/-! ## 7. Class group -/

/-- The class number of `ℚ(ζ₅)` is `1` (the Minkowski bound is `(4/π)² · 4!/4⁴ · √125 ≈ 1.7`,
so there is nothing to check beyond the unit ideal). -/
theorem classNumber_eq_one : NumberField.classNumber K = 1 := by
  sorry

/-- The ring of integers `ℤ[ζ₅]` is a principal ideal domain. -/
theorem isPrincipalIdealRing : IsPrincipalIdealRing (𝓞 K) := by
  sorry

/-- The class group of `𝓞 K` is trivial. -/
theorem classGroupStructure : Nonempty (ClassGroup (𝓞 K) ≃* Multiplicative (ZMod 1)) := by
  sorry

/-- The unit ideal as the concrete representative of the unique ideal class. -/
abbrev unitIdealRepresentative : (Ideal (𝓞 K))⁰ := ⟨(⊤ : Ideal (𝓞 K)), by simp⟩

/-- Every ideal class is represented by the unit ideal. -/
theorem classGroupRepresentative (C : ClassGroup (𝓞 K)) :
    C = ClassGroup.mk0 unitIdealRepresentative := by
  sorry

/-! ## 8. The quadratic subfield via the Gauss sum -/

/-- The quadratic Gauss sum for `5`: `(1 + 2ζ + 2ζ⁴)² = 5`. Hence `√5 ∈ ℚ(ζ₅)` and `ℚ(√5)`
is the unique quadratic subfield (corresponding to the index-`2` subgroup of the cyclic
Galois group) — the simplest case of the Kronecker–Weber phenomenon. -/
theorem gaussSum_sq : (1 + 2 * ζ + 2 * ζ ^ 4) ^ 2 = 5 := by
  sorry

/-! ## 9. Galois group -/

/-- The identity automorphism of `ℚ(ζ₅)`. -/
noncomputable def idAut : K ≃ₐ[ℚ] K := AlgEquiv.refl

/-- The automorphism of `ℚ(ζ₅)` sending `ζ` to `ζ²`. -/
noncomputable def sigmaTwo : K ≃ₐ[ℚ] K := by
  sorry

/-- The automorphism of `ℚ(ζ₅)` sending `ζ` to `ζ³`. -/
noncomputable def sigmaThree : K ≃ₐ[ℚ] K := by
  sorry

/-- The automorphism of `ℚ(ζ₅)` sending `ζ` to `ζ⁴` (complex conjugation). -/
noncomputable def sigmaFour : K ≃ₐ[ℚ] K := by
  sorry

/-- The automorphism `sigmaTwo` sends `ζ` to `ζ²`. -/
theorem sigmaTwo_apply_zeta : sigmaTwo ζ = ζ ^ 2 := by
  sorry

/-- The automorphism `sigmaThree` sends `ζ` to `ζ³`. -/
theorem sigmaThree_apply_zeta : sigmaThree ζ = ζ ^ 3 := by
  sorry

/-- The automorphism `sigmaFour` sends `ζ` to `ζ⁴ = ζ⁻¹`: it is complex conjugation, whose
fixed field is the maximal totally real subfield `ℚ(ζ + ζ⁻¹) = ℚ(√5)`. -/
theorem sigmaFour_apply_zeta : sigmaFour ζ = ζ ^ 4 := by
  sorry

/-- Cyclotomic extensions are Galois: `ℚ(ζ₅)/ℚ` is a Galois extension. -/
theorem isGalois : IsGalois ℚ K := by
  sorry

/-- The Galois group of `ℚ(ζ₅)/ℚ` is canonically `(ℤ/5)ˣ` (the cyclotomic character). -/
theorem galoisGroupStructure : Nonempty ((K ≃ₐ[ℚ] K) ≃* (ZMod 5)ˣ) := by
  sorry

/-- The Galois group is cyclic (of order `4`) — `2` is a primitive root mod `5`. -/
theorem galoisGroup_isCyclic : IsCyclic (K ≃ₐ[ℚ] K) := by
  sorry

/-- `σ₂ : ζ ↦ ζ²` generates the Galois group: it has order `4`. -/
theorem orderOf_sigmaTwo : orderOf sigmaTwo = 4 := by
  sorry

/-- The Galois group consists exactly of the four displayed automorphisms. -/
theorem aut_eq (σ : K ≃ₐ[ℚ] K) :
    σ = idAut ∨ σ = sigmaTwo ∨ σ = sigmaThree ∨ σ = sigmaFour := by
  sorry

end XYin.NumberField.New.CyclotomicFive
