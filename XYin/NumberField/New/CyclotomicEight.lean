import Mathlib

/-!
# The cyclotomic field `ℚ(ζ₈)`

The eighth cyclotomic field `K = ℚ(ζ₈)` and its main arithmetic invariants:

* degree `4 = φ(8)`, integral basis `1, ζ, ζ², ζ³`, ring of integers `ℤ[ζ]` (sections 1–2);
* discriminant `256 = 2⁸` (section 3);
* the three quadratic subfields `ℚ(i), ℚ(√2), ℚ(√-2)`, realised by the explicit square
  roots `ζ², ζ + ζ⁷, ζ - ζ⁷` (section 4);
* splitting of rational primes, governed by `p mod 8`: `2` is totally ramified as
  `(1 - ζ)⁴`, `17 ≡ 1` splits completely, `3` splits into two quadratic primes, and —
  since `(ℤ/8)ˣ` is not cyclic — **no rational prime is inert** (section 5);
* unit group `μ₈ × (1 + √2)^ℤ`: torsion of order `8` generated by `ζ`, signature `(0, 2)`,
  unit rank `1`, fundamental unit `1 + √2 = 1 + ζ + ζ⁷`, regulator `2·log(1 + √2)`
  (section 6);
* class number one (section 7);
* abelian, non-cyclic Galois theory: `Gal(ℚ(ζ₈)/ℚ) ≅ (ℤ/8)ˣ ≅ ℤ/2 × ℤ/2` is the Klein four
  group — every non-identity automorphism has order `2` (section 8).
-/

noncomputable section

open Module
open scoped NumberField nonZeroDivisors

namespace XYin.NumberField.New.CyclotomicEight

/-! ## 1. Basics -/

/-- The eighth cyclotomic field over `ℚ`. -/
abbrev K : Type := CyclotomicField 8 ℚ

/-- The cyclotomic-extension structure on `K = ℚ(ζ₈)`. -/
instance : IsCyclotomicExtension {8} ℚ K :=
  CyclotomicField.isCyclotomicExtension 8 ℚ

/-- A chosen primitive eighth root of unity. -/
abbrev ζ : K := IsCyclotomicExtension.zeta 8 ℚ K

/-- `ζ` is a primitive eighth root of unity. -/
theorem zeta_isPrimitiveRoot : IsPrimitiveRoot ζ 8 :=
  IsCyclotomicExtension.zeta_spec 8 ℚ K

/-- `ζ⁸ = 1`. -/
theorem zeta_pow_eight : ζ ^ 8 = 1 :=
  zeta_isPrimitiveRoot.pow_eq_one

/-- The vanishing of the eighth cyclotomic polynomial at `ζ`: `ζ⁴ = -1`. -/
theorem zeta_pow_four : ζ ^ 4 = -1 :=
  (zeta_isPrimitiveRoot.pow (by norm_num) (rfl : 8 = 4 * 2)).eq_neg_one_of_two_right

/-- The extension degree of `K = ℚ(ζ₈)` over `ℚ` is `φ(8) = 4`. -/
theorem degree_eq_four : Module.finrank ℚ K = 4 :=
  (IsCyclotomicExtension.finrank (n := 8) K
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))).trans rfl

/-! ## 2. Integral basis and ring of integers -/

/-- `ζ` is integral over `ℤ` (a root of the monic `X⁸ - 1`), hence lies in `𝓞 K`. -/
theorem zeta_integral : ζ ∈ integralClosure ℤ K :=
  zeta_isPrimitiveRoot.isIntegral (by norm_num)

/-- `ζ` as an element of the ring of integers `𝓞 K`. -/
noncomputable def zetaInt : 𝓞 K := ⟨ζ, zeta_integral⟩

/-- The integral generator also satisfies `ζ⁴ = -1` in `𝓞 K`. -/
theorem zetaInt_pow_four : zetaInt ^ 4 = -1 :=
  Subtype.ext (by push_cast [zetaInt]; exact zeta_pow_four)

/-- The displayed integral-basis vectors `1, ζ, ζ², ζ³` (as elements of `K`). -/
def integralBasisVectors : Fin 4 → K := ![1, ζ, ζ ^ 2, ζ ^ 3]

/-- `1, ζ, ζ², ζ³` is an integral basis of `ℚ(ζ₈)`: their `ℤ`-span in `K` is exactly the
ring of integers `𝓞 K`. -/
theorem span_integralBasisVectors_eq :
    Submodule.span ℤ (Set.range integralBasisVectors) =
      Subalgebra.toSubmodule (integralClosure ℤ K) := by
  have hmonic : (Polynomial.X ^ 4 + Polynomial.C (1 : ℤ)).Monic :=
    Polynomial.monic_X_pow_add_C 1 (by norm_num)
  refine le_antisymm (Submodule.span_le.mpr ?_) (fun x hx => ?_)
  · rintro y ⟨i, rfl⟩
    fin_cases i
    · exact Subalgebra.one_mem _
    · exact zeta_integral
    · exact Subalgebra.pow_mem _ zeta_integral 2
    · exact Subalgebra.pow_mem _ zeta_integral 3
  · have hx' : x ∈ Algebra.adjoin ℤ ({ζ} : Set K) := by
      obtain ⟨y, hy⟩ := (IsIntegralClosure.isIntegral_iff (self :=
        IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton zeta_isPrimitiveRoot)).mp hx
      exact hy ▸ y.2
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hx'
    obtain ⟨p, hp⟩ := hx'
    have hkey : x = Polynomial.aeval ζ (p %ₘ (Polynomial.X ^ 4 + Polynomial.C 1)) := by
      conv_lhs => rw [← hp,
        ← Polynomial.modByMonic_add_div p (Polynomial.X ^ 4 + Polynomial.C 1)]
      simp [zeta_pow_four]
    have hdeg : (p %ₘ (Polynomial.X ^ 4 + Polynomial.C 1)).natDegree < 4 := by
      rcases eq_or_ne (p %ₘ (Polynomial.X ^ 4 + Polynomial.C 1)) 0 with h0 | h0
      · rw [h0]
        norm_num
      · refine (Polynomial.natDegree_lt_iff_degree_lt h0).mpr ?_
        have h := Polynomial.degree_modByMonic_lt p hmonic
        rwa [Polynomial.degree_X_pow_add_C (by norm_num : 0 < 4) (1 : ℤ)] at h
    rw [hkey, Polynomial.aeval_eq_sum_range' hdeg]
    refine Submodule.sum_mem _ fun i hi => ?_
    rw [Finset.mem_range] at hi
    refine Submodule.smul_mem _ _ (Submodule.subset_span ?_)
    interval_cases i
    · exact ⟨0, by simp [integralBasisVectors]⟩
    · exact ⟨1, by simp [integralBasisVectors]⟩
    · exact ⟨2, by simp [integralBasisVectors]⟩
    · exact ⟨3, by simp [integralBasisVectors]⟩

/-- The integral basis `1, ζ, ζ², ζ³` packaged as a genuine `ℤ`-basis of `𝓞 K`. -/
noncomputable def concreteIntegralBasis : Basis (Fin 4) ℤ (𝓞 K) :=
  zeta_isPrimitiveRoot.integralPowerBasis.basis.reindex
    (finCongr (zeta_isPrimitiveRoot.integralPowerBasis_dim.trans rfl))

/-- The packaged integral basis is, vector by vector, the displayed family `1, ζ, ζ², ζ³`. -/
theorem concreteIntegralBasis_apply (i : Fin 4) :
    (algebraMap (𝓞 K) K) (concreteIntegralBasis i) = integralBasisVectors i := by
  fin_cases i <;>
    simp [concreteIntegralBasis, integralBasisVectors, PowerBasis.basis_eq_pow,
      zeta_isPrimitiveRoot.integralPowerBasis_gen, IsPrimitiveRoot.toInteger]

/-- The displayed integral basis spans the same `ℤ`-lattice in `K` as mathlib's
`NumberField.integralBasis K` (the correct form of "the two integral bases agree": equality
of lattices, not a mere reindexing). -/
theorem span_integralBasisVectors_eq_integralBasis :
    Submodule.span ℤ (Set.range integralBasisVectors) =
      Submodule.span ℤ (Set.range (NumberField.integralBasis K)) := by
  rw [span_integralBasisVectors_eq]
  ext x
  rw [Subalgebra.mem_toSubmodule]
  constructor
  · intro hx
    exact (NumberField.mem_span_integralBasis K).mpr (RingHom.mem_range.mpr ⟨⟨x, hx⟩, rfl⟩)
  · intro hx
    obtain ⟨y, hy⟩ := RingHom.mem_range.mp ((NumberField.mem_span_integralBasis K).mp hx)
    exact hy ▸ y.2

/-- The concrete order `ℤ[ζ]` inside `K`. -/
abbrev concreteRingOfIntegers : Subalgebra ℤ K := Algebra.adjoin ℤ ({ζ} : Set K)

/-- The full ring of integers of `ℚ(ζ₈)` is `ℤ[ζ]`: cyclotomic fields are monogenic. -/
theorem ringOfIntegers_eq : integralClosure ℤ K = concreteRingOfIntegers := by
  refine le_antisymm (fun x hx => ?_)
    (Algebra.adjoin_le (Set.singleton_subset_iff.mpr zeta_integral))
  obtain ⟨y, hy⟩ := (IsIntegralClosure.isIntegral_iff (self :=
    IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton zeta_isPrimitiveRoot)).mp hx
  exact hy ▸ y.2

/-! ## 3. Discriminant -/

/-- The number-field discriminant of `ℚ(ζ₈)` is `256 = 2⁸`. In particular `2` is the only
ramified prime, cf. `ramified_iff_eq_two`. -/
theorem numberField_discr_eq : NumberField.discr K = (256 : ℤ) := by
  have : IsCyclotomicExtension {2 ^ 3} ℚ K := by
    rw [show (2 : ℕ) ^ 3 = 8 by norm_num]
    infer_instance
  rw [IsCyclotomicExtension.Rat.discr_prime_pow 2 3 K,
    show ((2 : ℕ) ^ 3).totient = 4 from rfl]
  norm_num

/-! ## 4. The three quadratic subfields -/

/-- `√2 = ζ + ζ⁻¹` inside `ℚ(ζ₈)`: one has `(ζ + ζ⁷)² = 2`, since `ζ² + ζ⁻² = 0`. -/
theorem sqrt_two_sq : (ζ + ζ ^ 7) ^ 2 = 2 := by
  linear_combination (ζ ^ 10 - ζ ^ 6 + 2 * ζ ^ 4 + ζ ^ 2 - 2) * zeta_pow_four

/-- `i = ζ²` inside `ℚ(ζ₈)`: one has `(ζ²)² = -1`. -/
theorem i_sq : (ζ ^ 2) ^ 2 = -1 := by
  linear_combination zeta_pow_four

/-- `√-2 = ζ - ζ⁻¹` inside `ℚ(ζ₈)`: one has `(ζ - ζ⁷)² = -2`. Together with `sqrt_two_sq`
and `i_sq` this exhibits the three quadratic subfields `ℚ(√2), ℚ(i), ℚ(√-2)` — matching the
three index-`2` subgroups of the Klein-four Galois group. -/
theorem sqrt_neg_two_sq : (ζ - ζ ^ 7) ^ 2 = -2 := by
  linear_combination (ζ ^ 10 - ζ ^ 6 - 2 * ζ ^ 4 + ζ ^ 2 + 2) * zeta_pow_four

/-! ## 5. Splitting of primes -/

private theorem coe_zetaInt : algebraMap (𝓞 K) K zetaInt = ζ := rfl

private theorem gen_eq_zetaInt : zeta_isPrimitiveRoot.integralPowerBasis.gen = zetaInt := by
  rw [zeta_isPrimitiveRoot.integralPowerBasis_gen]; rfl

/-- Private forward copy of `sigmaThree` (the public definition appears in section 8). -/
private noncomputable def sig3 : K ≃ₐ[ℚ] K :=
  IsCyclotomicExtension.fromZetaAut (zeta_isPrimitiveRoot.pow_of_coprime 3 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

private noncomputable def sig5 : K ≃ₐ[ℚ] K :=
  IsCyclotomicExtension.fromZetaAut (zeta_isPrimitiveRoot.pow_of_coprime 5 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

private noncomputable def sig7 : K ≃ₐ[ℚ] K :=
  IsCyclotomicExtension.fromZetaAut (zeta_isPrimitiveRoot.pow_of_coprime 7 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

private theorem sig3_zeta : sig3 ζ = ζ ^ 3 :=
  IsCyclotomicExtension.fromZetaAut_spec (zeta_isPrimitiveRoot.pow_of_coprime 3 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

private theorem sig5_zeta : sig5 ζ = ζ ^ 5 :=
  IsCyclotomicExtension.fromZetaAut_spec (zeta_isPrimitiveRoot.pow_of_coprime 5 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

private theorem sig7_zeta : sig7 ζ = ζ ^ 7 :=
  IsCyclotomicExtension.fromZetaAut_spec (zeta_isPrimitiveRoot.pow_of_coprime 7 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

private theorem autEq' (σ : K ≃ₐ[ℚ] K) : σ = 1 ∨ σ = sig3 ∨ σ = sig5 ∨ σ = sig7 := by
  have hval : ∀ t : (ZMod 8)ˣ, (t : ZMod 8).val = 1 ∨ (t : ZMod 8).val = 3 ∨
      (t : ZMod 8).val = 5 ∨ (t : ZMod 8).val = 7 := by decide
  have hspec := IsPrimitiveRoot.autToPow_spec ℚ zeta_isPrimitiveRoot σ
  have hext : ∀ τ : K ≃ₐ[ℚ] K, σ ζ = τ ζ → σ = τ := by
    intro τ h
    have hgen := (zeta_isPrimitiveRoot.powerBasis ℚ).algHom_ext
      (f := (σ : K →ₐ[ℚ] K)) (g := (τ : K →ₐ[ℚ] K))
      (by rwa [IsPrimitiveRoot.powerBasis_gen])
    exact AlgEquiv.ext fun x => AlgHom.congr_fun hgen x
  rcases hval (IsPrimitiveRoot.autToPow ℚ zeta_isPrimitiveRoot σ) with h | h | h | h <;>
    rw [h] at hspec
  · exact Or.inl (hext 1 (by rw [← hspec, pow_one]; rfl))
  · exact Or.inr (Or.inl (hext sig3 (by rw [← hspec, sig3_zeta])))
  · exact Or.inr (Or.inr (Or.inl (hext sig5 (by rw [← hspec, sig5_zeta]))))
  · exact Or.inr (Or.inr (Or.inr (hext sig7 (by rw [← hspec, sig7_zeta]))))

/-- The product of the four Galois conjugates computes the field norm. -/
private theorem prod_aut_apply (x : K) :
    ∏ σ : K ≃ₐ[ℚ] K, σ x = x * sig3 x * sig5 x * sig7 x := by
  classical
  have hne : ∀ (i j : ℕ) (σ τ : K ≃ₐ[ℚ] K), i < 8 → j < 8 → i ≠ j →
      σ ζ = ζ ^ i → τ ζ = ζ ^ j → σ ≠ τ := fun i j σ τ hi hj hij hσ hτ hστ =>
    hij (zeta_isPrimitiveRoot.pow_inj hi hj (by rw [← hσ, ← hτ, hστ]))
  have hid : (1 : K ≃ₐ[ℚ] K) ζ = ζ ^ 1 := by rw [pow_one]; rfl
  have h1 : (1 : K ≃ₐ[ℚ] K) ≠ sig3 :=
    hne 1 3 _ _ (by norm_num) (by norm_num) (by norm_num) hid sig3_zeta
  have h2 : (1 : K ≃ₐ[ℚ] K) ≠ sig5 :=
    hne 1 5 _ _ (by norm_num) (by norm_num) (by norm_num) hid sig5_zeta
  have h3 : (1 : K ≃ₐ[ℚ] K) ≠ sig7 :=
    hne 1 7 _ _ (by norm_num) (by norm_num) (by norm_num) hid sig7_zeta
  have h4 : sig3 ≠ sig5 := hne 3 5 _ _ (by norm_num) (by norm_num) (by norm_num)
    sig3_zeta sig5_zeta
  have h5 : sig3 ≠ sig7 := hne 3 7 _ _ (by norm_num) (by norm_num) (by norm_num)
    sig3_zeta sig7_zeta
  have h6 : sig5 ≠ sig7 := hne 5 7 _ _ (by norm_num) (by norm_num) (by norm_num)
    sig5_zeta sig7_zeta
  have huniv : (Finset.univ : Finset (K ≃ₐ[ℚ] K)) = {1, sig3, sig5, sig7} := by
    refine (Finset.eq_univ_iff_forall.mpr fun σ => ?_).symm
    rcases autEq' σ with h | h | h | h <;> simp [h]
  rw [huniv, Finset.prod_insert (by simp [h1, h2, h3]), Finset.prod_insert (by simp [h4, h5]),
    Finset.prod_pair h6]
  show x * (sig3 x * (sig5 x * sig7 x)) = _
  ring

/-- Computing integral norms via the four Galois conjugates. -/
private theorem intNorm_eq (x : 𝓞 K) (n : ℤ)
    (h : algebraMap (𝓞 K) K x * sig3 (algebraMap (𝓞 K) K x) *
      sig5 (algebraMap (𝓞 K) K x) * sig7 (algebraMap (𝓞 K) K x) = (n : K)) :
    Algebra.norm ℤ x = n := by
  haveI := IsCyclotomicExtension.isGalois {8} ℚ K
  have h1 : algebraMap ℚ K (Algebra.norm ℚ (algebraMap (𝓞 K) K x)) = ((n : ℚ) : K) := by
    rw [Algebra.norm_eq_prod_automorphisms, prod_aut_apply, h]
    push_cast
    ring
  have h2 : Algebra.norm ℚ (algebraMap (𝓞 K) K x) = (n : ℚ) := by
    apply (algebraMap ℚ K).injective
    rw [h1, eq_ratCast (algebraMap ℚ K) (n : ℚ)]
  have h3 : ((Algebra.norm ℤ x : ℤ) : ℚ) = Algebra.norm ℚ (algebraMap (𝓞 K) K x) :=
    Algebra.coe_norm_int x
  rw [h2] at h3
  exact_mod_cast h3

private theorem cyclotomic_eight_int : Polynomial.cyclotomic 8 ℤ = Polynomial.X ^ 4 + 1 := by
  have h4 : Polynomial.cyclotomic 4 ℤ = Polynomial.X ^ 2 + 1 := by
    have h := Polynomial.cyclotomic_expand_eq_cyclotomic (R := ℤ) Nat.prime_two (dvd_refl 2)
    rw [Polynomial.cyclotomic_two, show (2 * 2 : ℕ) = 4 from rfl] at h
    rw [← h, map_add, map_one, Polynomial.expand_X]
  have h8 := Polynomial.cyclotomic_expand_eq_cyclotomic (R := ℤ) Nat.prime_two
    (by norm_num : (2 : ℕ) ∣ 4)
  rw [h4, show (4 * 2 : ℕ) = 8 from rfl] at h8
  rw [← h8, map_add, map_one, map_pow, Polynomial.expand_X]
  ring

private theorem minpoly_gen_eq :
    minpoly ℤ zeta_isPrimitiveRoot.integralPowerBasis.gen = Polynomial.X ^ 4 + 1 := by
  have hint : IsIntegral ℤ zeta_isPrimitiveRoot.integralPowerBasis.gen :=
    zeta_isPrimitiveRoot.integralPowerBasis.isIntegral_gen
  have hdvd : minpoly ℤ zeta_isPrimitiveRoot.integralPowerBasis.gen ∣ Polynomial.X ^ 4 + 1 :=
    minpoly.isIntegrallyClosed_dvd hint (by rw [gen_eq_zetaInt]; simp [zetaInt_pow_four])
  have hmonic := minpoly.monic hint
  have hdeg : (minpoly ℤ zeta_isPrimitiveRoot.integralPowerBasis.gen).natDegree = 4 := by
    rw [zeta_isPrimitiveRoot.integralPowerBasis.natDegree_minpoly,
      zeta_isPrimitiveRoot.integralPowerBasis_dim]
    rfl
  have hXmonic : (Polynomial.X ^ 4 + 1 : Polynomial ℤ).Monic := by
    rw [show (1 : Polynomial ℤ) = Polynomial.C 1 from Polynomial.C_1.symm]
    exact Polynomial.monic_X_pow_add_C 1 (by norm_num)
  obtain ⟨c, hc⟩ := hdvd
  have hcmonic : c.Monic := hmonic.of_mul_monic_left (hc ▸ hXmonic)
  have hdegc : c.natDegree = 0 := by
    have h4 : (Polynomial.X ^ 4 + 1 : Polynomial ℤ).natDegree = 4 := by
      rw [show (1 : Polynomial ℤ) = Polynomial.C 1 from Polynomial.C_1.symm]
      exact Polynomial.natDegree_X_pow_add_C
    have hcong := congrArg Polynomial.natDegree hc
    rw [h4, Polynomial.natDegree_mul (minpoly.ne_zero hint) hcmonic.ne_zero, hdeg] at hcong
    omega
  rw [hc, Polynomial.eq_one_of_monic_natDegree_zero hcmonic hdegc, mul_one]

/-- Reduction `𝓞 K → 𝔽_p` sending `ζ ↦ r`, for `r` a fourth root of `-1` mod `p`. -/
private noncomputable def residueHom (p : ℕ) (r : ℤ) (hr : ((r : ZMod p)) ^ 4 = -1) :
    𝓞 K →ₐ[ℤ] ZMod p :=
  zeta_isPrimitiveRoot.integralPowerBasis.lift ((r : ℤ) : ZMod p)
    (by rw [minpoly_gen_eq]; simp [hr])

private theorem residueHom_zetaInt (p : ℕ) (r : ℤ) (hr : ((r : ZMod p)) ^ 4 = -1) :
    residueHom p r hr zetaInt = (r : ZMod p) := by
  rw [← gen_eq_zetaInt]
  exact zeta_isPrimitiveRoot.integralPowerBasis.lift_gen ((r : ℤ) : ZMod p)
    (by rw [minpoly_gen_eq]; simp [hr])

private theorem ker_residueHom (p : ℕ) (r : ℤ) (hr : ((r : ZMod p)) ^ 4 = -1) :
    RingHom.ker (residueHom p r hr).toRingHom =
      Ideal.span {(p : 𝓞 K), zetaInt - (r : 𝓞 K)} := by
  refine le_antisymm (fun x hx => ?_) ?_
  · rw [RingHom.mem_ker] at hx
    obtain ⟨q, -, hq⟩ := zeta_isPrimitiveRoot.integralPowerBasis.exists_eq_aeval x
    rw [gen_eq_zetaInt] at hq
    have key : x - ((q.eval r : ℤ) : 𝓞 K) ∈ Ideal.span {zetaInt - (r : 𝓞 K)} := by
      rw [Ideal.mem_span_singleton, hq]
      have hdvd := Polynomial.sub_dvd_eval_sub zetaInt ((r : ℤ) : 𝓞 K)
        (q.map (algebraMap ℤ (𝓞 K)))
      have e1 : (q.map (algebraMap ℤ (𝓞 K))).eval zetaInt = Polynomial.aeval zetaInt q := by
        rw [Polynomial.eval_map, ← Polynomial.aeval_def]
      have e2 : (q.map (algebraMap ℤ (𝓞 K))).eval ((r : ℤ) : 𝓞 K) = ((q.eval r : ℤ) : 𝓞 K) := by
        have hcast : ((r : ℤ) : 𝓞 K) = algebraMap ℤ (𝓞 K) r := by
          simp [algebraMap_int_eq]
        rw [Polynomial.eval_map, hcast, Polynomial.eval₂_at_apply]
        simp [algebraMap_int_eq]
      rw [e1, e2] at hdvd
      exact hdvd
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp key
    have hphi : ((q.eval r : ℤ) : ZMod p) = 0 := by
      have h1 : residueHom p r hr (x - ((q.eval r : ℤ) : 𝓞 K)) = 0 := by
        rw [hd, map_mul, map_sub, residueHom_zetaInt, map_intCast, sub_self, zero_mul]
      rw [map_sub, map_intCast, show residueHom p r hr x = 0 from hx, zero_sub,
        neg_eq_zero] at h1
      exact h1
    obtain ⟨m, hm⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp hphi
    have hx_eq : x = (zetaInt - (r : 𝓞 K)) * d + (p : 𝓞 K) * ((m : ℤ) : 𝓞 K) := by
      have h2 : x = (zetaInt - (r : 𝓞 K)) * d + ((q.eval r : ℤ) : 𝓞 K) := by
        rw [← hd]; ring
      rw [h2, hm]
      push_cast
      ring
    rw [hx_eq]
    refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.subset_span ?_))
      (Ideal.mul_mem_right _ _ (Ideal.subset_span ?_))
    · simp
    · simp
  · rw [Ideal.span_le]
    rintro y (rfl | rfl)
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      simp
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      have h0 : (residueHom p r hr) (zetaInt - (r : 𝓞 K)) = 0 := by
        rw [map_sub, residueHom_zetaInt, map_intCast, sub_self]
      exact h0

private theorem residueHom_surjective (p : ℕ) (r : ℤ) (hr : ((r : ZMod p)) ^ 4 = -1) :
    Function.Surjective (residueHom p r hr) := by
  intro z
  obtain ⟨m, hm⟩ := ZMod.intCast_surjective z
  exact ⟨((m : ℤ) : 𝓞 K), by rw [map_intCast]; exact hm⟩

private theorem isMaximal_span_pair (p : ℕ) [Fact p.Prime] (r : ℤ)
    (hr : ((r : ZMod p)) ^ 4 = -1) :
    (Ideal.span {(p : 𝓞 K), zetaInt - (r : 𝓞 K)}).IsMaximal := by
  rw [← ker_residueHom p r hr]
  exact RingHom.ker_isMaximal_of_surjective _ (residueHom_surjective p r hr)

private theorem absNorm_span_pair (p : ℕ) (r : ℤ) (hr : ((r : ZMod p)) ^ 4 = -1) :
    Ideal.absNorm (Ideal.span {(p : 𝓞 K), zetaInt - (r : 𝓞 K)}) = p := by
  rw [← ker_residueHom p r hr, Ideal.absNorm_apply, Submodule.cardQuot_apply]
  rw [Nat.card_congr (RingHom.quotientKerEquivOfSurjective
    (residueHom_surjective p r hr)).toEquiv]
  exact Nat.card_zmod p

/-- `2` is totally ramified: `(2) = (1 - ζ)⁴` as ideals of `𝓞 K` — ramification index
`e = 4` equals the full degree. -/
theorem span_two_eq : Ideal.span {(2 : 𝓞 K)} = Ideal.span {1 - zetaInt} ^ 4 := by
  rw [Ideal.span_singleton_pow, Ideal.span_singleton_eq_span_singleton]
  refine ⟨⟨-2 * zetaInt + 3 * zetaInt ^ 2 - 2 * zetaInt ^ 3,
    -2 * zetaInt - 3 * zetaInt ^ 2 - 2 * zetaInt ^ 3,
    by linear_combination (4 * zetaInt ^ 2 - 1) * zetaInt_pow_four,
    by linear_combination (4 * zetaInt ^ 2 - 1) * zetaInt_pow_four⟩, ?_⟩
  change (2 : 𝓞 K) * (-2 * zetaInt + 3 * zetaInt ^ 2 - 2 * zetaInt ^ 3) = (1 - zetaInt) ^ 4
  linear_combination -zetaInt_pow_four

private theorem span_one_sub_zetaInt_eq_pair :
    Ideal.span {1 - zetaInt} = Ideal.span {((2 : ℕ) : 𝓞 K), zetaInt - ((1 : ℤ) : 𝓞 K)} := by
  refine le_antisymm ((Ideal.span_singleton_le_iff_mem _).mpr ?_) (Ideal.span_le.mpr ?_)
  · refine Ideal.mem_span_pair.mpr ⟨0, -1, ?_⟩
    push_cast
    ring
  · rintro y (rfl | rfl)
    · have h2 : ((2 : ℕ) : 𝓞 K) ∈ Ideal.span {(2 : 𝓞 K)} := by
        rw [Ideal.mem_span_singleton]
        exact ⟨1, by push_cast; ring⟩
      rw [span_two_eq] at h2
      exact Ideal.pow_le_self (by norm_num) h2
    · rw [SetLike.mem_coe, Ideal.mem_span_singleton]
      exact ⟨-1, by push_cast; ring⟩

/-- `(1 - ζ)` is a prime ideal — the unique prime of `𝓞 K` above `2`. -/
theorem isPrime_span_one_sub_zeta : (Ideal.span {1 - zetaInt}).IsPrime := by
  rw [span_one_sub_zetaInt_eq_pair]
  exact (isMaximal_span_pair 2 1 (by decide)).isPrime

/-- The prime `(1 - ζ)` above `2` has norm `Φ₈(1) = 2` (residue degree `f = 1`). -/
theorem absNorm_span_one_sub_zeta : Ideal.absNorm (Ideal.span {1 - zetaInt}) = 2 := by
  rw [span_one_sub_zetaInt_eq_pair]
  exact absNorm_span_pair 2 1 (by decide)

private theorem span_pair_three_left :
    Ideal.span {(3 : 𝓞 K), zetaInt ^ 2 + zetaInt + 2} =
      Ideal.span {zetaInt ^ 2 + zetaInt - 1} := by
  have h3 : (3 : 𝓞 K) ∈ Ideal.span {zetaInt ^ 2 + zetaInt - 1} := by
    rw [Ideal.mem_span_singleton]
    refine ⟨-(zetaInt ^ 3 + zetaInt ^ 2 + 1), ?_⟩
    linear_combination (zetaInt + 2) * zetaInt_pow_four
  refine le_antisymm (Ideal.span_le.mpr ?_) ((Ideal.span_singleton_le_iff_mem _).mpr ?_)
  · rintro y (rfl | rfl)
    · exact h3
    · rw [SetLike.mem_coe, show zetaInt ^ 2 + zetaInt + 2 =
        (zetaInt ^ 2 + zetaInt - 1) + 3 from by ring]
      exact Ideal.add_mem _ (Ideal.mem_span_singleton_self _) h3
  · exact Ideal.mem_span_pair.mpr ⟨-1, 1, by ring⟩

private theorem span_pair_three_right :
    Ideal.span {(3 : 𝓞 K), zetaInt ^ 2 + 2 * zetaInt + 2} =
      Ideal.span {zetaInt ^ 2 - zetaInt - 1} := by
  have h3 : (3 : 𝓞 K) ∈ Ideal.span {zetaInt ^ 2 - zetaInt - 1} := by
    rw [Ideal.mem_span_singleton]
    refine ⟨zetaInt ^ 3 - zetaInt ^ 2 - 1, ?_⟩
    linear_combination (2 - zetaInt) * zetaInt_pow_four
  refine le_antisymm (Ideal.span_le.mpr ?_) ((Ideal.span_singleton_le_iff_mem _).mpr ?_)
  · rintro y (rfl | rfl)
    · exact h3
    · rw [SetLike.mem_coe, show zetaInt ^ 2 + 2 * zetaInt + 2 =
        (zetaInt ^ 2 - zetaInt - 1) + 3 * (zetaInt + 1) from by ring]
      exact Ideal.add_mem _ (Ideal.mem_span_singleton_self _) (Ideal.mul_mem_right _ _ h3)
  · exact Ideal.mem_span_pair.mpr ⟨-(zetaInt + 1), 1, by ring⟩

/-- `3` splits into two primes of degree `2`: `3` has order `2` in `(ℤ/8)ˣ`, and
`Φ₈ = X⁴ + 1 ≡ (X² + X + 2)(X² + 2X + 2) (mod 3)`. -/
theorem span_three_eq :
    Ideal.span {(3 : 𝓞 K)} =
      Ideal.span {(3 : 𝓞 K), zetaInt ^ 2 + zetaInt + 2} *
        Ideal.span {(3 : 𝓞 K), zetaInt ^ 2 + 2 * zetaInt + 2} := by
  rw [span_pair_three_left, span_pair_three_right, Ideal.span_singleton_mul_span_singleton,
    Ideal.span_singleton_eq_span_singleton]
  refine ⟨⟨-zetaInt ^ 2, zetaInt ^ 2, by linear_combination -zetaInt_pow_four,
    by linear_combination -zetaInt_pow_four⟩, ?_⟩
  change (3 : 𝓞 K) * (-zetaInt ^ 2) =
    (zetaInt ^ 2 + zetaInt - 1) * (zetaInt ^ 2 - zetaInt - 1)
  linear_combination -zetaInt_pow_four

/-- There is no prime of `𝓞 K` with residue field `𝔽₃`: `X⁴ + 1` has no root mod `3`. -/
private theorem absNorm_ne_three (P : Ideal (𝓞 K)) : Ideal.absNorm P ≠ 3 := by
  intro hcard
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply] at hcard
  haveI : Finite ((𝓞 K) ⧸ P) := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  haveI : Fintype ((𝓞 K) ⧸ P) := Fintype.ofFinite _
  have hcard' : Fintype.card ((𝓞 K) ⧸ P) = 3 := by rw [← Nat.card_eq_fintype_card]; exact hcard
  let e := ZMod.ringEquivOfPrime ((𝓞 K) ⧸ P) (by norm_num) hcard'
  obtain ⟨s, hs⟩ := e.surjective (Ideal.Quotient.mk P zetaInt)
  have hs4 : s ^ 4 = (-1 : ZMod 3) := by
    apply e.injective
    rw [map_pow, hs, ← map_pow (Ideal.Quotient.mk P), zetaInt_pow_four, map_neg, map_one,
      map_neg, map_one]
  clear hs
  revert s
  decide

private theorem isPrime_of_absNorm_nine {g : 𝓞 K}
    (h9 : Ideal.absNorm (Ideal.span {g}) = 9) : (Ideal.span {g}).IsPrime := by
  have htop : Ideal.span {g} ≠ ⊤ := by
    intro h
    rw [h, Ideal.absNorm_top] at h9
    norm_num at h9
  obtain ⟨M, hMmax, hMle⟩ := Ideal.exists_le_maximal _ htop
  have hdvd : Ideal.absNorm M ∣ 9 := h9 ▸ Ideal.absNorm_dvd_absNorm_of_le hMle
  have hM1 : Ideal.absNorm M ≠ 1 := by
    rw [Ne, Ideal.absNorm_eq_one_iff]
    exact hMmax.ne_top
  have hM3 : Ideal.absNorm M ≠ 3 := absNorm_ne_three M
  have hM9 : Ideal.absNorm M = 9 := by
    obtain ⟨k, hk, hkeq⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp
      (show Ideal.absNorm M ∣ 3 ^ 2 from hdvd)
    interval_cases k <;> simp_all
  obtain ⟨C, hC⟩ := Ideal.dvd_iff_le.mpr hMle
  have hCnorm : Ideal.absNorm C = 1 := by
    have hmul := _root_.map_mul Ideal.absNorm M C
    rw [← hC, h9, hM9] at hmul
    omega
  have hgM : Ideal.span {g} = M := by
    rw [hC, Ideal.absNorm_eq_one_iff.mp hCnorm, Ideal.mul_top]
  rw [hgM]
  exact hMmax.isPrime

private theorem absNorm_span_g1 :
    Ideal.absNorm (Ideal.span {zetaInt ^ 2 + zetaInt - 1}) = 9 := by
  have hn : Algebra.norm ℤ (zetaInt ^ 2 + zetaInt - 1) = 9 := by
    apply intNorm_eq
    have e0 : algebraMap (𝓞 K) K (zetaInt ^ 2 + zetaInt - 1) = ζ ^ 2 + ζ - 1 := by
      simp [map_add, map_sub, map_pow, map_one, coe_zetaInt]
    rw [e0]
    have e3 : sig3 (ζ ^ 2 + ζ - 1) = ζ ^ 3 - ζ ^ 2 - 1 := by
      rw [map_sub, map_add, map_pow, map_one, sig3_zeta]
      linear_combination ζ ^ 2 * zeta_pow_four
    have e5 : sig5 (ζ ^ 2 + ζ - 1) = ζ ^ 2 - ζ - 1 := by
      rw [map_sub, map_add, map_pow, map_one, sig5_zeta]
      linear_combination (ζ ^ 6 - ζ ^ 2 + ζ) * zeta_pow_four
    have e7 : sig7 (ζ ^ 2 + ζ - 1) = -ζ ^ 3 - ζ ^ 2 - 1 := by
      rw [map_sub, map_add, map_pow, map_one, sig7_zeta]
      linear_combination (ζ ^ 10 - ζ ^ 6 + ζ ^ 2 + ζ ^ 3) * zeta_pow_four
    rw [e3, e5, e7]
    push_cast
    linear_combination (-ζ ^ 6 + 4 * ζ ^ 4 - ζ ^ 2 - 8) * zeta_pow_four
  rw [Ideal.absNorm_span_singleton, hn]
  rfl

private theorem absNorm_span_g2 :
    Ideal.absNorm (Ideal.span {zetaInt ^ 2 - zetaInt - 1}) = 9 := by
  have hn : Algebra.norm ℤ (zetaInt ^ 2 - zetaInt - 1) = 9 := by
    apply intNorm_eq
    have e0 : algebraMap (𝓞 K) K (zetaInt ^ 2 - zetaInt - 1) = ζ ^ 2 - ζ - 1 := by
      simp [map_add, map_sub, map_pow, map_one, coe_zetaInt]
    rw [e0]
    have e3 : sig3 (ζ ^ 2 - ζ - 1) = -ζ ^ 3 - ζ ^ 2 - 1 := by
      rw [map_sub, map_sub, map_pow, map_one, sig3_zeta]
      linear_combination ζ ^ 2 * zeta_pow_four
    have e5 : sig5 (ζ ^ 2 - ζ - 1) = ζ ^ 2 + ζ - 1 := by
      rw [map_sub, map_sub, map_pow, map_one, sig5_zeta]
      linear_combination (ζ ^ 6 - ζ ^ 2 - ζ) * zeta_pow_four
    have e7 : sig7 (ζ ^ 2 - ζ - 1) = ζ ^ 3 - ζ ^ 2 - 1 := by
      rw [map_sub, map_sub, map_pow, map_one, sig7_zeta]
      linear_combination (ζ ^ 10 - ζ ^ 6 + ζ ^ 2 - ζ ^ 3) * zeta_pow_four
    rw [e3, e5, e7]
    push_cast
    linear_combination (-ζ ^ 6 + 4 * ζ ^ 4 - ζ ^ 2 - 8) * zeta_pow_four
  rw [Ideal.absNorm_span_singleton, hn]
  rfl

/-- Both primes above `3` are prime ideals of norm `3² = 9`. -/
theorem isPrime_primesAboveThree :
    (Ideal.span {(3 : 𝓞 K), zetaInt ^ 2 + zetaInt + 2}).IsPrime ∧
      (Ideal.span {(3 : 𝓞 K), zetaInt ^ 2 + 2 * zetaInt + 2}).IsPrime := by
  constructor
  · rw [span_pair_three_left]
    exact isPrime_of_absNorm_nine absNorm_span_g1
  · rw [span_pair_three_right]
    exact isPrime_of_absNorm_nine absNorm_span_g2

private theorem seventeen_mem_span_two :
    (17 : 𝓞 K) ∈ Ideal.span {zetaInt - 2} := by
  rw [Ideal.mem_span_singleton]
  refine ⟨(zetaInt ^ 3 - 2) * ((zetaInt ^ 5 - 2) * (zetaInt ^ 7 - 2)), ?_⟩
  linear_combination (-zetaInt ^ 12 + 2 * zetaInt ^ 11 + 2 * zetaInt ^ 9 - 3 * zetaInt ^ 8 -
    4 * zetaInt ^ 6 - 5 * zetaInt ^ 4 + 8 * zetaInt ^ 3 + 8 * zetaInt + 1) * zetaInt_pow_four

private theorem seventeen_mem_span_eight :
    (17 : 𝓞 K) ∈ Ideal.span {zetaInt ^ 3 - 2} := by
  rw [Ideal.mem_span_singleton]
  refine ⟨(zetaInt - 2) * ((zetaInt ^ 5 - 2) * (zetaInt ^ 7 - 2)), ?_⟩
  linear_combination (-zetaInt ^ 12 + 2 * zetaInt ^ 11 + 2 * zetaInt ^ 9 - 3 * zetaInt ^ 8 -
    4 * zetaInt ^ 6 - 5 * zetaInt ^ 4 + 8 * zetaInt ^ 3 + 8 * zetaInt + 1) * zetaInt_pow_four

private theorem seventeen_mem_span_nine :
    (17 : 𝓞 K) ∈ Ideal.span {zetaInt ^ 7 - 2} := by
  rw [Ideal.mem_span_singleton]
  refine ⟨(zetaInt - 2) * ((zetaInt ^ 3 - 2) * (zetaInt ^ 5 - 2)), ?_⟩
  linear_combination (-zetaInt ^ 12 + 2 * zetaInt ^ 11 + 2 * zetaInt ^ 9 - 3 * zetaInt ^ 8 -
    4 * zetaInt ^ 6 - 5 * zetaInt ^ 4 + 8 * zetaInt ^ 3 + 8 * zetaInt + 1) * zetaInt_pow_four

private theorem seventeen_mem_span_fifteen :
    (17 : 𝓞 K) ∈ Ideal.span {zetaInt ^ 5 - 2} := by
  rw [Ideal.mem_span_singleton]
  refine ⟨(zetaInt - 2) * ((zetaInt ^ 3 - 2) * (zetaInt ^ 7 - 2)), ?_⟩
  linear_combination (-zetaInt ^ 12 + 2 * zetaInt ^ 11 + 2 * zetaInt ^ 9 - 3 * zetaInt ^ 8 -
    4 * zetaInt ^ 6 - 5 * zetaInt ^ 4 + 8 * zetaInt ^ 3 + 8 * zetaInt + 1) * zetaInt_pow_four

private theorem span_pair_seventeen_two :
    Ideal.span {(17 : 𝓞 K), zetaInt - 2} = Ideal.span {zetaInt - 2} := by
  refine le_antisymm (Ideal.span_le.mpr ?_) ((Ideal.span_singleton_le_iff_mem _).mpr ?_)
  · rintro y (rfl | rfl)
    · exact seventeen_mem_span_two
    · exact Ideal.mem_span_singleton_self _
  · exact Ideal.mem_span_pair.mpr ⟨0, 1, by ring⟩

private theorem span_pair_seventeen_eight :
    Ideal.span {(17 : 𝓞 K), zetaInt - 8} = Ideal.span {zetaInt ^ 3 - 2} := by
  refine le_antisymm (Ideal.span_le.mpr ?_) ((Ideal.span_singleton_le_iff_mem _).mpr ?_)
  · rintro y (rfl | rfl)
    · exact seventeen_mem_span_eight
    · rw [SetLike.mem_coe, Ideal.mem_span_singleton]
      refine ⟨zetaInt ^ 6 + 2 * zetaInt ^ 3 + 4, ?_⟩
      linear_combination (zetaInt - zetaInt ^ 5) * zetaInt_pow_four
  · exact Ideal.mem_span_pair.mpr ⟨30, zetaInt ^ 2 + 8 * zetaInt + 64, by ring⟩

private theorem span_pair_seventeen_nine :
    Ideal.span {(17 : 𝓞 K), zetaInt - 9} = Ideal.span {zetaInt ^ 7 - 2} := by
  refine le_antisymm (Ideal.span_le.mpr ?_) ((Ideal.span_singleton_le_iff_mem _).mpr ?_)
  · rintro y (rfl | rfl)
    · exact seventeen_mem_span_nine
    · rw [SetLike.mem_coe, show zetaInt - (9 : 𝓞 K) =
        (zetaInt ^ 7 - 2) * (-9 * zetaInt) + 17 * (-zetaInt) from by
          linear_combination (9 * zetaInt ^ 4 - 9) * zetaInt_pow_four]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
        (Ideal.mul_mem_right _ _ seventeen_mem_span_nine)
  · exact Ideal.mem_span_pair.mpr ⟨-43, -(zetaInt ^ 2 + 9 * zetaInt + 81),
      by linear_combination -zetaInt ^ 3 * zetaInt_pow_four⟩

private theorem span_pair_seventeen_fifteen :
    Ideal.span {(17 : 𝓞 K), zetaInt - 15} = Ideal.span {zetaInt ^ 5 - 2} := by
  refine le_antisymm (Ideal.span_le.mpr ?_) ((Ideal.span_singleton_le_iff_mem _).mpr ?_)
  · rintro y (rfl | rfl)
    · exact seventeen_mem_span_fifteen
    · rw [SetLike.mem_coe, show zetaInt - (15 : 𝓞 K) =
        (zetaInt ^ 5 - 2) * (-1) + 17 * (-1) from by
          linear_combination zetaInt * zetaInt_pow_four]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
        (Ideal.mul_mem_right _ _ seventeen_mem_span_fifteen)
  · exact Ideal.mem_span_pair.mpr ⟨-1, -1, by linear_combination -zetaInt * zetaInt_pow_four⟩

/-- `17` splits completely: `17 ≡ 1 (mod 8)`, and the roots of `X⁴ + 1` mod `17` are
`2, 8, 9, 15` (the elements of order `8` in `(ℤ/17)ˣ`). -/
theorem span_seventeen_eq :
    Ideal.span {(17 : 𝓞 K)} =
      Ideal.span {(17 : 𝓞 K), zetaInt - 2} * Ideal.span {(17 : 𝓞 K), zetaInt - 8} *
        Ideal.span {(17 : 𝓞 K), zetaInt - 9} * Ideal.span {(17 : 𝓞 K), zetaInt - 15} := by
  rw [span_pair_seventeen_two, span_pair_seventeen_eight, span_pair_seventeen_nine,
    span_pair_seventeen_fifteen, Ideal.span_singleton_mul_span_singleton,
    Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_mul_span_singleton,
    show (zetaInt - 2) * (zetaInt ^ 3 - 2) * (zetaInt ^ 7 - 2) * (zetaInt ^ 5 - 2) =
      (17 : 𝓞 K) from by
        linear_combination (zetaInt ^ 12 - 2 * zetaInt ^ 11 - 2 * zetaInt ^ 9 +
          3 * zetaInt ^ 8 + 4 * zetaInt ^ 6 + 5 * zetaInt ^ 4 - 8 * zetaInt ^ 3 -
          8 * zetaInt - 1) * zetaInt_pow_four]

/-- Each ideal `(17, ζ - r)` for `r ∈ {2, 8, 9, 15}` is a prime of norm `17`. -/
theorem isPrime_primeAboveSeventeen (r : ℤ) (hr : r = 2 ∨ r = 8 ∨ r = 9 ∨ r = 15) :
    (Ideal.span {(17 : 𝓞 K), zetaInt - (r : 𝓞 K)}).IsPrime := by
  have hs : ((r : ZMod 17)) ^ 4 = -1 := by
    rcases hr with rfl | rfl | rfl | rfl <;> decide
  haveI : Fact (Nat.Prime 17) := ⟨by norm_num⟩
  have h := (isMaximal_span_pair 17 r hs).isPrime
  rwa [show ((17 : ℕ) : 𝓞 K) = (17 : 𝓞 K) from by norm_cast] at h

/-- **No rational prime is inert in `ℚ(ζ₈)`**: the Galois group `(ℤ/8)ˣ` has exponent `2`,
so every Frobenius has order at most `2` and every residue degree is `≤ 2 < 4`. This is a
hallmark of non-cyclic abelian extensions. -/
theorem no_inert_prime (p : ℕ) (hp : p.Prime) :
    ¬ (Ideal.span {(p : 𝓞 K)}).IsPrime := by
  sorry

/-- The splitting law for `ℚ(ζ₈)`: a prime `p` splits completely iff `p ≡ 1 (mod 8)`. -/
theorem splits_completely_iff (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) :
    (∃ P : Ideal (𝓞 K), P.IsPrime ∧ Ideal.span {(p : 𝓞 K)} ≤ P ∧ Ideal.absNorm P = p) ↔
      p % 8 = 1 := by
  sorry

/-- A rational prime `p` ramifies in `ℚ(ζ₈)` iff `p = 2`, i.e. iff `p` divides the
discriminant `256`. -/
theorem ramified_iff_eq_two (p : ℕ) (hp : p.Prime) :
    (∃ P : Ideal (𝓞 K), P.IsPrime ∧ Ideal.span {(p : 𝓞 K)} ≤ P ^ 2) ↔ p = 2 := by
  constructor
  · rintro ⟨P, hP, hle2⟩
    haveI : P.IsPrime := hP
    have hple : Ideal.span {((p : ℕ) : 𝓞 K)} ≤ P :=
      hle2.trans (Ideal.pow_le_self (by norm_num))
    have hpmemP : ((p : ℕ) : 𝓞 K) ∈ P := hple (Ideal.mem_span_singleton_self _)
    have hpne : ((p : ℕ) : 𝓞 K) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
    have hPbot : P ≠ ⊥ := by
      intro h
      rw [h] at hpmemP
      exact hpne (Ideal.mem_bot.mp hpmemP)
    have hfin : Module.finrank ℤ (𝓞 K) = 4 := by
      rw [Module.finrank_eq_card_basis concreteIntegralBasis, Fintype.card_fin]
    have habsp : Ideal.absNorm (Ideal.span {((p : ℕ) : 𝓞 K)}) = p ^ 4 := by
      rw [Ideal.absNorm_span_singleton]
      have hcast : ((p : ℕ) : 𝓞 K) = algebraMap ℤ (𝓞 K) ((p : ℕ) : ℤ) := by push_cast; rfl
      rw [hcast, Algebra.norm_algebraMap, hfin, Int.natAbs_pow, Int.natAbs_natCast]
    have habsPp4 : Ideal.absNorm P ∣ p ^ 4 :=
      habsp ▸ Ideal.absNorm_dvd_absNorm_of_le hple
    obtain ⟨k, hk4, hkeq⟩ := (Nat.dvd_prime_pow hp).mp habsPp4
    have hk0 : k ≠ 0 := by
      intro h0
      rw [h0, pow_zero] at hkeq
      exact hP.ne_top (Ideal.absNorm_eq_one_iff.mp hkeq)
    have hmap : Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span {((p : ℕ) : ℤ)}) =
        Ideal.span {((p : ℕ) : 𝓞 K)} := by
      rw [Ideal.map_span, Set.image_singleton]
      norm_num
    have hle2' : Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span {((p : ℕ) : ℤ)}) ≤ P ^ 2 := by
      rw [hmap]; exact hle2
    have hno5 : ¬ Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span {((p : ℕ) : ℤ)}) ≤ P ^ 5 := by
      intro h5
      rw [hmap] at h5
      have hd := Ideal.absNorm_dvd_absNorm_of_le h5
      rw [map_pow, habsp, hkeq, ← pow_mul] at hd
      rw [Nat.pow_dvd_pow_iff_le_right hp.one_lt] at hd
      omega
    have hidx : Ideal.ramificationIdx (Ideal.span {((p : ℕ) : ℤ)}) P ≠ 1 := by
      by_cases h3 : Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span {((p : ℕ) : ℤ)}) ≤ P ^ 3
      · by_cases h4 : Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span {((p : ℕ) : ℤ)}) ≤ P ^ 4
        · rw [Ideal.ramificationIdx_spec h4 hno5]
          norm_num
        · rw [Ideal.ramificationIdx_spec h3 h4]
          norm_num
      · rw [Ideal.ramificationIdx_spec hle2' h3]
        norm_num
    have hund : Ideal.under ℤ P = Ideal.span {((p : ℕ) : ℤ)} := by
      have hmem : ((p : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
        rw [Ideal.under, Ideal.mem_comap]
        have hcast2 : algebraMap ℤ (𝓞 K) ((p : ℕ) : ℤ) = ((p : ℕ) : 𝓞 K) := by push_cast; rfl
        rw [hcast2]
        exact hpmemP
      have hle : Ideal.span {((p : ℕ) : ℤ)} ≤ Ideal.under ℤ P := by
        rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hmem
      have hprime : (Ideal.span {((p : ℕ) : ℤ)}).IsPrime :=
        (Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)).mpr
          (Nat.prime_iff_prime_int.mp hp)
      have hbot : Ideal.span {((p : ℕ) : ℤ)} ≠ ⊥ := by
        rw [Ne, Ideal.span_singleton_eq_bot]
        exact_mod_cast hp.ne_zero
      have hnetop : Ideal.under ℤ P ≠ ⊤ := by
        intro h
        have h1 : (1 : ℤ) ∈ Ideal.under ℤ P := h ▸ Submodule.mem_top
        rw [Ideal.under, Ideal.mem_comap, map_one] at h1
        exact hP.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
      exact ((hprime.isMaximal hbot).eq_of_le hnetop hle).symm
    have hunram : ¬ Algebra.IsUnramifiedAt ℤ P := by
      rw [Algebra.isUnramifiedAt_iff_of_isDedekindDomain hPbot, hund]
      exact hidx
    have hPdiff : P ∣ differentIdeal ℤ (𝓞 K) := dvd_differentIdeal_iff.mpr hunram
    have habsP256 : Ideal.absNorm P ∣ 256 := by
      have h := Ideal.absNorm_dvd_absNorm_of_le (Ideal.le_of_dvd hPdiff)
      rw [NumberField.absNorm_differentIdeal (K := K), numberField_discr_eq] at h
      simpa using h
    have hpdvd : p ∣ 256 := (hkeq ▸ dvd_pow_self p hk0).trans habsP256
    have hp2 : p ∣ 2 := hp.dvd_of_dvd_pow (show p ∣ 2 ^ 8 by norm_num; exact hpdvd)
    exact (Nat.prime_dvd_prime_iff_eq hp (by norm_num)).mp hp2
  · rintro rfl
    refine ⟨Ideal.span {1 - zetaInt}, isPrime_span_one_sub_zeta, ?_⟩
    have hcast : ((2 : ℕ) : 𝓞 K) = (2 : 𝓞 K) := by norm_num
    rw [hcast, span_two_eq]
    exact Ideal.pow_le_pow_right (by norm_num)

/-! ## 6. Ring of units -/

/-- A torsion generator of `𝓞 Kˣ`: the eighth root of unity `ζ` itself, with explicit
inverse `ζ⁷`. -/
noncomputable def torsionGenerator : (𝓞 K)ˣ where
  val := zetaInt
  inv := zetaInt ^ 7
  val_inv := by linear_combination (zetaInt ^ 4 - 1) * zetaInt_pow_four
  inv_val := by linear_combination (zetaInt ^ 4 - 1) * zetaInt_pow_four

/-- The concrete torsion units: the eight roots of unity `ζ^k`. -/
def torsionUnits : Set ((𝓞 K)ˣ) := {u | ∃ k : Fin 8, u = torsionGenerator ^ k.val}

/-- The torsion subgroup of `𝓞 Kˣ` is exactly `μ₈ = {ζ^k}` (note `-1 = ζ⁴` is already a
power of `ζ`, unlike in `ℚ(ζ₅)`). -/
private theorem torsionOrder_eq' : NumberField.Units.torsionOrder K = 8 := by
  rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := 8)]
  norm_num

theorem torsionUnits_eq : {u : (𝓞 K)ˣ | IsOfFinOrder u} = torsionUnits := by
  have htg8 : torsionGenerator ^ 8 = 1 := by
    ext
    exact zeta_pow_eight
  ext u
  constructor
  · intro hu
    have humem : u ∈ NumberField.Units.torsion K := hu
    rw [← NumberField.Units.rootsOfUnity_eq_torsion K, torsionOrder_eq'] at humem
    have h8 : u ^ 8 = 1 := humem
    have hK : (algebraMap (𝓞 K) K ((u : (𝓞 K)ˣ) : 𝓞 K)) ^ 8 = 1 := by
      have hval : ((u ^ 8 : (𝓞 K)ˣ) : 𝓞 K) = ((1 : (𝓞 K)ˣ) : 𝓞 K) := by rw [h8]
      rw [Units.val_pow_eq_pow_val, Units.val_one] at hval
      rw [← map_pow, hval, map_one]
    obtain ⟨i, hi, hieq⟩ := zeta_isPrimitiveRoot.eq_pow_of_pow_eq_one hK
    refine ⟨⟨i, hi⟩, Units.ext (IsFractionRing.injective (𝓞 K) K ?_)⟩
    rw [← hieq]
    change ζ ^ i = algebraMap (𝓞 K) K ((torsionGenerator ^ i : (𝓞 K)ˣ) : 𝓞 K)
    rw [Units.val_pow_eq_pow_val, map_pow]
    rfl
  · rintro ⟨k, rfl⟩
    refine isOfFinOrder_iff_pow_eq_one.mpr ⟨8, by norm_num, ?_⟩
    rw [← pow_mul, mul_comm, pow_mul, htg8, one_pow]

/-- The torsion subgroup of `𝓞 Kˣ` has order `8`. -/
theorem torsionOrder_eq_eight : NumberField.Units.torsionOrder K = 8 :=
  torsionOrder_eq'

/-- `ℚ(ζ₈)` is totally complex: the signature is `(0, 2)`. -/
theorem nrRealPlaces_eq_zero : NumberField.InfinitePlace.nrRealPlaces K = 0 :=
  IsCyclotomicExtension.Rat.nrRealPlaces_eq_zero (n := 8) K (by norm_num)

private theorem nrComplexPlaces_eq_two : NumberField.InfinitePlace.nrComplexPlaces K = 2 := by
  have h := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
  rw [nrRealPlaces_eq_zero, degree_eq_four] at h
  omega

/-- The Dirichlet unit rank of `ℚ(ζ₈)` is `1`: the signature is `(0, 2)`, so the rank is
`r₁ + r₂ - 1 = 1`. -/
theorem unitRank_eq_one : NumberField.Units.rank K = 1 := by
  rw [NumberField.Units.rank, NumberField.InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces,
    nrRealPlaces_eq_zero, nrComplexPlaces_eq_two]

/-- The fundamental unit of `𝓞 K`: `1 + √2 = 1 + ζ + ζ⁷`, with explicit inverse
`√2 - 1 = ζ + ζ⁷ - 1` (the fundamental unit of the real quadratic subfield `ℚ(√2)`). -/
noncomputable def fundamentalUnit : (𝓞 K)ˣ where
  val := 1 + zetaInt + zetaInt ^ 7
  inv := zetaInt + zetaInt ^ 7 - 1
  val_inv := by
    linear_combination (zetaInt ^ 10 - zetaInt ^ 6 + 2 * zetaInt ^ 4 + zetaInt ^ 2 - 2) *
      zetaInt_pow_four
  inv_val := by
    linear_combination (zetaInt ^ 10 - zetaInt ^ 6 + 2 * zetaInt ^ 4 + zetaInt ^ 2 - 2) *
      zetaInt_pow_four

/-- The system of fundamental units for the rank-`1` unit group: the single unit `1 + √2`. -/
noncomputable def fundamentalUnitSystem : Fin (NumberField.Units.rank K) → (𝓞 K)ˣ :=
  fun _ => fundamentalUnit

/-- Mathlib's abstract fundamental unit `fundSystem K i₀`, together with the torsion, generates
the whole unit group (rank-one specialization of `closure_fundSystem_sup_torsion_eq_top`). -/
private theorem exists_eq_torsion_mul_fundSystem_zpow (i₀ : Fin (NumberField.Units.rank K))
    (u : (𝓞 K)ˣ) :
    ∃ ζ' ∈ NumberField.Units.torsion K, ∃ n : ℤ,
      u = ζ' * NumberField.Units.fundSystem K i₀ ^ n := by
  haveI hsub : Subsingleton (Fin (NumberField.Units.rank K)) :=
    Fin.subsingleton_iff_le_one.mpr (by rw [unitRank_eq_one])
  have hu : u ∈ Subgroup.closure (Set.range (NumberField.Units.fundSystem K)) ⊔
      NumberField.Units.torsion K := by
    rw [NumberField.Units.closure_fundSystem_sup_torsion_eq_top]; trivial
  rw [Subgroup.mem_sup] at hu
  obtain ⟨x, hx, y, hy, hxy⟩ := hu
  have hrange : Set.range (NumberField.Units.fundSystem K) =
      {NumberField.Units.fundSystem K i₀} := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩
      rw [Subsingleton.elim i i₀]
      rfl
    · rintro rfl
      exact ⟨i₀, rfl⟩
  rw [hrange, Subgroup.mem_closure_singleton] at hx
  obtain ⟨n, hn⟩ := hx
  exact ⟨y, hy, n, by rw [hn, ← hxy]; exact mul_comm x y⟩

/-- A power of the abstract fundamental unit is torsion only for exponent zero: its image in
the (free) quotient modulo torsion is a basis vector. -/
private theorem fundSystem_zpow_mem_torsion (i₀ : Fin (NumberField.Units.rank K)) (n : ℤ)
    (hn : NumberField.Units.fundSystem K i₀ ^ n ∈ NumberField.Units.torsion K) : n = 0 := by
  have h1 : ((NumberField.Units.fundSystem K i₀ ^ n : (𝓞 K)ˣ) :
      (𝓞 K)ˣ ⧸ NumberField.Units.torsion K) = 1 := (QuotientGroup.eq_one_iff _).mpr hn
  rw [QuotientGroup.mk_zpow] at h1
  have h0 : Additive.ofMul ((NumberField.Units.fundSystem K i₀ :
      (𝓞 K)ˣ ⧸ NumberField.Units.torsion K) ^ n) = (0 :
      Additive ((𝓞 K)ˣ ⧸ NumberField.Units.torsion K)) := by
    rw [h1]; rfl
  rw [ofMul_zpow, NumberField.Units.fundSystem_mk] at h0
  have hco := congrArg (fun v => ((NumberField.Units.basisModTorsion K).repr v) i₀) h0
  simpa using hco

/-- Pointwise classification of the torsion: every torsion unit is a power of `ζ`. -/
private theorem eq_torsionGenerator_pow_of_mem_torsion {ζ' : (𝓞 K)ˣ}
    (hζ' : ζ' ∈ NumberField.Units.torsion K) : ∃ k : Fin 8, ζ' = torsionGenerator ^ k.val := by
  have hfin : IsOfFinOrder ζ' := hζ'
  have hmem : ζ' ∈ {u : (𝓞 K)ˣ | IsOfFinOrder u} := hfin
  rw [torsionUnits_eq] at hmem
  exact hmem

/-- The displayed family is a system of fundamental units: together with `μ₈`, the unit
`1 + √2` generates all units of `ℤ[ζ₈]`. -/
theorem fundamentalUnitSystem_isFundamental :
    Subgroup.closure (Set.range fundamentalUnitSystem) ⊔ NumberField.Units.torsion K = ⊤ := by
  sorry

/-- Equivalently, every unit of `ℤ[ζ₈]` is `ζ^j (1 + √2)ⁿ`. -/
theorem unit_eq_torsion_mul_fundamentalUnit_zpow (u : (𝓞 K)ˣ) :
    ∃ ζ' : (𝓞 K)ˣ, ζ' ∈ NumberField.Units.torsion K ∧ ∃ n : ℤ, u = ζ' * fundamentalUnit ^ n := by
  have hu : u ∈ Subgroup.closure (Set.range fundamentalUnitSystem) ⊔
      NumberField.Units.torsion K := by
    rw [fundamentalUnitSystem_isFundamental]; trivial
  rw [Subgroup.mem_sup] at hu
  obtain ⟨x, hx, y, hy, hxy⟩ := hu
  have hrange : Set.range fundamentalUnitSystem = {fundamentalUnit} := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩; rfl
    · rintro rfl
      exact ⟨⟨0, by rw [unitRank_eq_one]; exact Nat.zero_lt_one⟩, rfl⟩
  rw [hrange, Subgroup.mem_closure_singleton] at hx
  obtain ⟨n, hn⟩ := hx
  exact ⟨y, hy, n, by rw [hn, ← hxy]; exact mul_comm x y⟩

/-- The unit group is `μ₈ × ℤ` as an abstract abelian group. -/
theorem unitGroupStructure :
    Nonempty ((𝓞 K)ˣ ≃* (Multiplicative (ZMod 8) × Multiplicative (Fin 1 → ℤ))) := by
  set i₀ : Fin (NumberField.Units.rank K) :=
    ⟨0, by rw [unitRank_eq_one]; exact Nat.zero_lt_one⟩ with hi₀
  set η : (𝓞 K)ˣ := NumberField.Units.fundSystem K i₀ with hη
  have htg8 : torsionGenerator ^ 8 = 1 := by
    ext
    exact zeta_pow_eight
  have hpow : ∀ k : ℕ, torsionGenerator ^ k = torsionGenerator ^ (k % 8) := by
    intro k
    conv_lhs => rw [← Nat.div_add_mod k 8]
    rw [pow_add, pow_mul, htg8, one_pow, one_mul]
  have hsign : ∀ a b : ZMod 8,
      torsionGenerator ^ (a + b).val = torsionGenerator ^ a.val * torsionGenerator ^ b.val := by
    intro a b
    calc torsionGenerator ^ (a + b).val = torsionGenerator ^ ((a + b).val % 8) := hpow _
      _ = torsionGenerator ^ ((a.val + b.val) % 8) := by
          rw [ZMod.val_add, Nat.mod_mod_of_dvd _ (dvd_refl 8)]
      _ = torsionGenerator ^ (a.val + b.val) := (hpow _).symm
      _ = torsionGenerator ^ a.val * torsionGenerator ^ b.val := pow_add _ _ _
  let ψ₁ : Multiplicative (ZMod 8) →* (𝓞 K)ˣ :=
    MonoidHom.mk' (fun a => torsionGenerator ^ (Multiplicative.toAdd a).val)
      (fun a b => hsign (Multiplicative.toAdd a) (Multiplicative.toAdd b))
  let ψ₂ : Multiplicative (Fin 1 → ℤ) →* (𝓞 K)ˣ :=
    MonoidHom.mk' (fun f => η ^ (Multiplicative.toAdd f 0))
      (fun f g => by
        change η ^ ((Multiplicative.toAdd f + Multiplicative.toAdd g) 0) = _
        rw [Pi.add_apply, zpow_add])
  let ψ : Multiplicative (ZMod 8) × Multiplicative (Fin 1 → ℤ) →* (𝓞 K)ˣ := ψ₁.coprod ψ₂
  have htg_tor : torsionGenerator ∈ NumberField.Units.torsion K := by
    change IsOfFinOrder torsionGenerator
    rw [isOfFinOrder_iff_pow_eq_one]
    exact ⟨8, by norm_num, htg8⟩
  have hbij : Function.Bijective ψ := by
    constructor
    · rw [injective_iff_map_eq_one]
      rintro ⟨a, f⟩ h
      have h' : torsionGenerator ^ ((Multiplicative.toAdd a).val) *
          η ^ (Multiplicative.toAdd f 0) = 1 := h
      have htor : η ^ (Multiplicative.toAdd f 0) ∈ NumberField.Units.torsion K := by
        have heq : η ^ (Multiplicative.toAdd f 0) =
            (torsionGenerator ^ ((Multiplicative.toAdd a).val))⁻¹ :=
          (mul_eq_one_iff_inv_eq.mp h').symm
        rw [heq]
        exact Subgroup.inv_mem _ (Subgroup.pow_mem _ htg_tor _)
      have hn0 : Multiplicative.toAdd f 0 = 0 := fundSystem_zpow_mem_torsion i₀ _ htor
      rw [hn0, zpow_zero, mul_one] at h'
      have haval : (Multiplicative.toAdd a).val = 0 := by
        have hOK : zetaInt ^ (Multiplicative.toAdd a).val = 1 := by
          have hval := congrArg Units.val h'
          simpa [Units.val_pow_eq_pow_val] using hval
        have hK : ζ ^ (Multiplicative.toAdd a).val = 1 := by
          have hmap := congrArg (algebraMap (𝓞 K) K) hOK
          simpa [map_pow, coe_zetaInt] using hmap
        have hdvd := (IsPrimitiveRoot.pow_eq_one_iff_dvd zeta_isPrimitiveRoot _).mp hK
        have hlt : (Multiplicative.toAdd a).val < 8 := ZMod.val_lt _
        omega
      have ha0 : Multiplicative.toAdd a = 0 := by
        have hinv := ZMod.natCast_rightInverse (n := 8) (Multiplicative.toAdd a)
        rw [← hinv, haval]
        rfl
      refine Prod.ext (Multiplicative.toAdd.injective ha0) ?_
      refine Multiplicative.toAdd.injective (funext fun i => ?_)
      rw [Subsingleton.elim i 0]
      exact hn0
    · intro u
      obtain ⟨ζ', hζ', n, hu⟩ := exists_eq_torsion_mul_fundSystem_zpow i₀ u
      obtain ⟨k, hk⟩ := eq_torsionGenerator_pow_of_mem_torsion hζ'
      refine ⟨(Multiplicative.ofAdd ((k.val : ZMod 8)), Multiplicative.ofAdd (fun _ => n)), ?_⟩
      change torsionGenerator ^ ((k.val : ZMod 8)).val * η ^ n = u
      rw [ZMod.val_cast_of_lt k.isLt, hu, hk]
  exact ⟨(MulEquiv.ofBijective ψ hbij).symm⟩

/-- The regulator of `ℚ(ζ₈)` is `2·log(1 + √2) ≈ 1.7627`: the complex place contributes
weight `2`, and `|1 + ζ + ζ⁷| = 1 + √2` at one of the two places. -/
theorem regulator_eq :
    NumberField.Units.regulator K = 2 * Real.log (1 + Real.sqrt 2) := by
  sorry

/-! ## 7. Class group -/

/-- The class number of `ℚ(ζ₈)` is `1` (the Minkowski bound is `(4/π)² · 4!/4⁴ · √256 ≈ 2.4`,
and the only prime below it, `2`, is principal: `(2) = (1 - ζ)⁴` with `(1 - ζ)` principal). -/
private theorem eq_span_one_sub_of_two_mem (P : Ideal (𝓞 K)) (hP : P.IsPrime)
    (h2 : (2 : 𝓞 K) ∈ P) : P = Ideal.span {1 - zetaInt} := by
  have hle : Ideal.span {(2 : 𝓞 K)} ≤ P := (Ideal.span_singleton_le_iff_mem _).mpr h2
  have h4 : (1 - zetaInt) ^ 4 ∈ P := by
    apply hle
    rw [span_two_eq, Ideal.span_singleton_pow]
    exact Ideal.mem_span_singleton_self _
  have h1 : 1 - zetaInt ∈ P := hP.mem_of_pow_mem 4 h4
  have hmax : (Ideal.span {1 - zetaInt}).IsMaximal := by
    rw [span_one_sub_zetaInt_eq_pair]
    exact isMaximal_span_pair 2 1 (by decide)
  exact (hmax.eq_of_le hP.ne_top ((Ideal.span_singleton_le_iff_mem _).mpr h1)).symm

theorem classNumber_eq_one : NumberField.classNumber K = 1 := by
  rw [NumberField.classNumber_eq_one_iff]
  apply RingOfIntegers.isPrincipalIdealRing_of_isPrincipal_of_pow_le_of_mem_primesOver_of_mem_Icc
  intro p hp hprime P hPmem _
  have hPprime : P.IsPrime := hPmem.1
  have hpmem : ((p : ℕ) : 𝓞 K) ∈ P := by
    have hover := hPmem.2.over
    have hmem : ((p : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
      rw [← hover]
      exact Ideal.mem_span_singleton_self _
    rw [Ideal.under, Ideal.mem_comap] at hmem
    simpa [algebraMap_int_eq] using hmem
  have hple : p ≤ 2 := by
    have h2 := (Finset.mem_Icc.mp hp).2
    have h5 : ⌊(4 / Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        (((Module.finrank ℚ K).factorial : ℝ) /
          ((Module.finrank ℚ K : ℝ)) ^ (Module.finrank ℚ K) *
            Real.sqrt (|NumberField.discr K| : ℝ))⌋₊ < 3 := by
      rw [Nat.floor_lt (by positivity)]
      rw [nrComplexPlaces_eq_two, degree_eq_four, numberField_discr_eq]
      have h16 : Real.sqrt |((256 : ℤ) : ℝ)| = 16 := by
        rw [show |((256 : ℤ) : ℝ)| = (16 : ℝ) ^ 2 by norm_num]
        exact Real.sqrt_sq (by norm_num)
      rw [h16]
      have hx : (4 / Real.pi) ^ 2 * (((Nat.factorial 4 : ℕ) : ℝ) / ((4 : ℕ) : ℝ) ^ (4 : ℕ) * 16) =
          24 / Real.pi ^ 2 := by
        norm_num [Nat.factorial]
        ring
      rw [hx, div_lt_iff₀ (by positivity)]
      have hπ : (3.14 : ℝ) < Real.pi := Real.pi_gt_d2
      push_cast
      nlinarith [sq_nonneg (Real.pi - 3.14)]
    omega
  have hpge := (Finset.mem_Icc.mp hp).1
  interval_cases p
  · exact absurd hprime (by norm_num)
  · rw [eq_span_one_sub_of_two_mem P hPprime (by exact_mod_cast hpmem)]
    exact ⟨⟨1 - zetaInt, rfl⟩⟩

/-- The ring of integers `ℤ[ζ₈]` is a principal ideal domain. -/
theorem isPrincipalIdealRing : IsPrincipalIdealRing (𝓞 K) := by
  rw [← NumberField.classNumber_eq_one_iff]
  exact classNumber_eq_one

/-- The class group of `𝓞 K` is trivial. -/
theorem classGroupStructure : Nonempty (ClassGroup (𝓞 K) ≃* Multiplicative (ZMod 1)) := by
  have h1 : Nat.card (ClassGroup (𝓞 K)) = 1 := by
    simpa [NumberField.classNumber] using classNumber_eq_one
  haveI : Subsingleton (ClassGroup (𝓞 K)) := (Nat.card_eq_one_iff_unique.mp h1).1
  haveI : Unique (ClassGroup (𝓞 K)) := uniqueOfSubsingleton 1
  exact ⟨MulEquiv.ofUnique⟩

/-- The unit ideal as the concrete representative of the unique ideal class. -/
abbrev unitIdealRepresentative : (Ideal (𝓞 K))⁰ := ⟨(⊤ : Ideal (𝓞 K)), by simp⟩

/-- Every ideal class is represented by the unit ideal. -/
theorem classGroupRepresentative (C : ClassGroup (𝓞 K)) :
    C = ClassGroup.mk0 unitIdealRepresentative := by
  have h1 : Nat.card (ClassGroup (𝓞 K)) = 1 := by
    simpa [NumberField.classNumber] using classNumber_eq_one
  haveI : Subsingleton (ClassGroup (𝓞 K)) := (Nat.card_eq_one_iff_unique.mp h1).1
  exact Subsingleton.elim _ _

/-! ## 8. Galois group -/

/-- The identity automorphism of `ℚ(ζ₈)`. -/
noncomputable def idAut : K ≃ₐ[ℚ] K := AlgEquiv.refl

/-- The automorphism of `ℚ(ζ₈)` sending `ζ` to `ζ³` (fixing `ℚ(√-2)`). -/
noncomputable def sigmaThree : K ≃ₐ[ℚ] K :=
  IsCyclotomicExtension.fromZetaAut (zeta_isPrimitiveRoot.pow_of_coprime 3 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

/-- The automorphism of `ℚ(ζ₈)` sending `ζ` to `ζ⁵ = -ζ` (fixing `ℚ(i)`). -/
noncomputable def sigmaFive : K ≃ₐ[ℚ] K :=
  IsCyclotomicExtension.fromZetaAut (zeta_isPrimitiveRoot.pow_of_coprime 5 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

/-- The automorphism of `ℚ(ζ₈)` sending `ζ` to `ζ⁷ = ζ⁻¹` (complex conjugation, fixing the
maximal totally real subfield `ℚ(√2)`). -/
noncomputable def sigmaSeven : K ≃ₐ[ℚ] K :=
  IsCyclotomicExtension.fromZetaAut (zeta_isPrimitiveRoot.pow_of_coprime 7 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

/-- The automorphism `sigmaThree` sends `ζ` to `ζ³`. -/
theorem sigmaThree_apply_zeta : sigmaThree ζ = ζ ^ 3 :=
  IsCyclotomicExtension.fromZetaAut_spec (zeta_isPrimitiveRoot.pow_of_coprime 3 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

/-- The automorphism `sigmaFive` sends `ζ` to `ζ⁵`. -/
theorem sigmaFive_apply_zeta : sigmaFive ζ = ζ ^ 5 :=
  IsCyclotomicExtension.fromZetaAut_spec (zeta_isPrimitiveRoot.pow_of_coprime 5 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

/-- The automorphism `sigmaSeven` sends `ζ` to `ζ⁷`. -/
theorem sigmaSeven_apply_zeta : sigmaSeven ζ = ζ ^ 7 :=
  IsCyclotomicExtension.fromZetaAut_spec (zeta_isPrimitiveRoot.pow_of_coprime 7 (by norm_num))
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))

/-- Cyclotomic extensions are Galois: `ℚ(ζ₈)/ℚ` is a Galois extension. -/
theorem isGalois : IsGalois ℚ K :=
  IsCyclotomicExtension.isGalois {8} ℚ K

/-- The Galois group of `ℚ(ζ₈)/ℚ` is canonically `(ℤ/8)ˣ` (the cyclotomic character). -/
theorem galoisGroupStructure : Nonempty ((K ≃ₐ[ℚ] K) ≃* (ZMod 8)ˣ) :=
  ⟨IsCyclotomicExtension.autEquivPow K (Polynomial.cyclotomic.irreducible_rat (by norm_num))⟩

/-- The Galois group is the Klein four group `ℤ/2 × ℤ/2`. -/
theorem galoisGroup_klein :
    Nonempty ((K ≃ₐ[ℚ] K) ≃*
      (Multiplicative (ZMod 2) × Multiplicative (ZMod 2))) := by
  haveI := isGalois
  have e := IsCyclotomicExtension.autEquivPow (n := 8) K
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))
  have hsq : ∀ σ : K ≃ₐ[ℚ] K, σ * σ = 1 := fun σ => e.injective (by
    rw [map_mul, map_one]
    exact (by decide : ∀ t : (ZMod 8)ˣ, t * t = 1) _)
  have h4 : Nat.card (K ≃ₐ[ℚ] K) = 4 := by
    rw [IsGalois.card_aut_eq_finrank ℚ K, degree_eq_four]
  have hexp : Monoid.exponent (K ≃ₐ[ℚ] K) = 2 := by
    have hdvd : Monoid.exponent (K ≃ₐ[ℚ] K) ∣ 2 :=
      Monoid.exponent_dvd_of_forall_pow_eq_one fun σ => by rw [pow_two]; exact hsq σ
    have ho : orderOf (e.symm (⟨7, 7, by decide, by decide⟩ : (ZMod 8)ˣ)) = 2 :=
      (orderOf_injective e.symm.toMonoidHom e.symm.injective _).trans
        (orderOf_eq_prime (by decide) (by decide))
    have h2 := Monoid.order_dvd_exponent (e.symm (⟨7, 7, by decide, by decide⟩ : (ZMod 8)ˣ))
    rw [ho] at h2
    exact Nat.dvd_antisymm hdvd h2
  haveI : IsKleinFour (K ≃ₐ[ℚ] K) := ⟨h4, hexp⟩
  haveI : IsKleinFour (Multiplicative (ZMod 2) × Multiplicative (ZMod 2)) := by
    constructor
    · rw [Nat.card_prod]
      rw [show Nat.card (Multiplicative (ZMod 2)) = 2 from Nat.card_zmod 2]
    · have hdvd : Monoid.exponent (Multiplicative (ZMod 2) × Multiplicative (ZMod 2)) ∣ 2 :=
        Monoid.exponent_dvd_of_forall_pow_eq_one (by decide)
      have h2 :
          (2 : ℕ) ∣ Monoid.exponent (Multiplicative (ZMod 2) × Multiplicative (ZMod 2)) := by
        have ho : orderOf ((Multiplicative.ofAdd (1 : ZMod 2)), (1 : Multiplicative (ZMod 2))) = 2 :=
          orderOf_eq_prime (by decide) (by decide)
        have hd := Monoid.order_dvd_exponent
          ((Multiplicative.ofAdd (1 : ZMod 2)), (1 : Multiplicative (ZMod 2)))
        rwa [ho] at hd
      exact Nat.dvd_antisymm hdvd h2
  exact IsKleinFour.nonempty_mulEquiv

/-- Every automorphism of `ℚ(ζ₈)` is an involution: `σ² = 1`. In particular the Galois
group is **not cyclic** — in contrast with `ℚ(ζ₅)`. -/
theorem aut_sq_eq_one (σ : K ≃ₐ[ℚ] K) : σ * σ = 1 := by
  have e := IsCyclotomicExtension.autEquivPow (n := 8) K
    (Polynomial.cyclotomic.irreducible_rat (by norm_num))
  apply e.injective
  rw [map_mul, map_one]
  exact (by decide : ∀ t : (ZMod 8)ˣ, t * t = 1) _

/-- The Galois group is not cyclic (the smallest non-cyclic Galois group over `ℚ`). -/
theorem galoisGroup_not_isCyclic : ¬ IsCyclic (K ≃ₐ[ℚ] K) := by
  haveI := isGalois
  intro hcyc
  obtain ⟨g, hg⟩ := hcyc.exists_generator
  have h4 : orderOf g = 4 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg, IsGalois.card_aut_eq_finrank, degree_eq_four]
  have h2 : orderOf g ∣ 2 := orderOf_dvd_of_pow_eq_one (by rw [pow_two]; exact aut_sq_eq_one g)
  rw [h4] at h2
  norm_num at h2

/-- The Galois group consists exactly of the four displayed automorphisms. -/
theorem aut_eq (σ : K ≃ₐ[ℚ] K) :
    σ = idAut ∨ σ = sigmaThree ∨ σ = sigmaFive ∨ σ = sigmaSeven := by
  have hval : ∀ t : (ZMod 8)ˣ, (t : ZMod 8).val = 1 ∨ (t : ZMod 8).val = 3 ∨
      (t : ZMod 8).val = 5 ∨ (t : ZMod 8).val = 7 := by decide
  have hspec := IsPrimitiveRoot.autToPow_spec ℚ zeta_isPrimitiveRoot σ
  have hext : ∀ τ : K ≃ₐ[ℚ] K, σ ζ = τ ζ → σ = τ := by
    intro τ h
    have hgen := (zeta_isPrimitiveRoot.powerBasis ℚ).algHom_ext
      (f := (σ : K →ₐ[ℚ] K)) (g := (τ : K →ₐ[ℚ] K))
      (by rwa [IsPrimitiveRoot.powerBasis_gen])
    exact AlgEquiv.ext fun x => AlgHom.congr_fun hgen x
  rcases hval (IsPrimitiveRoot.autToPow ℚ zeta_isPrimitiveRoot σ) with h | h | h | h <;>
    rw [h] at hspec
  · exact Or.inl (hext idAut (by rw [← hspec, pow_one]; rfl))
  · exact Or.inr (Or.inl (hext sigmaThree (by rw [← hspec, sigmaThree_apply_zeta])))
  · exact Or.inr (Or.inr (Or.inl (hext sigmaFive (by rw [← hspec, sigmaFive_apply_zeta]))))
  · exact Or.inr (Or.inr (Or.inr (hext sigmaSeven (by rw [← hspec, sigmaSeven_apply_zeta]))))

end XYin.NumberField.New.CyclotomicEight
