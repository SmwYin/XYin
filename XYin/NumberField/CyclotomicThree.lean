import Mathlib

/-!
# The cyclotomic quadratic field `ℚ(ζ₃)`

The imaginary quadratic field `K = CyclotomicField 3 ℚ`, i.e. `ℚ(ζ₃) ≃ ℚ(√-3)`, and its main
arithmetic invariants:

* degree `2`, generator `ζ₃`, alternative `AdjoinRoot` presentations (section 1);
* integral basis `1, ζ`, ring of integers `ℤ[ζ]` — the Eisenstein integers (section 2);
* discriminant `-3` (section 3);
* the norm form `x² - xy + y²` and its unit equation (section 4);
* splitting of rational primes: `3` ramifies as `(ζ - 1)²`, `2` is inert, `7` splits, and the
  splitting law: `p ≠ 3` splits iff `p ≡ 1 (mod 3)` (section 5);
* unit group `μ₆ = {±1, ±ζ, ±ζ²}` of rank `0`, regulator `1` (section 6);
* class number one (section 7);
* the norm-Euclidean property (section 8);
* Galois group `(ℤ/3)ˣ ≅ ℤ/2` (section 9).
-/

noncomputable section

open scoped NumberField nonZeroDivisors Real ENNReal

open Module NumberField Polynomial

namespace XYin.NumberField.CyclotomicThree

/-! ## 1. Basics -/

/-- Our running example: the third cyclotomic field, i.e. `ℚ(√-3)`. -/
abbrev K : Type := CyclotomicField 3 ℚ

instance : IsCyclotomicExtension {3} ℚ K :=
  CyclotomicField.isCyclotomicExtension 3 ℚ

/-- A chosen primitive third root of unity. -/
abbrev ζ : K := IsCyclotomicExtension.zeta 3 ℚ K

theorem zeta_isPrimitiveRoot : IsPrimitiveRoot ζ 3 :=
  IsCyclotomicExtension.zeta_spec 3 ℚ K

example : Field K := by infer_instance

example : NumberField K := by infer_instance

example : IsCyclotomicExtension {3} ℚ K := by infer_instance

/-- The defining quadratic relation `ζ^2 + ζ + 1 = 0`. -/
example : ζ ^ 2 + ζ + 1 = 0 := by
  simpa using zeta_isPrimitiveRoot.isRoot_cyclotomic (by decide)

/-- The field is generated by this one element. -/
example : Algebra.adjoin ℚ ({ζ} : Set K) = ⊤ :=
  IsCyclotomicExtension.adjoin_primitive_root_eq_top zeta_isPrimitiveRoot

/-- Since `φ(3) = 2`, this cyclotomic field is quadratic over `ℚ`. -/
example : Module.finrank ℚ K = 2 := by
  rw [IsCyclotomicExtension.Rat.finrank 3 K]
  rw [Nat.totient_prime Nat.prime_three]

instance : Algebra.IsQuadraticExtension ℚ K where
  finrank_eq_two' := by
    rw [IsCyclotomicExtension.Rat.finrank 3 K]
    rw [Nat.totient_prime Nat.prime_three]

/-! ### Alternative `AdjoinRoot` presentations -/

/--
The same quadratic field built directly by adjoining a root of `X^2 + X + 1`.
This polynomial is `Φ₃`, so adjoining one of its roots is adjoining a primitive
third root of unity.
-/
abbrev zetaThreePolynomial : ℚ[X] := X ^ 2 + X + 1

instance : Fact (Irreducible zetaThreePolynomial) := by
  refine ⟨?_⟩
  rw [zetaThreePolynomial, ← cyclotomic_three ℚ]
  exact cyclotomic.irreducible_rat (by norm_num : 0 < 3)

/-- The `AdjoinRoot` presentation of `ℚ(ζ₃)`. -/
abbrev KAdjoinRoot : Type := AdjoinRoot zetaThreePolynomial

example : Field KAdjoinRoot := by infer_instance

example : NumberField KAdjoinRoot := by infer_instance

/-- The explicit polynomial `X^2 + X + 1` is the minimal polynomial of `ζ`. -/
theorem zetaThreePolynomial_eq_minpoly : zetaThreePolynomial = minpoly ℚ ζ := by
  rw [zetaThreePolynomial, ← cyclotomic_three ℚ]
  exact
    zeta_isPrimitiveRoot.minpoly_eq_cyclotomic_of_irreducible
      (cyclotomic.irreducible_rat (by norm_num : 0 < 3))

/-- The cyclotomic model is obtained by adjoining a root of the minimal polynomial of `ζ`. -/
def zetaMinpolyAdjoinRootPresentation : IsAdjoinRoot K (minpoly ℚ ζ) :=
  IsAdjoinRoot.mkOfAdjoinEqTop
    ((IsCyclotomicExtension.integral {3} ℚ K).isIntegral ζ)
    (IsCyclotomicExtension.adjoin_primitive_root_eq_top zeta_isPrimitiveRoot)

/--
The two constructions are the same field, expressed as a `ℚ`-algebra equivalence.
In Lean this is the useful form of equality, because the constructions are different
types.
-/
abbrev adjoinRootEquivCyclotomic : KAdjoinRoot ≃ₐ[ℚ] K :=
  (AdjoinRoot.algEquivOfEq ℚ zetaThreePolynomial (minpoly ℚ ζ)
    zetaThreePolynomial_eq_minpoly).trans
    zetaMinpolyAdjoinRootPresentation.adjoinRootAlgEquiv

/-- Under the equivalence, the formal adjoining root is the cyclotomic root `ζ`. -/
theorem adjoinRootEquivCyclotomic_root :
    adjoinRootEquivCyclotomic (AdjoinRoot.root zetaThreePolynomial) = ζ := by
  change zetaMinpolyAdjoinRootPresentation.adjoinRootAlgEquiv
    ((AdjoinRoot.algEquivOfEq ℚ zetaThreePolynomial (minpoly ℚ ζ)
      zetaThreePolynomial_eq_minpoly) (AdjoinRoot.root zetaThreePolynomial)) = ζ
  rw [AdjoinRoot.algEquivOfEq_root]
  simp [zetaMinpolyAdjoinRootPresentation]

example : (2 * ζ + 1) ^ 2 = (-3 : K) := by
  have hζ : ζ ^ 2 + ζ + 1 = 0 := by
    simpa using zeta_isPrimitiveRoot.isRoot_cyclotomic (by decide)
  calc
    (2 * ζ + 1) ^ 2 = 4 * (ζ ^ 2 + ζ + 1) - 3 := by ring
    _ = -3 := by rw [hζ]; ring

/-! #### The `ℚ(√-3)` `AdjoinRoot` model -/

/-- The polynomial defining `ℚ(√-3)` as an `AdjoinRoot`. -/
abbrev sqrtNegThreePolynomial : ℚ[X] := X ^ 2 + 3

instance : Fact (Irreducible sqrtNegThreePolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [sqrtNegThreePolynomial, Finset.mem_Icc]
    change 1 ≤ (X ^ 2 + C (3 : ℚ)).natDegree ∧
      (X ^ 2 + C (3 : ℚ)).natDegree ≤ 3
    rw [natDegree_X_pow_add_C]
    norm_num
  · intro x hx
    have hpos : 0 < x ^ 2 + 3 := by nlinarith [sq_nonneg x]
    exact (ne_of_gt hpos) (by simpa [sqrtNegThreePolynomial, IsRoot] using hx)

/-- The field `ℚ(√-3)`, constructed by adjoining a root of `X^2 + 3`. -/
abbrev QSqrtNegThree : Type := AdjoinRoot sqrtNegThreePolynomial

example : Field QSqrtNegThree := by infer_instance

example : NumberField QSqrtNegThree := by infer_instance

/-- The formal square root of `-3` in the `AdjoinRoot` model. -/
abbrev sqrtNegThreeRoot : QSqrtNegThree := AdjoinRoot.root sqrtNegThreePolynomial

/-- The formal primitive third root in the `AdjoinRoot (X^2 + X + 1)` model. -/
abbrev zetaThreeRoot : KAdjoinRoot := AdjoinRoot.root zetaThreePolynomial

theorem sqrtNegThreeRoot_sq : sqrtNegThreeRoot ^ 2 = (-3 : QSqrtNegThree) := by
  have hroot : sqrtNegThreeRoot ^ 2 + 3 = 0 := by
    simpa [sqrtNegThreeRoot, sqrtNegThreePolynomial] using
      (AdjoinRoot.eval₂_root sqrtNegThreePolynomial)
  calc
    sqrtNegThreeRoot ^ 2 = sqrtNegThreeRoot ^ 2 + 3 - 3 := by ring
    _ = -3 := by rw [hroot]; ring

theorem zetaThreeRoot_relation : zetaThreeRoot ^ 2 + zetaThreeRoot + 1 = 0 := by
  simpa [zetaThreeRoot, zetaThreePolynomial] using
    (AdjoinRoot.eval₂_root zetaThreePolynomial)

/-- The map `ℚ(√-3) → ℚ(ζ₃)` in the two `AdjoinRoot` presentations. -/
def sqrtNegThreeToZetaThree : QSqrtNegThree →ₐ[ℚ] KAdjoinRoot :=
  AdjoinRoot.liftAlgHom sqrtNegThreePolynomial (Algebra.ofId ℚ KAdjoinRoot)
    (2 * zetaThreeRoot + 1) (by
      calc
        sqrtNegThreePolynomial.eval₂ (Algebra.ofId ℚ KAdjoinRoot) (2 * zetaThreeRoot + 1)
            = (2 * zetaThreeRoot + 1) ^ 2 + 3 := by
              simp [sqrtNegThreePolynomial]
        _ = 4 * (zetaThreeRoot ^ 2 + zetaThreeRoot + 1) := by ring
        _ = 0 := by rw [zetaThreeRoot_relation]; ring)

@[simp]
theorem sqrtNegThreeToZetaThree_root :
    sqrtNegThreeToZetaThree sqrtNegThreeRoot = 2 * zetaThreeRoot + 1 := by
  rw [sqrtNegThreeToZetaThree, sqrtNegThreeRoot]
  exact AdjoinRoot.liftAlgHom_root sqrtNegThreePolynomial (Algebra.ofId ℚ KAdjoinRoot)
    (2 * zetaThreeRoot + 1) _

/-- The inverse map sends `ζ` to `(√-3 - 1) / 2`. -/
def zetaThreeToSqrtNegThree : KAdjoinRoot →ₐ[ℚ] QSqrtNegThree :=
  AdjoinRoot.liftAlgHom zetaThreePolynomial (Algebra.ofId ℚ QSqrtNegThree)
    ((sqrtNegThreeRoot - 1) / 2) (by
      calc
        zetaThreePolynomial.eval₂ (Algebra.ofId ℚ QSqrtNegThree)
            ((sqrtNegThreeRoot - 1) / 2)
            = ((sqrtNegThreeRoot - 1) / 2) ^ 2 + (sqrtNegThreeRoot - 1) / 2 + 1 := by
              simp [zetaThreePolynomial]
        _ = (sqrtNegThreeRoot ^ 2 + 3) / 4 := by ring
        _ = 0 := by rw [sqrtNegThreeRoot_sq]; norm_num)

@[simp]
theorem zetaThreeToSqrtNegThree_root :
    zetaThreeToSqrtNegThree zetaThreeRoot = (sqrtNegThreeRoot - 1) / 2 := by
  rw [zetaThreeToSqrtNegThree, zetaThreeRoot]
  exact AdjoinRoot.liftAlgHom_root zetaThreePolynomial (Algebra.ofId ℚ QSqrtNegThree)
    ((sqrtNegThreeRoot - 1) / 2) _

/-- `AdjoinRoot (X^2 + 3)` and `AdjoinRoot (X^2 + X + 1)` are the same field. -/
def sqrtNegThreeEquivZetaThree : QSqrtNegThree ≃ₐ[ℚ] KAdjoinRoot where
  __ := sqrtNegThreeToZetaThree
  invFun := zetaThreeToSqrtNegThree
  left_inv x := by
    have hcomp :
        zetaThreeToSqrtNegThree.comp sqrtNegThreeToZetaThree =
          AlgHom.id ℚ QSqrtNegThree := by
      apply AdjoinRoot.algHom_ext
      change zetaThreeToSqrtNegThree (sqrtNegThreeToZetaThree sqrtNegThreeRoot) =
        sqrtNegThreeRoot
      rw [sqrtNegThreeToZetaThree_root]
      simp only [map_add, map_mul, map_one, map_ofNat, zetaThreeToSqrtNegThree_root]
      ring
    change (zetaThreeToSqrtNegThree.comp sqrtNegThreeToZetaThree) x =
      (AlgHom.id ℚ QSqrtNegThree) x
    rw [hcomp]
  right_inv x := by
    have hcomp :
        sqrtNegThreeToZetaThree.comp zetaThreeToSqrtNegThree =
          AlgHom.id ℚ KAdjoinRoot := by
      apply AdjoinRoot.algHom_ext
      change sqrtNegThreeToZetaThree (zetaThreeToSqrtNegThree zetaThreeRoot) =
        zetaThreeRoot
      rw [zetaThreeToSqrtNegThree_root]
      simp only [map_sub, map_div₀, map_one, map_ofNat, sqrtNegThreeToZetaThree_root]
      ring_nf
    change (sqrtNegThreeToZetaThree.comp zetaThreeToSqrtNegThree) x =
      (AlgHom.id ℚ KAdjoinRoot) x
    rw [hcomp]

@[simp]
theorem sqrtNegThreeEquivZetaThree_root :
    sqrtNegThreeEquivZetaThree sqrtNegThreeRoot = 2 * zetaThreeRoot + 1 :=
  sqrtNegThreeToZetaThree_root

/-- Therefore the `ℚ(√-3)` `AdjoinRoot` model is the cyclotomic field `K`. -/
def sqrtNegThreeEquivCyclotomic : QSqrtNegThree ≃ₐ[ℚ] K :=
  sqrtNegThreeEquivZetaThree.trans adjoinRootEquivCyclotomic

theorem sqrtNegThreeEquivCyclotomic_root :
    sqrtNegThreeEquivCyclotomic sqrtNegThreeRoot = 2 * ζ + 1 := by
  rw [sqrtNegThreeEquivCyclotomic, AlgEquiv.trans_apply]
  rw [sqrtNegThreeEquivZetaThree_root]
  simp only [map_add, map_mul, map_one, map_ofNat, adjoinRootEquivCyclotomic_root]

/-! ## 2. Integral basis and ring of integers -/

/-- The ring of integers of `K`. -/
abbrev OK : Type := 𝓞 K

example : CommRing OK := by infer_instance

example : IsDomain OK := by infer_instance

example : Algebra OK K := by infer_instance

/-- Elements of `𝓞 K` are, by definition, integral over `ℤ`. -/
example (x : OK) : IsIntegral ℤ (x : K) :=
  x.2

/-- `ζ` as an element of the ring of integers `𝓞 K`. -/
noncomputable def zetaInt : OK := zeta_isPrimitiveRoot.toInteger

/--
For cyclotomic fields, a primitive root of unity gives an explicit integral power basis
of the ring of integers.
-/
abbrev integralPowerBasis : PowerBasis ℤ OK :=
  zeta_isPrimitiveRoot.integralPowerBasis

example : integralPowerBasis.gen = zeta_isPrimitiveRoot.toInteger := by
  simp [integralPowerBasis]

theorem integralPowerBasis_dim : integralPowerBasis.dim = 2 := by
  simp [integralPowerBasis, Nat.totient_prime Nat.prime_three]

example : integralPowerBasis.dim = 2 :=
  integralPowerBasis_dim

example : Basis (Fin integralPowerBasis.dim) ℤ OK :=
  integralPowerBasis.basis

/-- The explicit `Fin 2` integral basis `[1, ζ]`. -/
abbrev zetaExplicitIntegralBasis : Basis (Fin 2) ℤ OK :=
  integralPowerBasis.basis.reindex (finCongr integralPowerBasis_dim)

theorem zetaExplicitIntegralBasis_zero :
    zetaExplicitIntegralBasis 0 = 1 := by
  rw [zetaExplicitIntegralBasis, Basis.reindex_apply]
  rw [integralPowerBasis.basis_eq_pow]
  have hcoe :
      (((finCongr integralPowerBasis_dim).symm (0 : Fin 2) : Fin integralPowerBasis.dim) : ℕ) = 0 :=
    rfl
  rw [hcoe]
  simp

theorem zetaExplicitIntegralBasis_one :
    zetaExplicitIntegralBasis 1 = zeta_isPrimitiveRoot.toInteger := by
  rw [zetaExplicitIntegralBasis, Basis.reindex_apply]
  rw [integralPowerBasis.basis_eq_pow]
  have hcoe :
      (((finCongr integralPowerBasis_dim).symm (1 : Fin 2) : Fin integralPowerBasis.dim) : ℕ) = 1 :=
    rfl
  rw [hcoe]
  simp [integralPowerBasis]

/-- The cyclotomic ring is another concrete model for the integral closure. -/
example : IsIntegralClosure (CyclotomicRing 3 ℤ ℚ) ℤ K :=
  IsCyclotomicExtension.Rat.cyclotomicRing_isIntegralClosure 3

/--
`IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton` says that the
`ℤ`-subalgebra `ℤ[ζ] = Algebra.adjoin ℤ {ζ}` generated by a single primitive root
inside `K` is already the full ring of integers `𝓞 K`.
-/
example : IsIntegralClosure (Algebra.adjoin ℤ ({ζ} : Set K)) ℤ K :=
  IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton zeta_isPrimitiveRoot

/--
As a consequence, the ring of integers is generated over `ℤ` by the primitive root:
`Algebra.adjoin ℤ {zeta_isPrimitiveRoot.toInteger} = ⊤` in `𝓞 K`.
-/
example : Algebra.adjoin ℤ ({integralPowerBasis.gen} : Set (𝓞 K)) = ⊤ :=
  integralPowerBasis.adjoin_gen_eq_top

/-! ## 3. Discriminant -/

/-- The number-field discriminant of `ℚ(ζ₃) = ℚ(√-3)` is `-3`: the quadratic field of
smallest absolute discriminant. In particular `3` is the only ramified prime, cf.
`ramified_iff_eq_three`. -/
theorem numberField_discr_eq : NumberField.discr K = -3 := by
  rw [IsCyclotomicExtension.Rat.discr_prime 3 K]
  norm_num

theorem zetaExplicitIntegralBasis_discr :
    Algebra.discr ℤ zetaExplicitIntegralBasis = (-3 : ℤ) := by
  calc
    Algebra.discr ℤ zetaExplicitIntegralBasis = NumberField.discr K := by
      simpa using (NumberField.discr_eq_discr (K := K) zetaExplicitIntegralBasis)
    _ = -3 := by
      rw [IsCyclotomicExtension.Rat.discr_prime 3 K]
      norm_num

/--
`NumberField.coe_discr` says `(NumberField.discr K : ℚ) = Algebra.discr ℚ (integralBasis K)`.
This bridges the integer-valued field discriminant to the concrete `Algebra.discr ℚ`
computed from mathlib's canonical `ℚ`-basis of `K`.
-/
example : Algebra.discr ℚ (NumberField.integralBasis K) = (-3 : ℚ) := by
  have h := NumberField.coe_discr K
  rw [show NumberField.discr K = -3 from by
        rw [IsCyclotomicExtension.Rat.discr_prime 3 K]; norm_num] at h
  simpa using h.symm

/--
`Algebra.discr_of_matrix_mulVec`: replacing basis `b` by `Pb` scales the discriminant by `det(P)²`.
This is the key formula behind the fact that all `ℤ`-bases of `𝓞 K` yield the same
`NumberField.discr K`: change-of-basis matrices between them are unimodular (`det = ±1`),
so `det(P)² = 1` and the discriminant is preserved.
-/
theorem discr_matrix_mulVec_K
    (P : Matrix (Free.ChooseBasisIndex ℤ (𝓞 K)) (Free.ChooseBasisIndex ℤ (𝓞 K)) ℚ) :
    Algebra.discr ℚ (Matrix.mulVec (P.map (algebraMap ℚ K)) (NumberField.integralBasis K)) =
      P.det ^ 2 * Algebra.discr ℚ (NumberField.integralBasis K) :=
  Algebra.discr_of_matrix_mulVec _ _

/-- Concretely: a unimodular change of basis preserves the discriminant `-3`. -/
example (P : Matrix (Free.ChooseBasisIndex ℤ (𝓞 K)) (Free.ChooseBasisIndex ℤ (𝓞 K)) ℚ)
    (hdet : P.det = 1 ∨ P.det = -1) :
    Algebra.discr ℚ (Matrix.mulVec (P.map (algebraMap ℚ K)) (NumberField.integralBasis K)) =
        (-3 : ℚ) := by
  have hdiscr : Algebra.discr ℚ (NumberField.integralBasis K) = -3 := by
    have h := NumberField.coe_discr K
    rw [show NumberField.discr K = -3 from by
          rw [IsCyclotomicExtension.Rat.discr_prime 3 K]; norm_num] at h
    simpa using h.symm
  rw [discr_matrix_mulVec_K, hdiscr]
  rcases hdet with h | h <;> simp [h]

/-! ## 4. Norm form -/

/-- The norm form of `ℚ(ζ₃)` in the basis `1, ζ`: the field norm of `x + yζ` is the binary
quadratic form `x² - xy + y²`, the principal form of discriminant `-3`. -/
theorem norm_eq_normForm (x y : ℚ) :
    Algebra.norm ℚ (x • (1 : K) + y • ζ) = x ^ 2 - x * y + y ^ 2 := by
  sorry

/-- The integral norm form: on `𝓞 K = ℤ[ζ]` the norm of `x + yζ` (with `x, y ∈ ℤ`) is
`x² - xy + y²`. -/
theorem intNorm_eq_normForm (x y : ℤ) :
    Algebra.norm ℤ (x • (1 : OK) + y • zetaInt) = x ^ 2 - x * y + y ^ 2 := by
  sorry

/-- The unit equation of `ℚ(ζ₃)`: `x + yζ` is a unit of `ℤ[ζ]` iff `x² - xy + y² = 1`. The
form is positive definite (this is the imaginary quadratic case), so only the value `+1`
occurs, and the six integer solutions correspond to the six roots of unity `±1, ±ζ, ±ζ²`. -/
theorem isUnit_iff_normForm (x y : ℤ) :
    IsUnit (x • (1 : OK) + y • zetaInt) ↔ x ^ 2 - x * y + y ^ 2 = 1 := by
  sorry

/-! ## 5. Splitting of primes -/

/-- The element `ζ - 1` is a prime element of the ring of integers. -/
example : Prime (zeta_isPrimitiveRoot.toInteger - 1 : OK) :=
  zeta_isPrimitiveRoot.zeta_sub_one_prime'

/-- In this field, `ζ - 1` lies above `3`: it divides `3` in `𝓞 K`. -/
example : (zeta_isPrimitiveRoot.toInteger - 1 : OK) ∣ (3 : OK) :=
  zeta_isPrimitiveRoot.toInteger_sub_one_dvd_prime'

/-- `3` is (totally) ramified: `(3) = (ζ - 1)²` as ideals of `𝓞 K`. It is the unique
ramified prime, matching the discriminant `-3`. -/
theorem span_three_eq :
    Ideal.span {(3 : OK)} = Ideal.span {zetaInt - 1} ^ 2 := by
  sorry

/-- The prime `(ζ - 1)` above `3` has norm `3` (residue degree `f = 1`). -/
theorem absNorm_span_zetaInt_sub_one :
    Ideal.absNorm (Ideal.span {zetaInt - 1}) = 3 := by
  sorry

/-- `(ζ - 1)` is a prime ideal — the unique prime of `𝓞 K` above `3`. -/
theorem isPrime_span_zetaInt_sub_one : (Ideal.span {zetaInt - 1}).IsPrime := by
  sorry

/-- `2` is inert in `ℚ(ζ₃)`: `2 ≡ 2 (mod 3)`, equivalently `X² + X + 1` is irreducible
mod `2`, so `(2)` is itself prime. -/
theorem isPrime_span_two : (Ideal.span {(2 : OK)}).IsPrime := by
  sorry

/-- The inert prime `(2)` has norm `4` (residue degree `f = 2`). -/
theorem absNorm_span_two : Ideal.absNorm (Ideal.span {(2 : OK)}) = 4 := by
  sorry

/-- `7 ≡ 1 (mod 3)` splits completely: `7 = (3 + ζ)(3 + ζ²)` and
`(7) = (3 + ζ) · (3 + ζ²)` is a product of two distinct primes of norm `7`. -/
theorem span_seven_eq :
    Ideal.span {(7 : OK)} = Ideal.span {3 + zetaInt} * Ideal.span {3 + zetaInt ^ 2} := by
  sorry

/-- The prime `(3 + ζ)` above `7` has norm `7` (residue degree `f = 1`). -/
theorem absNorm_span_seven_factor : Ideal.absNorm (Ideal.span {3 + zetaInt}) = 7 := by
  sorry

/-- `(3 + ζ)` is a prime ideal — one of the two primes of `𝓞 K` above `7`. -/
theorem isPrime_span_seven_factor : (Ideal.span {3 + zetaInt}).IsPrime := by
  sorry

/-- The splitting law at ramified primes: a rational prime `p` ramifies in `ℚ(ζ₃)` iff
`p = 3`, i.e. iff `p` divides the discriminant `-3`. -/
theorem ramified_iff_eq_three (p : ℕ) (hp : p.Prime) :
    (∃ P : Ideal OK, P.IsPrime ∧ Ideal.span {(p : OK)} ≤ P ^ 2) ↔ p = 3 := by
  sorry

/-- The quadratic (cyclotomic) splitting law for `ℚ(ζ₃)`: an unramified rational prime `p`
splits into two distinct primes iff `p ≡ 1 (mod 3)`, and is inert otherwise. This is the
simplest instance of splitting governed by congruence conditions (class field theory). -/
theorem splits_iff_one_mod_three (p : ℕ) (hp : p.Prime) (hp3 : p ≠ 3) :
    (∃ P Q : Ideal OK, P.IsPrime ∧ Q.IsPrime ∧ P ≠ Q ∧
      Ideal.span {(p : OK)} = P * Q) ↔ p % 3 = 1 := by
  sorry

/-! ## 6. Ring of units -/

/-- The unit corresponding to `ζ`. -/
abbrev etaUnit : OKˣ :=
  (zeta_isPrimitiveRoot.toInteger_isPrimitiveRoot.isUnit (by decide)).unit

/--
The unit group is finite here: every unit is one of
`±1`, `±ζ`, `±ζ²`.
-/
example (u : OKˣ) : u ∈ ([1, -1, etaUnit, -etaUnit, etaUnit ^ 2, -etaUnit ^ 2] : List OKˣ) := by
  simpa [etaUnit] using IsCyclotomicExtension.Rat.Three.Units.mem zeta_isPrimitiveRoot u

/-- The torsion subgroup of the unit group has order `6`. -/
theorem torsionOrder_eq_six : Units.torsionOrder K = 6 := by
  rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := 3) (K := K)]
  norm_num

/-- Dirichlet's unit rank is `0` for this imaginary quadratic field: the signature is
`(r₁, r₂) = (0, 1)`, so the rank is `r₁ + r₂ - 1 = 0`. -/
theorem unitRank_eq_zero : Units.rank K = 0 := by
  dsimp [Units.rank]
  rw [InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces,
    IsCyclotomicExtension.Rat.nrRealPlaces_eq_zero (n := 3) K (by norm_num),
    IsCyclotomicExtension.Rat.nrComplexPlaces_eq_totient_div_two (n := 3) K]
  rw [Nat.totient_prime Nat.prime_three]

/-- The unit group is the finite cyclic group `μ₆` as an abstract abelian group: in rank `0`
the units are exactly the roots of unity, generated by `-ζ`. -/
theorem unitGroupStructure : Nonempty (OKˣ ≃* Multiplicative (ZMod 6)) := by
  sorry

/-- The regulator of `ℚ(ζ₃)` is `1`: the unit lattice is the zero lattice in rank `0`, with
covolume `1`. -/
theorem regulator_eq_one : Units.regulator K = 1 := by
  sorry

/-! ## 7. Class group -/

/--
The convex-body version of the Minkowski bound in mathlib is attached to a fractional
ideal. For the trivial fractional ideal it is finite and positive.
-/
abbrev trivialFractionalIdeal : (FractionalIdeal OK⁰ K)ˣ :=
  1

example : 0 < mixedEmbedding.minkowskiBound K trivialFractionalIdeal :=
  mixedEmbedding.minkowskiBound_pos K trivialFractionalIdeal

example : mixedEmbedding.minkowskiBound K trivialFractionalIdeal < ⊤ :=
  mixedEmbedding.minkowskiBound_lt_top K trivialFractionalIdeal

/--
The class-number API presents the class group as a finite type and provides the map
from nonzero integral ideals to ideal classes.
-/
example : Fintype (ClassGroup OK) := by infer_instance

example (C : ClassGroup OK) : ∃ I : (Ideal OK)⁰, ClassGroup.mk0 I = C :=
  ClassGroup.mk0_surjective C

/-- The ring of integers `ℤ[ζ]` is a principal ideal domain — the ring-theoretic content of
class number one. -/
theorem isPrincipalIdealRing : IsPrincipalIdealRing OK :=
  IsCyclotomicExtension.Rat.three_pid K

/-- The class number of `ℚ(ζ₃)` is `1`. -/
theorem classNumber_eq_one : NumberField.classNumber K = 1 :=
  NumberField.classNumber_eq_one_iff.mpr (IsCyclotomicExtension.Rat.three_pid K)

/-- The class group of `𝓞 K` is trivial. -/
theorem classGroupStructure : Nonempty (ClassGroup OK ≃* Multiplicative (ZMod 1)) := by
  sorry

/-! ## 8. Euclidean structure -/

/-- `ℤ[ζ₃]`, the ring of Eisenstein integers, is norm-Euclidean: division with remainder
with respect to the absolute value of the field norm. This strengthens
`isPrincipalIdealRing`. -/
theorem normEuclidean (a b : OK) (hb : b ≠ 0) :
    ∃ q r : OK, a = b * q + r ∧
      (Algebra.norm ℤ r).natAbs < (Algebra.norm ℤ b).natAbs := by
  sorry

/-! ## 9. Galois group -/

example : IsGalois ℚ K :=
  IsCyclotomicExtension.isGalois {3} ℚ K

/--
Cyclotomic Galois theory identifies `Gal(ℚ(ζ₃)/ℚ)` with `(ZMod 3)ˣ`.
An automorphism is recorded by the power to which it sends `ζ`.
-/
abbrev galEquivZMod : Gal(K / ℚ) ≃* (ZMod 3)ˣ :=
  IsCyclotomicExtension.Rat.galEquivZMod 3 K

example (σ : Gal(K/ℚ)) :
    σ ζ = ζ ^ (galEquivZMod σ).val.val :=
  IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq 3 K σ zeta_isPrimitiveRoot.pow_eq_one

/-- The Galois group of `ℚ(ζ₃)/ℚ` is cyclic of order `2`: `(ℤ/3)ˣ ≅ ℤ/2`, generated by
complex conjugation `ζ ↦ ζ² = ζ̄`. -/
theorem galoisGroupStructure : Nonempty (Gal(K/ℚ) ≃* Multiplicative (ZMod 2)) := by
  sorry

end XYin.NumberField.CyclotomicThree
