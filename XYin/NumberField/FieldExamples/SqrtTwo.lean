import Mathlib

/-!
# The real quadratic field `ℚ(√2)`

The real quadratic field `QSqrtTwo = AdjoinRoot (X ^ 2 - C (2 : ℚ))`, i.e. `ℚ(√2)`, and its
main arithmetic invariants:

* degree `2`, generator `√2`, the alternative `1 + √2` presentation (section 1);
* integral basis `1, √2`, ring of integers `ℤ[√2]` via Eisenstein at `2` (section 2);
* discriminant `8` (section 3);
* the norm form `x² - 2y²` and the Pell unit equation `x² - 2y² = ±1` (section 4);
* splitting of rational primes: `2` ramifies as `(√2)²`, `7` splits, `3` is inert, and the
  splitting law: odd `p` splits iff `p ≡ ±1 (mod 8)` (section 5);
* unit group `{±1} × (1 + √2)^ℤ` via `Zsqrtd`/Pell, signature `(2, 0)`, regulator
  `log(1 + √2)` (section 6);
* class number one (section 7);
* the norm-Euclidean property (section 8);
* Galois group `C₂`, generated by the conjugation `√2 ↦ -√2` (section 9).
-/

noncomputable section

open scoped NumberField nonZeroDivisors Real ENNReal

open Module NumberField Polynomial

namespace XYin.NumberField.SqrtTwo

/-! ## 1. Basics -/

/-- The polynomial defining the real quadratic field `ℚ(√2)`. -/
abbrev sqrtTwoPolynomial : ℚ[X] := X ^ 2 - C (2 : ℚ)

instance : Fact (Irreducible sqrtTwoPolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [sqrtTwoPolynomial, Finset.mem_Icc]
    change 1 ≤ (X ^ 2 - C (2 : ℚ)).natDegree ∧
      (X ^ 2 - C (2 : ℚ)).natDegree ≤ 3
    rw [natDegree_X_pow_sub_C]
    norm_num
  · intro x hx
    have hx2 : x ^ 2 = 2 := by
      have hzero : x ^ 2 - 2 = 0 := by
        simpa [sqrtTwoPolynomial, IsRoot] using hx
      nlinarith
    have hsquare : IsSquare (2 : ℚ) := by
      rw [isSquare_iff_exists_sq]
      exact ⟨x, hx2.symm⟩
    norm_num at hsquare

/-- The real quadratic field `ℚ(√2)`, constructed directly as an `AdjoinRoot`. -/
abbrev QSqrtTwo : Type := AdjoinRoot sqrtTwoPolynomial

example : Field QSqrtTwo := by infer_instance

example : NumberField QSqrtTwo := by infer_instance

/-- The formal square root of `2`. -/
abbrev sqrtTwoRoot : QSqrtTwo := AdjoinRoot.root sqrtTwoPolynomial

theorem sqrtTwoRoot_sq : sqrtTwoRoot ^ 2 = (2 : QSqrtTwo) := by
  have hroot : sqrtTwoRoot ^ 2 - 2 = 0 := by
    simpa [sqrtTwoRoot, sqrtTwoPolynomial] using
      (AdjoinRoot.eval₂_root sqrtTwoPolynomial)
  calc
    sqrtTwoRoot ^ 2 = sqrtTwoRoot ^ 2 - 2 + 2 := by ring
    _ = 2 := by rw [hroot]; ring

/-! ### The `QuadraticAlgebra ℚ 2 0` presentation -/

instance : Fact (∀ r : ℚ, r ^ 2 ≠ (2 : ℚ) + (0 : ℚ) * r) := by
  exact ⟨by
    intro r hr
    have hsquare : IsSquare (2 : ℚ) := by
      rw [isSquare_iff_exists_sq]
      refine ⟨r, ?_⟩
      nlinarith
    norm_num at hsquare⟩

/-- The same field, now presented as the radical quadratic algebra `ℚ[√2]`. -/
abbrev QSqrtTwoQuadratic : Type := QuadraticAlgebra ℚ (2 : ℚ) 0

/-- The distinguished square root of `2` in the quadratic-algebra presentation. -/
abbrev sqrtTwoQuadraticRoot : QSqrtTwoQuadratic := QuadraticAlgebra.omega

theorem sqrtTwoQuadraticRoot_sq :
    sqrtTwoQuadraticRoot ^ 2 = (2 : QSqrtTwoQuadratic) := by
  rw [pow_two, sqrtTwoQuadraticRoot, QuadraticAlgebra.omega_mul_omega_eq_add]
  ext <;> norm_num

def sqrtTwoAdjoinRootToQuadratic : QSqrtTwo →ₐ[ℚ] QSqrtTwoQuadratic :=
  AdjoinRoot.liftAlgHom sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwoQuadratic)
    sqrtTwoQuadraticRoot (by
      calc
        sqrtTwoPolynomial.eval₂ (Algebra.ofId ℚ QSqrtTwoQuadratic) sqrtTwoQuadraticRoot =
            sqrtTwoQuadraticRoot ^ 2 - 2 := by
          simp [sqrtTwoPolynomial]
        _ = 0 := by rw [sqrtTwoQuadraticRoot_sq]; ring)

@[simp]
theorem sqrtTwoAdjoinRootToQuadratic_root :
    sqrtTwoAdjoinRootToQuadratic sqrtTwoRoot = sqrtTwoQuadraticRoot := by
  rw [sqrtTwoAdjoinRootToQuadratic, sqrtTwoRoot]
  exact AdjoinRoot.liftAlgHom_root sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwoQuadratic)
    sqrtTwoQuadraticRoot _

def sqrtTwoQuadraticToAdjoinRoot : QSqrtTwoQuadratic →ₐ[ℚ] QSqrtTwo :=
  (QuadraticAlgebra.lift (R := ℚ) (a := (2 : ℚ)) (b := 0)) ⟨sqrtTwoRoot, by
    rw [← pow_two, sqrtTwoRoot_sq]
    simp⟩

@[simp]
theorem sqrtTwoQuadraticToAdjoinRoot_root :
    sqrtTwoQuadraticToAdjoinRoot sqrtTwoQuadraticRoot = sqrtTwoRoot := by
  dsimp [sqrtTwoQuadraticToAdjoinRoot, sqrtTwoQuadraticRoot, QuadraticAlgebra.lift,
    QuadraticAlgebra.omega]
  change (0 : ℚ) • (1 : QSqrtTwo) + (1 : ℚ) • sqrtTwoRoot = sqrtTwoRoot
  simp

/-- The radical quadratic-algebra presentation is equivalent to the `AdjoinRoot` model. -/
noncomputable def sqrtTwoQuadraticEquivAdjoinRoot :
    QSqrtTwoQuadratic ≃ₐ[ℚ] QSqrtTwo := by
  refine
    { __ := sqrtTwoQuadraticToAdjoinRoot
      invFun := sqrtTwoAdjoinRootToQuadratic
      left_inv := ?_
      right_inv := ?_ }
  · intro x
    have hcomp :
        sqrtTwoAdjoinRootToQuadratic.comp sqrtTwoQuadraticToAdjoinRoot =
          AlgHom.id ℚ QSqrtTwoQuadratic := by
      apply QuadraticAlgebra.algHom_ext
      change sqrtTwoAdjoinRootToQuadratic
          (sqrtTwoQuadraticToAdjoinRoot sqrtTwoQuadraticRoot) = sqrtTwoQuadraticRoot
      rw [sqrtTwoQuadraticToAdjoinRoot_root, sqrtTwoAdjoinRootToQuadratic_root]
    exact DFunLike.congr_fun hcomp x
  · intro x
    have hcomp :
        sqrtTwoQuadraticToAdjoinRoot.comp sqrtTwoAdjoinRootToQuadratic =
          AlgHom.id ℚ QSqrtTwo := by
      apply AdjoinRoot.algHom_ext
      change sqrtTwoQuadraticToAdjoinRoot
          (sqrtTwoAdjoinRootToQuadratic sqrtTwoRoot) = sqrtTwoRoot
      rw [sqrtTwoAdjoinRootToQuadratic_root, sqrtTwoQuadraticToAdjoinRoot_root]
    exact DFunLike.congr_fun hcomp x

theorem sqrtTwoQuadraticEquivAdjoinRoot_root :
    sqrtTwoQuadraticEquivAdjoinRoot sqrtTwoQuadraticRoot = sqrtTwoRoot := by
  exact sqrtTwoQuadraticToAdjoinRoot_root

/-- The usual power basis `1, √2`. -/
abbrev sqrtTwoPowerBasis : PowerBasis ℚ QSqrtTwo :=
  AdjoinRoot.powerBasis (f := sqrtTwoPolynomial)
    ((Fact.out : Irreducible sqrtTwoPolynomial).ne_zero)

/-- The field is generated by the single element `√2`. -/
example : Algebra.adjoin ℚ ({sqrtTwoRoot} : Set QSqrtTwo) = ⊤ := by
  simpa [sqrtTwoPowerBasis, sqrtTwoRoot] using sqrtTwoPowerBasis.adjoin_gen_eq_top

example : sqrtTwoPowerBasis.gen = sqrtTwoRoot := by
  simp [sqrtTwoPowerBasis, sqrtTwoRoot]

theorem sqrtTwoPowerBasis_dim : sqrtTwoPowerBasis.dim = 2 := by
  change sqrtTwoPolynomial.natDegree = 2
  rw [sqrtTwoPolynomial, natDegree_X_pow_sub_C]

example : sqrtTwoPowerBasis.dim = 2 :=
  sqrtTwoPowerBasis_dim

example : Module.finrank ℚ QSqrtTwo = 2 := by
  rw [PowerBasis.finrank sqrtTwoPowerBasis]
  exact sqrtTwoPowerBasis_dim

instance : Algebra.IsQuadraticExtension ℚ QSqrtTwo where
  finrank_eq_two' := by
    rw [PowerBasis.finrank sqrtTwoPowerBasis]
    change sqrtTwoPolynomial.natDegree = 2
    rw [sqrtTwoPolynomial, natDegree_X_pow_sub_C]

/-! ### Alternative `AdjoinRoot` presentations -/

/--
The element `1 + √2` satisfies `X^2 - 2X - 1`.
This is a useful second presentation because `1 + √2` is a unit.
-/
abbrev sqrtTwoUnitPolynomial : ℚ[X] :=
  C (1 : ℚ) * X ^ 2 + C (-2 : ℚ) * X + C (-1 : ℚ)

instance : Fact (Irreducible sqrtTwoUnitPolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [sqrtTwoUnitPolynomial, Finset.mem_Icc, natDegree_quadratic (by norm_num : (1 : ℚ) ≠ 0)]
    norm_num
  · intro x hx
    have hzero : x ^ 2 + -(2 * x) + -1 = 0 := by
      simpa [sqrtTwoUnitPolynomial, IsRoot] using hx
    have hsquare : IsSquare (2 : ℚ) := by
      rw [isSquare_iff_exists_sq]
      refine ⟨x - 1, ?_⟩
      nlinarith
    norm_num at hsquare

/-- The same field, now generated by a root of `X^2 - 2X - 1`. -/
abbrev QSqrtTwoUnitModel : Type := AdjoinRoot sqrtTwoUnitPolynomial

example : Field QSqrtTwoUnitModel := by infer_instance

example : NumberField QSqrtTwoUnitModel := by infer_instance

/-- The formal root corresponding to `1 + √2`. -/
abbrev sqrtTwoUnitRoot : QSqrtTwoUnitModel := AdjoinRoot.root sqrtTwoUnitPolynomial

theorem sqrtTwoUnitRoot_relation :
    sqrtTwoUnitRoot ^ 2 - 2 * sqrtTwoUnitRoot - 1 = 0 := by
  simpa [sqrtTwoUnitRoot, sqrtTwoUnitPolynomial] using
    (AdjoinRoot.eval₂_root sqrtTwoUnitPolynomial)

/-- The map from `ℚ(√2)` to the `1 + √2` presentation sends `√2` to `β - 1`. -/
def sqrtTwoToUnitModel : QSqrtTwo →ₐ[ℚ] QSqrtTwoUnitModel :=
  AdjoinRoot.liftAlgHom sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwoUnitModel)
    (sqrtTwoUnitRoot - 1) (by
      calc
        sqrtTwoPolynomial.eval₂ (Algebra.ofId ℚ QSqrtTwoUnitModel) (sqrtTwoUnitRoot - 1)
            = (sqrtTwoUnitRoot - 1) ^ 2 - 2 := by
              simp [sqrtTwoPolynomial]
        _ = sqrtTwoUnitRoot ^ 2 - 2 * sqrtTwoUnitRoot - 1 := by ring
        _ = 0 := sqrtTwoUnitRoot_relation)

@[simp]
theorem sqrtTwoToUnitModel_root :
    sqrtTwoToUnitModel sqrtTwoRoot = sqrtTwoUnitRoot - 1 := by
  rw [sqrtTwoToUnitModel, sqrtTwoRoot]
  exact AdjoinRoot.liftAlgHom_root sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwoUnitModel)
    (sqrtTwoUnitRoot - 1) _

/-- The inverse map sends the shifted generator to `√2 + 1`. -/
def unitModelToSqrtTwo : QSqrtTwoUnitModel →ₐ[ℚ] QSqrtTwo :=
  AdjoinRoot.liftAlgHom sqrtTwoUnitPolynomial (Algebra.ofId ℚ QSqrtTwo)
    (sqrtTwoRoot + 1) (by
      calc
        sqrtTwoUnitPolynomial.eval₂ (Algebra.ofId ℚ QSqrtTwo) (sqrtTwoRoot + 1)
            = (sqrtTwoRoot + 1) ^ 2 + -(2 * (sqrtTwoRoot + 1)) + -1 := by
              simp [sqrtTwoUnitPolynomial]
        _ = sqrtTwoRoot ^ 2 - 2 := by ring
        _ = 0 := by rw [sqrtTwoRoot_sq]; ring)

@[simp]
theorem unitModelToSqrtTwo_root :
    unitModelToSqrtTwo sqrtTwoUnitRoot = sqrtTwoRoot + 1 := by
  rw [unitModelToSqrtTwo, sqrtTwoUnitRoot]
  exact AdjoinRoot.liftAlgHom_root sqrtTwoUnitPolynomial (Algebra.ofId ℚ QSqrtTwo)
    (sqrtTwoRoot + 1) _

/-- The two `AdjoinRoot` presentations of `ℚ(√2)` are equivalent. -/
def sqrtTwoEquivUnitModel : QSqrtTwo ≃ₐ[ℚ] QSqrtTwoUnitModel where
  __ := sqrtTwoToUnitModel
  invFun := unitModelToSqrtTwo
  left_inv x := by
    have hcomp :
        unitModelToSqrtTwo.comp sqrtTwoToUnitModel = AlgHom.id ℚ QSqrtTwo := by
      apply AdjoinRoot.algHom_ext
      change unitModelToSqrtTwo (sqrtTwoToUnitModel sqrtTwoRoot) = sqrtTwoRoot
      rw [sqrtTwoToUnitModel_root]
      simp only [map_sub, map_one, unitModelToSqrtTwo_root]
      ring
    change (unitModelToSqrtTwo.comp sqrtTwoToUnitModel) x = (AlgHom.id ℚ QSqrtTwo) x
    rw [hcomp]
  right_inv x := by
    have hcomp :
        sqrtTwoToUnitModel.comp unitModelToSqrtTwo = AlgHom.id ℚ QSqrtTwoUnitModel := by
      apply AdjoinRoot.algHom_ext
      change sqrtTwoToUnitModel (unitModelToSqrtTwo sqrtTwoUnitRoot) = sqrtTwoUnitRoot
      rw [unitModelToSqrtTwo_root]
      simp only [map_add, map_one, sqrtTwoToUnitModel_root]
      ring
    change (sqrtTwoToUnitModel.comp unitModelToSqrtTwo) x =
      (AlgHom.id ℚ QSqrtTwoUnitModel) x
    rw [hcomp]

theorem sqrtTwoEquivUnitModel_root :
    sqrtTwoEquivUnitModel sqrtTwoRoot = sqrtTwoUnitRoot - 1 :=
  sqrtTwoToUnitModel_root

/-! ## 2. Integral basis and ring of integers -/

/-- The ring of integers of `ℚ(√2)`. -/
abbrev O2 : Type := 𝓞 QSqrtTwo

example : CommRing O2 := by infer_instance

example : IsDomain O2 := by infer_instance

example : Algebra O2 QSqrtTwo := by infer_instance

theorem sqrtTwoRoot_isIntegral : IsIntegral ℤ sqrtTwoRoot := by
  refine ⟨X ^ 2 - C (2 : ℤ), ?_, ?_⟩
  · exact monic_X_pow_sub_C (2 : ℤ) (by norm_num : (2 : ℕ) ≠ 0)
  · simp [sqrtTwoRoot_sq]

/-- The algebraic integer `√2`. -/
abbrev sqrtTwoInteger : O2 :=
  ⟨sqrtTwoRoot, sqrtTwoRoot_isIntegral⟩

local notation "𝓟₂" => Submodule.span ℤ ({(2 : ℤ)} : Set ℤ)

/-- The same polynomial, now over `ℤ`. -/
abbrev sqrtTwoIntegerPolynomial : ℤ[X] := X ^ 2 - C (2 : ℤ)

/-- The rational minimal polynomial of the chosen root `√2`. -/
theorem sqrtTwo_minpoly_rat : minpoly ℚ sqrtTwoRoot = sqrtTwoPolynomial := by
  change minpoly ℚ (AdjoinRoot.root sqrtTwoPolynomial) = sqrtTwoPolynomial
  simpa [sqrtTwoPolynomial] using
    (AdjoinRoot.minpoly_root ((Fact.out : Irreducible sqrtTwoPolynomial).ne_zero) :
      minpoly ℚ (AdjoinRoot.root sqrtTwoPolynomial) =
        sqrtTwoPolynomial * C sqrtTwoPolynomial.leadingCoeff⁻¹)

theorem sqrtTwoPolynomial_eq_minpoly : sqrtTwoPolynomial = minpoly ℚ sqrtTwoRoot := by
  rw [sqrtTwo_minpoly_rat]

/-- The integral minimal polynomial of `√2`, viewed as an element of the field. -/
theorem sqrtTwo_minpoly_int : minpoly ℤ sqrtTwoRoot = sqrtTwoIntegerPolynomial := by
  apply (Polynomial.map_injective (algebraMap ℤ ℚ) Int.cast_injective)
  rw [← minpoly.isIntegrallyClosed_eq_field_fractions' (K := ℚ) sqrtTwoRoot_isIntegral,
    sqrtTwo_minpoly_rat]
  change X ^ 2 - C (2 : ℚ) =
    map (algebraMap ℤ ℚ) (X ^ 2 - C (2 : ℤ))
  rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  rw [show (algebraMap ℤ ℚ) (2 : ℤ) = (2 : ℚ) by norm_num]

/-- The polynomial `X^2 - 2` is Eisenstein at `2`. -/
theorem sqrtTwo_minpoly_int_isEisenstein :
    (minpoly ℤ sqrtTwoRoot).IsEisensteinAt 𝓟₂ := by
  rw [sqrtTwo_minpoly_int]
  refine
    (monic_X_pow_sub_C (2 : ℤ)
      (by norm_num : (2 : ℕ) ≠ 0)).isEisensteinAt_of_mem_of_notMem ?_ ?_ ?_
  · rw [ne_eq, Ideal.eq_top_iff_one]
    simp [Ideal.submodule_span_eq, Ideal.mem_span_singleton]
  · intro n hn
    rw [natDegree_X_pow_sub_C] at hn
    interval_cases n <;>
      simp [Ideal.submodule_span_eq]
  · simp [Ideal.submodule_span_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]

/-! ## 3. Discriminant -/

/-- The discriminant of the order `ℤ[√2]` with basis `1, √2` is `8`. -/
theorem sqrtTwoPowerBasis_discr :
    Algebra.discr ℚ sqrtTwoPowerBasis.basis = (8 : ℚ) := by
  rw [Algebra.discr_powerBasis_eq_norm]
  have hdim : sqrtTwoPowerBasis.dim = 2 := by
    change sqrtTwoPolynomial.natDegree = 2
    rw [sqrtTwoPolynomial, natDegree_X_pow_sub_C]
  have hfin : Module.finrank ℚ QSqrtTwo = 2 := by
    rw [PowerBasis.finrank sqrtTwoPowerBasis]
    exact hdim
  have hgen : sqrtTwoPowerBasis.gen = sqrtTwoRoot := by
    simp [sqrtTwoPowerBasis, sqrtTwoRoot]
  have hnorm_two : Algebra.norm ℚ (1 + 1 : QSqrtTwo) = (4 : ℚ) := by
    rw [show (1 + 1 : QSqrtTwo) = algebraMap ℚ QSqrtTwo (2 : ℚ) by norm_num]
    rw [Algebra.norm_algebraMap, hfin]
    norm_num
  have hnorm_root : Algebra.norm ℚ sqrtTwoRoot = (-2 : ℚ) := by
    rw [← hgen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly sqrtTwoPowerBasis]
    rw [hdim, hgen, sqrtTwo_minpoly_rat]
    simp [sqrtTwoPolynomial]
  rw [hfin, hgen, sqrtTwo_minpoly_rat]
  simp [sqrtTwoRoot, sqrtTwoPolynomial, hnorm_two, hnorm_root]
  norm_num

/--
Every algebraic integer in `ℚ(√2)` lies in `ℤ[√2]`.

The proof uses the discriminant bound `8 • z ∈ ℤ[√2]`, then removes the factor
`2^3` with the Eisenstein theorem for `X^2 - 2`.
-/
theorem sqrtTwo_integral_mem_adjoin (z : QSqrtTwo) (hz : IsIntegral ℤ z) :
    z ∈ Algebra.adjoin ℤ ({sqrtTwoRoot} : Set QSqrtTwo) := by
  have hBint : IsIntegral ℤ sqrtTwoPowerBasis.gen := by
    simpa [sqrtTwoPowerBasis, sqrtTwoRoot] using sqrtTwoRoot_isIntegral
  have hdiscr :=
    Algebra.discr_mul_isIntegral_mem_adjoin (K := ℚ) (L := QSqrtTwo)
      (R := ℤ) (B := sqrtTwoPowerBasis) hBint hz
  have hpow :
      (2 : ℤ) ^ 3 • z ∈ Algebra.adjoin ℤ ({sqrtTwoPowerBasis.gen} : Set QSqrtTwo) := by
    convert hdiscr using 1
    rw [sqrtTwoPowerBasis_discr]
    norm_num [Algebra.smul_def]
  have hmem :
      z ∈ Algebra.adjoin ℤ ({sqrtTwoPowerBasis.gen} : Set QSqrtTwo) :=
    mem_adjoin_of_smul_prime_pow_smul_of_minpoly_isEisensteinAt
      (R := ℤ) (K := ℚ) (L := QSqrtTwo) (B := sqrtTwoPowerBasis)
      (p := (2 : ℤ)) (n := 3) Int.prime_two hBint hz hpow
      (by simpa [sqrtTwoPowerBasis, sqrtTwoRoot] using sqrtTwo_minpoly_int_isEisenstein)
  simpa [sqrtTwoPowerBasis, sqrtTwoRoot] using hmem

/--
`ℤ[√2]` is integrally closed in `ℚ(√2)`.
-/
example : IsIntegralClosure
      (Algebra.adjoin ℤ ({sqrtTwoRoot} : Set QSqrtTwo)) ℤ QSqrtTwo := by
  refine ⟨?_, ?_⟩
  · intro x y hxy
    exact Subtype.ext hxy
  · intro x
    constructor
    · intro hx
      exact ⟨⟨x, sqrtTwo_integral_mem_adjoin x hx⟩, rfl⟩
    · rintro ⟨y, rfl⟩
      letI : Algebra.IsIntegral ℤ (Algebra.adjoin ℤ ({sqrtTwoRoot} : Set QSqrtTwo)) :=
        Algebra.IsIntegral.adjoin
          (by
            intro x hx
            simp only [Set.mem_singleton_iff] at hx
            rw [hx]
            exact sqrtTwoRoot_isIntegral)
      exact IsIntegral.algebraMap (Algebra.IsIntegral.isIntegral y)

/-- The ring of integers of `ℚ(√2)` is generated over `ℤ` by `√2`. -/
theorem sqrtTwoInteger_adjoin_eq_top :
    Algebra.adjoin ℤ ({sqrtTwoInteger} : Set O2) = ⊤ := by
  apply le_antisymm le_top
  intro x hx
  have hfield :
      (x : QSqrtTwo) ∈ Algebra.adjoin ℤ ({sqrtTwoRoot} : Set QSqrtTwo) :=
    sqrtTwo_integral_mem_adjoin (x : QSqrtTwo) x.2
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hfield
  rcases hfield with ⟨P, hP⟩
  have hx_eq : x = aeval sqrtTwoInteger P := by
    ext
    change (x : QSqrtTwo) = ((aeval sqrtTwoInteger P : O2) : QSqrtTwo)
    rw [← hP]
    simpa [sqrtTwoInteger] using
      (Polynomial.aeval_algHom_apply
        (algebraMap O2 QSqrtTwo).toIntAlgHom sqrtTwoInteger P)
  rw [hx_eq]
  rw [Algebra.adjoin_singleton_eq_range_aeval]
  exact ⟨P, rfl⟩

theorem sqrtTwoInteger_minpoly :
    minpoly ℤ sqrtTwoInteger = sqrtTwoIntegerPolynomial := by
  letI : IsScalarTower ℤ O2 QSqrtTwo :=
    IsScalarTower.of_algebraMap_eq fun z => by
      rfl
  have hint : IsIntegral ℤ sqrtTwoInteger := Algebra.IsIntegral.isIntegral sqrtTwoInteger
  have hfrac :
      minpoly ℚ ((algebraMap O2 QSqrtTwo) sqrtTwoInteger) =
        map (algebraMap ℤ ℚ) (minpoly ℤ sqrtTwoInteger) :=
    @minpoly.isIntegrallyClosed_eq_field_fractions ℤ O2
      inferInstance inferInstance inferInstance inferInstance
      ℚ QSqrtTwo inferInstance inferInstance inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance inferInstance this inferInstance inferInstance
      sqrtTwoInteger hint
  apply (Polynomial.map_injective (algebraMap ℤ ℚ) Int.cast_injective)
  rw [← hfrac]
  change minpoly ℚ sqrtTwoRoot = map (algebraMap ℤ ℚ) sqrtTwoIntegerPolynomial
  rw [sqrtTwo_minpoly_rat]
  change X ^ 2 - C (2 : ℚ) =
    map (algebraMap ℤ ℚ) (X ^ 2 - C (2 : ℤ))
  rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  rw [show (algebraMap ℤ ℚ) (2 : ℤ) = (2 : ℚ) by norm_num]

/--
An explicit integral power basis of `𝓞 ℚ(√2)`: the generator is the algebraic
integer `√2`.
-/
abbrev sqrtTwoExplicitIntegralPowerBasis : PowerBasis ℤ O2 :=
  PowerBasis.ofAdjoinEqTop'
    (Algebra.IsIntegral.isIntegral sqrtTwoInteger)
    sqrtTwoInteger_adjoin_eq_top

theorem sqrtTwoExplicitIntegralPowerBasis_gen :
    sqrtTwoExplicitIntegralPowerBasis.gen = sqrtTwoInteger := by
  exact PowerBasis.ofAdjoinEqTop'_gen
    (Algebra.IsIntegral.isIntegral sqrtTwoInteger)
    sqrtTwoInteger_adjoin_eq_top

theorem sqrtTwoExplicitIntegralPowerBasis_dim :
    sqrtTwoExplicitIntegralPowerBasis.dim = 2 := by
  rw [sqrtTwoExplicitIntegralPowerBasis, PowerBasis.ofAdjoinEqTop'_dim,
    sqrtTwoInteger_minpoly]
  change sqrtTwoIntegerPolynomial.natDegree = 2
  rw [sqrtTwoIntegerPolynomial, natDegree_X_pow_sub_C]

/-- The explicit integral basis `[1, √2]` of the ring of integers. -/
abbrev sqrtTwoExplicitIntegralBasis : Basis (Fin 2) ℤ O2 :=
  sqrtTwoExplicitIntegralPowerBasis.basis.reindex
    (finCongr sqrtTwoExplicitIntegralPowerBasis_dim)

/-- The first vector in the explicit integral basis is `1`. -/
theorem sqrtTwoExplicitIntegralBasis_zero :
    sqrtTwoExplicitIntegralBasis 0 = 1 := by
  rw [sqrtTwoExplicitIntegralBasis, Basis.reindex_apply]
  rw [sqrtTwoExplicitIntegralPowerBasis.basis_eq_pow]
  have hcoe :
      (((finCongr sqrtTwoExplicitIntegralPowerBasis_dim).symm (0 : Fin 2) :
        Fin sqrtTwoExplicitIntegralPowerBasis.dim) : ℕ) = 0 := rfl
  rw [hcoe]
  simp

example : sqrtTwoExplicitIntegralBasis 0 = 1 :=
  sqrtTwoExplicitIntegralBasis_zero

/-- The second vector in the explicit integral basis is `√2`. -/
theorem sqrtTwoExplicitIntegralBasis_one :
    sqrtTwoExplicitIntegralBasis 1 = sqrtTwoInteger := by
  rw [sqrtTwoExplicitIntegralBasis, Basis.reindex_apply]
  rw [sqrtTwoExplicitIntegralPowerBasis.basis_eq_pow]
  have hcoe :
      (((finCongr sqrtTwoExplicitIntegralPowerBasis_dim).symm (1 : Fin 2) :
        Fin sqrtTwoExplicitIntegralPowerBasis.dim) : ℕ) = 1 := rfl
  rw [hcoe]
  simp

example : sqrtTwoExplicitIntegralBasis 1 = sqrtTwoInteger :=
  sqrtTwoExplicitIntegralBasis_one

theorem sqrtTwoInteger_sq : sqrtTwoInteger ^ 2 = (2 : O2) := by
  ext
  change sqrtTwoRoot ^ 2 = (2 : QSqrtTwo)
  exact sqrtTwoRoot_sq

set_option linter.flexible false in
/-- The discriminant of the explicit integral basis `[1, √2]` is `8`. -/
theorem sqrtTwoExplicitIntegralBasis_discr :
    Algebra.discr ℤ sqrtTwoExplicitIntegralBasis = (8 : ℤ) := by
  let bInt : Basis (Fin 2) ℤ (𝓞 QSqrtTwo) := sqrtTwoExplicitIntegralBasis
  haveI : IsScalarTower ℤ (𝓞 QSqrtTwo) QSqrtTwo := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hdiscLoc :=
    @Algebra.discr_localizationLocalization
      ℤ (𝓞 QSqrtTwo) _ _ _ ℚ _ _ ℤ⁰ _ QSqrtTwo _ _ _ _
      (by infer_instance : IsScalarTower ℤ ℚ QSqrtTwo)
      (by infer_instance : IsScalarTower ℤ (𝓞 QSqrtTwo) QSqrtTwo)
      (by
        infer_instance :
          IsLocalization (Algebra.algebraMapSubmonoid (𝓞 QSqrtTwo) ℤ⁰) QSqrtTwo)
      (Fin 2) (by infer_instance) (by infer_instance) bInt
  let bLoc : Basis (Fin 2) ℚ QSqrtTwo :=
    @Module.Basis.localizationLocalization
      ℤ ℚ _ ℤ⁰ _ _ _ (𝓞 QSqrtTwo) _ _ QSqrtTwo _ _ _ _
      (by infer_instance : IsScalarTower ℤ ℚ QSqrtTwo)
      (by infer_instance : IsScalarTower ℤ (𝓞 QSqrtTwo) QSqrtTwo)
      (by
        infer_instance :
          IsLocalization (Algebra.algebraMapSubmonoid (𝓞 QSqrtTwo) ℤ⁰) QSqrtTwo)
      (Fin 2) bInt
  apply (algebraMap ℤ ℚ).injective_int
  change (algebraMap ℤ ℚ) (Algebra.discr ℤ bInt) = (algebraMap ℤ ℚ) 8
  rw [← hdiscLoc]
  change Algebra.discr ℚ bLoc = (8 : ℚ)
  have hBasis : bLoc = sqrtTwoPowerBasis.basis.reindex (finCongr sqrtTwoPowerBasis_dim) := by
    ext i
    fin_cases i
    · simp [bLoc, bInt, Basis.localizationLocalization_apply, sqrtTwoExplicitIntegralBasis_zero]
      change (1 : QSqrtTwo) =
        sqrtTwoPowerBasis.basis ((finCongr sqrtTwoPowerBasis_dim).symm (0 : Fin 2))
      rw [sqrtTwoPowerBasis.basis_eq_pow]
      have hcoe :
          (((finCongr sqrtTwoPowerBasis_dim).symm (0 : Fin 2) :
            Fin sqrtTwoPowerBasis.dim) : ℕ) = 0 := rfl
      rw [hcoe]
      simp
    · simp [bLoc, bInt, Basis.localizationLocalization_apply, sqrtTwoExplicitIntegralBasis_one]
      change sqrtTwoRoot =
        sqrtTwoPowerBasis.basis ((finCongr sqrtTwoPowerBasis_dim).symm (1 : Fin 2))
      rw [sqrtTwoPowerBasis.basis_eq_pow]
      have hcoe :
          (((finCongr sqrtTwoPowerBasis_dim).symm (1 : Fin 2) :
            Fin sqrtTwoPowerBasis.dim) : ℕ) = 1 := rfl
      rw [hcoe]
      simp [sqrtTwoPowerBasis, sqrtTwoRoot]
  rw [hBasis]
  simpa [Basis.coe_reindex] using
    (Algebra.discr_reindex ℚ sqrtTwoPowerBasis.basis (finCongr sqrtTwoPowerBasis_dim)).trans
      sqrtTwoPowerBasis_discr

theorem sqrtTwo_numberField_discr :
    NumberField.discr QSqrtTwo = 8 := by
  rw [← NumberField.discr_eq_discr QSqrtTwo sqrtTwoExplicitIntegralBasis]
  exact sqrtTwoExplicitIntegralBasis_discr

example : Algebra.discr ℚ (NumberField.integralBasis QSqrtTwo) = (8 : ℚ) := by
  have h := NumberField.coe_discr QSqrtTwo
  rw [sqrtTwo_numberField_discr] at h
  simpa using h.symm

theorem discr_matrix_mulVec_sqrtTwo
    (P : Matrix (Fin sqrtTwoPowerBasis.dim) (Fin sqrtTwoPowerBasis.dim) ℚ) :
    Algebra.discr ℚ (Matrix.mulVec (P.map (algebraMap ℚ QSqrtTwo)) sqrtTwoPowerBasis.basis) =
      P.det ^ 2 * Algebra.discr ℚ sqrtTwoPowerBasis.basis :=
  Algebra.discr_of_matrix_mulVec _ _

example (P : Matrix (Fin sqrtTwoPowerBasis.dim) (Fin sqrtTwoPowerBasis.dim) ℚ)
    (hdet : P.det = 1 ∨ P.det = -1) :
    Algebra.discr ℚ (Matrix.mulVec (P.map (algebraMap ℚ QSqrtTwo)) sqrtTwoPowerBasis.basis) =
      (8 : ℚ) := by
  rw [discr_matrix_mulVec_sqrtTwo, sqrtTwoPowerBasis_discr]
  rcases hdet with h | h
  · rw [h]
    norm_num
  · rw [h]
    norm_num

example : sqrtTwoInteger ∣ (2 : O2) := by
  use sqrtTwoInteger
  simpa [pow_two] using sqrtTwoInteger_sq.symm

/-! ## 4. Norm form -/

/-- The norm form of `ℚ(√2)` in the basis `1, √2`: the field norm of `x + y√2` is the binary
quadratic form `x² - 2y²`, the principal form of discriminant `8`. -/
theorem norm_eq_normForm (x y : ℚ) :
    Algebra.norm ℚ (x • (1 : QSqrtTwo) + y • sqrtTwoRoot) = x ^ 2 - 2 * y ^ 2 := by
  calc
    Algebra.norm ℚ (x • (1 : QSqrtTwo) + y • sqrtTwoRoot) =
        Algebra.norm ℚ (sqrtTwoQuadraticEquivAdjoinRoot
          (x • (1 : QSqrtTwoQuadratic) + y • sqrtTwoQuadraticRoot)) := by
      congr 1
      simp [Algebra.smul_def, sqrtTwoQuadraticEquivAdjoinRoot_root]
    _ = Algebra.norm ℚ (x • (1 : QSqrtTwoQuadratic) + y • sqrtTwoQuadraticRoot) := by
      rw [Algebra.norm_eq_of_algEquiv]
    _ = x ^ 2 - 2 * y ^ 2 := by
      rw [Algebra.norm_apply]
      change LinearMap.det
          (DistribSMul.toLinearMap ℚ QSqrtTwoQuadratic
            (x • (1 : QSqrtTwoQuadratic) + y • sqrtTwoQuadraticRoot)) =
        x ^ 2 - 2 * y ^ 2
      rw [QuadraticAlgebra.det_toLinearMap_eq_norm, QuadraticAlgebra.norm_def]
      simp [sqrtTwoQuadraticRoot]
      ring

/-- The integral norm form: on `𝓞 K = ℤ[√2]` the norm of `x + y√2` (with `x, y ∈ ℤ`) is
`x² - 2y²`. -/
theorem intNorm_eq_normForm (x y : ℤ) :
    Algebra.norm ℤ (x • (1 : O2) + y • sqrtTwoInteger) = x ^ 2 - 2 * y ^ 2 := by
  have h1 : ((Algebra.norm ℤ (x • (1 : O2) + y • sqrtTwoInteger) : ℤ) : ℚ) =
      Algebra.norm ℚ (algebraMap O2 QSqrtTwo (x • (1 : O2) + y • sqrtTwoInteger)) :=
    Algebra.coe_norm_int (K := QSqrtTwo) _
  have h2 : algebraMap O2 QSqrtTwo (x • (1 : O2) + y • sqrtTwoInteger) =
      (x : ℚ) • (1 : QSqrtTwo) + (y : ℚ) • sqrtTwoRoot := by
    rw [map_add, map_zsmul, map_zsmul, map_one]
    rw [Int.cast_smul_eq_zsmul ℚ x (1 : QSqrtTwo),
      Int.cast_smul_eq_zsmul ℚ y sqrtTwoRoot]
    rfl
  rw [h2, norm_eq_normForm] at h1
  exact_mod_cast h1

/-- The Pell equation for `ℚ(√2)`: `x + y√2` is a unit of `ℤ[√2]` iff `x² - 2y² = ±1`.
Combined with `sqrtTwoFundamentalUnit_generates_unitGroup`, all integer solutions of
`x² - 2y² = ±1` arise from `±(1 + √2)ⁿ`, `n ∈ ℤ`. -/
theorem isUnit_iff_normForm (x y : ℤ) :
    IsUnit (x • (1 : O2) + y • sqrtTwoInteger) ↔
      x ^ 2 - 2 * y ^ 2 = 1 ∨ x ^ 2 - 2 * y ^ 2 = -1 := by
  rw [NumberField.isUnit_iff_norm, RingOfIntegers.coe_norm, ← Algebra.coe_norm_int,
    intNorm_eq_normForm, abs_eq (by norm_num : (0 : ℚ) ≤ 1)]
  constructor
  · rintro (h | h)
    · exact Or.inl (by exact_mod_cast h)
    · exact Or.inr (by exact_mod_cast h)
  · rintro (h | h)
    · exact Or.inl (by exact_mod_cast h)
    · exact Or.inr (by exact_mod_cast h)

/-! ## 5. Splitting of primes -/

/-- `2` is (totally) ramified: `(2) = (√2)²` as ideals of `𝓞 K`, directly from `(√2)² = 2`.
It is the unique ramified prime, matching the discriminant `8 = 2³`. -/
theorem span_two_eq : Ideal.span {(2 : O2)} = Ideal.span {sqrtTwoInteger} ^ 2 := by
  rw [Ideal.span_singleton_pow, sqrtTwoInteger_sq]

/-- The prime `(√2)` above `2` has norm `2` (residue degree `f = 1`). -/
theorem absNorm_span_sqrtTwoInteger : Ideal.absNorm (Ideal.span {sqrtTwoInteger}) = 2 := by
  have h := intNorm_eq_normForm 0 1
  have h2 : (0 : ℤ) • (1 : O2) + (1 : ℤ) • sqrtTwoInteger = sqrtTwoInteger := by
    simp
  rw [h2] at h
  norm_num at h
  rw [Ideal.absNorm_span_singleton, h]
  rfl

/-- `(√2)` is a prime ideal — the unique prime of `𝓞 K` above `2`. -/
theorem isPrime_span_sqrtTwoInteger : (Ideal.span {sqrtTwoInteger}).IsPrime := by
  apply Ideal.isPrime_of_irreducible_absNorm
  rw [absNorm_span_sqrtTwoInteger]
  exact (by norm_num : Nat.Prime 2)

/-- `7 ≡ -1 (mod 8)` splits: `7 = (3 + √2)(3 - √2)` and `(7)` is a product of two distinct
primes of norm `7`. -/
theorem span_seven_eq :
    Ideal.span {(7 : O2)} =
      Ideal.span {3 + sqrtTwoInteger} * Ideal.span {3 - sqrtTwoInteger} := by
  rw [Ideal.span_singleton_mul_span_singleton]
  have hseven : (3 + sqrtTwoInteger) * (3 - sqrtTwoInteger) = (7 : O2) := by
    calc
      (3 + sqrtTwoInteger) * (3 - sqrtTwoInteger) = 9 - sqrtTwoInteger ^ 2 := by ring
      _ = 7 := by rw [sqrtTwoInteger_sq]; norm_num
  rw [hseven]

/-- The prime `(3 + √2)` above `7` has norm `7` (residue degree `f = 1`). -/
theorem absNorm_span_three_add_sqrtTwo :
    Ideal.absNorm (Ideal.span {3 + sqrtTwoInteger}) = 7 := by
  have h := intNorm_eq_normForm 3 1
  have h3 : (3 : ℤ) • (1 : O2) + (1 : ℤ) • sqrtTwoInteger =
      3 + sqrtTwoInteger := by
    simp
  rw [h3] at h
  norm_num at h
  rw [Ideal.absNorm_span_singleton, h]
  rfl

/-- `(3 + √2)` is a prime ideal — one of the two primes of `𝓞 K` above `7`. -/
theorem isPrime_span_three_add_sqrtTwo : (Ideal.span {3 + sqrtTwoInteger}).IsPrime := by
  apply Ideal.isPrime_of_irreducible_absNorm
  rw [absNorm_span_three_add_sqrtTwo]
  exact (by norm_num : Nat.Prime 7)

/-- Nonzero ideals with equal absolute norms and one inclusion are equal. -/
private theorem eq_of_le_of_absNorm_eq {I J : Ideal O2} (hle : I ≤ J) {n : ℕ}
    (hI : Ideal.absNorm I = n) (hJ : Ideal.absNorm J = n) (hn : n ≠ 0) : I = J := by
  obtain ⟨C, hC⟩ := Ideal.dvd_iff_le.mpr hle
  have hmul := _root_.map_mul Ideal.absNorm J C
  rw [← hC, hI, hJ] at hmul
  have hC1 : Ideal.absNorm C = 1 :=
    (Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hn)
      (by rw [mul_one]; exact hmul)).symm
  rw [hC, Ideal.absNorm_eq_one_iff.mp hC1, Ideal.mul_top]

/-- There is no prime of `𝓞 K` with residue field `𝔽₃`: `X² - 2` has no root mod `3`. -/
private theorem absNorm_ne_three (P : Ideal O2) : Ideal.absNorm P ≠ 3 := by
  intro hcard
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply] at hcard
  haveI : Finite (O2 ⧸ P) := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  haveI : Fintype (O2 ⧸ P) := Fintype.ofFinite _
  have hcard' : Fintype.card (O2 ⧸ P) = 3 := by
    rw [← Nat.card_eq_fintype_card]
    exact hcard
  let e := ZMod.ringEquivOfPrime (O2 ⧸ P) (by norm_num) hcard'
  obtain ⟨t, ht⟩ := e.surjective (Ideal.Quotient.mk P sqrtTwoInteger)
  have ht2 : t ^ 2 = 2 := by
    apply e.injective
    rw [map_pow, ht, ← map_pow (Ideal.Quotient.mk P), sqrtTwoInteger_sq]
    simpa using (map_ofNat e 2).symm
  clear ht
  revert t
  decide

/-- `3` is inert in `ℚ(√2)`: `2` is not a square mod `3`, so `X² - 2` is irreducible mod `3`
and `(3)` is itself prime. -/
theorem isPrime_span_three : (Ideal.span {(3 : O2)}).IsPrime := by
  have habs9 : Ideal.absNorm (Ideal.span {(3 : O2)}) = 9 := by
    have h := intNorm_eq_normForm 3 0
    have h3 : (3 : ℤ) • (1 : O2) + (0 : ℤ) • sqrtTwoInteger = 3 := by
      simp
    rw [h3] at h
    norm_num at h
    rw [Ideal.absNorm_span_singleton, h]
    rfl
  have htop : Ideal.span {(3 : O2)} ≠ ⊤ := by
    intro h
    rw [h, Ideal.absNorm_top] at habs9
    norm_num at habs9
  obtain ⟨M, hMmax, hMle⟩ := Ideal.exists_le_maximal _ htop
  have hdvd : Ideal.absNorm M ∣ 9 := habs9 ▸ Ideal.absNorm_dvd_absNorm_of_le hMle
  have hM1 : Ideal.absNorm M ≠ 1 := by
    rw [Ne, Ideal.absNorm_eq_one_iff]
    exact hMmax.ne_top
  have hM3 : Ideal.absNorm M ≠ 3 := absNorm_ne_three M
  have hM9 : Ideal.absNorm M = 9 := by
    obtain ⟨k, hk, hkeq⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp
      (show Ideal.absNorm M ∣ 3 ^ 2 from hdvd)
    interval_cases k
    · rw [pow_zero] at hkeq
      exact absurd hkeq hM1
    · rw [pow_one] at hkeq
      exact absurd hkeq hM3
    · rw [hkeq]
      norm_num
  have heq := eq_of_le_of_absNorm_eq hMle habs9 hM9 (by norm_num)
  rw [heq]
  exact hMmax.isPrime

/-- The inert prime `(3)` has norm `9` (residue degree `f = 2`). -/
theorem absNorm_span_three : Ideal.absNorm (Ideal.span {(3 : O2)}) = 9 := by
  have h := intNorm_eq_normForm 3 0
  have h3 : (3 : ℤ) • (1 : O2) + (0 : ℤ) • sqrtTwoInteger = 3 := by
    simp
  rw [h3] at h
  norm_num at h
  rw [Ideal.absNorm_span_singleton, h]
  rfl

/-- A rational prime generates an ideal of norm `p²` in the quadratic ring `ℤ[√2]`. -/
private theorem absNorm_span_natCast (p : ℕ) :
    Ideal.absNorm (Ideal.span {((p : ℕ) : O2)}) = p ^ 2 := by
  have h := intNorm_eq_normForm (p : ℤ) 0
  have hp : ((p : ℤ)) • (1 : O2) + (0 : ℤ) • sqrtTwoInteger = ((p : ℕ) : O2) := by
    simp
  rw [hp] at h
  norm_num at h
  rw [Ideal.absNorm_span_singleton, h]
  simp [Int.natAbs_pow]

private theorem li_one_sqrtTwo : LinearIndependent ℤ ![(1 : O2), sqrtTwoInteger] := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  rw [Fin.sum_univ_two] at hg
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hg
  have hsum : ∑ i : Fin 2, g i • sqrtTwoExplicitIntegralBasis i = 0 := by
    rw [Fin.sum_univ_two, sqrtTwoExplicitIntegralBasis_zero, sqrtTwoExplicitIntegralBasis_one]
    exact hg
  exact Fintype.linearIndependent_iff.mp sqrtTwoExplicitIntegralBasis.linearIndependent g hsum

private theorem exists_o2_coords (z : O2) :
    ∃ A B : ℤ, z = A • (1 : O2) + B • sqrtTwoInteger := by
  let A : ℤ := sqrtTwoExplicitIntegralBasis.repr z 0
  let B : ℤ := sqrtTwoExplicitIntegralBasis.repr z 1
  refine ⟨A, B, ?_⟩
  have hsum := sqrtTwoExplicitIntegralBasis.sum_repr z
  rw [Fin.sum_univ_two, sqrtTwoExplicitIntegralBasis_zero,
    sqrtTwoExplicitIntegralBasis_one] at hsum
  simpa [A, B] using hsum.symm

/-- An element `A + B√2` with `B = ±1` is never divisible by a rational prime `p ≥ 2`. -/
private theorem unit_sqrtTwo_coeff_not_mem (p : ℕ) (hp : 2 ≤ p) (A B : ℤ)
    (hB : B = 1 ∨ B = -1) :
    ((A : ℤ) : O2) + ((B : ℤ) : O2) * sqrtTwoInteger ∉
      Ideal.span {((p : ℕ) : O2)} := by
  intro hmem
  rw [Ideal.mem_span_singleton] at hmem
  obtain ⟨z, hz⟩ := hmem
  obtain ⟨A', m, hzdec⟩ := exists_o2_coords z
  rw [hzdec] at hz
  have hsum : ∑ i : Fin 2,
      (![A - p * A', B - p * m] i) • (![(1 : O2), sqrtTwoInteger] i) = 0 := by
    rw [Fin.sum_univ_two]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, zsmul_eq_mul] at hz ⊢
    push_cast at hz ⊢
    linear_combination hz
  have hcoeff := Fintype.linearIndependent_iff.mp li_one_sqrtTwo _ hsum 1
  simp only [Matrix.cons_val_one, Matrix.cons_val_zero] at hcoeff
  rcases hB with rfl | rfl
  · have h1 : (p : ℤ) ∣ 1 := ⟨m, by linarith [hcoeff]⟩
    have := Int.le_of_dvd one_pos h1
    omega
  · have h1 : (p : ℤ) ∣ 1 := ⟨-m, by linarith [hcoeff]⟩
    have := Int.le_of_dvd one_pos h1
    omega

/-- The splitting law at ramified primes: a rational prime `p` ramifies in `ℚ(√2)` iff
`p = 2`, i.e. iff `p` divides the discriminant `8`. -/
theorem ramified_iff_eq_two (p : ℕ) (hp : p.Prime) :
    (∃ P : Ideal O2, P.IsPrime ∧ Ideal.span {(p : O2)} ≤ P ^ 2) ↔ p = 2 := by
  constructor
  · rintro ⟨P, hP, hle2⟩
    haveI : P.IsPrime := hP
    have hple : Ideal.span {((p : ℕ) : O2)} ≤ P :=
      hle2.trans (Ideal.pow_le_self (by norm_num))
    have hpmemP : ((p : ℕ) : O2) ∈ P := hple (Ideal.mem_span_singleton_self _)
    have hpne : ((p : ℕ) : O2) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
    have hPbot : P ≠ ⊥ := by
      intro h
      rw [h] at hpmemP
      exact hpne (Ideal.mem_bot.mp hpmemP)
    have hfin : Module.finrank ℤ O2 = 2 := by
      rw [Module.finrank_eq_card_basis sqrtTwoExplicitIntegralBasis, Fintype.card_fin]
    have habsp : Ideal.absNorm (Ideal.span {((p : ℕ) : O2)}) = p ^ 2 := by
      rw [Ideal.absNorm_span_singleton]
      have hcast : ((p : ℕ) : O2) = algebraMap ℤ O2 ((p : ℕ) : ℤ) := by
        push_cast
        rfl
      rw [hcast, Algebra.norm_algebraMap, hfin, Int.natAbs_pow, Int.natAbs_natCast]
    have habsPp2 : Ideal.absNorm P ∣ p ^ 2 :=
      habsp ▸ Ideal.absNorm_dvd_absNorm_of_le hple
    obtain ⟨k, hk2, hkeq⟩ := (Nat.dvd_prime_pow hp).mp habsPp2
    have hk0 : k ≠ 0 := by
      intro h0
      rw [h0, pow_zero] at hkeq
      exact hP.ne_top (Ideal.absNorm_eq_one_iff.mp hkeq)
    have hmap : Ideal.map (algebraMap ℤ O2) (Ideal.span {((p : ℕ) : ℤ)}) =
        Ideal.span {((p : ℕ) : O2)} := by
      rw [Ideal.map_span, Set.image_singleton]
      norm_num
    have hle2' : Ideal.map (algebraMap ℤ O2) (Ideal.span {((p : ℕ) : ℤ)}) ≤ P ^ 2 := by
      rw [hmap]
      exact hle2
    have hno3 : ¬ Ideal.map (algebraMap ℤ O2) (Ideal.span {((p : ℕ) : ℤ)}) ≤ P ^ 3 := by
      intro h3
      rw [hmap] at h3
      have hd := Ideal.absNorm_dvd_absNorm_of_le h3
      rw [map_pow, habsp, hkeq, ← pow_mul] at hd
      rw [Nat.pow_dvd_pow_iff_le_right hp.one_lt] at hd
      omega
    have hidx : Ideal.ramificationIdx (Ideal.span {((p : ℕ) : ℤ)}) P ≠ 1 := by
      rw [Ideal.ramificationIdx_spec hle2' hno3]
      norm_num
    have hund : Ideal.under ℤ P = Ideal.span {((p : ℕ) : ℤ)} := by
      have hmem : ((p : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
        rw [Ideal.under, Ideal.mem_comap]
        have hcast2 : algebraMap ℤ O2 ((p : ℕ) : ℤ) = ((p : ℕ) : O2) := by
          push_cast
          rfl
        rw [hcast2]
        exact hpmemP
      have hle : Ideal.span {((p : ℕ) : ℤ)} ≤ Ideal.under ℤ P := by
        rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hmem
      have hprime : (Ideal.span {((p : ℕ) : ℤ)}).IsPrime :=
        (Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)).mpr
          (Nat.prime_iff_prime_int.mp hp)
      have hbot : Ideal.span {((p : ℕ) : ℤ)} ≠ ⊥ := by
        rw [Ne, Ideal.span_singleton_eq_bot]
        exact_mod_cast hp.ne_zero
      have hnetop : Ideal.under ℤ P ≠ ⊤ := by
        intro h
        have h1 : (1 : ℤ) ∈ Ideal.under ℤ P := h ▸ Submodule.mem_top
        rw [Ideal.under, Ideal.mem_comap, map_one] at h1
        exact hP.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
      exact ((hprime.isMaximal hbot).eq_of_le hnetop hle).symm
    have hunram : ¬ Algebra.IsUnramifiedAt ℤ P := by
      rw [Algebra.isUnramifiedAt_iff_of_isDedekindDomain hPbot, hund]
      exact hidx
    have hPdiff : P ∣ differentIdeal ℤ O2 := dvd_differentIdeal_iff.mpr hunram
    have habsP8 : Ideal.absNorm P ∣ 8 := by
      have h := Ideal.absNorm_dvd_absNorm_of_le (Ideal.le_of_dvd hPdiff)
      rw [NumberField.absNorm_differentIdeal (K := QSqrtTwo), sqrtTwo_numberField_discr] at h
      simpa using h
    have hpdvd8 : p ∣ 8 := (hkeq ▸ dvd_pow_self p hk0).trans habsP8
    obtain ⟨k, hk3, hpeq⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp
      (show p ∣ 2 ^ 3 from by simpa using hpdvd8)
    interval_cases k
    · rw [pow_zero] at hpeq
      exact absurd hpeq hp.ne_one
    · simpa using hpeq
    · rw [hpeq] at hp
      norm_num at hp
    · rw [hpeq] at hp
      norm_num at hp
  · rintro rfl
    refine ⟨Ideal.span {sqrtTwoInteger}, isPrime_span_sqrtTwoInteger, ?_⟩
    have hcast : ((2 : ℕ) : O2) = (2 : O2) := by norm_num
    rw [hcast, span_two_eq]

private theorem exists_prime_norm_iff_pm_one_mod_eight (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) :
    (∃ P : Ideal O2, P.IsPrime ∧ Ideal.span {(p : O2)} ≤ P ∧ Ideal.absNorm P = p) ↔
      p % 8 = 1 ∨ p % 8 = 7 := by
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  constructor
  · rintro ⟨P, hPprime, hPle, hNP⟩
    have hcard : Nat.card (O2 ⧸ P) = p := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply] at hNP
      exact hNP
    haveI : Finite (O2 ⧸ P) := Nat.finite_of_card_ne_zero (by rw [hcard]; exact hp.pos.ne')
    haveI : Fintype (O2 ⧸ P) := Fintype.ofFinite _
    have hcard' : Fintype.card (O2 ⧸ P) = p := by
      rw [← Nat.card_eq_fintype_card]
      exact hcard
    let e := ZMod.ringEquivOfPrime (O2 ⧸ P) hp hcard'
    obtain ⟨t, ht⟩ := e.surjective (Ideal.Quotient.mk P sqrtTwoInteger)
    have ht2 : t ^ 2 = 2 := by
      apply e.injective
      rw [map_pow, ht, ← map_pow (Ideal.Quotient.mk P), sqrtTwoInteger_sq]
      simpa using (map_ofNat e 2).symm
    have hsq2 : IsSquare ((2 : ℕ) : ZMod p) := by
      rw [isSquare_iff_exists_sq]
      exact ⟨t, by simpa using ht2.symm⟩
    exact (ZMod.exists_sq_eq_two_iff (p := p) hp2).mp hsq2
  · intro hmod
    have hsq2 : IsSquare ((2 : ℕ) : ZMod p) :=
      (ZMod.exists_sq_eq_two_iff (p := p) hp2).mpr hmod
    rw [isSquare_iff_exists_sq] at hsq2
    obtain ⟨s, hs⟩ := hsq2
    set c : ℤ := (s.val : ℤ) with hcdef
    have hct : ((c : ℤ) : ZMod p) = s := by
      rw [hcdef]
      exact_mod_cast ZMod.natCast_rightInverse s
    have hdvd : (p : ℤ) ∣ 2 - c * c := by
      rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
      push_cast
      rw [hct]
      have hs' : s * s = 2 := by simpa [pow_two] using hs.symm
      linear_combination -hs'
    obtain ⟨k, hk⟩ := hdvd
    have hkO2 : (2 : O2) - (c : O2) * (c : O2) = ((p : ℕ) : O2) * (k : O2) := by
      have h := congrArg (fun n : ℤ => ((n : ℤ) : O2)) hk
      push_cast at h
      exact h
    have hprod : (sqrtTwoInteger - (c : O2)) * (sqrtTwoInteger + (c : O2)) =
        ((p : ℕ) : O2) * (k : O2) := by
      calc
        (sqrtTwoInteger - (c : O2)) * (sqrtTwoInteger + (c : O2)) =
            sqrtTwoInteger ^ 2 - (c : O2) * (c : O2) := by ring
        _ = (2 : O2) - (c : O2) * (c : O2) := by rw [sqrtTwoInteger_sq]
        _ = ((p : ℕ) : O2) * (k : O2) := hkO2
    set P := Ideal.span {((p : ℕ) : O2), sqrtTwoInteger - (c : O2)} with hPdef
    have hp_memP : ((p : ℕ) : O2) ∈ P := Ideal.subset_span (Set.mem_insert _ _)
    have hsc_memP : sqrtTwoInteger - (c : O2) ∈ P :=
      Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    have hPle : Ideal.span {((p : ℕ) : O2)} ≤ P :=
      (Ideal.span_singleton_le_iff_mem _).mpr hp_memP
    have hnorm : ∀ (I : Ideal O2), Ideal.span {((p : ℕ) : O2)} ≤ I →
        Ideal.absNorm I ≠ 1 → Ideal.absNorm I ≠ p ^ 2 → Ideal.absNorm I = p := by
      intro I hle h1 hpsq
      obtain ⟨j, hj, hjeq⟩ := (Nat.dvd_prime_pow hp).mp
        ((absNorm_span_natCast p) ▸ Ideal.absNorm_dvd_absNorm_of_le hle)
      interval_cases j
      · rw [pow_zero] at hjeq
        exact absurd hjeq h1
      · rw [pow_one] at hjeq
        exact hjeq
      · exact absurd hjeq hpsq
    have hPnot1 : Ideal.absNorm P ≠ 1 := by
      rw [Ne, Ideal.absNorm_eq_one_iff]
      intro htop
      have h1 : (1 : O2) ∈ P := htop ▸ Submodule.mem_top
      rw [hPdef, Ideal.mem_span_pair] at h1
      obtain ⟨α, β, hαβ⟩ := h1
      have hsc' : sqrtTwoInteger + (c : O2) ∈ Ideal.span {((p : ℕ) : O2)} := by
        rw [Ideal.mem_span_singleton]
        refine ⟨α * (sqrtTwoInteger + (c : O2)) + β * (k : O2), ?_⟩
        calc sqrtTwoInteger + (c : O2)
            = (α * ((p : ℕ) : O2) + β * (sqrtTwoInteger - (c : O2))) *
                (sqrtTwoInteger + (c : O2)) := by
              rw [hαβ, one_mul]
          _ = ((p : ℕ) : O2) *
                (α * (sqrtTwoInteger + (c : O2)) + β * (k : O2)) := by
              linear_combination β * hprod
      refine unit_sqrtTwo_coeff_not_mem p hp.two_le c 1 (Or.inl rfl) ?_
      rw [show ((c : ℤ) : O2) + ((1 : ℤ) : O2) * sqrtTwoInteger =
        sqrtTwoInteger + (c : O2) by
          push_cast
          ring]
      exact hsc'
    have hPnotsq : Ideal.absNorm P ≠ p ^ 2 := by
      intro hNP
      have heq := eq_of_le_of_absNorm_eq hPle (absNorm_span_natCast p) hNP
        (pow_ne_zero 2 hp.pos.ne')
      refine unit_sqrtTwo_coeff_not_mem p hp.two_le (-c) 1 (Or.inl rfl) ?_
      rw [show (((-c : ℤ) : O2) + ((1 : ℤ) : O2) * sqrtTwoInteger) =
        sqrtTwoInteger - (c : O2) by
          push_cast
          ring]
      rw [heq]
      exact hsc_memP
    have hNP : Ideal.absNorm P = p := hnorm P hPle hPnot1 hPnotsq
    have hPprime : P.IsPrime := by
      apply Ideal.isPrime_of_irreducible_absNorm
      rw [hNP]
      exact (Nat.irreducible_iff_nat_prime p).mpr hp
    exact ⟨P, hPprime, hPle, hNP⟩

/-- The quadratic splitting law for `ℚ(√2)`: an odd rational prime `p` splits into two
distinct primes iff `p ≡ ±1 (mod 8)` (i.e. iff `2` is a quadratic residue mod `p`, by the
second supplement to quadratic reciprocity), and is inert otherwise. -/
theorem splits_iff_pm_one_mod_eight (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) :
    (∃ P Q : Ideal O2, P.IsPrime ∧ Q.IsPrime ∧ P ≠ Q ∧
      Ideal.span {(p : O2)} = P * Q) ↔ p % 8 = 1 ∨ p % 8 = 7 := by
  constructor
  · rintro ⟨P, Q, hPprime, hQprime, hPQne, hspan⟩
    have hPle : Ideal.span {(p : O2)} ≤ P := by
      rw [hspan]
      exact Ideal.mul_le_right
    have hPnorm_dvd : Ideal.absNorm P ∣ p ^ 2 := by
      exact absNorm_span_natCast p ▸ Ideal.absNorm_dvd_absNorm_of_le hPle
    obtain ⟨k, hk2, hPnorm⟩ := (Nat.dvd_prime_pow hp).mp hPnorm_dvd
    have hk0 : k ≠ 0 := by
      intro h0
      rw [h0, pow_zero] at hPnorm
      exact hPprime.ne_top (Ideal.absNorm_eq_one_iff.mp hPnorm)
    have hmul := _root_.map_mul Ideal.absNorm P Q
    have hspan' : Ideal.span {((p : ℕ) : O2)} = P * Q := by
      simpa using hspan
    rw [← hspan', absNorm_span_natCast] at hmul
    have hQnorm_ne_one : Ideal.absNorm Q ≠ 1 := by
      rw [Ne, Ideal.absNorm_eq_one_iff]
      exact hQprime.ne_top
    have hPnorm_eq : Ideal.absNorm P = p := by
      interval_cases k
      · exact (hk0 rfl).elim
      · simpa using hPnorm
      · exfalso
        rw [hPnorm] at hmul
        have hQone : Ideal.absNorm Q = 1 :=
          (Nat.eq_of_mul_eq_mul_left (pow_pos hp.pos 2)
            (by rw [mul_one]; exact hmul)).symm
        exact hQnorm_ne_one hQone
    exact (exists_prime_norm_iff_pm_one_mod_eight p hp hp2).mp
      ⟨P, hPprime, hPle, hPnorm_eq⟩
  · intro hmod
    obtain ⟨P, hPprime, hPle, hPnorm⟩ :=
      (exists_prime_norm_iff_pm_one_mod_eight p hp hp2).mpr hmod
    obtain ⟨Q, hspan⟩ := Ideal.dvd_iff_le.mpr hPle
    have hQnorm : Ideal.absNorm Q = p := by
      have hmul := _root_.map_mul Ideal.absNorm P Q
      have hspan' : Ideal.span {((p : ℕ) : O2)} = P * Q := by
        simpa using hspan
      rw [← hspan', absNorm_span_natCast, hPnorm] at hmul
      rw [pow_two] at hmul
      exact Nat.eq_of_mul_eq_mul_left hp.pos hmul.symm
    have hQprime : Q.IsPrime := by
      apply Ideal.isPrime_of_irreducible_absNorm
      rw [hQnorm]
      exact (Nat.irreducible_iff_nat_prime p).mpr hp
    have hPQ : P ≠ Q := by
      intro h
      have hram : ∃ R : Ideal O2, R.IsPrime ∧ Ideal.span {(p : O2)} ≤ R ^ 2 := by
        refine ⟨P, hPprime, ?_⟩
        rw [hspan, h, sq]
      exact hp2 ((ramified_iff_eq_two p hp).mp hram)
    exact ⟨P, Q, hPprime, hQprime, hPQ, by simpa using hspan⟩

/-! ## 6. Ring of units -/

/-!
This Pell-theoretic unit analysis is genuinely specific to the real quadratic side.
There is no corresponding Pell section for `ℚ(ζ₃)`, which is imaginary quadratic.
-/

/-- The concrete quadratic order `ℤ[√2]` from mathlib's Pell API. -/
abbrev ZSqrtTwo : Type := Zsqrtd (2 : ℤ)

/-- The concrete `ℤ√2` model maps to the ring of integers by `√2 ↦ √2`. -/
abbrev zsqrtTwoToO2 : ZSqrtTwo →+* O2 :=
  Zsqrtd.lift ⟨sqrtTwoInteger, by simpa [sq] using sqrtTwoInteger_sq⟩

theorem zsqrtTwoToO2_apply (a b : ℤ) :
    zsqrtTwoToO2 (⟨a, b⟩ : ZSqrtTwo) =
      (a : O2) + b * sqrtTwoInteger := by
  simp [zsqrtTwoToO2]

theorem two_not_int_square : ∀ n : ℤ, (2 : ℤ) ≠ n * n := by
  intro n hn
  have hsquare : IsSquare (2 : ℤ) := ⟨n, hn⟩
  norm_num at hsquare

theorem zsqrtTwoToO2_injective : Function.Injective zsqrtTwoToO2 :=
  Zsqrtd.lift_injective
    ⟨sqrtTwoInteger, by simpa [sq] using sqrtTwoInteger_sq⟩
    two_not_int_square

theorem zsqrtTwoToO2_surjective : Function.Surjective zsqrtTwoToO2 := by
  intro x
  let a : ℤ := sqrtTwoExplicitIntegralBasis.repr x 0
  let b : ℤ := sqrtTwoExplicitIntegralBasis.repr x 1
  refine ⟨(⟨a, b⟩ : ZSqrtTwo), ?_⟩
  rw [zsqrtTwoToO2_apply]
  have hsum := sqrtTwoExplicitIntegralBasis.sum_repr x
  have h0 :
      sqrtTwoExplicitIntegralPowerBasis.basis
          ((finCongr sqrtTwoExplicitIntegralPowerBasis_dim).symm (0 : Fin 2)) =
        (1 : O2) := by
    simpa [sqrtTwoExplicitIntegralBasis, Basis.reindex_apply] using
      sqrtTwoExplicitIntegralBasis_zero
  have h1 :
      sqrtTwoExplicitIntegralPowerBasis.basis
          ((finCongr sqrtTwoExplicitIntegralPowerBasis_dim).symm (1 : Fin 2)) =
        sqrtTwoInteger := by
    simpa [sqrtTwoExplicitIntegralBasis, Basis.reindex_apply] using
      sqrtTwoExplicitIntegralBasis_one
  rw [show (a : O2) = (a : O2) * (1 : O2) by rw [mul_one]]
  rw [← h0, ← h1]
  simpa [a, b, Fin.sum_univ_two] using hsum

/-- The explicit ring equivalence `ℤ√2 ≃ 𝓞 ℚ(√2)`. -/
abbrev zsqrtTwoEquivO2 : ZSqrtTwo ≃+* O2 :=
  RingEquiv.ofBijective zsqrtTwoToO2
    ⟨zsqrtTwoToO2_injective, zsqrtTwoToO2_surjective⟩

/-- The unit `1 + √2` in the ring of integers. -/
abbrev sqrtTwoFundamentalUnit : O2ˣ where
  val := sqrtTwoInteger + 1
  inv := sqrtTwoInteger - 1
  val_inv := by
    ext
    calc
      (sqrtTwoRoot + 1) * (sqrtTwoRoot - 1) = sqrtTwoRoot ^ 2 - 1 := by ring
      _ = (1 : QSqrtTwo) := by rw [sqrtTwoRoot_sq]; ring
  inv_val := by
    ext
    calc
      (sqrtTwoRoot - 1) * (sqrtTwoRoot + 1) = sqrtTwoRoot ^ 2 - 1 := by ring
      _ = (1 : QSqrtTwo) := by rw [sqrtTwoRoot_sq]; ring

/-- The same unit `1 + √2`, but in mathlib's concrete `ℤ√2` model. -/
abbrev zsqrtTwoFundamentalUnit : ZSqrtTwoˣ where
  val := ⟨1, 1⟩
  inv := ⟨-1, 1⟩
  val_inv := by ext <;> norm_num
  inv_val := by ext <;> norm_num

theorem zsqrtTwoFundamentalUnit_norm :
    Zsqrtd.norm (zsqrtTwoFundamentalUnit : ZSqrtTwo) = -1 := by
  norm_num [zsqrtTwoFundamentalUnit, Zsqrtd.norm]

theorem zsqrtTwoEquivO2_fundamentalUnit :
    Units.mapEquiv zsqrtTwoEquivO2.toMulEquiv zsqrtTwoFundamentalUnit =
      sqrtTwoFundamentalUnit := by
  apply Units.ext
  change zsqrtTwoEquivO2 (⟨1, 1⟩ : ZSqrtTwo) = sqrtTwoInteger + 1
  change zsqrtTwoToO2 (⟨1, 1⟩ : ZSqrtTwo) = sqrtTwoInteger + 1
  rw [zsqrtTwoToO2_apply]
  ring

theorem zsqrtTwoEquivO2_unitsMap_neg (v : ZSqrtTwoˣ) :
    Units.mapEquiv zsqrtTwoEquivO2.toMulEquiv (-v) =
      -(Units.mapEquiv zsqrtTwoEquivO2.toMulEquiv v) := by
  apply Units.ext
  change zsqrtTwoEquivO2 (-(v : ZSqrtTwo)) =
    -zsqrtTwoEquivO2 (v : ZSqrtTwo)
  rw [map_neg]

/--
The square of `1 + √2` is `3 + 2√2`, a norm-one unit.
Mathlib's Pell API phrases "fundamental" for norm-one solutions, so this is
the Pell solution attached to the fundamental unit `1 + √2`.
-/
theorem sqrtTwoFundamentalUnit_sq :
    ((sqrtTwoFundamentalUnit ^ 2 : O2ˣ) : O2) =
      3 + 2 * sqrtTwoInteger := by
  ext
  calc
    (sqrtTwoRoot + 1) ^ 2 =
        sqrtTwoRoot ^ 2 + 2 * sqrtTwoRoot + 1 := by ring
    _ = (3 : QSqrtTwo) + 2 * sqrtTwoRoot := by rw [sqrtTwoRoot_sq]; ring

/-- The Pell solution `3 + 2√2`, i.e. `(1 + √2)^2`. -/
abbrev pellTwoFundamentalSolution : Pell.Solution₁ (2 : ℤ) :=
  Pell.Solution₁.mk 3 2 (by norm_num)

/--
`3 + 2√2` is the fundamental norm-one solution of Pell's equation
`x^2 - 2y^2 = 1`. Equivalently, the unit `1 + √2` is the usual fundamental
unit, with square equal to the fundamental positive norm-one unit.
-/
theorem pellTwoFundamentalSolution_isFundamental :
    Pell.IsFundamental pellTwoFundamentalSolution := by
  refine ⟨?_, ?_, ?_⟩
  · norm_num [pellTwoFundamentalSolution]
  · norm_num [pellTwoFundamentalSolution]
  · intro b hb
    by_contra hlt
    have hsmall : b.x < 3 := by
      have h := not_le.mp hlt
      simpa [pellTwoFundamentalSolution] using h
    have hx2 : b.x = 2 := by omega
    have hprop := b.prop
    rw [hx2] at hprop
    have hodd : 2 * b.y ^ 2 = 3 := by nlinarith
    omega

/-- Every norm-one Pell unit for `d = 2` is a signed power of `3 + 2√2`. -/
theorem pellTwoFundamentalSolution_generates_normOnePell
    (a : Pell.Solution₁ (2 : ℤ)) :
    ∃ n : ℤ, a = pellTwoFundamentalSolution ^ n ∨
      a = -pellTwoFundamentalSolution ^ n :=
  pellTwoFundamentalSolution_isFundamental.eq_zpow_or_neg_zpow a

theorem zsqrtTwoFundamentalUnit_sq_toPell :
    (Unitary.toUnits pellTwoFundamentalSolution : ZSqrtTwoˣ) =
      zsqrtTwoFundamentalUnit ^ 2 := by
  ext <;> norm_num [pellTwoFundamentalSolution, zsqrtTwoFundamentalUnit,
    pow_two]

theorem zsqrtTwo_normOneUnit_generated_by_square
    (u : ZSqrtTwoˣ) (hnorm : Zsqrtd.norm (u : ZSqrtTwo) = 1) :
    ∃ n : ℤ, u = zsqrtTwoFundamentalUnit ^ (2 * n) ∨
      u = -(zsqrtTwoFundamentalUnit ^ (2 * n)) := by
  let a : Pell.Solution₁ (2 : ℤ) :=
    ⟨(u : ZSqrtTwo), Zsqrtd.norm_eq_one_iff_mem_unitary.mp hnorm⟩
  have hua : u = Unitary.toUnits a := by
    apply Units.ext
    rfl
  obtain ⟨n, hn | hn⟩ := pellTwoFundamentalSolution_generates_normOnePell a
  · refine ⟨n, Or.inl ?_⟩
    calc
      u = Unitary.toUnits a := hua
      _ = Unitary.toUnits (pellTwoFundamentalSolution ^ n) := by rw [hn]
      _ = (Unitary.toUnits pellTwoFundamentalSolution : ZSqrtTwoˣ) ^ n := by
        exact (Unitary.toUnits : unitary ZSqrtTwo →* ZSqrtTwoˣ).map_zpow
          pellTwoFundamentalSolution n
      _ = (zsqrtTwoFundamentalUnit ^ 2) ^ n := by
        rw [zsqrtTwoFundamentalUnit_sq_toPell]
      _ = zsqrtTwoFundamentalUnit ^ (2 * n) :=
        (zpow_mul zsqrtTwoFundamentalUnit 2 n).symm
  · refine ⟨n, Or.inr ?_⟩
    calc
      u = Unitary.toUnits a := hua
      _ = Unitary.toUnits (-(pellTwoFundamentalSolution ^ n)) := by rw [hn]
      _ = -Unitary.toUnits (pellTwoFundamentalSolution ^ n) := by
        apply Units.ext
        rfl
      _ = -((Unitary.toUnits pellTwoFundamentalSolution : ZSqrtTwoˣ) ^ n) := by
        have hpow :
            Unitary.toUnits (pellTwoFundamentalSolution ^ n) =
              (Unitary.toUnits pellTwoFundamentalSolution : ZSqrtTwoˣ) ^ n :=
          (Unitary.toUnits : unitary ZSqrtTwo →* ZSqrtTwoˣ).map_zpow
            pellTwoFundamentalSolution n
        rw [hpow]
      _ = -(zsqrtTwoFundamentalUnit ^ (2 * n)) := by
        rw [zsqrtTwoFundamentalUnit_sq_toPell]
        exact congrArg Neg.neg
          (zpow_mul zsqrtTwoFundamentalUnit 2 n).symm

/-- Every unit of `ℤ√2` is a signed power of `1 + √2`. -/
theorem zsqrtTwo_units_generated_by_fundamental (u : ZSqrtTwoˣ) :
    ∃ n : ℤ, u = zsqrtTwoFundamentalUnit ^ n ∨
      u = -(zsqrtTwoFundamentalUnit ^ n) := by
  have hnormUnit : IsUnit (Zsqrtd.norm (u : ZSqrtTwo)) :=
    (Zsqrtd.isUnit_iff_norm_isUnit (u : ZSqrtTwo)).mp u.isUnit
  rcases Int.isUnit_eq_one_or hnormUnit with hnorm | hnorm
  · obtain ⟨n, hn | hn⟩ :=
      zsqrtTwo_normOneUnit_generated_by_square u hnorm
    · exact ⟨2 * n, Or.inl hn⟩
    · exact ⟨2 * n, Or.inr hn⟩
  · have hmulnorm :
        Zsqrtd.norm ((u * zsqrtTwoFundamentalUnit : ZSqrtTwoˣ) :
          ZSqrtTwo) = 1 := by
      rw [Units.val_mul, Zsqrtd.norm_mul, hnorm,
        zsqrtTwoFundamentalUnit_norm]
      norm_num
    obtain ⟨n, hn | hn⟩ :=
      zsqrtTwo_normOneUnit_generated_by_square
        (u * zsqrtTwoFundamentalUnit) hmulnorm
    · refine ⟨2 * n - 1, Or.inl ?_⟩
      calc
        u = (u * zsqrtTwoFundamentalUnit) *
            zsqrtTwoFundamentalUnit⁻¹ := by group
        _ = (zsqrtTwoFundamentalUnit ^ (2 * n)) *
            zsqrtTwoFundamentalUnit⁻¹ := by rw [hn]
        _ = zsqrtTwoFundamentalUnit ^ (2 * n - 1) := by
          rw [← zpow_neg_one zsqrtTwoFundamentalUnit, ← zpow_add]
          ring_nf
    · refine ⟨2 * n - 1, Or.inr ?_⟩
      calc
        u = (u * zsqrtTwoFundamentalUnit) *
            zsqrtTwoFundamentalUnit⁻¹ := by group
        _ = (-(zsqrtTwoFundamentalUnit ^ (2 * n))) *
            zsqrtTwoFundamentalUnit⁻¹ := by rw [hn]
        _ = -(zsqrtTwoFundamentalUnit ^ (2 * n - 1)) := by
          rw [neg_mul, ← zpow_neg_one zsqrtTwoFundamentalUnit, ← zpow_add]
          ring_nf

/-- Every unit of `𝓞 ℚ(√2)` is a signed power of the unit `1 + √2`. -/
theorem sqrtTwoFundamentalUnit_generates_unitGroup (u : O2ˣ) :
    ∃ n : ℤ, u = sqrtTwoFundamentalUnit ^ n ∨
      u = -(sqrtTwoFundamentalUnit ^ n) := by
  let e : ZSqrtTwoˣ ≃* O2ˣ :=
    Units.mapEquiv zsqrtTwoEquivO2.toMulEquiv
  obtain ⟨n, hn | hn⟩ :=
    zsqrtTwo_units_generated_by_fundamental (e.symm u)
  · refine ⟨n, Or.inl ?_⟩
    calc
      u = e (e.symm u) := (e.apply_symm_apply u).symm
      _ = e (zsqrtTwoFundamentalUnit ^ n) := by rw [hn]
      _ = e zsqrtTwoFundamentalUnit ^ n := by
        exact map_zpow e zsqrtTwoFundamentalUnit n
      _ = sqrtTwoFundamentalUnit ^ n := by
        rw [zsqrtTwoEquivO2_fundamentalUnit]
  · refine ⟨n, Or.inr ?_⟩
    calc
      u = e (e.symm u) := (e.apply_symm_apply u).symm
      _ = e (-(zsqrtTwoFundamentalUnit ^ n)) := by rw [hn]
      _ = -(e (zsqrtTwoFundamentalUnit ^ n)) := by
        exact zsqrtTwoEquivO2_unitsMap_neg (zsqrtTwoFundamentalUnit ^ n)
      _ = -(e zsqrtTwoFundamentalUnit ^ n) := by
        rw [map_zpow e zsqrtTwoFundamentalUnit n]
      _ = -(sqrtTwoFundamentalUnit ^ n) := by
        rw [zsqrtTwoEquivO2_fundamentalUnit]

/-- The field `ℚ(√2)` has no complex infinite places. -/
theorem sqrtTwo_nrComplexPlaces :
    NumberField.InfinitePlace.nrComplexPlaces QSqrtTwo = 0 := by
  have hfin : Module.finrank ℚ QSqrtTwo = 2 := by
    rw [PowerBasis.finrank sqrtTwoPowerBasis]
    exact sqrtTwoPowerBasis_dim
  have hsig := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank (K := QSqrtTwo)
  rw [hfin] at hsig
  have hsign := NumberField.sign_discr (K := QSqrtTwo)
  rw [sqrtTwo_numberField_discr] at hsign
  have hnle : NumberField.InfinitePlace.nrComplexPlaces QSqrtTwo ≤ 1 := by omega
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hnle with hn | hn
  · exact hn
  · rw [hn] at hsign
    norm_num at hsign

/-- The field `ℚ(√2)` has two real infinite places. -/
theorem sqrtTwo_nrRealPlaces :
    NumberField.InfinitePlace.nrRealPlaces QSqrtTwo = 2 := by
  have hfin : Module.finrank ℚ QSqrtTwo = 2 := by
    rw [PowerBasis.finrank sqrtTwoPowerBasis]
    exact sqrtTwoPowerBasis_dim
  have hsig := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank (K := QSqrtTwo)
  rw [hfin, sqrtTwo_nrComplexPlaces] at hsig
  omega

/-- The only torsion units in `𝓞 ℚ(√2)` are `±1`. -/
theorem sqrtTwo_torsion_eq_one_or_neg_one
    (x : Units.torsion QSqrtTwo) : (x : O2ˣ) = 1 ∨ (x : O2ˣ) = -1 := by
  by_cases! hc : 2 < orderOf (x : O2ˣ)
  · have horder :
        orderOf ((x : O2ˣ) : QSqrtTwo) = orderOf (x : O2ˣ) := by
      simpa using
        (orderOf_injective
          ((Units.coeHom QSqrtTwo).comp (Units.map (algebraMap O2 QSqrtTwo)))
          (by
            intro u v huv
            exact NumberField.Units.coe_injective (K := QSqrtTwo) huv)
          (x : O2ˣ))
    have hcK : 2 < orderOf ((x : O2ˣ) : QSqrtTwo) := by
      rwa [horder]
    linarith [
      NumberField.InfinitePlace.IsPrimitiveRoot.nrRealPlaces_eq_zero_of_two_lt hcK
        (IsPrimitiveRoot.orderOf ((x : O2ˣ) : QSqrtTwo)),
      show 0 < NumberField.InfinitePlace.nrRealPlaces QSqrtTwo by
        rw [sqrtTwo_nrRealPlaces]
        norm_num]
  · interval_cases hi : orderOf (x : O2ˣ)
    · linarith [orderOf_pos_iff.2 ((CommGroup.mem_torsion x.1).1 x.2)]
    · exact Or.inl (orderOf_eq_one_iff.1 hi)
    · rw [← orderOf_units, CharP.orderOf_eq_two_iff 0 (by decide)] at hi
      simp [← Units.val_inj, Units.val_neg, Units.val_one, hi]

/-- The torsion subgroup of `𝓞 ℚ(√2)` has order `2`. -/
theorem sqrtTwo_units_torsionOrder :
    Units.torsionOrder QSqrtTwo = 2 := by
  classical
  refine (Finset.card_eq_two.2 ⟨1, ⟨-1, neg_one_mem_torsion⟩,
    by simp [← Subtype.coe_ne_coe], Finset.ext fun x ↦ ⟨fun _ ↦ ?_, fun _ ↦ Finset.mem_univ _⟩⟩)
  rw [Finset.mem_insert, Finset.mem_singleton, ← Subtype.val_inj, ← Subtype.val_inj]
  exact sqrtTwo_torsion_eq_one_or_neg_one x

/-- Dirichlet's unit rank is `1` for this real quadratic field. -/
theorem sqrtTwo_units_rank :
    Units.rank QSqrtTwo = 1 := by
  dsimp [Units.rank]
  rw [NumberField.InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces,
    sqrtTwo_nrRealPlaces, sqrtTwo_nrComplexPlaces]

example : Units.torsionOrder QSqrtTwo = 2 :=
  sqrtTwo_units_torsionOrder

example : Units.rank QSqrtTwo = 1 :=
  sqrtTwo_units_rank

/-- The regulator of `ℚ(√2)` is `log(1 + √2) ≈ 0.8814`, the covolume of the unit lattice.
This is the analytic restatement that `1 + √2` is a fundamental unit. -/
theorem regulator_eq : Units.regulator QSqrtTwo = Real.log (1 + Real.sqrt 2) := by
  sorry

/-- The unit group is `μ₂ × ℤ` as an abstract abelian group. -/
theorem unitGroupStructure :
    Nonempty (O2ˣ ≃* (Multiplicative (ZMod 2) × Multiplicative (Fin 1 → ℤ))) := by
  sorry

/-! ## 7. Class group -/

example : Fintype (ClassGroup O2) := by infer_instance

example (C : ClassGroup O2) : ∃ I : (Ideal O2)⁰, ClassGroup.mk0 I = C :=
  ClassGroup.mk0_surjective C

abbrev trivialFractionalIdealSqrtTwo : (FractionalIdeal O2⁰ QSqrtTwo)ˣ :=
  1

example : 0 < mixedEmbedding.minkowskiBound QSqrtTwo trivialFractionalIdealSqrtTwo :=
  mixedEmbedding.minkowskiBound_pos QSqrtTwo trivialFractionalIdealSqrtTwo

example : mixedEmbedding.minkowskiBound QSqrtTwo trivialFractionalIdealSqrtTwo < ⊤ :=
  mixedEmbedding.minkowskiBound_lt_top QSqrtTwo trivialFractionalIdealSqrtTwo

theorem sqrtTwo_ringOfIntegers_isPrincipalIdealRing :
    IsPrincipalIdealRing O2 := by
  apply RingOfIntegers.isPrincipalIdealRing_of_abs_discr_lt
  rw [sqrtTwo_numberField_discr]
  have hfin : Module.finrank ℚ QSqrtTwo = 2 := by
    rw [PowerBasis.finrank sqrtTwoPowerBasis]
    exact sqrtTwoPowerBasis_dim
  rw [hfin]
  have hsig := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank (K := QSqrtTwo)
  rw [hfin] at hsig
  have hnle : NumberField.InfinitePlace.nrComplexPlaces QSqrtTwo ≤ 1 := by omega
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hnle with hn | hn
  · rw [hn]
    norm_num
  · rw [hn]
    ring_nf
    nlinarith [Real.pi_gt_three]

theorem sqrtTwo_numberField_classNumber :
    NumberField.classNumber QSqrtTwo = 1 :=
  NumberField.classNumber_eq_one_iff.mpr sqrtTwo_ringOfIntegers_isPrincipalIdealRing

/-- The class group of `𝓞 ℚ(√2)` is trivial. -/
theorem classGroupStructure : Nonempty (ClassGroup O2 ≃* Multiplicative (ZMod 1)) := by
  classical
  have hcard : Fintype.card (ClassGroup O2) = 1 := by
    simpa [NumberField.classNumber] using sqrtTwo_numberField_classNumber
  haveI : Subsingleton (ClassGroup O2) :=
    Fintype.card_le_one_iff_subsingleton.mp (by omega)
  exact ⟨MulEquiv.ofBijective (1 : ClassGroup O2 →* Multiplicative (ZMod 1)) (by
    constructor
    · intro a b h
      exact Subsingleton.elim _ _
    · intro y
      exact ⟨1, Subsingleton.elim _ _⟩)⟩

/-- The unit ideal as the concrete representative of the unique ideal class. -/
abbrev unitIdealRepresentative : (Ideal O2)⁰ := ⟨(⊤ : Ideal O2), by simp⟩

/-- Every ideal class is represented by the unit ideal. -/
theorem classGroupRepresentative (C : ClassGroup O2) :
    C = ClassGroup.mk0 unitIdealRepresentative := by
  classical
  have hcard : Fintype.card (ClassGroup O2) = 1 := by
    simpa [NumberField.classNumber] using sqrtTwo_numberField_classNumber
  haveI : Subsingleton (ClassGroup O2) :=
    Fintype.card_le_one_iff_subsingleton.mp (by omega)
  exact Subsingleton.elim _ _

/-! ## 8. Euclidean structure -/

/-- `ℚ(√2)` is norm-Euclidean: division with remainder in `ℤ[√2]` with respect to the
absolute value of the field norm. This is the classical Euclidean algorithm for the real
quadratic field of smallest discriminant, and strengthens
`sqrtTwo_ringOfIntegers_isPrincipalIdealRing`. -/
theorem normEuclidean (a b : O2) (hb : b ≠ 0) :
    ∃ q r : O2, a = b * q + r ∧
      (Algebra.norm ℤ r).natAbs < (Algebra.norm ℤ b).natAbs := by
  sorry

/-! ## 9. Galois group -/

/-- The nontrivial conjugation automorphism sends `√2` to `-√2`. -/
def sqrtTwoConjHom : QSqrtTwo →ₐ[ℚ] QSqrtTwo :=
  AdjoinRoot.liftAlgHom sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwo)
    (-sqrtTwoRoot) (by
      calc
        sqrtTwoPolynomial.eval₂ (Algebra.ofId ℚ QSqrtTwo) (-sqrtTwoRoot)
            = (-sqrtTwoRoot) ^ 2 - 2 := by
              simp [sqrtTwoPolynomial]
        _ = sqrtTwoRoot ^ 2 - 2 := by ring
        _ = 0 := by rw [sqrtTwoRoot_sq]; ring)

@[simp]
theorem sqrtTwoConjHom_root : sqrtTwoConjHom sqrtTwoRoot = -sqrtTwoRoot := by
  change sqrtTwoConjHom (AdjoinRoot.root sqrtTwoPolynomial) = -sqrtTwoRoot
  rw [sqrtTwoConjHom]
  exact AdjoinRoot.liftAlgHom_root sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwo)
    (-sqrtTwoRoot) _

/-- The conjugation map is an involutive `ℚ`-algebra equivalence. -/
def sqrtTwoConj : QSqrtTwo ≃ₐ[ℚ] QSqrtTwo where
  __ := sqrtTwoConjHom
  invFun := sqrtTwoConjHom
  left_inv x := by
    have hcomp : sqrtTwoConjHom.comp sqrtTwoConjHom = AlgHom.id ℚ QSqrtTwo := by
      apply AdjoinRoot.algHom_ext
      change sqrtTwoConjHom (sqrtTwoConjHom sqrtTwoRoot) = sqrtTwoRoot
      rw [sqrtTwoConjHom_root]
      simp only [map_neg, sqrtTwoConjHom_root, neg_neg]
    change (sqrtTwoConjHom.comp sqrtTwoConjHom) x = (AlgHom.id ℚ QSqrtTwo) x
    rw [hcomp]
  right_inv x := by
    have hcomp : sqrtTwoConjHom.comp sqrtTwoConjHom = AlgHom.id ℚ QSqrtTwo := by
      apply AdjoinRoot.algHom_ext
      change sqrtTwoConjHom (sqrtTwoConjHom sqrtTwoRoot) = sqrtTwoRoot
      rw [sqrtTwoConjHom_root]
      simp only [map_neg, sqrtTwoConjHom_root, neg_neg]
    change (sqrtTwoConjHom.comp sqrtTwoConjHom) x = (AlgHom.id ℚ QSqrtTwo) x
    rw [hcomp]

example : sqrtTwoConj sqrtTwoRoot = -sqrtTwoRoot :=
  sqrtTwoConjHom_root

example : IsGalois ℚ QSqrtTwo := by infer_instance

theorem sqrtTwo_gal_eq_id_or_conj (σ : Gal(QSqrtTwo/ℚ)) :
    σ = 1 ∨ σ = sqrtTwoConj := by
  have hsq : (σ sqrtTwoRoot) ^ 2 = (2 : QSqrtTwo) := by
    rw [← map_pow, sqrtTwoRoot_sq]
    change σ (algebraMap ℚ QSqrtTwo (2 : ℚ)) = algebraMap ℚ QSqrtTwo (2 : ℚ)
    exact σ.commutes 2
  have hfactor : (σ sqrtTwoRoot - sqrtTwoRoot) * (σ sqrtTwoRoot + sqrtTwoRoot) = 0 := by
    calc
      (σ sqrtTwoRoot - sqrtTwoRoot) * (σ sqrtTwoRoot + sqrtTwoRoot) =
          (σ sqrtTwoRoot) ^ 2 - sqrtTwoRoot ^ 2 := by ring
      _ = 2 - 2 := by rw [hsq, sqrtTwoRoot_sq]
      _ = 0 := by norm_num
  rcases mul_eq_zero.mp hfactor with h | h
  · left
    have hσ : (σ : QSqrtTwo →ₐ[ℚ] QSqrtTwo) = AlgHom.id ℚ QSqrtTwo := by
      apply AdjoinRoot.algHom_ext
      change σ sqrtTwoRoot = sqrtTwoRoot
      exact sub_eq_zero.mp h
    ext x
    change (σ : QSqrtTwo →ₐ[ℚ] QSqrtTwo) x = (AlgHom.id ℚ QSqrtTwo) x
    rw [hσ]
  · right
    have hσ : (σ : QSqrtTwo →ₐ[ℚ] QSqrtTwo) = sqrtTwoConj.toAlgHom := by
      apply AdjoinRoot.algHom_ext
      calc
        σ sqrtTwoRoot = -sqrtTwoRoot := eq_neg_iff_add_eq_zero.mpr h
        _ = sqrtTwoConj sqrtTwoRoot := by
          change -sqrtTwoRoot = sqrtTwoConjHom sqrtTwoRoot
          exact sqrtTwoConjHom_root.symm
    ext x
    change (σ : QSqrtTwo →ₐ[ℚ] QSqrtTwo) x = sqrtTwoConj.toAlgHom x
    rw [hσ]

/-- The conjugation automorphism is the nontrivial element of the Galois group. -/
theorem sqrtTwoConj_ne_one : sqrtTwoConj ≠ (1 : Gal(QSqrtTwo/ℚ)) := by
  intro h
  have hroot : -sqrtTwoRoot = sqrtTwoRoot := by
    calc
      -sqrtTwoRoot = sqrtTwoConj sqrtTwoRoot := sqrtTwoConjHom_root.symm
      _ = (1 : Gal(QSqrtTwo/ℚ)) sqrtTwoRoot := by rw [h]
      _ = sqrtTwoRoot := rfl
  have hzero : sqrtTwoRoot = 0 := by
    have hmul : (2 : QSqrtTwo) * sqrtTwoRoot = 0 := by
      calc
        (2 : QSqrtTwo) * sqrtTwoRoot = sqrtTwoRoot + sqrtTwoRoot := by ring
        _ = -sqrtTwoRoot + sqrtTwoRoot := by rw [hroot]
        _ = 0 := by ring
    have htwo : (2 : QSqrtTwo) ≠ 0 := by norm_num
    exact (mul_eq_zero.mp hmul).resolve_left htwo
  have htwo_zero : (2 : QSqrtTwo) = 0 := by
    rw [← sqrtTwoRoot_sq, hzero]
    ring
  norm_num at htwo_zero

/-- The Galois group of `ℚ(√2)/ℚ` has order `2`. -/
theorem sqrtTwo_gal_natCard : Nat.card (Gal(QSqrtTwo/ℚ)) = 2 := by
  rw [Nat.card_eq_two_iff]
  refine ⟨(1 : Gal(QSqrtTwo/ℚ)), sqrtTwoConj, ?_, ?_⟩
  · exact sqrtTwoConj_ne_one.symm
  · ext σ
    simp [sqrtTwo_gal_eq_id_or_conj σ]

theorem sqrtTwo_gal_card : Fintype.card (Gal(QSqrtTwo/ℚ)) = 2 := by
  rw [Fintype.card_eq_nat_card]
  exact sqrtTwo_gal_natCard

/-- The Galois group of `ℚ(√2)/ℚ` is cyclic, generated by conjugation. -/
theorem sqrtTwo_gal_isCyclic : IsCyclic (Gal(QSqrtTwo/ℚ)) := by
  exact isCyclic_of_prime_card sqrtTwo_gal_natCard

example : IsCyclic (Gal(QSqrtTwo/ℚ)) ∧ Fintype.card (Gal(QSqrtTwo/ℚ)) = 2 :=
  ⟨sqrtTwo_gal_isCyclic, sqrtTwo_gal_card⟩

/-- The concrete multiplicative cyclic group of order `2`. -/
abbrev CyclicTwo : Type := Multiplicative (ZMod 2)

/-- In additive notation, the Galois group is generated by conjugation. -/
theorem sqrtTwoGal_additive_generator :
    ∀ σ : Additive (Gal(QSqrtTwo/ℚ)),
      σ ∈ AddSubgroup.zmultiples (Additive.ofMul sqrtTwoConj) := by
  intro σ
  rcases sqrtTwo_gal_eq_id_or_conj σ.toMul with h | h
  · rw [← ofMul_toMul σ, h]
    exact ⟨0, by simp⟩
  · rw [← ofMul_toMul σ, h]
    exact ⟨1, by simp⟩

/--
The explicit isomorphism from the concrete cyclic group of order `2` to the Galois
group, sending the nonzero class of `ZMod 2` to conjugation.
-/
noncomputable abbrev cyclicTwoEquivSqrtTwoGal : CyclicTwo ≃* Gal(QSqrtTwo/ℚ) :=
  AddEquiv.toMultiplicativeLeft <|
    zmodAddEquivOfGenerator sqrtTwoGal_additive_generator sqrtTwo_gal_natCard

/-- The Galois group of `ℚ(√2)/ℚ` is explicitly `C₂`. -/
noncomputable abbrev sqrtTwoGalEquivCyclicTwo : Gal(QSqrtTwo/ℚ) ≃* CyclicTwo :=
  cyclicTwoEquivSqrtTwoGal.symm

@[simp]
theorem cyclicTwoEquivSqrtTwoGal_one :
    cyclicTwoEquivSqrtTwoGal (Multiplicative.ofAdd (1 : ZMod 2)) = sqrtTwoConj := by
  change (zmodAddEquivOfGenerator sqrtTwoGal_additive_generator sqrtTwo_gal_natCard
      (1 : ZMod 2)).toMul = sqrtTwoConj
  simp

@[simp]
theorem sqrtTwoGalEquivCyclicTwo_conj :
    sqrtTwoGalEquivCyclicTwo sqrtTwoConj = Multiplicative.ofAdd (1 : ZMod 2) := by
  rw [← cyclicTwoEquivSqrtTwoGal_one]
  exact cyclicTwoEquivSqrtTwoGal.symm_apply_apply (Multiplicative.ofAdd (1 : ZMod 2))

end XYin.NumberField.SqrtTwo
