import XYin.NumberField.FieldExamples.CyclotomicFive.PrimeSplitting

noncomputable section

open Module Polynomial
open scoped NumberField nonZeroDivisors

namespace NumberField.CyclotomicFive

private theorem coe_zetaInt : algebraMap (𝓞 K) K zetaInt = ζ := rfl

/-! ## 6. Ring of units -/

/-- A torsion generator of `𝓞 Kˣ`: the primitive tenth root of unity `-ζ`, with explicit
inverse `-ζ⁴` (since `(-ζ)(-ζ⁴) = ζ⁵ = 1`). -/
noncomputable def torsionGenerator : (𝓞 K)ˣ where
  val := -zetaInt
  inv := -zetaInt ^ 4
  val_inv := by linear_combination zetaInt_pow_five
  inv_val := by linear_combination zetaInt_pow_five

/-- The concrete torsion units: the ten roots of unity `(-ζ)^k = ±ζ^j`. -/
def torsionUnits : Set ((𝓞 K)ˣ) := {u | ∃ k : Fin 10, u = torsionGenerator ^ k.val}

/-- The torsion subgroup of `𝓞 Kˣ` is exactly `μ₁₀ = {±ζ^j}`, generated by `-ζ`. -/
private theorem torsionOrder_eq' : NumberField.Units.torsionOrder K = 10 := by
  rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := 5), if_neg (by decide : ¬ Even (5 : ℕ))]

private theorem neg_zeta_isPrimitiveRoot : IsPrimitiveRoot (-ζ : K) 10 := by
  have horderζ : orderOf ζ = 5 := zeta_isPrimitiveRoot.eq_orderOf.symm
  have horderm1 : orderOf (-1 : K) = 2 := by
    rw [orderOf_neg_one, ringChar.eq_zero]
    norm_num
  have horder10 : orderOf (-ζ : K) = 10 := by
    rw [show (-ζ : K) = (-1 : K) * ζ from by ring,
      (Commute.all (-1 : K) ζ).orderOf_mul_eq_mul_orderOf_of_coprime
        (by rw [horderm1, horderζ]; norm_num),
      horderm1, horderζ]
  exact horder10 ▸ IsPrimitiveRoot.orderOf (-ζ : K)

theorem torsionUnits_eq : {u : (𝓞 K)ˣ | IsOfFinOrder u} = torsionUnits := by
  have htg10 : torsionGenerator ^ 10 = 1 := by
    have hK : ((-ζ : K)) ^ 10 = 1 := by
      linear_combination (ζ ^ 5 + 1) * zeta_pow_five
    ext
    exact hK
  ext u
  constructor
  · intro hu
    have humem : u ∈ NumberField.Units.torsion K := hu
    rw [← NumberField.Units.rootsOfUnity_eq_torsion K, torsionOrder_eq'] at humem
    have h10 : u ^ 10 = 1 := humem
    have hK : (algebraMap (𝓞 K) K ((u : (𝓞 K)ˣ) : 𝓞 K)) ^ 10 = 1 := by
      have hval : ((u ^ 10 : (𝓞 K)ˣ) : 𝓞 K) = ((1 : (𝓞 K)ˣ) : 𝓞 K) := by rw [h10]
      rw [Units.val_pow_eq_pow_val, Units.val_one] at hval
      rw [← map_pow, hval, map_one]
    obtain ⟨i, hi, hieq⟩ := neg_zeta_isPrimitiveRoot.eq_pow_of_pow_eq_one hK
    refine ⟨⟨i, hi⟩, Units.ext (IsFractionRing.injective (𝓞 K) K ?_)⟩
    rw [← hieq]
    change (-ζ : K) ^ i = algebraMap (𝓞 K) K ((torsionGenerator ^ i : (𝓞 K)ˣ) : 𝓞 K)
    rw [Units.val_pow_eq_pow_val, map_pow]
    rfl
  · rintro ⟨k, rfl⟩
    refine isOfFinOrder_iff_pow_eq_one.mpr ⟨10, by norm_num, ?_⟩
    rw [← pow_mul, mul_comm, pow_mul, htg10, one_pow]

/-- The torsion subgroup of `𝓞 Kˣ` has order `10` — the largest `m` with `φ(m) ∣ 4` and
`ℚ(ζₘ) ⊆ ℚ(ζ₅)`. -/
theorem torsionOrder_eq_ten : NumberField.Units.torsionOrder K = 10 :=
  torsionOrder_eq'

/-- `ℚ(ζ₅)` is totally complex: the signature is `(0, 2)`. -/
theorem isTotallyComplex : NumberField.IsTotallyComplex K :=
  IsCyclotomicExtension.Rat.isTotallyComplex (n := 5) K (by norm_num)

/-- `ℚ(ζ₅)` has no real infinite places. -/
theorem nrRealPlaces_eq_zero : NumberField.InfinitePlace.nrRealPlaces K = 0 :=
  IsCyclotomicExtension.Rat.nrRealPlaces_eq_zero (n := 5) K (by norm_num)

/-- `ℚ(ζ₅)` has exactly two (conjugate pairs of) complex places. -/
theorem nrComplexPlaces_eq_two : NumberField.InfinitePlace.nrComplexPlaces K = 2 := by
  have h := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
  rw [nrRealPlaces_eq_zero, degree_eq_four] at h
  omega

/-- The Dirichlet unit rank of `ℚ(ζ₅)` is `1`: the signature is `(0, 2)`, so the rank is
`r₁ + r₂ - 1 = 1`. -/
theorem unitRank_eq_one : NumberField.Units.rank K = 1 := by
  rw [NumberField.Units.rank, NumberField.InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces,
    nrRealPlaces_eq_zero, nrComplexPlaces_eq_two]

/-- The fundamental unit of `𝓞 K`: the cyclotomic unit `1 + ζ`, with explicit inverse
`-(ζ + ζ³)` (from `(1 + ζ)(ζ + ζ³) = ζ + ζ² + ζ³ + ζ⁴ = -1`). -/
noncomputable def fundamentalUnit : (𝓞 K)ˣ where
  val := 1 + zetaInt
  inv := -(zetaInt + zetaInt ^ 3)
  val_inv := by linear_combination -zetaInt_sum_eq_zero
  inv_val := by linear_combination -zetaInt_sum_eq_zero

/-- The system of fundamental units for the rank-`1` unit group: the single unit `1 + ζ`. -/
noncomputable def fundamentalUnitSystem : Fin (NumberField.Units.rank K) → (𝓞 K)ˣ :=
  fun _ => fundamentalUnit

/-- Mathlib's abstract fundamental unit `fundSystem K i₀`, together with the torsion, generates
the whole unit group (rank-one specialization of `closure_fundSystem_sup_torsion_eq_top`). -/
private theorem exists_eq_torsion_mul_fundSystem_zpow (i₀ : Fin (NumberField.Units.rank K))
    (u : (𝓞 K)ˣ) :
    ∃ ζ' ∈ NumberField.Units.torsion K, ∃ n : ℤ,
      u = ζ' * NumberField.Units.fundSystem K i₀ ^ n := by
  haveI hsub : Subsingleton (Fin (NumberField.Units.rank K)) :=
    Fin.subsingleton_iff_le_one.mpr (by rw [unitRank_eq_one])
  have hu : u ∈ Subgroup.closure (Set.range (NumberField.Units.fundSystem K)) ⊔
      NumberField.Units.torsion K := by
    rw [NumberField.Units.closure_fundSystem_sup_torsion_eq_top]; trivial
  rw [Subgroup.mem_sup] at hu
  obtain ⟨x, hx, y, hy, hxy⟩ := hu
  have hrange : Set.range (NumberField.Units.fundSystem K) =
      {NumberField.Units.fundSystem K i₀} := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩
      rw [Subsingleton.elim i i₀]
      rfl
    · rintro rfl
      exact ⟨i₀, rfl⟩
  rw [hrange, Subgroup.mem_closure_singleton] at hx
  obtain ⟨n, hn⟩ := hx
  exact ⟨y, hy, n, by rw [hn, ← hxy]; exact mul_comm x y⟩

/-- A power of the abstract fundamental unit is torsion only for exponent zero. -/
private theorem fundSystem_zpow_mem_torsion (i₀ : Fin (NumberField.Units.rank K)) (n : ℤ)
    (hn : NumberField.Units.fundSystem K i₀ ^ n ∈ NumberField.Units.torsion K) : n = 0 := by
  have hq : Additive.ofMul ((QuotientGroup.mk ((NumberField.Units.fundSystem K i₀) ^ n) :
      (𝓞 K)ˣ ⧸ NumberField.Units.torsion K)) = 0 := by
    rw [ofMul_eq_zero]
    exact (QuotientGroup.eq_one_iff ((NumberField.Units.fundSystem K i₀) ^ n)).mpr hn
  rw [QuotientGroup.mk_zpow, ofMul_zpow, NumberField.Units.fundSystem_mk] at hq
  letI : Module ℤ (Additive ((𝓞 K)ˣ ⧸ NumberField.Units.torsion K)) :=
    AddCommGroup.toIntModule (Additive ((𝓞 K)ˣ ⧸ NumberField.Units.torsion K))
  have hrepr := congrArg
    (fun x : Additive ((𝓞 K)ˣ ⧸ NumberField.Units.torsion K) =>
      ((NumberField.Units.basisModTorsion K).repr x) i₀) hq
  simpa [Module.Basis.repr_self, Module.Basis.repr_self_apply] using hrepr

/-- Pointwise classification of the torsion: every torsion unit is a power of `-ζ`. -/
private theorem eq_torsionGenerator_pow_of_mem_torsion {ζ' : (𝓞 K)ˣ}
    (hζ' : ζ' ∈ NumberField.Units.torsion K) : ∃ k : Fin 10, ζ' = torsionGenerator ^ k.val := by
  have hfin : IsOfFinOrder ζ' := hζ'
  have hmem : ζ' ∈ {u : (𝓞 K)ˣ | IsOfFinOrder u} := hfin
  rw [torsionUnits_eq] at hmem
  exact hmem

/-- The displayed family is a system of fundamental units: together with the roots of unity
`μ₁₀`, the cyclotomic unit `1 + ζ` generates all units of `ℤ[ζ]` (an instance of the index
formula `[𝓞ˣ : cyclotomic units] = h⁺ = 1`). -/
theorem fundamentalUnitSystem_isFundamental :
    Subgroup.closure (Set.range fundamentalUnitSystem) ⊔ NumberField.Units.torsion K = ⊤ := by
  sorry

/-- Equivalently, every unit of `ℤ[ζ]` is `±ζ^j (1 + ζ)ⁿ`. -/
theorem unit_eq_torsion_mul_fundamentalUnit_zpow (u : (𝓞 K)ˣ) :
    ∃ ζ' : (𝓞 K)ˣ, ζ' ∈ NumberField.Units.torsion K ∧ ∃ n : ℤ, u = ζ' * fundamentalUnit ^ n := by
  have hu : u ∈ Subgroup.closure (Set.range fundamentalUnitSystem) ⊔
      NumberField.Units.torsion K := by
    rw [fundamentalUnitSystem_isFundamental]; trivial
  rw [Subgroup.mem_sup] at hu
  obtain ⟨x, hx, y, hy, hxy⟩ := hu
  have hrange : Set.range fundamentalUnitSystem = {fundamentalUnit} := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩; rfl
    · rintro rfl
      exact ⟨⟨0, by rw [unitRank_eq_one]; exact Nat.zero_lt_one⟩, rfl⟩
  rw [hrange, Subgroup.mem_closure_singleton] at hx
  obtain ⟨n, hn⟩ := hx
  exact ⟨y, hy, n, by rw [hn, ← hxy]; exact mul_comm x y⟩

/-- The unit group is `μ₁₀ × ℤ` as an abstract abelian group. -/
theorem unitGroupStructure :
    Nonempty ((𝓞 K)ˣ ≃* (Multiplicative (ZMod 10) × Multiplicative (Fin 1 → ℤ))) := by
  set i₀ : Fin (NumberField.Units.rank K) :=
    ⟨0, by rw [unitRank_eq_one]; exact Nat.zero_lt_one⟩ with hi₀
  set η : (𝓞 K)ˣ := NumberField.Units.fundSystem K i₀ with hη
  have htg10 : torsionGenerator ^ 10 = 1 := by
    have hK : ((-ζ : K)) ^ 10 = 1 := by
      linear_combination (ζ ^ 5 + 1) * zeta_pow_five
    ext
    exact hK
  have hpow : ∀ k : ℕ, torsionGenerator ^ k = torsionGenerator ^ (k % 10) := by
    intro k
    conv_lhs => rw [← Nat.div_add_mod k 10]
    rw [pow_add, pow_mul, htg10, one_pow, one_mul]
  have hsign : ∀ a b : ZMod 10,
      torsionGenerator ^ (a + b).val = torsionGenerator ^ a.val * torsionGenerator ^ b.val := by
    intro a b
    calc torsionGenerator ^ (a + b).val = torsionGenerator ^ ((a + b).val % 10) := hpow _
      _ = torsionGenerator ^ ((a.val + b.val) % 10) := by
          rw [ZMod.val_add, Nat.mod_mod_of_dvd _ (dvd_refl 10)]
      _ = torsionGenerator ^ (a.val + b.val) := (hpow _).symm
      _ = torsionGenerator ^ a.val * torsionGenerator ^ b.val := pow_add _ _ _
  let ψ₁ : Multiplicative (ZMod 10) →* (𝓞 K)ˣ :=
    MonoidHom.mk' (fun a => torsionGenerator ^ (Multiplicative.toAdd a).val)
      (fun a b => hsign (Multiplicative.toAdd a) (Multiplicative.toAdd b))
  let ψ₂ : Multiplicative (Fin 1 → ℤ) →* (𝓞 K)ˣ :=
    MonoidHom.mk' (fun f => η ^ (Multiplicative.toAdd f 0))
      (fun f g => by
        change η ^ ((Multiplicative.toAdd f + Multiplicative.toAdd g) 0) = _
        rw [Pi.add_apply, zpow_add])
  let ψ : Multiplicative (ZMod 10) × Multiplicative (Fin 1 → ℤ) →* (𝓞 K)ˣ := ψ₁.coprod ψ₂
  have htg_tor : torsionGenerator ∈ NumberField.Units.torsion K := by
    change IsOfFinOrder torsionGenerator
    rw [isOfFinOrder_iff_pow_eq_one]
    exact ⟨10, by norm_num, htg10⟩
  have hbij : Function.Bijective ψ := by
    constructor
    · rw [injective_iff_map_eq_one]
      rintro ⟨a, f⟩ h
      have h' : torsionGenerator ^ ((Multiplicative.toAdd a).val) *
          η ^ (Multiplicative.toAdd f 0) = 1 := h
      have htor : η ^ (Multiplicative.toAdd f 0) ∈ NumberField.Units.torsion K := by
        have heq : η ^ (Multiplicative.toAdd f 0) =
            (torsionGenerator ^ ((Multiplicative.toAdd a).val))⁻¹ :=
          (mul_eq_one_iff_inv_eq.mp h').symm
        rw [heq]
        exact Subgroup.inv_mem _ (Subgroup.pow_mem _ htg_tor _)
      have hn0 : Multiplicative.toAdd f 0 = 0 := fundSystem_zpow_mem_torsion i₀ _ htor
      rw [hn0, zpow_zero, mul_one] at h'
      have haval : (Multiplicative.toAdd a).val = 0 := by
        have hOK : (-zetaInt) ^ (Multiplicative.toAdd a).val = 1 := by
          have hval := congrArg Units.val h'
          simpa [Units.val_pow_eq_pow_val] using hval
        have hK : (-ζ : K) ^ (Multiplicative.toAdd a).val = 1 := by
          have hmap := congrArg (algebraMap (𝓞 K) K) hOK
          simpa [map_pow, map_neg, coe_zetaInt] using hmap
        have hdvd := (IsPrimitiveRoot.pow_eq_one_iff_dvd neg_zeta_isPrimitiveRoot _).mp hK
        have hlt : (Multiplicative.toAdd a).val < 10 := ZMod.val_lt _
        omega
      have ha0 : Multiplicative.toAdd a = 0 := by
        have hinv := ZMod.natCast_rightInverse (n := 10) (Multiplicative.toAdd a)
        rw [← hinv, haval]
        rfl
      refine Prod.ext (Multiplicative.toAdd.injective ha0) ?_
      refine Multiplicative.toAdd.injective (funext fun i => ?_)
      rw [Subsingleton.elim i 0]
      exact hn0
    · intro u
      obtain ⟨ζ', hζ', n, hu⟩ := exists_eq_torsion_mul_fundSystem_zpow i₀ u
      obtain ⟨k, hk⟩ := eq_torsionGenerator_pow_of_mem_torsion hζ'
      refine ⟨(Multiplicative.ofAdd ((k.val : ZMod 10)), Multiplicative.ofAdd (fun _ => n)), ?_⟩
      change torsionGenerator ^ ((k.val : ZMod 10)).val * η ^ n = u
      rw [ZMod.val_cast_of_lt k.isLt, hu, hk]
  exact ⟨(MulEquiv.ofBijective ψ hbij).symm⟩

/-- The regulator of `ℚ(ζ₅)` is `2·log φ ≈ 0.9624`, where `φ = (1 + √5)/2`: the two complex
places each contribute weight `2`, and `|1 + ζ| = φ` at one of them. -/
theorem regulator_eq :
    NumberField.Units.regulator K = 2 * Real.log ((1 + Real.sqrt 5) / 2) := by
  sorry


end NumberField.CyclotomicFive
