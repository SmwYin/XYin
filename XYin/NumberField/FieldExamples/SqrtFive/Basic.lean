import Mathlib

/-!
# The real quadratic field `ℚ(√5)`

For `5 ≡ 1 [MOD 4]`, the integral basis is not `[1, √5]`; it is `[1, (1 + √5) / 2]`. This
file uses the golden-ratio generator `φ = (1 + √5) / 2`, satisfying `φ ^ 2 = φ + 1`, realised
as `QuadraticAlgebra ℚ 1 1`. Main arithmetic invariants:

* degree `2`, golden generator `φ`, the radical `√5` presentation (section 1);
* integral basis `1, φ`, ring of integers `ℤ[φ]` (section 2);
* discriminant `5` (section 3);
* the norm form `x² + xy - y²` and its Pell-type unit equation, solved by consecutive
  Fibonacci pairs (section 4);
* splitting of rational primes: `5` ramifies as `(√5)²`, `11` splits, `2` and `3` are inert,
  and the splitting law: `p ≠ 5` splits iff `p ≡ ±1 (mod 5)` (section 5);
* unit group `{±1} × φ^ℤ`, signature `(2, 0)`, regulator `log φ` (section 6);
* class number one (section 7);
* the norm-Euclidean property (section 8);
* Galois group `C₂`, generated by the conjugation `φ ↦ 1 - φ` (section 9).
-/

noncomputable section

attribute [-instance] DivisionRing.toRatAlgebra

open scoped NumberField nonZeroDivisors Real ENNReal QuadraticAlgebra

open Module NumberField Polynomial

namespace NumberField.SqrtFive

instance : Fact (∀ r : ℚ, r ^ 2 ≠ (1 : ℚ) + (1 : ℚ) * r) := by
  refine ⟨?_⟩
  intro r hr
  have hsquare : IsSquare (5 : ℚ) := by
    rw [isSquare_iff_exists_sq]
    refine ⟨2 * r - 1, ?_⟩
    nlinarith
  norm_num at hsquare

/-- The real quadratic field `ℚ(√5)`, generated by `φ = (1 + √5) / 2`. -/
abbrev K : Type := QuadraticAlgebra ℚ (1 : ℚ) (1 : ℚ)

instance : FiniteDimensional ℚ K :=
  (QuadraticAlgebra.basis (1 : ℚ) (1 : ℚ)).finiteDimensional_of_finite

instance : NumberField K :=
  NumberField.of_module_finite ℚ K

/-- The extension degree of `ℚ(√5)` over `ℚ` is `2`. -/
theorem degree_eq_two : Module.finrank ℚ K = 2 := by
  rw [Module.finrank_eq_card_basis (QuadraticAlgebra.basis (1 : ℚ) (1 : ℚ)),
    Fintype.card_fin]

instance : Algebra.IsQuadraticExtension ℚ K where
  finrank_eq_two' := by
    exact degree_eq_two

/-- The golden-ratio generator `φ`, satisfying `φ ^ 2 = φ + 1`. -/
abbrev goldenRoot : K := QuadraticAlgebra.omega

theorem goldenRoot_sq : goldenRoot ^ 2 = goldenRoot + 1 := by
  change (⟨0, 1⟩ : K) ^ 2 = ⟨0, 1⟩ + ⟨1, 0⟩
  ext <;> simp [pow_two]

/-- The polynomial `X² - X - 1`, whose root is the golden ratio. -/
abbrev goldenPolynomial : ℚ[X] :=
  C (1 : ℚ) * X ^ 2 + C (-1 : ℚ) * X + C (-1 : ℚ)

instance : Fact (Irreducible goldenPolynomial) := by
  exact ⟨by
    simpa [goldenPolynomial, sub_eq_add_neg] using
      (Polynomial.X_pow_sub_X_sub_one_irreducible_rat (n := 2)
        (by norm_num : (2 : ℕ) ≠ 1))⟩

/-- The same field, now presented by adjoining a root of `X² - X - 1`. -/
abbrev KAdjoinRoot : Type := AdjoinRoot goldenPolynomial

/-- The formal golden-ratio root in the `AdjoinRoot` presentation. -/
abbrev goldenAdjoinRoot : KAdjoinRoot := AdjoinRoot.root goldenPolynomial

theorem goldenAdjoinRoot_sq :
    goldenAdjoinRoot ^ 2 = goldenAdjoinRoot + 1 := by
  have hroot : goldenAdjoinRoot ^ 2 - goldenAdjoinRoot - 1 = 0 := by
    simpa [goldenAdjoinRoot, goldenPolynomial] using (AdjoinRoot.eval₂_root goldenPolynomial)
  linear_combination hroot

/-- The `AdjoinRoot` presentation is equivalent to the quadratic-algebra model. -/
noncomputable def goldenAdjoinRootEquivGolden :
    KAdjoinRoot ≃ₐ[ℚ] K := by
  let f : KAdjoinRoot →ₐ[ℚ] K :=
    AdjoinRoot.liftAlgHom goldenPolynomial (Algebra.ofId ℚ K) goldenRoot (by
      simp [goldenPolynomial, goldenRoot_sq])
  let g : K →ₐ[ℚ] KAdjoinRoot :=
    (QuadraticAlgebra.lift (R := ℚ) (a := (1 : ℚ)) (b := 1)) ⟨goldenAdjoinRoot, by
      rw [← pow_two, goldenAdjoinRoot_sq]
      simp
      ring_nf⟩
  refine { __ := f, invFun := g, left_inv := ?_, right_inv := ?_ }
  · intro x
    have hcomp : g.comp f = AlgHom.id ℚ KAdjoinRoot := by
      apply AdjoinRoot.algHom_ext
      change g (f goldenAdjoinRoot) = goldenAdjoinRoot
      simp [f, g, goldenAdjoinRoot]
    exact DFunLike.congr_fun hcomp x
  · intro x
    have hcomp : f.comp g = AlgHom.id ℚ K := by
      apply QuadraticAlgebra.algHom_ext
      change f (g goldenRoot) = goldenRoot
      simp [f, g, goldenRoot, goldenAdjoinRoot]
    exact DFunLike.congr_fun hcomp x

theorem goldenAdjoinRootEquivGolden_root :
    goldenAdjoinRootEquivGolden goldenAdjoinRoot = goldenRoot := by
  simp [goldenAdjoinRootEquivGolden, goldenAdjoinRoot, goldenRoot]

/-- The square root of `5` recovered from `φ`: `√5 = 2φ - 1`. -/
abbrev sqrtFiveRoot : K := 2 * goldenRoot - 1

theorem sqrtFiveRoot_sq : sqrtFiveRoot ^ 2 = (5 : K) := by
  rw [sqrtFiveRoot]
  calc
    (2 * goldenRoot - 1) ^ 2 = 4 * goldenRoot ^ 2 - 4 * goldenRoot + 1 := by ring
    _ = 5 := by rw [goldenRoot_sq]; ring

theorem goldenRoot_eq_half_sqrtFiveRoot_add_one :
    goldenRoot = (sqrtFiveRoot + 1) / 2 := by
  rw [sqrtFiveRoot]
  field_simp
  ring

theorem goldenRoot_isIntegral : IsIntegral ℤ goldenRoot := by
  refine ⟨X ^ 2 - X - 1, ?_, ?_⟩
  · monicity
    norm_num
  · simp [goldenRoot_sq]

instance : Fact (∀ r : ℚ, r ^ 2 ≠ (5 : ℚ) + (0 : ℚ) * r) := by
  refine ⟨?_⟩
  intro r hr
  have hsquare : IsSquare (5 : ℚ) := by
    rw [isSquare_iff_exists_sq]
    refine ⟨r, ?_⟩
    nlinarith
  norm_num at hsquare

/-- The same field, now presented with a generator whose square is `5`. -/
abbrev RadicalModel : Type := QuadraticAlgebra ℚ (5 : ℚ) 0

/-- The distinguished square root of `5` in the radical presentation. -/
abbrev sqrtFiveRadicalRoot : RadicalModel := QuadraticAlgebra.omega

theorem sqrtFiveRadicalRoot_sq :
    sqrtFiveRadicalRoot ^ 2 = (5 : RadicalModel) := by
  change (⟨0, 1⟩ : RadicalModel) ^ 2 = ⟨5, 0⟩
  ext <;> simp [pow_two]

/-- The distinguished square root of `5` in the radical presentation. -/
abbrev sqrtFive : RadicalModel := sqrtFiveRadicalRoot

theorem sqrtFive_sq : sqrtFive ^ 2 = (5 : RadicalModel) :=
  sqrtFiveRadicalRoot_sq

/-- The golden ratio in the radical presentation. -/
abbrev goldenRadicalRoot : RadicalModel := (1 + sqrtFive) / 2

theorem goldenRadicalRoot_sq : goldenRadicalRoot ^ 2 = goldenRadicalRoot + 1 := by
  have h := sqrtFive_sq
  rw [goldenRadicalRoot]
  field_simp
  linear_combination h

/-- The polynomial `X² - 5`, whose root is `√5`. -/
abbrev sqrtFivePolynomial : ℚ[X] :=
  X ^ 2 - C (5 : ℚ)

/-- The same radical field, presented by adjoining a root of `X² - 5`. -/
abbrev RadicalAdjoinRoot : Type := AdjoinRoot sqrtFivePolynomial

/-- The formal square root of `5` in the `AdjoinRoot` presentation. -/
abbrev sqrtFiveAdjoinRoot : RadicalAdjoinRoot := AdjoinRoot.root sqrtFivePolynomial

theorem sqrtFiveAdjoinRoot_sq :
    sqrtFiveAdjoinRoot ^ 2 = (5 : RadicalAdjoinRoot) := by
  have hroot : sqrtFiveAdjoinRoot ^ 2 - 5 = 0 := by
    simpa [sqrtFiveAdjoinRoot, sqrtFivePolynomial] using
      (AdjoinRoot.eval₂_root sqrtFivePolynomial)
  linear_combination hroot

private def sqrtFiveAdjoinRootToRadical : RadicalAdjoinRoot →ₐ[ℚ] RadicalModel :=
  AdjoinRoot.liftAlgHom sqrtFivePolynomial (Algebra.ofId ℚ RadicalModel) sqrtFive (by
    calc
      sqrtFivePolynomial.eval₂ (Algebra.ofId ℚ RadicalModel) sqrtFive = sqrtFive ^ 2 - 5 := by
        simp [sqrtFivePolynomial]
      _ = 0 := by rw [sqrtFive_sq]; ring)

private theorem sqrtFiveAdjoinRootToRadical_root :
    sqrtFiveAdjoinRootToRadical sqrtFiveAdjoinRoot = sqrtFive := by
  rw [sqrtFiveAdjoinRootToRadical, sqrtFiveAdjoinRoot]
  exact AdjoinRoot.liftAlgHom_root sqrtFivePolynomial (Algebra.ofId ℚ RadicalModel) sqrtFive _

private def sqrtFiveRadicalToAdjoinRoot : RadicalModel →ₐ[ℚ] RadicalAdjoinRoot :=
  (QuadraticAlgebra.lift (R := ℚ) (a := (5 : ℚ)) (b := 0)) ⟨sqrtFiveAdjoinRoot, by
    rw [← pow_two, sqrtFiveAdjoinRoot_sq]
    simp [Algebra.smul_def, map_ofNat]⟩

private theorem sqrtFiveRadicalToAdjoinRoot_root :
    sqrtFiveRadicalToAdjoinRoot sqrtFive = sqrtFiveAdjoinRoot := by
  dsimp [sqrtFiveRadicalToAdjoinRoot, sqrtFive, sqrtFiveRadicalRoot, QuadraticAlgebra.lift,
    QuadraticAlgebra.omega]
  change (0 : ℚ) • (1 : RadicalAdjoinRoot) + (1 : ℚ) • sqrtFiveAdjoinRoot = sqrtFiveAdjoinRoot
  simp

/-- The radical quadratic-algebra presentation is equivalent to the `AdjoinRoot` model. -/
noncomputable def sqrtFiveRadicalEquivAdjoinRoot : RadicalModel ≃ₐ[ℚ] RadicalAdjoinRoot := by
  refine
    { __ := sqrtFiveRadicalToAdjoinRoot
      invFun := sqrtFiveAdjoinRootToRadical
      left_inv := ?_
      right_inv := ?_ }
  · intro x
    have hcomp :
        sqrtFiveAdjoinRootToRadical.comp sqrtFiveRadicalToAdjoinRoot =
          AlgHom.id ℚ RadicalModel := by
      apply QuadraticAlgebra.algHom_ext
      change sqrtFiveAdjoinRootToRadical
          (sqrtFiveRadicalToAdjoinRoot sqrtFive) = sqrtFive
      rw [sqrtFiveRadicalToAdjoinRoot_root, sqrtFiveAdjoinRootToRadical_root]
    exact DFunLike.congr_fun hcomp x
  · intro x
    have hcomp :
        sqrtFiveRadicalToAdjoinRoot.comp sqrtFiveAdjoinRootToRadical =
          AlgHom.id ℚ RadicalAdjoinRoot := by
      apply AdjoinRoot.algHom_ext
      change sqrtFiveRadicalToAdjoinRoot
          (sqrtFiveAdjoinRootToRadical sqrtFiveAdjoinRoot) = sqrtFiveAdjoinRoot
      rw [sqrtFiveAdjoinRootToRadical_root, sqrtFiveRadicalToAdjoinRoot_root]
    exact DFunLike.congr_fun hcomp x

theorem sqrtFiveRadicalEquivAdjoinRoot_root :
    sqrtFiveRadicalEquivAdjoinRoot sqrtFive = sqrtFiveAdjoinRoot :=
  sqrtFiveRadicalToAdjoinRoot_root

/-- The map from the `√5` presentation to the golden-ratio presentation. -/
def sqrtFiveRadicalToGolden : RadicalModel →ₐ[ℚ] K :=
  (QuadraticAlgebra.lift (R := ℚ) (a := (5 : ℚ)) (b := 0)) ⟨sqrtFiveRoot, by
    rw [← pow_two, sqrtFiveRoot_sq]
    ext <;> norm_num⟩

@[simp]
theorem sqrtFiveRadicalToGolden_root :
    sqrtFiveRadicalToGolden sqrtFiveRadicalRoot = sqrtFiveRoot := by
  simp [sqrtFiveRadicalToGolden, sqrtFiveRadicalRoot]

/-- The inverse map sends the golden-ratio generator to `(√5 + 1) / 2`. -/
def goldenToSqrtFiveRadical : K →ₐ[ℚ] RadicalModel :=
  (QuadraticAlgebra.lift (R := ℚ) (a := (1 : ℚ)) (b := 1))
    ⟨(sqrtFiveRadicalRoot + 1) / 2, by
      calc
        ((sqrtFiveRadicalRoot + 1) / 2) * ((sqrtFiveRadicalRoot + 1) / 2)
            = (sqrtFiveRadicalRoot ^ 2 + 2 * sqrtFiveRadicalRoot + 1) / 4 := by ring
        _ = 1 • (1 : RadicalModel) + 1 • ((sqrtFiveRadicalRoot + 1) / 2) := by
          rw [sqrtFiveRadicalRoot_sq]
          ring⟩

@[simp]
theorem goldenToSqrtFiveRadical_root :
    goldenToSqrtFiveRadical goldenRoot = (sqrtFiveRadicalRoot + 1) / 2 := by
  simp [goldenToSqrtFiveRadical, goldenRoot]

/-- The golden-ratio and radical quadratic-algebra presentations are the same `ℚ`-field. -/
def sqrtFiveRadicalEquivGolden : RadicalModel ≃ₐ[ℚ] K where
  __ := sqrtFiveRadicalToGolden
  invFun := goldenToSqrtFiveRadical
  left_inv x := by
    have hcomp :
        goldenToSqrtFiveRadical.comp sqrtFiveRadicalToGolden =
          AlgHom.id ℚ RadicalModel := by
      apply QuadraticAlgebra.algHom_ext
      change goldenToSqrtFiveRadical
          (sqrtFiveRadicalToGolden sqrtFiveRadicalRoot) = sqrtFiveRadicalRoot
      rw [sqrtFiveRadicalToGolden_root, sqrtFiveRoot, map_sub, map_mul, map_ofNat,
        goldenToSqrtFiveRadical_root, map_one]
      ring
    exact DFunLike.congr_fun hcomp x
  right_inv x := by
    have hcomp :
        sqrtFiveRadicalToGolden.comp goldenToSqrtFiveRadical =
          AlgHom.id ℚ K := by
      apply QuadraticAlgebra.algHom_ext
      change sqrtFiveRadicalToGolden
          (goldenToSqrtFiveRadical goldenRoot) = goldenRoot
      rw [goldenToSqrtFiveRadical_root, map_div₀, map_add, map_one,
        sqrtFiveRadicalToGolden_root]
      have hmap_two : sqrtFiveRadicalToGolden (2 : RadicalModel) = (2 : K) := by
        simpa using sqrtFiveRadicalToGolden.commutes (2 : ℚ)
      rw [hmap_two]
      exact goldenRoot_eq_half_sqrtFiveRoot_add_one.symm
    exact DFunLike.congr_fun hcomp x

theorem sqrtFiveRadicalEquivGolden_root :
    sqrtFiveRadicalEquivGolden sqrtFiveRadicalRoot = sqrtFiveRoot :=
  sqrtFiveRadicalToGolden_root

theorem sqrtFiveRadicalEquivGolden_symm_root :
    sqrtFiveRadicalEquivGolden.symm goldenRoot = (sqrtFiveRadicalRoot + 1) / 2 :=
  goldenToSqrtFiveRadical_root

/-- The `AdjoinRoot (X^2 - 5)` model is equivalent to the golden-ratio presentation. -/
noncomputable def sqrtFiveAdjoinRootEquivGolden : RadicalAdjoinRoot ≃ₐ[ℚ] K :=
  sqrtFiveRadicalEquivAdjoinRoot.symm.trans sqrtFiveRadicalEquivGolden

theorem sqrtFiveAdjoinRootEquivGolden_root :
    sqrtFiveAdjoinRootEquivGolden sqrtFiveAdjoinRoot = sqrtFiveRoot := by
  rw [sqrtFiveAdjoinRootEquivGolden, AlgEquiv.trans_apply]
  have hsymm : sqrtFiveRadicalEquivAdjoinRoot.symm sqrtFiveAdjoinRoot = sqrtFive := by
    rw [← sqrtFiveRadicalEquivAdjoinRoot_root]
    simp
  rw [hsymm, sqrtFiveRadicalEquivGolden_root]


end NumberField.SqrtFive
