import Mathlib

/-!
# The field `ℚ(√-6)` via `AdjoinRoot`

The imaginary quadratic field `K = ℚ(√-6)`, realised as `AdjoinRoot (X ^ 2 + 6)`, and its
main arithmetic invariants. Its interest is the *nontrivial* class group:

* degree `2`, integral basis `1, θ` with `θ = √-6`; ring of integers `ℤ[√-6]`
  (sections 1–2);
* discriminant `-24` (section 3);
* the norm form `x² + 6y²`; the only units are `±1` (section 4);
* splitting of rational primes: `2` and `3` ramify with *non-principal* ramified primes,
  `7` splits with principal factors `(1 ± θ)`, `5` splits with non-principal factors, `13`
  is inert; `p` splits `↔ p ≡ 1, 5, 7, 11 (mod 24)` (section 5);
* unit group `{±1}`: signature `(0, 1)`, unit rank `0`, regulator `1` (section 6);
* **class number two**: `ℤ[√-6]` is not a PID, the class group is `ℤ/2` generated by the
  ramified prime `(2, θ)` (section 7);
* the resulting failure of unique factorisation: `6 = 2 · 3 = -θ · θ` with `2, 3, θ`
  irreducible (section 8);
* Galois over `ℚ` with group `ℤ/2` (section 9).
-/

noncomputable section

open Module Polynomial
open scoped NumberField nonZeroDivisors

namespace XYin.NumberField.New.SqrtNegSixAdjoinRoot

/-! ## 1. Basics -/

/-- The polynomial `X^2 + 6` over `ℚ`, defining `ℚ(√-6)`. -/
abbrev sqrtNegSixPolynomial : ℚ[X] := X ^ 2 + C (6 : ℚ)

/-- The polynomial `X^2 + 6` is irreducible over `ℚ`: `-6` is not a rational square. -/
instance : Fact (Irreducible sqrtNegSixPolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [sqrtNegSixPolynomial, Finset.mem_Icc]
    change 1 ≤ (X ^ 2 + C (6 : ℚ)).natDegree ∧ (X ^ 2 + C (6 : ℚ)).natDegree ≤ 3
    rw [natDegree_X_pow_add_C]
    norm_num
  · intro x hx
    have hzero : x ^ 2 + 6 = 0 := by
      simpa [sqrtNegSixPolynomial, IsRoot] using hx
    have h : (0 : ℚ) ≤ x ^ 2 := sq_nonneg x
    nlinarith

/-- The number field `ℚ(√-6)` as an `AdjoinRoot`. -/
abbrev K : Type := AdjoinRoot sqrtNegSixPolynomial

/-- The distinguished square root of `-6`. -/
abbrev θ : K := AdjoinRoot.root sqrtNegSixPolynomial

/-- The field structure on `K`. -/
instance : Field K := by
  infer_instance

/-- The number-field structure on `K`. -/
instance : NumberField K := by
  infer_instance

/-- The power basis `1, θ` of `K` over `ℚ`. -/
private noncomputable abbrev sqrtNegSixPB : PowerBasis ℚ K :=
  AdjoinRoot.powerBasis (f := sqrtNegSixPolynomial)
    ((Fact.out : Irreducible sqrtNegSixPolynomial).ne_zero)

private theorem sqrtNegSixPB_dim : sqrtNegSixPB.dim = 2 := by
  change sqrtNegSixPolynomial.natDegree = 2
  rw [sqrtNegSixPolynomial, natDegree_X_pow_add_C]

private theorem sqrtNegSixPB_gen : sqrtNegSixPB.gen = θ := by
  simp [sqrtNegSixPB, θ]

/-- The extension degree of `K = ℚ(√-6)` over `ℚ` is `2`. -/
theorem degree_eq_two : Module.finrank ℚ K = 2 := by
  rw [PowerBasis.finrank sqrtNegSixPB]
  exact sqrtNegSixPB_dim

instance : Algebra.IsQuadraticExtension ℚ K where
  finrank_eq_two' := degree_eq_two

/-- The generator satisfies `θ² = -6`. -/
theorem theta_sq : θ ^ 2 = -6 := by
  have hroot : θ ^ 2 + 6 = 0 := by
    simpa [θ, sqrtNegSixPolynomial] using (AdjoinRoot.eval₂_root sqrtNegSixPolynomial)
  linear_combination hroot

/-! ### The `QuadraticAlgebra ℚ (-6) 0` presentation -/

instance : Fact (∀ r : ℚ, r ^ 2 ≠ (-6 : ℚ) + (0 : ℚ) * r) := by
  exact ⟨by
    sorry⟩

/-- The same field, now presented as the radical quadratic algebra `ℚ[√-6]`. -/
abbrev KQuadratic : Type := QuadraticAlgebra ℚ (-6 : ℚ) 0

/-- The distinguished square root of `-6` in the quadratic-algebra presentation. -/
abbrev thetaQuadratic : KQuadratic := QuadraticAlgebra.omega

theorem thetaQuadratic_sq : thetaQuadratic ^ 2 = (-6 : KQuadratic) := by
  sorry

/-- The radical quadratic-algebra presentation is equivalent to the `AdjoinRoot` model. -/
noncomputable def quadraticEquivAdjoinRoot : KQuadratic ≃ₐ[ℚ] K := by
  sorry

theorem quadraticEquivAdjoinRoot_root :
    quadraticEquivAdjoinRoot thetaQuadratic = θ := by
  sorry


end XYin.NumberField.New.SqrtNegSixAdjoinRoot
