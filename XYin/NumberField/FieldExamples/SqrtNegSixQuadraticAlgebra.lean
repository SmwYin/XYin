import Mathlib

/-!
# The field `ℚ(√-6)` via `QuadraticAlgebra`

The imaginary quadratic field `K = ℚ(√-6)`, realised as `QuadraticAlgebra ℚ (-6) 0`, and its
main arithmetic invariants (the `AdjoinRoot` construction of the same field is in
`SqrtNegSixAdjoinRoot.lean`). Its interest is the *nontrivial* class group:

* degree `2`, integral basis `1, θ` with `θ = √-6`; ring of integers `ℤ[√-6]`
  (sections 1–2);
* discriminant `-24` (section 3);
* the norm form `x² + 6y²`; the only units are `±1` (section 4);
* splitting of rational primes: `2` and `3` ramify with *non-principal* ramified primes,
  `7` splits with principal factors `(1 ± θ)`, `5` splits with non-principal factors, `13`
  is inert; `p` splits `↔ p ≡ 1, 5, 7, 11 (mod 24)` (section 5);
* unit group `{±1}`: signature `(0, 1)`, unit rank `0`, regulator `1` (section 6);
* **class number two**: `ℤ[√-6]` is not a PID, the class group is `ℤ/2` generated by the
  ramified prime `(2, θ)` (section 7);
* the resulting failure of unique factorisation: `6 = 2 · 3 = -θ · θ` with `2, 3, θ`
  irreducible (section 8);
* Galois over `ℚ` with group `ℤ/2` (section 9).
-/

noncomputable section

open Module
open scoped NumberField nonZeroDivisors QuadraticAlgebra

namespace XYin.NumberField.New.SqrtNegSixQuadraticAlgebra

/-! ## 1. Basics -/

/-- The nonsquare condition making `QuadraticAlgebra ℚ (-6) 0` a field: `-6` is not a
rational square. -/
instance : Fact (∀ r : ℚ, r ^ 2 ≠ (-6 : ℚ) + (0 : ℚ) * r) := by
  refine ⟨fun r hr => ?_⟩
  have h : (0 : ℚ) ≤ r ^ 2 := sq_nonneg r
  nlinarith

/-- The number field `ℚ(√-6)` as `QuadraticAlgebra ℚ (-6) 0`. -/
abbrev K : Type := QuadraticAlgebra ℚ (-6 : ℚ) 0

/-- The distinguished square root of `-6`. -/
abbrev θ : K := QuadraticAlgebra.omega

/-- The field structure on `K`. -/
instance : Field K := by
  infer_instance

/-- The finite-dimensional `ℚ`-vector-space structure on `K`. -/
instance : FiniteDimensional ℚ K :=
  (QuadraticAlgebra.basis (-6 : ℚ) (0 : ℚ)).finiteDimensional_of_finite

/-- The number-field structure on `K`. -/
instance : NumberField K :=
  NumberField.of_module_finite ℚ K

/-- The extension degree of `K = ℚ(√-6)` over `ℚ` is `2`. -/
theorem degree_eq_two : Module.finrank ℚ K = 2 := by
  rw [Module.finrank_eq_card_basis (QuadraticAlgebra.basis (-6 : ℚ) (0 : ℚ)), Fintype.card_fin]

/-- The generator satisfies `θ² = -6`. -/
theorem theta_sq : θ ^ 2 = -6 := by
  rw [sq, QuadraticAlgebra.omega_mul_omega_eq_add]
  simp

/-! ### The `AdjoinRoot` presentation -/

/-- The polynomial `X² + 6`, whose root is `√-6`. -/
abbrev sqrtNegSixPolynomial : Polynomial ℚ :=
  Polynomial.X ^ 2 + Polynomial.C (6 : ℚ)

instance : Fact (Irreducible sqrtNegSixPolynomial) := by
  exact ⟨by
    sorry⟩

/-- The same field, now presented by adjoining a root of `X² + 6`. -/
abbrev KAdjoinRoot : Type := AdjoinRoot sqrtNegSixPolynomial

/-- The formal square root of `-6` in the `AdjoinRoot` presentation. -/
abbrev thetaAdjoinRoot : KAdjoinRoot := AdjoinRoot.root sqrtNegSixPolynomial

theorem thetaAdjoinRoot_sq :
    thetaAdjoinRoot ^ 2 = (-6 : KAdjoinRoot) := by
  sorry

/-- The `AdjoinRoot` presentation is equivalent to the quadratic-algebra model. -/
noncomputable def adjoinRootEquivQuadratic : KAdjoinRoot ≃ₐ[ℚ] K := by
  sorry

theorem adjoinRootEquivQuadratic_root :
    adjoinRootEquivQuadratic thetaAdjoinRoot = θ := by
  sorry

/-! ## 2. Integral basis and ring of integers -/

/-- The generator `θ = √-6` is integral over `ℤ` (a root of the monic `X² + 6`), hence lies
in `𝓞 K`. -/
theorem theta_integral : θ ∈ integralClosure ℤ K := by
  refine ⟨Polynomial.X ^ 2 + 6, ?_, ?_⟩
  · monicity!
  · simp only [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_ofNat]
    linear_combination theta_sq

/-- `θ = √-6` as an element of the ring of integers `𝓞 K`. -/
noncomputable def thetaInt : 𝓞 K := ⟨θ, theta_integral⟩

/-- The integral generator also satisfies `θ² = -6` in `𝓞 K`. -/
theorem thetaInt_sq : thetaInt ^ 2 = -6 := by
  apply Subtype.ext
  change (θ : K) ^ 2 = (-6 : K)
  exact theta_sq

/-- The conjugation `θ ↦ -θ` as an algebra map, via the universal property. -/
private noncomputable def conjHom : K →ₐ[ℚ] K :=
  QuadraticAlgebra.lift ⟨-QuadraticAlgebra.omega, by
    have h := QuadraticAlgebra.omega_mul_omega_eq_add
      (R := ℚ) (a := (-6 : ℚ)) (b := (0 : ℚ))
    simpa [neg_mul_neg] using h⟩

private theorem conjHom_omega : conjHom θ = -θ := by
  change (QuadraticAlgebra.omega : K).re • (1 : K) +
    (QuadraticAlgebra.omega : K).im • (-QuadraticAlgebra.omega) = -θ
  simp

private theorem conjHom_conjHom : conjHom.comp conjHom = AlgHom.id ℚ K := by
  apply QuadraticAlgebra.algHom_ext
  change conjHom (conjHom θ) = θ
  rw [conjHom_omega, map_neg, conjHom_omega, neg_neg]

private noncomputable def conj' : K ≃ₐ[ℚ] K :=
  AlgEquiv.ofAlgHom conjHom conjHom conjHom_conjHom conjHom_conjHom

private theorem conj'_omega : conj' θ = -θ := conjHom_omega

/-- The displayed integral-basis vectors `1, θ` (as elements of `K`). -/
def integralBasisVectors : Fin 2 → K := ![1, θ]

/-- `1, θ` is an integral basis of `ℚ(√-6)`: their `ℤ`-span in `K` is exactly the ring of
integers `𝓞 K`. Since `-6 ≡ 2 (mod 4)`, the naive order `ℤ[√-6]` is already maximal — in
contrast with `ℚ(√5)`. -/
theorem span_integralBasisVectors_eq :
    Submodule.span ℤ (Set.range integralBasisVectors) =
      Subalgebra.toSubmodule (integralClosure ℤ K) := by
  sorry

/-- The integral basis `1, θ` packaged as a genuine `ℤ`-basis of the ring of integers `𝓞 K`. -/
noncomputable def concreteIntegralBasis : Basis (Fin 2) ℤ (𝓞 K) := by
  sorry

/-- The packaged integral basis is, vector by vector, the displayed family `1, θ`. -/
theorem concreteIntegralBasis_apply (i : Fin 2) :
    (algebraMap (𝓞 K) K) (concreteIntegralBasis i) = integralBasisVectors i := by
  sorry

private theorem exists_eq_smul_one_add_smul_theta (z : 𝓞 K) :
    ∃ x y : ℤ, z = x • (1 : 𝓞 K) + y • thetaInt := by
  refine ⟨concreteIntegralBasis.repr z 0, concreteIntegralBasis.repr z 1, ?_⟩
  apply IsFractionRing.injective (𝓞 K) K
  have hsum := concreteIntegralBasis.sum_repr z
  conv_lhs => rw [← hsum]
  rw [map_sum]
  rw [Fin.sum_univ_two]
  simp [concreteIntegralBasis_apply, integralBasisVectors, thetaInt]

/-- The displayed integral basis `1, θ` spans the same `ℤ`-lattice in `K` as mathlib's
`NumberField.integralBasis K` (the correct form of "the two integral bases agree": equality
of lattices, not a mere reindexing). -/
theorem span_integralBasisVectors_eq_integralBasis :
    Submodule.span ℤ (Set.range integralBasisVectors) =
      Submodule.span ℤ (Set.range (NumberField.integralBasis K)) := by
  sorry

/-- The concrete order `ℤ[θ]` inside `K`. -/
abbrev concreteRingOfIntegers : Subalgebra ℤ K := Algebra.adjoin ℤ ({θ} : Set K)

/-- The full ring of integers of `ℚ(√-6)` is `ℤ[θ]` (maximality of the naive order, since
`-6 ≡ 2 (mod 4)`). -/
theorem ringOfIntegers_eq : integralClosure ℤ K = concreteRingOfIntegers := by
  sorry

/-! ## 3. Discriminant -/

/-- The number-field discriminant of `ℚ(√-6)` is `-24` (for `d ≡ 2, 3 (mod 4)` squarefree
the discriminant of `ℚ(√d)` is `4d`). In particular the ramified primes are exactly `2`
and `3`, cf. `ramified_iff`. -/
theorem numberField_discr_eq : NumberField.discr K = (-24 : ℤ) := by
  sorry

/-- The discriminant of the explicit integral basis `1, θ` is `-24`. -/
theorem concreteIntegralBasis_discr :
    Algebra.discr ℤ concreteIntegralBasis = (-24 : ℤ) := by
  sorry

/-! ## 4. Norm form -/

/-- The norm form of `ℚ(√-6)` in the basis `1, θ`: the field norm of `x + yθ` is the
positive-definite binary quadratic form `x² + 6y²`. -/
theorem norm_eq_normForm (x y : ℚ) :
    Algebra.norm ℚ (x • (1 : K) + y • θ) = x ^ 2 + 6 * y ^ 2 := by
  have h : Algebra.norm ℚ (x • (1 : K) + y • θ) =
      QuadraticAlgebra.norm (x • (1 : K) + y • θ) := by
    rw [Algebra.norm_apply, ← QuadraticAlgebra.det_toLinearMap_eq_norm]
    congr 1
  rw [h]
  simp [QuadraticAlgebra.norm_def, θ]
  ring

/-- The integral norm form: on `𝓞 K = ℤ[θ]` the norm of `x + yθ` (with `x, y ∈ ℤ`) is
`x² + 6y²`. -/
theorem intNorm_eq_normForm (x y : ℤ) :
    Algebra.norm ℤ (x • (1 : 𝓞 K) + y • thetaInt) = x ^ 2 + 6 * y ^ 2 := by
  have h1 : ((Algebra.norm ℤ (x • (1 : 𝓞 K) + y • thetaInt) : ℤ) : ℚ) =
      Algebra.norm ℚ (algebraMap (𝓞 K) K (x • (1 : 𝓞 K) + y • thetaInt)) :=
    Algebra.coe_norm_int _
  have h2 : algebraMap (𝓞 K) K (x • (1 : 𝓞 K) + y • thetaInt) =
      (x : ℚ) • (1 : K) + (y : ℚ) • θ := by
    rw [map_add, map_zsmul, map_zsmul, map_one]
    rw [Int.cast_smul_eq_zsmul ℚ x (1 : K), Int.cast_smul_eq_zsmul ℚ y θ]
    rfl
  rw [h2, norm_eq_normForm] at h1
  exact_mod_cast h1

private theorem normForm_ne_two (x y : ℤ) : x ^ 2 + 6 * y ^ 2 ≠ 2 := by
  intro h
  have hy_nonneg : 0 ≤ y ^ 2 := sq_nonneg y
  have hx_nonneg : 0 ≤ x ^ 2 := sq_nonneg x
  have hy0 : y ^ 2 = 0 := by nlinarith
  have hx2 : x ^ 2 = 2 := by nlinarith
  have hx_le : x ≤ 1 := by nlinarith [sq_nonneg (x - 1)]
  have hx_ge : -1 ≤ x := by nlinarith [sq_nonneg (x + 1)]
  interval_cases x <;> norm_num at hx2

private theorem normForm_ne_three (x y : ℤ) : x ^ 2 + 6 * y ^ 2 ≠ 3 := by
  intro h
  have hy_nonneg : 0 ≤ y ^ 2 := sq_nonneg y
  have hx_nonneg : 0 ≤ x ^ 2 := sq_nonneg x
  have hy0 : y ^ 2 = 0 := by nlinarith
  have hx3 : x ^ 2 = 3 := by nlinarith
  have hx_le' : 4 * x ≤ 7 := by nlinarith [sq_nonneg (x - 2)]
  have hx_ge' : -7 ≤ 4 * x := by nlinarith [sq_nonneg (x + 2)]
  have hx_le : x ≤ 1 := by omega
  have hx_ge : -1 ≤ x := by omega
  interval_cases x <;> norm_num at hx3

private theorem normForm_ne_five (x y : ℤ) : x ^ 2 + 6 * y ^ 2 ≠ 5 := by
  intro h
  have hy_nonneg : 0 ≤ y ^ 2 := sq_nonneg y
  have hx_nonneg : 0 ≤ x ^ 2 := sq_nonneg x
  have hy0 : y ^ 2 = 0 := by nlinarith
  have hx5 : x ^ 2 = 5 := by nlinarith
  have hx_le' : 6 * x ≤ 14 := by nlinarith [sq_nonneg (x - 3)]
  have hx_ge' : -14 ≤ 6 * x := by nlinarith [sq_nonneg (x + 3)]
  have hx_le : x ≤ 2 := by omega
  have hx_ge : -2 ≤ x := by omega
  interval_cases x <;> norm_num at hx5

/-- The unit equation for `ℚ(√-6)`: `x + yθ` is a unit iff `x² + 6y² = 1`, i.e. iff
`(x, y) = (±1, 0)`. The form is positive definite, so there is no Pell phenomenon. -/
theorem isUnit_iff_normForm (x y : ℤ) :
    IsUnit (x • (1 : 𝓞 K) + y • thetaInt) ↔ x ^ 2 + 6 * y ^ 2 = 1 := by
  rw [NumberField.isUnit_iff_norm, RingOfIntegers.coe_norm, ← Algebra.coe_norm_int,
    intNorm_eq_normForm, abs_eq (by norm_num : (0 : ℚ) ≤ 1)]
  constructor
  · rintro (h | h)
    · exact_mod_cast h
    · have hq : x ^ 2 + 6 * y ^ 2 = (-1 : ℤ) := by exact_mod_cast h
      have hnonneg : (0 : ℤ) ≤ x ^ 2 + 6 * y ^ 2 := by nlinarith [sq_nonneg x, sq_nonneg y]
      omega
  · intro h
    left
    exact_mod_cast h

private theorem intNorm_nonneg (z : 𝓞 K) : 0 ≤ Algebra.norm ℤ z := by
  obtain ⟨x, y, hz⟩ := exists_eq_smul_one_add_smul_theta z
  rw [hz, intNorm_eq_normForm]
  nlinarith [sq_nonneg x, sq_nonneg y]

private theorem isUnit_iff_intNorm_eq_one (z : 𝓞 K) :
    IsUnit z ↔ Algebra.norm ℤ z = 1 := by
  obtain ⟨x, y, hz⟩ := exists_eq_smul_one_add_smul_theta z
  rw [hz, isUnit_iff_normForm, intNorm_eq_normForm]

private theorem intNorm_ne_two (z : 𝓞 K) : Algebra.norm ℤ z ≠ 2 := by
  intro hz2
  obtain ⟨x, y, hz⟩ := exists_eq_smul_one_add_smul_theta z
  rw [hz, intNorm_eq_normForm] at hz2
  exact normForm_ne_two x y hz2

private theorem intNorm_ne_three (z : 𝓞 K) : Algebra.norm ℤ z ≠ 3 := by
  intro hz3
  obtain ⟨x, y, hz⟩ := exists_eq_smul_one_add_smul_theta z
  rw [hz, intNorm_eq_normForm] at hz3
  exact normForm_ne_three x y hz3

private theorem intNorm_ne_five (z : 𝓞 K) : Algebra.norm ℤ z ≠ 5 := by
  intro hz5
  obtain ⟨x, y, hz⟩ := exists_eq_smul_one_add_smul_theta z
  rw [hz, intNorm_eq_normForm] at hz5
  exact normForm_ne_five x y hz5

/-! ## 5. Splitting of primes -/

/-- The ramified prime above `2`: the ideal `(2, θ)`. It is *not* principal — see
`not_isPrincipal_primeAboveTwo`. -/
def primeAboveTwo : Ideal (𝓞 K) := Ideal.span {(2 : 𝓞 K), thetaInt}

/-- The ramified prime above `3`: the ideal `(3, θ)`. -/
def primeAboveThree : Ideal (𝓞 K) := Ideal.span {(3 : 𝓞 K), thetaInt}

/-- `2` is ramified: `(2) = (2, θ)²`. -/
theorem span_two_eq : Ideal.span {(2 : 𝓞 K)} = primeAboveTwo ^ 2 := by
  rw [sq, primeAboveTwo, Ideal.span_pair_mul_span_pair]
  apply le_antisymm
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have h4 : (2 : 𝓞 K) * 2 ∈
        Ideal.span
          ({(2 : 𝓞 K) * 2, (2 : 𝓞 K) * thetaInt, thetaInt * 2,
            thetaInt * thetaInt} : Set (𝓞 K)) :=
      Ideal.subset_span (by simp)
    have hθ2 : thetaInt * thetaInt ∈
        Ideal.span
          ({(2 : 𝓞 K) * 2, (2 : 𝓞 K) * thetaInt, thetaInt * 2,
            thetaInt * thetaInt} : Set (𝓞 K)) :=
      Ideal.subset_span (by simp)
    convert Ideal.sub_mem _ (neg_mem h4) hθ2 using 1
    rw [show thetaInt * thetaInt = thetaInt ^ 2 by ring, thetaInt_sq]
    ring
  · rw [Ideal.span_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl | rfl
    · exact Ideal.mem_span_singleton.mpr ⟨(2 : 𝓞 K), by ring⟩
    · exact Ideal.mem_span_singleton.mpr ⟨thetaInt, by ring⟩
    · exact Ideal.mem_span_singleton.mpr ⟨thetaInt, by ring⟩
    · rw [show thetaInt * thetaInt = thetaInt ^ 2 by ring, thetaInt_sq]
      exact Ideal.mem_span_singleton.mpr ⟨(-3 : 𝓞 K), by ring⟩

/-- `(2, θ)` is a prime ideal of norm `2`. -/
theorem isPrime_primeAboveTwo : primeAboveTwo.IsPrime := by
  apply Ideal.isPrime_of_irreducible_absNorm
  have habs : Ideal.absNorm primeAboveTwo = 2 := by
    have hspan : Ideal.absNorm (Ideal.span {(2 : 𝓞 K)}) = 4 := by
      have h := intNorm_eq_normForm 2 0
      have heq : (2 : 𝓞 K) = (2 : ℤ) • (1 : 𝓞 K) + (0 : ℤ) • thetaInt := by simp
      rw [Ideal.absNorm_span_singleton, heq, h]
      rfl
    have h := congrArg Ideal.absNorm span_two_eq
    rw [hspan, map_pow] at h
    nlinarith
  rw [habs]
  exact (Nat.irreducible_iff_nat_prime _).mpr (by norm_num)

/-- The ramified prime `(2, θ)` has norm `2`. -/
theorem absNorm_primeAboveTwo : Ideal.absNorm primeAboveTwo = 2 := by
  have hspan : Ideal.absNorm (Ideal.span {(2 : 𝓞 K)}) = 4 := by
    have h := intNorm_eq_normForm 2 0
    have heq : (2 : 𝓞 K) = (2 : ℤ) • (1 : 𝓞 K) + (0 : ℤ) • thetaInt := by simp
    rw [Ideal.absNorm_span_singleton, heq, h]
    rfl
  have h := congrArg Ideal.absNorm span_two_eq
  rw [hspan, map_pow] at h
  nlinarith

/-- `(2, θ)` is not principal: no element of `ℤ[√-6]` has norm `±2`, since `x² + 6y² = 2`
has no integer solutions. This single ideal witnesses the nontrivial class group. -/
theorem not_isPrincipal_primeAboveTwo : ¬ Submodule.IsPrincipal primeAboveTwo := by
  intro hprincipal
  haveI : Submodule.IsPrincipal primeAboveTwo := hprincipal
  let a := Submodule.IsPrincipal.generator primeAboveTwo
  have hspan : Ideal.span ({a} : Set (𝓞 K)) = primeAboveTwo := by
    exact Ideal.span_singleton_generator primeAboveTwo
  have habs : (Algebra.norm ℤ a).natAbs = 2 := by
    rw [← Ideal.absNorm_span_singleton, hspan, absNorm_primeAboveTwo]
  obtain ⟨x, y, ha⟩ := exists_eq_smul_one_add_smul_theta a
  have hnorm : Algebra.norm ℤ a = x ^ 2 + 6 * y ^ 2 := by
    rw [ha, intNorm_eq_normForm]
  rw [hnorm, Int.natAbs_eq_iff] at habs
  rcases habs with h | h
  · exact normForm_ne_two x y h
  · have hnonneg : (0 : ℤ) ≤ x ^ 2 + 6 * y ^ 2 := by nlinarith [sq_nonneg x, sq_nonneg y]
    omega

/-- `3` is ramified: `(3) = (3, θ)²`. -/
theorem span_three_eq : Ideal.span {(3 : 𝓞 K)} = primeAboveThree ^ 2 := by
  rw [sq, primeAboveThree, Ideal.span_pair_mul_span_pair]
  apply le_antisymm
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have h9 := Ideal.subset_span
      (show (3 : 𝓞 K) * 3 ∈
        ({(3 : 𝓞 K) * 3, (3 : 𝓞 K) * thetaInt, thetaInt * 3,
          thetaInt * thetaInt} : Set (𝓞 K)) by simp)
    have hθ2 := Ideal.subset_span
      (show thetaInt * thetaInt ∈
        ({(3 : 𝓞 K) * 3, (3 : 𝓞 K) * thetaInt, thetaInt * 3,
          thetaInt * thetaInt} : Set (𝓞 K)) by simp)
    convert Ideal.add_mem _ h9 hθ2 using 1
    rw [show thetaInt * thetaInt = thetaInt ^ 2 by ring, thetaInt_sq]
    ring
  · rw [Ideal.span_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl | rfl
    · exact Ideal.mem_span_singleton.mpr ⟨(3 : 𝓞 K), by ring⟩
    · exact Ideal.mem_span_singleton.mpr ⟨thetaInt, by ring⟩
    · exact Ideal.mem_span_singleton.mpr ⟨thetaInt, by ring⟩
    · rw [show thetaInt * thetaInt = thetaInt ^ 2 by ring, thetaInt_sq]
      exact Ideal.mem_span_singleton.mpr ⟨(-2 : 𝓞 K), by ring⟩

/-- `(3, θ)` is a prime ideal of norm `3`, also non-principal (`x² + 6y² = 3` is
unsolvable). -/
theorem isPrime_primeAboveThree : primeAboveThree.IsPrime := by
  apply Ideal.isPrime_of_irreducible_absNorm
  have habs : Ideal.absNorm primeAboveThree = 3 := by
    have hspan : Ideal.absNorm (Ideal.span {(3 : 𝓞 K)}) = 9 := by
      have h := intNorm_eq_normForm 3 0
      have heq : (3 : 𝓞 K) = (3 : ℤ) • (1 : 𝓞 K) + (0 : ℤ) • thetaInt := by simp
      rw [Ideal.absNorm_span_singleton, heq, h]
      rfl
    have h := congrArg Ideal.absNorm span_three_eq
    rw [hspan, map_pow] at h
    nlinarith
  rw [habs]
  exact (Nat.irreducible_iff_nat_prime _).mpr (by norm_num)

/-- The elementary identity `7 = (1 + θ)(1 - θ)` in `ℤ[θ]` (norms: `1 + 6 = 7`). -/
theorem seven_eq_mul : (7 : 𝓞 K) = (1 + thetaInt) * (1 - thetaInt) := by
  ring_nf; rw [thetaInt_sq]; ring

/-- `7` splits with *principal* prime factors: `(7) = (1 + θ)(1 - θ)`, matching the
representation `7 = 1² + 6 · 1²` by the principal form. -/
theorem span_seven_eq :
    Ideal.span {(7 : 𝓞 K)} = Ideal.span {1 + thetaInt} * Ideal.span {1 - thetaInt} := by
  rw [Ideal.span_singleton_mul_span_singleton, ← seven_eq_mul]

/-- `(1 + θ)` is a prime ideal of norm `7`. -/
theorem isPrime_span_one_add_theta : (Ideal.span {1 + thetaInt}).IsPrime := by
  apply Ideal.isPrime_of_irreducible_absNorm
  have habs : Ideal.absNorm (Ideal.span {1 + thetaInt}) = 7 := by
    have h := intNorm_eq_normForm 1 1
    have heq : (1 : 𝓞 K) + thetaInt = (1 : ℤ) • (1 : 𝓞 K) + (1 : ℤ) • thetaInt := by
      simp
    rw [Ideal.absNorm_span_singleton, heq, h]
    rfl
  rw [habs]
  exact (Nat.irreducible_iff_nat_prime _).mpr (by norm_num)

/-- `5` splits, but with *non-principal* prime factors `(5, θ - 2)` and `(5, θ + 2)`:
`-6 ≡ 2² (mod 5)` yet `x² + 6y² = 5` has no integer solutions (the prime `5` is represented
by the non-principal genus form `2x² + 3y²` instead). -/
theorem span_five_eq :
    Ideal.span {(5 : 𝓞 K)} =
      Ideal.span {(5 : 𝓞 K), thetaInt - 2} * Ideal.span {(5 : 𝓞 K), thetaInt + 2} := by
  rw [Ideal.span_pair_mul_span_pair]
  apply le_antisymm
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have h25 : (5 : 𝓞 K) * 5 ∈
        Ideal.span
          ({(5 : 𝓞 K) * 5, (5 : 𝓞 K) * (thetaInt + 2), (thetaInt - 2) * 5,
            (thetaInt - 2) * (thetaInt + 2)} : Set (𝓞 K)) :=
      Ideal.subset_span (by simp)
    have hlast : (thetaInt - 2) * (thetaInt + 2) ∈
        Ideal.span
          ({(5 : 𝓞 K) * 5, (5 : 𝓞 K) * (thetaInt + 2), (thetaInt - 2) * 5,
            (thetaInt - 2) * (thetaInt + 2)} : Set (𝓞 K)) :=
      Ideal.subset_span (by simp)
    convert Ideal.add_mem _ h25 (Ideal.mul_mem_left _ (2 : 𝓞 K) hlast) using 1
    rw [show (thetaInt - 2) * (thetaInt + 2) = thetaInt ^ 2 - 4 by ring, thetaInt_sq]
    ring
  · rw [Ideal.span_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl | rfl
    · exact Ideal.mem_span_singleton.mpr ⟨(5 : 𝓞 K), by ring⟩
    · exact Ideal.mem_span_singleton.mpr ⟨thetaInt + 2, by ring⟩
    · exact Ideal.mem_span_singleton.mpr ⟨thetaInt - 2, by ring⟩
    · rw [show (thetaInt - 2) * (thetaInt + 2) = thetaInt ^ 2 - 4 by ring, thetaInt_sq]
      exact Ideal.mem_span_singleton.mpr ⟨(-2 : 𝓞 K), by ring⟩

/-- `(5, θ - 2)` is a non-principal prime of norm `5`. -/
theorem not_isPrincipal_primeAboveFive :
    ¬ Submodule.IsPrincipal (Ideal.span {(5 : 𝓞 K), thetaInt - 2}) := by
  sorry

/-- `13` is inert in `ℚ(√-6)`: `-6` is not a square mod `13`. -/
theorem isPrime_span_thirteen : (Ideal.span {(13 : 𝓞 K)}).IsPrime := by
  have habs169 : Ideal.absNorm (Ideal.span ({(13 : 𝓞 K)} : Set (𝓞 K))) = 169 := by
    have h := intNorm_eq_normForm 13 0
    have heq : (13 : 𝓞 K) = (13 : ℤ) • (1 : 𝓞 K) + (0 : ℤ) • thetaInt := by
      simp
    rw [Ideal.absNorm_span_singleton, heq, h]
    rfl
  have htop : Ideal.span ({(13 : 𝓞 K)} : Set (𝓞 K)) ≠ ⊤ := by
    intro h
    rw [h, Ideal.absNorm_top] at habs169
    norm_num at habs169
  obtain ⟨M, hMmax, hMle⟩ := Ideal.exists_le_maximal _ htop
  have hdvd : Ideal.absNorm M ∣ 169 := habs169 ▸ Ideal.absNorm_dvd_absNorm_of_le hMle
  have hM1 : Ideal.absNorm M ≠ 1 := by
    rw [Ne, Ideal.absNorm_eq_one_iff]
    exact hMmax.ne_top
  have hM13 : Ideal.absNorm M ≠ 13 := by
    intro hcard
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply] at hcard
    haveI : Finite ((𝓞 K) ⧸ M) := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
    haveI : Fintype ((𝓞 K) ⧸ M) := Fintype.ofFinite _
    have hcard' : Fintype.card ((𝓞 K) ⧸ M) = 13 := by
      rw [← Nat.card_eq_fintype_card]
      exact hcard
    let e := ZMod.ringEquivOfPrime ((𝓞 K) ⧸ M) (by norm_num) hcard'
    obtain ⟨t, ht⟩ := e.surjective (Ideal.Quotient.mk M thetaInt)
    have ht2 : t ^ 2 + 6 = 0 := by
      apply e.injective
      rw [map_add, map_pow, ht, map_ofNat, ← map_pow (Ideal.Quotient.mk M), thetaInt_sq]
      rw [map_zero, map_neg, map_ofNat]
      ring
    clear ht
    revert t
    decide
  have hM169 : Ideal.absNorm M = 169 := by
    obtain ⟨k, hk, hkeq⟩ := (Nat.dvd_prime_pow (show Nat.Prime 13 by norm_num)).mp
      (show Ideal.absNorm M ∣ 13 ^ 2 from by simpa using hdvd)
    interval_cases k
    · rw [pow_zero] at hkeq
      exact absurd hkeq hM1
    · rw [pow_one] at hkeq
      exact absurd hkeq hM13
    · rw [hkeq]
      norm_num
  have heq : Ideal.span ({(13 : 𝓞 K)} : Set (𝓞 K)) = M := by
    obtain ⟨C, hC⟩ := Ideal.dvd_iff_le.mpr hMle
    have hmul := _root_.map_mul Ideal.absNorm M C
    rw [← hC, habs169, hM169] at hmul
    have hC1 : Ideal.absNorm C = 1 := by
      nlinarith
    rw [hC, Ideal.absNorm_eq_one_iff.mp hC1, Ideal.mul_top]
  rw [heq]
  exact hMmax.isPrime

/-- The splitting law for `ℚ(√-6)`: a prime `p ∤ 24` splits into two distinct primes iff
`-6` is a square mod `p`, iff `p ≡ 1, 5, 7, 11 (mod 24)`. -/
theorem splits_iff_mod_twentyfour (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (hp3 : p ≠ 3) :
    (∃ P Q : Ideal (𝓞 K), P.IsPrime ∧ Q.IsPrime ∧ P ≠ Q ∧
      Ideal.span {(p : 𝓞 K)} = P * Q) ↔
        p % 24 = 1 ∨ p % 24 = 5 ∨ p % 24 = 7 ∨ p % 24 = 11 := by
  sorry

/-- A rational prime `p` ramifies in `ℚ(√-6)` iff `p ∈ {2, 3}`, i.e. iff `p` divides the
discriminant `-24`. -/
theorem ramified_iff (p : ℕ) (hp : p.Prime) :
    (∃ P : Ideal (𝓞 K), P.IsPrime ∧ Ideal.span {(p : 𝓞 K)} ≤ P ^ 2) ↔ p = 2 ∨ p = 3 := by
  constructor
  · rintro ⟨P, hP, hle2⟩
    haveI : P.IsPrime := hP
    have hple : Ideal.span {((p : ℕ) : 𝓞 K)} ≤ P :=
      hle2.trans (Ideal.pow_le_self (by norm_num))
    have hpmemP : ((p : ℕ) : 𝓞 K) ∈ P := hple (Ideal.mem_span_singleton_self _)
    have hpne : ((p : ℕ) : 𝓞 K) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
    have hPbot : P ≠ ⊥ := by
      intro h
      rw [h] at hpmemP
      exact hpne (Ideal.mem_bot.mp hpmemP)
    have hfin : Module.finrank ℤ (𝓞 K) = 2 := by
      rw [Module.finrank_eq_card_basis concreteIntegralBasis, Fintype.card_fin]
    have habsp : Ideal.absNorm (Ideal.span {((p : ℕ) : 𝓞 K)}) = p ^ 2 := by
      rw [Ideal.absNorm_span_singleton]
      have hcast : ((p : ℕ) : 𝓞 K) = algebraMap ℤ (𝓞 K) ((p : ℕ) : ℤ) := by
        push_cast
        rfl
      rw [hcast, Algebra.norm_algebraMap, hfin, Int.natAbs_pow, Int.natAbs_natCast]
    have habsPp2 : Ideal.absNorm P ∣ p ^ 2 :=
      habsp ▸ Ideal.absNorm_dvd_absNorm_of_le hple
    obtain ⟨k, hk2, hkeq⟩ := (Nat.dvd_prime_pow hp).mp habsPp2
    have hk0 : k ≠ 0 := by
      intro h0
      rw [h0, pow_zero] at hkeq
      exact hP.ne_top (Ideal.absNorm_eq_one_iff.mp hkeq)
    have hmap : Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span {((p : ℕ) : ℤ)}) =
        Ideal.span {((p : ℕ) : 𝓞 K)} := by
      rw [Ideal.map_span, Set.image_singleton]
      norm_num
    have hle2' : Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span {((p : ℕ) : ℤ)}) ≤
        P ^ 2 := by
      rw [hmap]
      exact hle2
    have hno3 : ¬ Ideal.map (algebraMap ℤ (𝓞 K)) (Ideal.span {((p : ℕ) : ℤ)}) ≤
        P ^ 3 := by
      intro h3
      rw [hmap] at h3
      have hd := Ideal.absNorm_dvd_absNorm_of_le h3
      rw [map_pow, habsp, hkeq, ← pow_mul] at hd
      rw [Nat.pow_dvd_pow_iff_le_right hp.one_lt] at hd
      omega
    have hidx : Ideal.ramificationIdx (Ideal.span {((p : ℕ) : ℤ)}) P ≠ 1 := by
      rw [Ideal.ramificationIdx_spec hle2' hno3]
      norm_num
    have hund : Ideal.under ℤ P = Ideal.span {((p : ℕ) : ℤ)} := by
      have hmem : ((p : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
        rw [Ideal.under, Ideal.mem_comap]
        have hcast2 : algebraMap ℤ (𝓞 K) ((p : ℕ) : ℤ) = ((p : ℕ) : 𝓞 K) := by
          push_cast
          rfl
        rw [hcast2]
        exact hpmemP
      have hle : Ideal.span {((p : ℕ) : ℤ)} ≤ Ideal.under ℤ P := by
        rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hmem
      have hprime : (Ideal.span {((p : ℕ) : ℤ)}).IsPrime :=
        (Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)).mpr
          (Nat.prime_iff_prime_int.mp hp)
      have hbot : Ideal.span {((p : ℕ) : ℤ)} ≠ ⊥ := by
        rw [Ne, Ideal.span_singleton_eq_bot]
        exact_mod_cast hp.ne_zero
      have hnetop : Ideal.under ℤ P ≠ ⊤ := by
        intro h
        have h1 : (1 : ℤ) ∈ Ideal.under ℤ P := h ▸ Submodule.mem_top
        rw [Ideal.under, Ideal.mem_comap, map_one] at h1
        exact hP.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
      exact ((hprime.isMaximal hbot).eq_of_le hnetop hle).symm
    have hunram : ¬ Algebra.IsUnramifiedAt ℤ P := by
      rw [Algebra.isUnramifiedAt_iff_of_isDedekindDomain hPbot, hund]
      exact hidx
    have hPdiff : P ∣ differentIdeal ℤ (𝓞 K) := dvd_differentIdeal_iff.mpr hunram
    have habsP24 : Ideal.absNorm P ∣ 24 := by
      have h := Ideal.absNorm_dvd_absNorm_of_le (Ideal.le_of_dvd hPdiff)
      rw [NumberField.absNorm_differentIdeal (K := K), numberField_discr_eq] at h
      simpa using h
    have hpdvd : p ∣ 24 := (hkeq ▸ dvd_pow_self p hk0).trans habsP24
    have hpor : p ∣ 2 ^ 3 ∨ p ∣ 3 := by
      exact hp.dvd_mul.mp (by simpa using hpdvd)
    rcases hpor with hp2pow | hp3dvd
    · left
      have hp2dvd : p ∣ 2 := hp.dvd_of_dvd_pow hp2pow
      exact (Nat.prime_dvd_prime_iff_eq hp (by norm_num)).mp hp2dvd
    · right
      exact (Nat.prime_dvd_prime_iff_eq hp (by norm_num)).mp hp3dvd
  · rintro (rfl | rfl)
    · refine ⟨primeAboveTwo, isPrime_primeAboveTwo, ?_⟩
      have hcast : ((2 : ℕ) : 𝓞 K) = (2 : 𝓞 K) := by norm_num
      rw [hcast, span_two_eq]
    · refine ⟨primeAboveThree, isPrime_primeAboveThree, ?_⟩
      have hcast : ((3 : ℕ) : 𝓞 K) = (3 : 𝓞 K) := by norm_num
      rw [hcast, span_three_eq]

/-! ## 6. Ring of units -/

/-- A torsion generator of `𝓞 Kˣ`, mathematically `-1`. -/
abbrev torsionGenerator : (𝓞 K)ˣ := -1

/-- The concrete torsion units `{1, -1}`. -/
def torsionUnits : Set ((𝓞 K)ˣ) := {u | ∃ k : Fin 2, u = torsionGenerator ^ k.val}

private theorem isTotallyComplex : NumberField.IsTotallyComplex K := by
  refine ⟨fun v => ?_⟩
  rw [NumberField.InfinitePlace.isComplex_iff]
  intro hreal
  set z := NumberField.InfinitePlace.embedding v θ with hz
  have hsq : z ^ 2 = (-6 : ℂ) := by
    rw [hz, ← map_pow, theta_sq]
    rw [map_neg, map_ofNat]
  have hconj := RingHom.congr_fun (NumberField.ComplexEmbedding.isReal_iff.mp hreal) θ
  rw [NumberField.ComplexEmbedding.conjugate_coe_eq, ← hz] at hconj
  have him : z.im = 0 := Complex.conj_eq_iff_im.mp hconj
  have hre := congrArg Complex.re hsq
  rw [sq, Complex.mul_re, him] at hre
  norm_num at hre
  nlinarith [sq_nonneg z.re]

/-- The torsion subgroup of `𝓞 Kˣ` is exactly `{1, -1}` (the discriminant is not `-3` or
`-4`, so there are no extra roots of unity). -/
theorem torsionUnits_eq : {u : (𝓞 K)ˣ | IsOfFinOrder u} = torsionUnits := by
  ext u
  constructor
  · intro hu
    obtain ⟨x, y, hxy⟩ := exists_eq_smul_one_add_smul_theta ((u : (𝓞 K)ˣ) : 𝓞 K)
    have hunit : IsUnit (x • (1 : 𝓞 K) + y • thetaInt) := by
      rw [← hxy]
      exact u.isUnit
    have hform := (isUnit_iff_normForm x y).mp hunit
    have hy0 : y ^ 2 = 0 := by nlinarith [sq_nonneg x, sq_nonneg y]
    have hy : y = 0 := sq_eq_zero_iff.mp hy0
    have hx2 : x ^ 2 = 1 := by nlinarith
    have hx_le : x ≤ 1 := by nlinarith [sq_nonneg (x - 1)]
    have hx_ge : -1 ≤ x := by nlinarith [sq_nonneg (x + 1)]
    interval_cases x
    · refine ⟨1, ?_⟩
      rw [show ((1 : Fin 2).val) = 1 from rfl, pow_one]
      apply Units.ext
      simpa [torsionGenerator, hy] using hxy
    · norm_num at hx2
    · refine ⟨0, ?_⟩
      rw [show ((0 : Fin 2).val) = 0 from rfl, pow_zero]
      apply Units.ext
      simpa [hy] using hxy
  · rintro ⟨k, rfl⟩
    refine isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by norm_num, ?_⟩
    rw [← pow_mul, mul_comm, pow_mul]
    simp [torsionGenerator]

/-- The torsion subgroup of `𝓞 Kˣ` has order `2`. -/
theorem torsionOrder_eq_two : NumberField.Units.torsionOrder K = 2 := by
  have hcard : Nat.card (NumberField.Units.torsion K) = 2 := by
    rw [Nat.card_eq_two_iff]
    have hmem1 : (1 : (𝓞 K)ˣ) ∈ NumberField.Units.torsion K :=
      isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by norm_num, by simp⟩
    have hmemn : (-1 : (𝓞 K)ˣ) ∈ NumberField.Units.torsion K := by
      change IsOfFinOrder _
      exact isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by norm_num, by simp⟩
    refine ⟨⟨1, hmem1⟩, ⟨-1, hmemn⟩, ?_, ?_⟩
    · intro h
      have hval := congrArg (fun z => ((z : (𝓞 K)ˣ) : 𝓞 K)) (Subtype.ext_iff.mp h)
      simp only [Units.val_one, Units.val_neg] at hval
      have h2 := congrArg (algebraMap (𝓞 K) K) hval
      simp only [map_one, map_neg] at h2
      exact two_ne_zero (by linear_combination h2 : (2 : K) = 0)
    · ext z
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true]
      have hz : (z : (𝓞 K)ˣ) ∈ {u : (𝓞 K)ˣ | IsOfFinOrder u} := z.2
      rw [torsionUnits_eq] at hz
      obtain ⟨k, hk⟩ := hz
      fin_cases k
      · left
        exact Subtype.ext (by simpa using hk)
      · right
        exact Subtype.ext (by simpa using hk)
  simpa [NumberField.Units.torsionOrder] using hcard

/-- `ℚ(√-6)` has no real embedding: the signature is `(0, 1)`. -/
theorem nrRealPlaces_eq_zero : NumberField.InfinitePlace.nrRealPlaces K = 0 := by
  haveI := isTotallyComplex
  exact NumberField.IsTotallyComplex.nrRealPlaces_eq_zero K

/-- The Dirichlet unit rank of the imaginary quadratic field `ℚ(√-6)` is `0`: the signature
is `(0, 1)`, so the rank is `r₁ + r₂ - 1 = 0` and the unit group is finite. -/
theorem unitRank_eq_zero : NumberField.Units.rank K = 0 := by
  have hcomplex : NumberField.InfinitePlace.nrComplexPlaces K = 1 := by
    have h := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
    rw [nrRealPlaces_eq_zero, degree_eq_two] at h
    omega
  rw [NumberField.Units.rank, NumberField.InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces,
    nrRealPlaces_eq_zero, hcomplex]

/-- Every unit of `ℤ[√-6]` is `1` or `-1`: the unit group is exactly the torsion `{±1}`. -/
theorem unit_eq_one_or_neg_one (u : (𝓞 K)ˣ) : u = 1 ∨ u = -1 := by
  obtain ⟨⟨ζ, f⟩, hζu, -⟩ := NumberField.Units.exist_unique_eq_mul_prod (K := K) u
  have hu_tors : u ∈ {u : (𝓞 K)ˣ | IsOfFinOrder u} := by
    have huζ : u = ζ := by
      rw [← mul_one ζ.1, hζu]
      apply congr_arg
      rw [← Finset.prod_empty]
      congr
      rw [Finset.univ_eq_empty_iff, unitRank_eq_zero]
      infer_instance
    rw [huζ]
    exact ζ.2
  rw [torsionUnits_eq] at hu_tors
  obtain ⟨k, hk⟩ := hu_tors
  fin_cases k
  · left
    simpa [torsionGenerator] using hk
  · right
    simpa [torsionGenerator] using hk

/-- The unit group is `μ₂` as an abstract group. -/
theorem unitGroupStructure : Nonempty ((𝓞 K)ˣ ≃* Multiplicative (ZMod 2)) := by
  have hcard : Nat.card ((𝓞 K)ˣ) = 2 := by
    rw [Nat.card_eq_two_iff]
    refine ⟨1, -1, ?_, ?_⟩
    · intro h
      have hval := congrArg (fun z => ((z : (𝓞 K)ˣ) : 𝓞 K)) h
      simp only [Units.val_one, Units.val_neg] at hval
      have h2 := congrArg (algebraMap (𝓞 K) K) hval
      simp only [map_one, map_neg] at h2
      exact two_ne_zero (by linear_combination h2 : (2 : K) = 0)
    · ext u
      simp [unit_eq_one_or_neg_one u]
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact ⟨mulEquivOfPrimeCardEq hcard (by
    rw [show Nat.card (Multiplicative (ZMod 2)) = Nat.card (ZMod 2) from rfl, Nat.card_zmod])⟩

/-- The regulator of a field with finite unit group is `1` (empty determinant). -/
theorem regulator_eq_one : NumberField.Units.regulator K = 1 := by
  classical
  rw [NumberField.Units.regulator_eq_det']
  have hcard :
      Fintype.card
        {w : NumberField.InfinitePlace K // w ≠ NumberField.Units.dirichletUnitTheorem.w₀} = 0 := by
    rw [Fintype.card_congr (NumberField.Units.equivFinRank K).symm]
    simp [unitRank_eq_zero]
  have hdet : (Matrix.of fun i ↦
      (NumberField.Units.logEmbedding K)
        (Additive.ofMul
          (NumberField.Units.fundSystem K ((NumberField.Units.equivFinRank K).symm i)))).det =
      (1 : ℝ) := by
    exact Matrix.det_eq_one_of_card_eq_zero hcard
  rw [hdet]
  simp

/-! ## 7. Class group -/

/-- The ramified prime `(2, θ)` as an element of the monoid of nonzero ideals: the concrete
representative of the nontrivial ideal class. -/
noncomputable def ramifiedIdealOverTwo : (Ideal (𝓞 K))⁰ :=
  ⟨primeAboveTwo, by
    rw [← Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors]
    rw [absNorm_primeAboveTwo]
    norm_num⟩

/-- The unit ideal as the representative of the trivial ideal class. -/
abbrev unitIdealRepresentative : (Ideal (𝓞 K))⁰ := ⟨(⊤ : Ideal (𝓞 K)), by simp⟩

/-- **The class number of `ℚ(√-6)` is `2`**: the Minkowski bound is `(2/π)√24 ≈ 3.12`, the
primes `2` and `3` below it generate the class group, and their classes coincide and are
nontrivial (`(2,θ)(3,θ) = (θ)` is principal while `(2, θ)` is not). -/
theorem classNumber_eq_two : NumberField.classNumber K = 2 := by
  sorry

/-- `ℤ[√-6]` is *not* a principal ideal domain — the smallest-discriminant imaginary
quadratic examples of class number `2` are `d = -5, -6`. -/
theorem not_isPrincipalIdealRing : ¬ IsPrincipalIdealRing (𝓞 K) := by
  intro hpid
  exact not_isPrincipal_primeAboveTwo (IsPrincipalIdealRing.principal primeAboveTwo)

/-- The ring of integers of `ℚ(√-6)` is not norm-Euclidean. -/
theorem not_normEuclidean :
    ¬ ∀ a b : 𝓞 K, b ≠ 0 →
      ∃ q r : 𝓞 K, a = b * q + r ∧
        (Algebra.norm ℤ r).natAbs < (Algebra.norm ℤ b).natAbs := by
  sorry

/-- The class group of `𝓞 K` is cyclic of order `2`. -/
theorem classGroupStructure : Nonempty (ClassGroup (𝓞 K) ≃* Multiplicative (ZMod 2)) := by
  have hcard : Nat.card (ClassGroup (𝓞 K)) = 2 := by
    simpa [NumberField.classNumber, Nat.card_eq_fintype_card] using classNumber_eq_two
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact ⟨mulEquivOfPrimeCardEq hcard (by
    rw [show Nat.card (Multiplicative (ZMod 2)) = Nat.card (ZMod 2) from rfl, Nat.card_zmod])⟩

/-- The class of the ramified prime `(2, θ)` is nontrivial in the class group. -/
theorem classGroup_mk0_ramified_ne :
    ClassGroup.mk0 ramifiedIdealOverTwo ≠ ClassGroup.mk0 unitIdealRepresentative := by
  intro h
  have hprincipal : (ramifiedIdealOverTwo : Ideal (𝓞 K)).IsPrincipal := by
    rw [← ClassGroup.mk0_eq_one_iff (SetLike.coe_mem ramifiedIdealOverTwo)]
    rw [h]
    rw [ClassGroup.mk0_eq_one_iff (SetLike.coe_mem unitIdealRepresentative)]
    infer_instance
  exact not_isPrincipal_primeAboveTwo (by simpa [ramifiedIdealOverTwo] using hprincipal)

/-- Every ideal class is represented by either `𝓞 K` or the ramified prime `(2, θ)`. -/
theorem classGroupRepresentatives (C : ClassGroup (𝓞 K)) :
    C = ClassGroup.mk0 unitIdealRepresentative ∨ C = ClassGroup.mk0 ramifiedIdealOverTwo := by
  have hcard : Nat.card (ClassGroup (𝓞 K)) = 2 := by
    simpa [NumberField.classNumber, Nat.card_eq_fintype_card] using classNumber_eq_two
  obtain ⟨y, _hy_ne, hy_unique⟩ :=
    (Nat.card_eq_two_iff' (ClassGroup.mk0 unitIdealRepresentative)).mp hcard
  have hram_eq : ClassGroup.mk0 ramifiedIdealOverTwo = y :=
    hy_unique (ClassGroup.mk0 ramifiedIdealOverTwo) classGroup_mk0_ramified_ne
  by_cases hC : C = ClassGroup.mk0 unitIdealRepresentative
  · exact Or.inl hC
  · exact Or.inr ((hy_unique C hC).trans hram_eq.symm)

/-! ## 8. Failure of unique factorisation -/

/-- The two essentially different factorisations of `6` in `ℤ[√-6]`: `6 = 2 · 3` and
`6 = -θ²` (i.e. `6 = -√-6 · √-6`). -/
theorem six_eq_neg_theta_sq : (6 : 𝓞 K) = -(thetaInt * thetaInt) := by
  rw [← sq, thetaInt_sq]
  ring

/-- `2` is irreducible in `ℤ[√-6]` (no element has norm `2`). -/
theorem irreducible_two : Irreducible (2 : 𝓞 K) := by
  refine ⟨?_, ?_⟩
  · intro hunit
    have hnorm2 : Algebra.norm ℤ (2 : 𝓞 K) = 4 := by
      have h := intNorm_eq_normForm 2 0
      have heq : (2 : 𝓞 K) = (2 : ℤ) • (1 : 𝓞 K) + (0 : ℤ) • thetaInt := by
        simp
      rw [← heq] at h
      exact h
    have hunitnorm := (isUnit_iff_intNorm_eq_one (2 : 𝓞 K)).mp hunit
    rw [hnorm2] at hunitnorm
    norm_num at hunitnorm
  · intro a b hmul
    by_cases ha : IsUnit a
    · exact Or.inl ha
    by_cases hb : IsUnit b
    · exact Or.inr hb
    exfalso
    have hN2 : Algebra.norm ℤ (2 : 𝓞 K) = 4 := by
      have h := intNorm_eq_normForm 2 0
      have heq : (2 : 𝓞 K) = (2 : ℤ) • (1 : 𝓞 K) + (0 : ℤ) • thetaInt := by
        simp
      rw [← heq] at h
      exact h
    have hmulN : Algebra.norm ℤ a * Algebra.norm ℤ b = 4 := by
      rw [← map_mul, ← hmul, hN2]
    let A : ℤ := Algebra.norm ℤ a
    let B : ℤ := Algebra.norm ℤ b
    have hAB : A * B = 4 := by simpa [A, B] using hmulN
    have hA_nonneg : 0 ≤ A := by simpa [A] using intNorm_nonneg a
    have hB_nonneg : 0 ≤ B := by simpa [B] using intNorm_nonneg b
    have hA_ne1 : A ≠ 1 := by
      intro hA1
      exact ha ((isUnit_iff_intNorm_eq_one a).mpr (by simpa [A] using hA1))
    have hB_ne1 : B ≠ 1 := by
      intro hB1
      exact hb ((isUnit_iff_intNorm_eq_one b).mpr (by simpa [B] using hB1))
    have hA_ne2 : A ≠ 2 := by
      intro hA2
      exact intNorm_ne_two a (by simpa [A] using hA2)
    have hB_pos : 0 < B := by nlinarith
    have hA_le : A ≤ 4 := by nlinarith
    interval_cases A
    · omega
    · exact hA_ne1 rfl
    · exact hA_ne2 rfl
    · omega
    · have hB1 : B = 1 := by nlinarith
      exact hB_ne1 hB1

/-- `3` is irreducible in `ℤ[√-6]` (no element has norm `3`). -/
theorem irreducible_three : Irreducible (3 : 𝓞 K) := by
  refine ⟨?_, ?_⟩
  · intro hunit
    have hnorm3 : Algebra.norm ℤ (3 : 𝓞 K) = 9 := by
      have h := intNorm_eq_normForm 3 0
      have heq : (3 : 𝓞 K) = (3 : ℤ) • (1 : 𝓞 K) + (0 : ℤ) • thetaInt := by
        simp
      rw [← heq] at h
      exact h
    have hunitnorm := (isUnit_iff_intNorm_eq_one (3 : 𝓞 K)).mp hunit
    rw [hnorm3] at hunitnorm
    norm_num at hunitnorm
  · intro a b hmul
    by_cases ha : IsUnit a
    · exact Or.inl ha
    by_cases hb : IsUnit b
    · exact Or.inr hb
    exfalso
    have hN3 : Algebra.norm ℤ (3 : 𝓞 K) = 9 := by
      have h := intNorm_eq_normForm 3 0
      have heq : (3 : 𝓞 K) = (3 : ℤ) • (1 : 𝓞 K) + (0 : ℤ) • thetaInt := by
        simp
      rw [← heq] at h
      exact h
    have hmulN : Algebra.norm ℤ a * Algebra.norm ℤ b = 9 := by
      rw [← map_mul, ← hmul, hN3]
    let A : ℤ := Algebra.norm ℤ a
    let B : ℤ := Algebra.norm ℤ b
    have hAB : A * B = 9 := by simpa [A, B] using hmulN
    have hA_nonneg : 0 ≤ A := by simpa [A] using intNorm_nonneg a
    have hB_nonneg : 0 ≤ B := by simpa [B] using intNorm_nonneg b
    have hA_ne1 : A ≠ 1 := by
      intro hA1
      exact ha ((isUnit_iff_intNorm_eq_one a).mpr (by simpa [A] using hA1))
    have hB_ne1 : B ≠ 1 := by
      intro hB1
      exact hb ((isUnit_iff_intNorm_eq_one b).mpr (by simpa [B] using hB1))
    have hA_ne3 : A ≠ 3 := by
      intro hA3
      exact intNorm_ne_three a (by simpa [A] using hA3)
    have hB_pos : 0 < B := by nlinarith
    have hA_le : A ≤ 9 := by nlinarith
    interval_cases A
    · omega
    · exact hA_ne1 rfl
    · omega
    · exact hA_ne3 rfl
    · omega
    · omega
    · omega
    · omega
    · omega
    · have hB1 : B = 1 := by nlinarith
      exact hB_ne1 hB1

/-- `θ = √-6` is irreducible in `ℤ[√-6]` (its norm `6` only factors as `2 · 3`, and neither
norm is attained). -/
theorem irreducible_theta : Irreducible thetaInt := by
  refine ⟨?_, ?_⟩
  · intro hunit
    have hnormθ : Algebra.norm ℤ thetaInt = 6 := by
      have h := intNorm_eq_normForm 0 1
      have heq : thetaInt = (0 : ℤ) • (1 : 𝓞 K) + (1 : ℤ) • thetaInt := by
        simp
      rw [← heq] at h
      exact h
    have hunitnorm := (isUnit_iff_intNorm_eq_one thetaInt).mp hunit
    rw [hnormθ] at hunitnorm
    norm_num at hunitnorm
  · intro a b hmul
    by_cases ha : IsUnit a
    · exact Or.inl ha
    by_cases hb : IsUnit b
    · exact Or.inr hb
    exfalso
    have hNθ : Algebra.norm ℤ thetaInt = 6 := by
      have h := intNorm_eq_normForm 0 1
      have heq : thetaInt = (0 : ℤ) • (1 : 𝓞 K) + (1 : ℤ) • thetaInt := by
        simp
      rw [← heq] at h
      exact h
    have hmulN : Algebra.norm ℤ a * Algebra.norm ℤ b = 6 := by
      rw [← map_mul, ← hmul, hNθ]
    let A : ℤ := Algebra.norm ℤ a
    let B : ℤ := Algebra.norm ℤ b
    have hAB : A * B = 6 := by simpa [A, B] using hmulN
    have hA_nonneg : 0 ≤ A := by simpa [A] using intNorm_nonneg a
    have hB_nonneg : 0 ≤ B := by simpa [B] using intNorm_nonneg b
    have hA_ne1 : A ≠ 1 := by
      intro hA1
      exact ha ((isUnit_iff_intNorm_eq_one a).mpr (by simpa [A] using hA1))
    have hB_ne1 : B ≠ 1 := by
      intro hB1
      exact hb ((isUnit_iff_intNorm_eq_one b).mpr (by simpa [B] using hB1))
    have hA_ne2 : A ≠ 2 := by
      intro hA2
      exact intNorm_ne_two a (by simpa [A] using hA2)
    have hA_ne3 : A ≠ 3 := by
      intro hA3
      exact intNorm_ne_three a (by simpa [A] using hA3)
    have hB_pos : 0 < B := by nlinarith
    have hA_le : A ≤ 6 := by nlinarith
    interval_cases A
    · omega
    · exact hA_ne1 rfl
    · exact hA_ne2 rfl
    · exact hA_ne3 rfl
    · omega
    · omega
    · have hB1 : B = 1 := by nlinarith
      exact hB_ne1 hB1

/-- `2` is irreducible but not prime: it divides `θ · θ = -6` without dividing `θ`. Hence
`ℤ[√-6]` is not a unique factorisation domain. -/
theorem two_not_prime : ¬ Prime (2 : 𝓞 K) := by
  intro hprime
  have hnot_dvd : ¬ (2 : 𝓞 K) ∣ thetaInt := by
    rintro ⟨a, ha⟩
    have hmem : thetaInt ∈ Ideal.span ({(2 : 𝓞 K)} : Set (𝓞 K)) := by
      exact Ideal.mem_span_singleton.mpr ⟨a, by rw [ha]⟩
    have heq : primeAboveTwo = Ideal.span ({(2 : 𝓞 K)} : Set (𝓞 K)) := by
      apply le_antisymm
      · rw [primeAboveTwo, Ideal.span_le]
        intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with rfl | rfl
        · exact Ideal.mem_span_singleton_self _
        · exact hmem
      · rw [primeAboveTwo]
        apply Ideal.span_mono
        intro z hz
        simp only [Set.mem_singleton_iff] at hz
        simp [hz]
    have hnorm := congrArg Ideal.absNorm heq
    have hspan : Ideal.absNorm (Ideal.span ({(2 : 𝓞 K)} : Set (𝓞 K))) = 4 := by
      have h := intNorm_eq_normForm 2 0
      have heq2 : (2 : 𝓞 K) = (2 : ℤ) • (1 : 𝓞 K) + (0 : ℤ) • thetaInt := by
        simp
      rw [Ideal.absNorm_span_singleton, heq2, h]
      rfl
    rw [absNorm_primeAboveTwo, hspan] at hnorm
    norm_num at hnorm
  have hdiv : (2 : 𝓞 K) ∣ thetaInt * thetaInt := by
    refine ⟨(-3 : 𝓞 K), ?_⟩
    rw [show thetaInt * thetaInt = thetaInt ^ 2 by ring, thetaInt_sq]
    ring
  rcases hprime.dvd_or_dvd hdiv with h | h
  · exact hnot_dvd h
  · exact hnot_dvd h

/-- `ℤ[√-6]` is not a unique factorisation monoid (equivalently, class number `> 1`). -/
theorem not_uniqueFactorizationMonoid : ¬ UniqueFactorizationMonoid (𝓞 K) := by
  intro hufd
  have hpid : IsPrincipalIdealRing (𝓞 K) := by
    exact IsPrincipalIdealRing.of_isDedekindDomain_of_uniqueFactorizationMonoid (𝓞 K)
  exact not_isPrincipalIdealRing hpid

/-! ## 9. Galois group -/

/-- The identity automorphism of `ℚ(√-6)`. -/
noncomputable def idAut : K ≃ₐ[ℚ] K := AlgEquiv.refl

/-- The nontrivial conjugation automorphism, sending `θ` to `-θ` (complex conjugation under
any embedding into `ℂ`). -/
noncomputable def conjugation : K ≃ₐ[ℚ] K := by
  exact conj'

/-- The conjugation automorphism sends `θ` to `-θ`. -/
theorem conjugation_apply_theta : conjugation θ = -θ := by
  exact conj'_omega

/-- Quadratic extensions are Galois: `ℚ(√-6)/ℚ` is a Galois extension. -/
instance : Algebra.IsQuadraticExtension ℚ K where
  finrank_eq_two' := degree_eq_two

theorem isGalois : IsGalois ℚ K := by
  infer_instance

/-- Every `ℚ`-automorphism of `K` is the identity or the conjugation. -/
theorem aut_eq_or (σ : K ≃ₐ[ℚ] K) : σ = idAut ∨ σ = conjugation := by
  have hsq : (σ θ) ^ 2 = (-6 : K) := by
    rw [← map_pow, theta_sq]
    rw [show (-6 : K) = algebraMap ℚ K (-6) by norm_num]
    exact σ.commutes (-6)
  have hfactor : (σ θ - θ) * (σ θ + θ) = 0 := by
    have hθ := theta_sq
    linear_combination hsq - hθ
  have hext : ∀ τ : K ≃ₐ[ℚ] K, σ θ = τ θ → σ = τ := by
    intro τ h
    have hgen : (σ : K →ₐ[ℚ] K) = (τ : K →ₐ[ℚ] K) := QuadraticAlgebra.algHom_ext h
    exact AlgEquiv.ext fun x => AlgHom.congr_fun hgen x
  rcases mul_eq_zero.mp hfactor with h | h
  · exact Or.inl (hext idAut (by rw [sub_eq_zero] at h; exact h))
  · refine Or.inr (hext conjugation ?_)
    rw [conjugation_apply_theta]
    linear_combination h

/-- The Galois group of `ℚ(√-6)/ℚ` is cyclic of order `2`. -/
theorem galoisGroupStructure : Nonempty ((K ≃ₐ[ℚ] K) ≃* Multiplicative (ZMod 2)) := by
  have hconj_ne : conjugation ≠ idAut := by
    intro h
    have h1 : conjugation θ = θ := by rw [h]; rfl
    rw [conjugation_apply_theta] at h1
    have h2 : (2 : K) * θ = 0 := by linear_combination -h1
    rcases mul_eq_zero.mp h2 with h3 | h3
    · norm_num at h3
    · have h4 := theta_sq
      rw [h3] at h4
      norm_num at h4
  have hcard : Nat.card (K ≃ₐ[ℚ] K) = 2 := by
    rw [Nat.card_eq_two_iff]
    refine ⟨idAut, conjugation, Ne.symm hconj_ne, ?_⟩
    ext σ
    simp [aut_eq_or σ]
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact ⟨mulEquivOfPrimeCardEq hcard (by
    rw [show Nat.card (Multiplicative (ZMod 2)) = Nat.card (ZMod 2) from rfl, Nat.card_zmod])⟩

end XYin.NumberField.New.SqrtNegSixQuadraticAlgebra
