import XYin.NumberField.FieldExamples.CyclotomicThree.PrimeSplitting

noncomputable section

open scoped NumberField nonZeroDivisors Real ENNReal

open Module NumberField Polynomial

namespace NumberField.CyclotomicThree

private theorem zeta_pow_three : ζ ^ 3 = 1 :=
  zeta_isPrimitiveRoot.pow_eq_one

/-! ## 6. Ring of units -/

/-- The unit corresponding to `ζ`. -/
abbrev etaUnit : OKˣ :=
  (zeta_isPrimitiveRoot.toInteger_isPrimitiveRoot.isUnit (by decide)).unit

/--
The unit group is finite here: every unit is one of
`±1`, `±ζ`, `±ζ²`.
-/
theorem unit_mem_unitsList (u : OKˣ) :
    u ∈ ([1, -1, etaUnit, -etaUnit, etaUnit ^ 2, -(etaUnit ^ 2)] : List OKˣ) := by
  simpa [etaUnit] using IsCyclotomicExtension.Rat.Three.Units.mem zeta_isPrimitiveRoot u

/-- Every unit of `𝓞 ℚ(ζ₃)` is one of `±1`, `±ζ`, `±ζ²`. -/
theorem unit_eq_one_or_neg_one_or_eta (u : OKˣ) :
    u = 1 ∨ u = -1 ∨ u = etaUnit ∨ u = -etaUnit ∨ u = etaUnit ^ 2 ∨
      u = -(etaUnit ^ 2) := by
  simpa using unit_mem_unitsList u

/-- The torsion subgroup of the unit group has order `6`. -/
theorem torsionOrder_eq_six : Units.torsionOrder K = 6 := by
  rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := 3) (K := K)]
  norm_num

/-- The field `ℚ(ζ₃)` has no real infinite places. -/
theorem nrRealPlaces_eq_zero : InfinitePlace.nrRealPlaces K = 0 := by
  exact IsCyclotomicExtension.Rat.nrRealPlaces_eq_zero (n := 3) K (by norm_num)

/-- The field `ℚ(ζ₃)` has one complex infinite place. -/
theorem nrComplexPlaces_eq_one : InfinitePlace.nrComplexPlaces K = 1 := by
  rw [IsCyclotomicExtension.Rat.nrComplexPlaces_eq_totient_div_two (n := 3) K]
  rw [Nat.totient_prime Nat.prime_three]

/-- Dirichlet's unit rank is `0` for this imaginary quadratic field: the signature is
`(r₁, r₂) = (0, 1)`, so the rank is `r₁ + r₂ - 1 = 0`. -/
theorem unitRank_eq_zero : Units.rank K = 0 := by
  dsimp [Units.rank]
  rw [InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces,
    IsCyclotomicExtension.Rat.nrRealPlaces_eq_zero (n := 3) K (by norm_num),
    IsCyclotomicExtension.Rat.nrComplexPlaces_eq_totient_div_two (n := 3) K]
  rw [Nat.totient_prime Nat.prime_three]

/-- The unit group is the finite cyclic group `μ₆` as an abstract abelian group: in rank `0`
the units are exactly the roots of unity, generated by `-ζ`. -/
theorem unitGroupStructure : Nonempty (OKˣ ≃* Multiplicative (ZMod 6)) := by
  have htorsion : ∀ u : OKˣ, u ∈ Units.torsion K := by
    intro u
    change IsOfFinOrder u
    have hmem := unit_mem_unitsList u
    fin_cases hmem <;> rw [isOfFinOrder_iff_pow_eq_one]
    · exact ⟨1, by norm_num⟩
    · exact ⟨2, by norm_num, by simp⟩
    · exact ⟨3, by norm_num, by ext; exact zeta_pow_three⟩
    · refine ⟨6, by norm_num, ?_⟩
      ext
      change ((-ζ : K) ^ 6 : K) = 1
      rw [show (-ζ : K) ^ 6 = (ζ ^ 3) ^ 2 by ring, zeta_pow_three]
      norm_num
    · refine ⟨3, by norm_num, ?_⟩
      ext
      change ((ζ ^ 2 : K) ^ 3 : K) = 1
      rw [show (ζ ^ 2 : K) ^ 3 = (ζ ^ 3) ^ 2 by ring, zeta_pow_three]
      norm_num
    · refine ⟨6, by norm_num, ?_⟩
      ext
      change ((-(ζ ^ 2) : K) ^ 6 : K) = 1
      rw [show (-(ζ ^ 2) : K) ^ 6 = (ζ ^ 3) ^ 4 by ring, zeta_pow_three]
      norm_num
  have hcyc : IsCyclic OKˣ := by
    exact isCyclic_of_surjective (Subgroup.subtype (Units.torsion K)) (by
      intro u
      exact ⟨⟨u, htorsion u⟩, rfl⟩)
  have hcard : Nat.card OKˣ = 6 := by
    let e : OKˣ ≃ Units.torsion K :=
      { toFun := fun u => ⟨u, htorsion u⟩
        invFun := fun u => u.1
        left_inv := fun u => rfl
        right_inv := fun u => by ext; rfl }
    rw [← torsionOrder_eq_six, Units.torsionOrder, ← Nat.card_eq_fintype_card]
    exact Nat.card_congr e
  have htarget : Nat.card (Multiplicative (ZMod 6)) = 6 := by
    rw [show Nat.card (Multiplicative (ZMod 6)) = Nat.card (ZMod 6) from rfl, Nat.card_zmod]
  haveI : IsCyclic OKˣ := hcyc
  exact ⟨mulEquivOfCyclicCardEq (G := OKˣ) (G' := Multiplicative (ZMod 6))
    (hcard.trans htarget.symm)⟩

/-- The regulator of `ℚ(ζ₃)` is `1`: the unit lattice is the zero lattice in rank `0`, with
covolume `1`. -/
theorem regulator_eq_one : Units.regulator K = 1 := by
  classical
  rw [Units.regulator_eq_det']
  have hcard : Fintype.card {w : InfinitePlace K // w ≠ Units.dirichletUnitTheorem.w₀} = 0 := by
    rw [Fintype.card_congr (Units.equivFinRank K).symm]
    simp [unitRank_eq_zero]
  have hdet : (Matrix.of fun i ↦
      (Units.logEmbedding K)
        (Additive.ofMul
          (Units.fundSystem K ((Units.equivFinRank K).symm i)))).det = (1 : ℝ) := by
    exact Matrix.det_eq_one_of_card_eq_zero hcard
  rw [hdet]
  simp


end NumberField.CyclotomicThree
