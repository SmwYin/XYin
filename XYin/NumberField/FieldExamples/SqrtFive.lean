import Mathlib

/-!
# The real quadratic field `ℚ(√5)`

For `5 ≡ 1 [MOD 4]`, the integral basis is not `[1, √5]`; it is `[1, (1 + √5) / 2]`. This
file uses the golden-ratio generator `φ = (1 + √5) / 2`, satisfying `φ ^ 2 = φ + 1`, realised
as `QuadraticAlgebra ℚ 1 1`. Main arithmetic invariants:

* degree `2`, golden generator `φ`, the radical `√5` presentation (section 1);
* integral basis `1, φ`, ring of integers `ℤ[φ]` (section 2);
* discriminant `5` (section 3);
* the norm form `x² + xy - y²` and its Pell-type unit equation, solved by consecutive
  Fibonacci pairs (section 4);
* splitting of rational primes: `5` ramifies as `(√5)²`, `11` splits, `2` and `3` are inert,
  and the splitting law: `p ≠ 5` splits iff `p ≡ ±1 (mod 5)` (section 5);
* unit group `{±1} × φ^ℤ`, signature `(2, 0)`, regulator `log φ` (section 6);
* class number one (section 7);
* the norm-Euclidean property (section 8);
* Galois group `C₂`, generated by the conjugation `φ ↦ 1 - φ` (section 9).
-/

noncomputable section

attribute [-instance] DivisionRing.toRatAlgebra

open scoped NumberField nonZeroDivisors Real ENNReal QuadraticAlgebra

open Module NumberField Polynomial

namespace XYin.NumberField.SqrtFive

/-! ## 1. Basics -/

instance : Fact (∀ r : ℚ, r ^ 2 ≠ (1 : ℚ) + (1 : ℚ) * r) := by
  refine ⟨?_⟩
  intro r hr
  have hsquare : IsSquare (5 : ℚ) := by
    rw [isSquare_iff_exists_sq]
    refine ⟨2 * r - 1, ?_⟩
    nlinarith
  norm_num at hsquare

/-- The real quadratic field `ℚ(√5)`, generated by `φ = (1 + √5) / 2`. -/
abbrev QSqrtFive : Type := QuadraticAlgebra ℚ (1 : ℚ) (1 : ℚ)

example : Field QSqrtFive := by infer_instance

instance : FiniteDimensional ℚ QSqrtFive :=
  (QuadraticAlgebra.basis (1 : ℚ) (1 : ℚ)).finiteDimensional_of_finite

instance : NumberField QSqrtFive :=
  NumberField.of_module_finite ℚ QSqrtFive

/-- The extension degree of `ℚ(√5)` over `ℚ` is `2`. -/
theorem degree_eq_two : Module.finrank ℚ QSqrtFive = 2 := by
  sorry

instance : Algebra.IsQuadraticExtension ℚ QSqrtFive where
  finrank_eq_two' := by
    sorry

/-- The golden-ratio generator `φ`, satisfying `φ ^ 2 = φ + 1`. -/
abbrev goldenRoot : QSqrtFive := QuadraticAlgebra.omega

theorem goldenRoot_sq : goldenRoot ^ 2 = goldenRoot + 1 := by
  change (⟨0, 1⟩ : QSqrtFive) ^ 2 = ⟨0, 1⟩ + ⟨1, 0⟩
  ext <;> simp [pow_two]

/-! ### The `AdjoinRoot` presentation -/

/-- The polynomial `X² - X - 1`, whose root is the golden ratio. -/
abbrev goldenPolynomial : ℚ[X] :=
  C (1 : ℚ) * X ^ 2 + C (-1 : ℚ) * X + C (-1 : ℚ)

instance : Fact (Irreducible goldenPolynomial) := by
  exact ⟨by
    sorry⟩

/-- The same field, now presented by adjoining a root of `X² - X - 1`. -/
abbrev QSqrtFiveAdjoinRoot : Type := AdjoinRoot goldenPolynomial

/-- The formal golden-ratio root in the `AdjoinRoot` presentation. -/
abbrev goldenAdjoinRoot : QSqrtFiveAdjoinRoot := AdjoinRoot.root goldenPolynomial

theorem goldenAdjoinRoot_sq :
    goldenAdjoinRoot ^ 2 = goldenAdjoinRoot + 1 := by
  sorry

/-- The `AdjoinRoot` presentation is equivalent to the quadratic-algebra model. -/
noncomputable def goldenAdjoinRootEquivGolden :
    QSqrtFiveAdjoinRoot ≃ₐ[ℚ] QSqrtFive := by
  sorry

theorem goldenAdjoinRootEquivGolden_root :
    goldenAdjoinRootEquivGolden goldenAdjoinRoot = goldenRoot := by
  sorry

/-- The square root of `5` recovered from `φ`: `√5 = 2φ - 1`. -/
abbrev sqrtFiveRoot : QSqrtFive := 2 * goldenRoot - 1

theorem sqrtFiveRoot_sq : sqrtFiveRoot ^ 2 = (5 : QSqrtFive) := by
  rw [sqrtFiveRoot]
  calc
    (2 * goldenRoot - 1) ^ 2 = 4 * goldenRoot ^ 2 - 4 * goldenRoot + 1 := by ring
    _ = 5 := by rw [goldenRoot_sq]; ring

theorem goldenRoot_eq_half_sqrtFiveRoot_add_one :
    goldenRoot = (sqrtFiveRoot + 1) / 2 := by
  rw [sqrtFiveRoot]
  field_simp
  ring

theorem goldenRoot_isIntegral : IsIntegral ℤ goldenRoot := by
  refine ⟨X ^ 2 - X - 1, ?_, ?_⟩
  · monicity
    norm_num
  · simp [goldenRoot_sq]

/-! ### The `QuadraticAlgebra ℚ 5 0` presentation -/

instance : Fact (∀ r : ℚ, r ^ 2 ≠ (5 : ℚ) + (0 : ℚ) * r) := by
  refine ⟨?_⟩
  intro r hr
  have hsquare : IsSquare (5 : ℚ) := by
    rw [isSquare_iff_exists_sq]
    refine ⟨r, ?_⟩
    nlinarith
  norm_num at hsquare

/-- The same field, now presented with a generator whose square is `5`. -/
abbrev QSqrtFiveRadical : Type := QuadraticAlgebra ℚ (5 : ℚ) 0

example : Field QSqrtFiveRadical := by infer_instance

/-- The distinguished square root of `5` in the radical presentation. -/
abbrev sqrtFiveRadicalRoot : QSqrtFiveRadical := QuadraticAlgebra.omega

theorem sqrtFiveRadicalRoot_sq :
    sqrtFiveRadicalRoot ^ 2 = (5 : QSqrtFiveRadical) := by
  change (⟨0, 1⟩ : QSqrtFiveRadical) ^ 2 = ⟨5, 0⟩
  ext <;> simp [pow_two]

/-- The map from the `√5` presentation to the golden-ratio presentation. -/
def sqrtFiveRadicalToGolden : QSqrtFiveRadical →ₐ[ℚ] QSqrtFive :=
  (QuadraticAlgebra.lift (R := ℚ) (a := (5 : ℚ)) (b := 0)) ⟨sqrtFiveRoot, by
    rw [← pow_two, sqrtFiveRoot_sq]
    ext <;> norm_num⟩

@[simp]
theorem sqrtFiveRadicalToGolden_root :
    sqrtFiveRadicalToGolden sqrtFiveRadicalRoot = sqrtFiveRoot := by
  simp [sqrtFiveRadicalToGolden, sqrtFiveRadicalRoot]

/-- The inverse map sends the golden-ratio generator to `(√5 + 1) / 2`. -/
def goldenToSqrtFiveRadical : QSqrtFive →ₐ[ℚ] QSqrtFiveRadical :=
  (QuadraticAlgebra.lift (R := ℚ) (a := (1 : ℚ)) (b := 1))
    ⟨(sqrtFiveRadicalRoot + 1) / 2, by
      calc
        ((sqrtFiveRadicalRoot + 1) / 2) * ((sqrtFiveRadicalRoot + 1) / 2)
            = (sqrtFiveRadicalRoot ^ 2 + 2 * sqrtFiveRadicalRoot + 1) / 4 := by ring
        _ = 1 • (1 : QSqrtFiveRadical) + 1 • ((sqrtFiveRadicalRoot + 1) / 2) := by
          rw [sqrtFiveRadicalRoot_sq]
          ring⟩

@[simp]
theorem goldenToSqrtFiveRadical_root :
    goldenToSqrtFiveRadical goldenRoot = (sqrtFiveRadicalRoot + 1) / 2 := by
  simp [goldenToSqrtFiveRadical, goldenRoot]

/-- The golden-ratio and radical quadratic-algebra presentations are the same `ℚ`-field. -/
def sqrtFiveRadicalEquivGolden : QSqrtFiveRadical ≃ₐ[ℚ] QSqrtFive where
  __ := sqrtFiveRadicalToGolden
  invFun := goldenToSqrtFiveRadical
  left_inv x := by
    have hcomp :
        goldenToSqrtFiveRadical.comp sqrtFiveRadicalToGolden =
          AlgHom.id ℚ QSqrtFiveRadical := by
      apply QuadraticAlgebra.algHom_ext
      change goldenToSqrtFiveRadical
          (sqrtFiveRadicalToGolden sqrtFiveRadicalRoot) = sqrtFiveRadicalRoot
      rw [sqrtFiveRadicalToGolden_root, sqrtFiveRoot, map_sub, map_mul, map_ofNat,
        goldenToSqrtFiveRadical_root, map_one]
      ring
    exact DFunLike.congr_fun hcomp x
  right_inv x := by
    have hcomp :
        sqrtFiveRadicalToGolden.comp goldenToSqrtFiveRadical =
          AlgHom.id ℚ QSqrtFive := by
      apply QuadraticAlgebra.algHom_ext
      change sqrtFiveRadicalToGolden
          (goldenToSqrtFiveRadical goldenRoot) = goldenRoot
      rw [goldenToSqrtFiveRadical_root, map_div₀, map_add, map_one,
        sqrtFiveRadicalToGolden_root]
      have hmap_two : sqrtFiveRadicalToGolden (2 : QSqrtFiveRadical) = (2 : QSqrtFive) := by
        simpa using sqrtFiveRadicalToGolden.commutes (2 : ℚ)
      rw [hmap_two]
      exact goldenRoot_eq_half_sqrtFiveRoot_add_one.symm
    exact DFunLike.congr_fun hcomp x

theorem sqrtFiveRadicalEquivGolden_root :
    sqrtFiveRadicalEquivGolden sqrtFiveRadicalRoot = sqrtFiveRoot :=
  sqrtFiveRadicalToGolden_root

theorem sqrtFiveRadicalEquivGolden_symm_root :
    sqrtFiveRadicalEquivGolden.symm goldenRoot = (sqrtFiveRadicalRoot + 1) / 2 :=
  goldenToSqrtFiveRadical_root

/-! ## 2. Integral basis and ring of integers -/

/--
A concrete model for the ring of integers: elements are `a + bφ`, with
`a b : ℤ` and `φ ^ 2 = φ + 1`.
-/
abbrev O5 : Type := QuadraticAlgebra ℤ (1 : ℤ) (1 : ℤ)

example : CommRing O5 := by infer_instance

/-- The algebraic integer `φ = (1 + √5) / 2`. -/
abbrev goldenInteger : O5 := QuadraticAlgebra.omega

theorem goldenInteger_sq : goldenInteger ^ 2 = goldenInteger + 1 := by
  change (⟨0, 1⟩ : O5) ^ 2 = ⟨0, 1⟩ + ⟨1, 0⟩
  ext <;> simp [pow_two]

theorem goldenInteger_isIntegral : IsIntegral ℤ goldenInteger := by
  refine ⟨X ^ 2 - X - 1, ?_, ?_⟩
  · monicity
    norm_num
  · simp [goldenInteger_sq]

instance : Algebra.IsIntegral ℤ O5 := by
  constructor
  intro z
  cases z with
  | mk a b =>
    rw [QuadraticAlgebra.mk_eq_add_smul_omega a b]
    exact isIntegral_algebraMap.add (goldenInteger_isIntegral.zsmul b)

/-- The natural embedding of the integral model into the field model. -/
def goldenOrderToField : O5 →+* QSqrtFive where
  toFun z := ⟨z.re, z.im⟩
  map_zero' := by ext <;> simp
  map_one' := by
    change (⟨((1 : O5).re : ℚ), ((1 : O5).im : ℚ)⟩ : QSqrtFive) = ⟨1, 0⟩
    ext <;> simp only [QuadraticAlgebra.re_one, QuadraticAlgebra.im_one, Int.cast_one,
      Int.cast_zero]
  map_add' x y := by ext <;> simp
  map_mul' x y := by ext <;> simp

@[simp]
theorem goldenOrderToField_goldenInteger :
    goldenOrderToField goldenInteger = goldenRoot := by
  rfl

instance : Algebra O5 QSqrtFive :=
  goldenOrderToField.toAlgebra

instance : IsScalarTower ℤ O5 QSqrtFive :=
  IsScalarTower.of_algebraMap_eq fun _ => by ext <;> simp

theorem goldenOrderToField_injective : Function.Injective goldenOrderToField := by
  intro x y hxy
  ext
  · have h := congr_arg QuadraticAlgebra.re hxy
    change (x.re : ℚ) = y.re at h
    exact_mod_cast h
  · have h := congr_arg QuadraticAlgebra.im hxy
    change (x.im : ℚ) = y.im at h
    exact_mod_cast h

@[simp]
theorem algebraMap_O5_QSqrtFive_eq_goldenOrderToField (x : O5) :
    algebraMap O5 QSqrtFive x = goldenOrderToField x :=
  rfl

abbrev goldenPowerBasis : PowerBasis ℚ QSqrtFive where
  gen := goldenRoot
  dim := 2
  basis := QuadraticAlgebra.basis (1 : ℚ) (1 : ℚ)
  basis_eq_pow i := by
    fin_cases i <;> ext <;>
      simp [QuadraticAlgebra.basis, QuadraticAlgebra.linearEquivTuple, goldenRoot]

theorem goldenPowerBasis_basis_zero : goldenPowerBasis.basis 0 = (1 : QSqrtFive) := by
  change (QuadraticAlgebra.basis (1 : ℚ) (1 : ℚ)) (0 : Fin 2) = (1 : QSqrtFive)
  ext <;> simp [QuadraticAlgebra.basis, QuadraticAlgebra.linearEquivTuple]

theorem goldenPowerBasis_basis_one : goldenPowerBasis.basis 1 = goldenRoot := by
  change (QuadraticAlgebra.basis (1 : ℚ) (1 : ℚ)) (1 : Fin 2) = goldenRoot
  ext <;> simp [QuadraticAlgebra.basis, QuadraticAlgebra.linearEquivTuple, goldenRoot]

theorem golden_trace_eq (x : QSqrtFive) :
    Algebra.trace ℚ QSqrtFive x = 2 * x.re + x.im := by
  rw [Algebra.trace_eq_matrix_trace (QuadraticAlgebra.basis (1 : ℚ) (1 : ℚ))]
  cases x
  simp [Algebra.leftMulMatrix_eq_repr_mul, QuadraticAlgebra.basis,
    QuadraticAlgebra.linearEquivTuple, QuadraticAlgebra.equivProd, Matrix.trace_fin_two]
  ring_nf

theorem golden_norm_eq (x : QSqrtFive) :
    Algebra.norm ℚ x = x.re ^ 2 + x.re * x.im - x.im ^ 2 := by
  rw [Algebra.norm_eq_matrix_det (QuadraticAlgebra.basis (1 : ℚ) (1 : ℚ))]
  cases x
  simp [Algebra.leftMulMatrix_eq_repr_mul, QuadraticAlgebra.basis,
    QuadraticAlgebra.linearEquivTuple, QuadraticAlgebra.equivProd, Matrix.det_fin_two, pow_two]
  ring_nf

theorem goldenPowerBasis_discr :
    Algebra.discr ℚ goldenPowerBasis.basis = (5 : ℚ) := by
  rw [Algebra.discr_def]
  have hmatrix : Algebra.traceMatrix ℚ goldenPowerBasis.basis = !![(2 : ℚ), 1; 1, 3] := by
    ext i j
    fin_cases i <;> fin_cases j
    · change
        Algebra.trace ℚ QSqrtFive
            (goldenPowerBasis.basis (0 : Fin 2) * goldenPowerBasis.basis (0 : Fin 2)) =
          (2 : ℚ)
      rw [goldenPowerBasis_basis_zero, one_mul, golden_trace_eq]
      norm_num
    · change
        Algebra.trace ℚ QSqrtFive
            (goldenPowerBasis.basis (0 : Fin 2) * goldenPowerBasis.basis (1 : Fin 2)) =
          (1 : ℚ)
      rw [goldenPowerBasis_basis_zero, goldenPowerBasis_basis_one, one_mul, golden_trace_eq]
      norm_num [goldenRoot]
    · change
        Algebra.trace ℚ QSqrtFive
            (goldenPowerBasis.basis (1 : Fin 2) * goldenPowerBasis.basis (0 : Fin 2)) =
          (1 : ℚ)
      rw [goldenPowerBasis_basis_one, goldenPowerBasis_basis_zero, mul_one, golden_trace_eq]
      norm_num [goldenRoot]
    · change
        Algebra.trace ℚ QSqrtFive
            (goldenPowerBasis.basis (1 : Fin 2) * goldenPowerBasis.basis (1 : Fin 2)) =
          (3 : ℚ)
      rw [goldenPowerBasis_basis_one, golden_trace_eq]
      norm_num [goldenRoot]
  rw [hmatrix, Matrix.det_fin_two_of]
  norm_num

theorem five_dvd_coords_of_trace_norm {m n T N : ℤ}
    (hT : 2 * m + n = 5 * T)
    (hN : m * m + m * n - n * n = 25 * N) :
    (5 : ℤ) ∣ m ∧ (5 : ℤ) ∣ n := by
  have hn_eq : n = 5 * T - 2 * m := by omega
  have hm_sq : m * m = 5 * (m * T - T * T - N) := by
    rw [hn_eq] at hN
    nlinarith
  have hm_sq_dvd : (5 : ℤ) ∣ m * m := ⟨m * T - T * T - N, hm_sq⟩
  have hprime : Prime (5 : ℤ) := by norm_num [Int.prime_ofNat_iff, Nat.prime_five]
  have hm : (5 : ℤ) ∣ m := by
    exact hprime.dvd_of_dvd_pow (a := m) (n := 2) (by simpa [pow_two] using hm_sq_dvd)
  have hn : (5 : ℤ) ∣ n := by
    rcases hm with ⟨m', rfl⟩
    use T - 2 * m'
    omega
  exact ⟨hm, hn⟩

theorem int_eq_of_rat_div_five_eq {a b : ℤ} (h : ((a : ℚ) / 5) = (b : ℚ)) :
    a = 5 * b := by
  have h' : (a : ℚ) = (5 * b : ℤ) := by
    norm_num at h ⊢
    linear_combination 5 * h
  exact_mod_cast h'

theorem int_eq_of_rat_div_twentyFive_eq {a b : ℤ}
    (h : ((a : ℚ) / 25) = (b : ℚ)) :
    a = 25 * b := by
  have h' : (a : ℚ) = (25 * b : ℤ) := by
    norm_num at h ⊢
    linear_combination 25 * h
  exact_mod_cast h'

theorem integral_mem_goldenOrderToField_range {x : QSqrtFive} (hx : IsIntegral ℤ x) :
    ∃ y : O5, algebraMap O5 QSqrtFive y = x := by
  have hmem :
      (5 : ℚ) • x ∈ Algebra.adjoin ℤ ({goldenRoot} : Set QSqrtFive) := by
    convert Algebra.discr_mul_isIntegral_mem_adjoin ℚ
        (B := goldenPowerBasis) goldenRoot_isIntegral hx using 1
    rw [goldenPowerBasis_discr]
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hmem
  rcases hmem with ⟨P, hP⟩
  let y : O5 := aeval goldenInteger P
  have hy : algebraMap O5 QSqrtFive y = (5 : ℚ) • x := by
    rw [← hP]
    simpa [y, goldenOrderToField_goldenInteger] using
      (Polynomial.aeval_algHom_apply goldenOrderToField.toIntAlgHom goldenInteger P).symm
  let m : ℤ := y.re
  let n : ℤ := y.im
  have hre : (m : ℚ) = 5 * x.re := by
    have h := congr_arg QuadraticAlgebra.re hy
    simpa [m] using h
  have him : (n : ℚ) = 5 * x.im := by
    have h := congr_arg QuadraticAlgebra.im hy
    simpa [n] using h
  have hx_re : x.re = (m : ℚ) / 5 := by linarith
  have hx_im : x.im = (n : ℚ) / 5 := by linarith
  have htrace_int : IsIntegral ℤ (Algebra.trace ℚ QSqrtFive x) :=
    Algebra.isIntegral_trace (L := ℚ) (F := QSqrtFive) hx
  obtain ⟨T, hT⟩ := (htrace_int.exists_int_iff_exists_rat).mp
    ⟨Algebra.trace ℚ QSqrtFive x, rfl⟩
  have hnorm_int : IsIntegral ℤ (Algebra.norm ℚ x) :=
    Algebra.isIntegral_norm ℚ hx
  obtain ⟨N, hN⟩ := (hnorm_int.exists_int_iff_exists_rat).mp
    ⟨Algebra.norm ℚ x, rfl⟩
  have hT_rat : (((2 * m + n : ℤ) : ℚ) / 5) = (T : ℚ) := by
    rw [← hT, golden_trace_eq, hx_re, hx_im]
    push_cast
    ring
  have hN_rat : (((m * m + m * n - n * n : ℤ) : ℚ) / 25) = (N : ℚ) := by
    rw [← hN, golden_norm_eq, hx_re, hx_im]
    push_cast
    ring
  have hT_int : 2 * m + n = 5 * T :=
    int_eq_of_rat_div_five_eq hT_rat
  have hN_int : m * m + m * n - n * n = 25 * N :=
    int_eq_of_rat_div_twentyFive_eq hN_rat
  rcases five_dvd_coords_of_trace_norm hT_int hN_int with ⟨hm, hn⟩
  rcases hm with ⟨m', hm'⟩
  rcases hn with ⟨n', hn'⟩
  refine ⟨⟨m', n'⟩, ?_⟩
  ext
  · change (m' : ℚ) = x.re
    rw [hm'] at hre
    norm_num at hre
    linarith
  · change (n' : ℚ) = x.im
    rw [hn'] at him
    norm_num at him
    linarith

instance : IsIntegralClosure O5 ℤ QSqrtFive where
  algebraMap_injective := goldenOrderToField_injective
  isIntegral_iff {x} := by
    constructor
    · exact integral_mem_goldenOrderToField_range
    · rintro ⟨y, rfl⟩
      exact IsIntegral.algebraMap (Algebra.IsIntegral.isIntegral (R := ℤ) y)

/-- The naive order `ℤ[√5]` is not the full ring of integers `ℤ[(1 + √5) / 2]`. -/
theorem adjoin_sqrtFive_ne_integralClosure :
    Algebra.adjoin ℤ ({sqrtFiveRoot} : Set QSqrtFive) ≠ integralClosure ℤ QSqrtFive := by
  sorry

/-- The explicit integral basis `[1, (1 + √5) / 2]`. -/
abbrev sqrtFiveExplicitIntegralBasis : Basis (Fin 2) ℤ O5 :=
  QuadraticAlgebra.basis (1 : ℤ) (1 : ℤ)

/-- The first vector in the explicit integral basis is `1`. -/
theorem sqrtFiveExplicitIntegralBasis_zero :
    sqrtFiveExplicitIntegralBasis 0 = 1 := by
  change (QuadraticAlgebra.basis (1 : ℤ) (1 : ℤ)) (0 : Fin 2) = ⟨1, 0⟩
  ext <;> simp [QuadraticAlgebra.basis, QuadraticAlgebra.linearEquivTuple]

/-- The second vector in the explicit integral basis is `(1 + √5) / 2`. -/
theorem sqrtFiveExplicitIntegralBasis_one :
    sqrtFiveExplicitIntegralBasis 1 = goldenInteger := by
  change (QuadraticAlgebra.basis (1 : ℤ) (1 : ℤ)) (1 : Fin 2) = ⟨0, 1⟩
  ext <;> simp [QuadraticAlgebra.basis, QuadraticAlgebra.linearEquivTuple]

example : sqrtFiveExplicitIntegralBasis 0 = 1 :=
  sqrtFiveExplicitIntegralBasis_zero

example : sqrtFiveExplicitIntegralBasis 1 = goldenInteger :=
  sqrtFiveExplicitIntegralBasis_one

theorem goldenOrderToField_basis_zero :
    goldenOrderToField (sqrtFiveExplicitIntegralBasis 0) = 1 := by
  rw [sqrtFiveExplicitIntegralBasis_zero]
  exact goldenOrderToField.map_one

theorem goldenOrderToField_basis_one :
    goldenOrderToField (sqrtFiveExplicitIntegralBasis 1) = goldenRoot := by
  rw [sqrtFiveExplicitIntegralBasis_one]
  exact goldenOrderToField_goldenInteger

/-! ## 3. Discriminant -/

/-- The number-field discriminant of `ℚ(√5)` is `5`: since `5 ≡ 1 (mod 4)`, the discriminant
is `5` itself (not `4·5`) — the real quadratic field of smallest discriminant. In particular
`5` is the only ramified prime, cf. `ramified_iff_eq_five`. -/
theorem numberField_discr_eq : NumberField.discr QSqrtFive = 5 := by
  sorry

/-! ## 4. Norm form -/

/-- `φ` as an element of the abstract ring of integers `𝓞 QSqrtFive`. -/
noncomputable def goldenIntO : 𝓞 QSqrtFive := ⟨goldenRoot, goldenRoot_isIntegral⟩

/-- The integral norm form: on `𝓞 K = ℤ[φ]` the norm of `x + yφ` (with `x, y ∈ ℤ`) is
`x² + xy - y²`, the principal form of discriminant `5`. -/
theorem intNorm_eq_normForm (x y : ℤ) :
    Algebra.norm ℤ (x • (1 : 𝓞 QSqrtFive) + y • goldenIntO) = x ^ 2 + x * y - y ^ 2 := by
  sorry

/-- The Pell-type unit equation for `ℚ(√5)`: `x + yφ` is a unit of `ℤ[φ]` iff
`x² + xy - y² = ±1`. Combined with `fundamentalUnit_generates`, all integer solutions arise
from `±φⁿ`, `n ∈ ℤ`; concretely `φⁿ = F(n-1) + F(n)·φ`, so the solutions are exactly the
pairs of consecutive Fibonacci numbers (up to sign). -/
theorem isUnit_iff_normForm (x y : ℤ) :
    IsUnit (x • (1 : 𝓞 QSqrtFive) + y • goldenIntO) ↔
      x ^ 2 + x * y - y ^ 2 = 1 ∨ x ^ 2 + x * y - y ^ 2 = -1 := by
  sorry

/-! ## 5. Splitting of primes -/

/-- `√5 = 2φ - 1` as an element of `𝓞 QSqrtFive`. -/
noncomputable def sqrtFiveIntO : 𝓞 QSqrtFive := 2 * goldenIntO - 1

/-- `5` is (totally) ramified: `(5) = (√5)²` as ideals of `𝓞 K`, directly from
`(2φ - 1)² = 5`. It is the unique ramified prime, matching the discriminant `5`. -/
theorem span_five_eq :
    Ideal.span {(5 : 𝓞 QSqrtFive)} = Ideal.span {sqrtFiveIntO} ^ 2 := by
  sorry

/-- The prime `(√5)` above `5` has norm `5` (residue degree `f = 1`). -/
theorem absNorm_span_sqrtFiveIntO : Ideal.absNorm (Ideal.span {sqrtFiveIntO}) = 5 := by
  sorry

/-- `(√5)` is a prime ideal — the unique prime of `𝓞 K` above `5`. -/
theorem isPrime_span_sqrtFiveIntO : (Ideal.span {sqrtFiveIntO}).IsPrime := by
  sorry

/-- `2` is inert in `ℚ(√5)`: `X² - X - 1` is irreducible mod `2`, so `(2)` is itself prime
(of norm `4`). -/
theorem isPrime_span_two : (Ideal.span {(2 : 𝓞 QSqrtFive)}).IsPrime := by
  sorry

/-- `3` is inert in `ℚ(√5)`: `5` is not a square mod `3`, so `(3)` is itself prime (of norm
`9`). -/
theorem isPrime_span_three : (Ideal.span {(3 : 𝓞 QSqrtFive)}).IsPrime := by
  sorry

/-- `11 ≡ 1 (mod 5)` splits: `11 = (3 + φ)(4 - φ)` and `(11)` is a product of two distinct
primes of norm `11`. -/
theorem span_eleven_eq :
    Ideal.span {(11 : 𝓞 QSqrtFive)} =
      Ideal.span {3 + goldenIntO} * Ideal.span {4 - goldenIntO} := by
  sorry

/-- The prime `(3 + φ)` above `11` has norm `11` (residue degree `f = 1`). -/
theorem absNorm_span_three_add_golden :
    Ideal.absNorm (Ideal.span {3 + goldenIntO}) = 11 := by
  sorry

/-- `(3 + φ)` is a prime ideal — one of the two primes of `𝓞 K` above `11`. -/
theorem isPrime_span_three_add_golden : (Ideal.span {3 + goldenIntO}).IsPrime := by
  sorry

/-- The splitting law at ramified primes: a rational prime `p` ramifies in `ℚ(√5)` iff
`p = 5`, i.e. iff `p` divides the discriminant `5`. -/
theorem ramified_iff_eq_five (p : ℕ) (hp : p.Prime) :
    (∃ P : Ideal (𝓞 QSqrtFive), P.IsPrime ∧
      Ideal.span {(p : 𝓞 QSqrtFive)} ≤ P ^ 2) ↔ p = 5 := by
  sorry

/-- The quadratic splitting law for `ℚ(√5)`: a rational prime `p ≠ 5` splits into two
distinct primes iff `p ≡ ±1 (mod 5)` (i.e. iff `5` is a quadratic residue mod `p`, by
quadratic reciprocity), and is inert otherwise. -/
theorem splits_iff_pm_one_mod_five (p : ℕ) (hp : p.Prime) (hp5 : p ≠ 5) :
    (∃ P Q : Ideal (𝓞 QSqrtFive), P.IsPrime ∧ Q.IsPrime ∧ P ≠ Q ∧
      Ideal.span {(p : 𝓞 QSqrtFive)} = P * Q) ↔ p % 5 = 1 ∨ p % 5 = 4 := by
  sorry

/-! ## 6. Ring of units -/

/-- The golden ratio `φ` is a unit of `𝓞 K`, with inverse `φ - 1 = 1/φ`: this is the
fundamental unit of `ℚ(√5)`, the smallest fundamental unit of any real quadratic field. -/
noncomputable def fundamentalUnit : (𝓞 QSqrtFive)ˣ where
  val := goldenIntO
  inv := goldenIntO - 1
  val_inv := by sorry
  inv_val := by sorry

/-- The field `ℚ(√5)` has two real infinite places: the signature is `(r₁, r₂) = (2, 0)`. -/
theorem nrRealPlaces_eq_two : InfinitePlace.nrRealPlaces QSqrtFive = 2 := by
  sorry

/-- The field `ℚ(√5)` has no complex infinite places. -/
theorem nrComplexPlaces_eq_zero : InfinitePlace.nrComplexPlaces QSqrtFive = 0 := by
  sorry

/-- The torsion subgroup of `𝓞 Kˣ` has order `2`: a totally real field has only the roots of
unity `±1`. -/
theorem torsionOrder_eq_two : Units.torsionOrder QSqrtFive = 2 := by
  sorry

/-- The Dirichlet unit rank of `ℚ(√5)` is `1`: the signature is `(2, 0)`, so the rank is
`r₁ + r₂ - 1 = 1`. -/
theorem unitRank_eq_one : Units.rank QSqrtFive = 1 := by
  sorry

/-- Every unit of `𝓞 ℚ(√5)` is a signed power of the golden ratio `φ`. -/
theorem fundamentalUnit_generates (u : (𝓞 QSqrtFive)ˣ) :
    ∃ n : ℤ, u = fundamentalUnit ^ n ∨ u = -(fundamentalUnit ^ n) := by
  sorry

/-- The norm-one Pell solutions are generated by the square of the fundamental unit. -/
theorem normOneUnit_generated_by_fundamentalUnit_sq (u : (𝓞 QSqrtFive)ˣ)
    (hu : Algebra.norm ℤ (u : 𝓞 QSqrtFive) = 1) :
    ∃ n : ℤ, u = fundamentalUnit ^ (2 * n) ∨
      u = -(fundamentalUnit ^ (2 * n)) := by
  sorry

/-- The regulator of `ℚ(√5)` is `log φ = log((1 + √5)/2) ≈ 0.4812` — the smallest regulator
of any real quadratic field. This is the analytic restatement that `φ` is a fundamental
unit. -/
theorem regulator_eq :
    Units.regulator QSqrtFive = Real.log ((1 + Real.sqrt 5) / 2) := by
  sorry

/-- The unit group is `μ₂ × ℤ` as an abstract abelian group. -/
theorem unitGroupStructure :
    Nonempty ((𝓞 QSqrtFive)ˣ ≃* (Multiplicative (ZMod 2) × Multiplicative (Fin 1 → ℤ))) := by
  sorry

/-! ## 7. Class group -/

/-- The class number of `ℚ(√5)` is `1`. The Minkowski bound is `(1/2)·√5 ≈ 1.12 < 2`, so
every ideal class contains an ideal of norm `1` and the class group is trivial outright. -/
theorem classNumber_eq_one : NumberField.classNumber QSqrtFive = 1 := by
  sorry

/-- The ring of integers `ℤ[φ]` is a principal ideal domain — the ring-theoretic content of
class number one. -/
theorem isPrincipalIdealRing : IsPrincipalIdealRing (𝓞 QSqrtFive) := by
  sorry

/-- The class group of `𝓞 K` is trivial. -/
theorem classGroupStructure :
    Nonempty (ClassGroup (𝓞 QSqrtFive) ≃* Multiplicative (ZMod 1)) := by
  sorry

/-- The unit ideal as the concrete representative of the unique ideal class. -/
abbrev unitIdealRepresentative : (Ideal (𝓞 QSqrtFive))⁰ :=
  ⟨(⊤ : Ideal (𝓞 QSqrtFive)), by simp⟩

/-- Every ideal class is represented by the unit ideal. -/
theorem classGroupRepresentative (C : ClassGroup (𝓞 QSqrtFive)) :
    C = ClassGroup.mk0 unitIdealRepresentative := by
  sorry

/-! ## 8. Euclidean structure -/

/-- `ℚ(√5)` is norm-Euclidean: division with remainder in `ℤ[φ]` with respect to the
absolute value of the field norm. This strengthens `isPrincipalIdealRing`. -/
theorem normEuclidean (a b : 𝓞 QSqrtFive) (hb : b ≠ 0) :
    ∃ q r : 𝓞 QSqrtFive, a = b * q + r ∧
      (Algebra.norm ℤ r).natAbs < (Algebra.norm ℤ b).natAbs := by
  sorry

/-! ## 9. Galois group -/

/-- The nontrivial automorphism of `ℚ(√5)` sends `φ` to its algebraic conjugate
`1 - φ = -1/φ` (equivalently `√5 ↦ -√5`). -/
theorem exists_conj :
    ∃ σ : QSqrtFive ≃ₐ[ℚ] QSqrtFive, σ goldenRoot = 1 - goldenRoot := by
  sorry

/-- Every `ℚ`-automorphism of `ℚ(√5)` fixes `φ` or sends it to its conjugate `1 - φ`: the
Galois group has exactly two elements. -/
theorem aut_apply_goldenRoot (σ : QSqrtFive ≃ₐ[ℚ] QSqrtFive) :
    σ goldenRoot = goldenRoot ∨ σ goldenRoot = 1 - goldenRoot := by
  sorry

/-- The extension `ℚ(√5)/ℚ` is Galois (quadratic extensions in characteristic zero always
are). -/
theorem isGalois : IsGalois ℚ QSqrtFive := by
  sorry

/-- The Galois group of `ℚ(√5)/ℚ` is cyclic of order `2`, generated by the conjugation
`φ ↦ 1 - φ`. -/
theorem galoisGroupStructure :
    Nonempty ((QSqrtFive ≃ₐ[ℚ] QSqrtFive) ≃* Multiplicative (ZMod 2)) := by
  sorry

end XYin.NumberField.SqrtFive
