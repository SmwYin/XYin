import Mathlib

/-!
# The field `ℚ(√5)` via `QuadraticAlgebra`

The real quadratic field `K = ℚ(√5)`, realised as `QuadraticAlgebra ℚ 5 0`, and its main
arithmetic invariants (the `AdjoinRoot` construction of the same field is in
`SqrtFiveAdjoinRoot.lean`):

* degree `2`, integral basis `1, φ` with `φ = (1 + √5)/2` the golden ratio; the ring of
  integers is `ℤ[φ]`, strictly larger than `ℤ[√5]` (sections 1–2);
* discriminant `5` — the smallest discriminant of any real quadratic field (section 3);
* the norm form `x² + xy - y²` and its unit ("Pell/Fibonacci") equation (section 4);
* splitting of rational primes: `5` ramifies as `(√5)²`, `2` is inert, `11` splits with
  principal prime factors, and the splitting law `p` splits `↔ p ≡ ±1 (mod 5)` (section 5);
* unit group `{±1} × φ^ℤ`: totally real, signature `(2, 0)`, fundamental unit the golden
  ratio `φ` of norm `-1`, regulator `log φ` (section 6);
* class number one (section 7);
* the norm-Euclidean property (section 8);
* Galois over `ℚ` with group `ℤ/2` generated by the conjugation `√5 ↦ -√5` (section 9).
-/

noncomputable section

open Module
open scoped NumberField nonZeroDivisors QuadraticAlgebra

namespace XYin.NumberField.New.SqrtFiveQuadraticAlgebra

/-! ## 1. Basics -/

/-- The nonsquare condition making `QuadraticAlgebra ℚ 5 0` a field: `5` is not a rational
square. -/
instance : Fact (∀ r : ℚ, r ^ 2 ≠ (5 : ℚ) + (0 : ℚ) * r) := by
  refine ⟨fun r hr => ?_⟩
  rw [zero_mul, add_zero] at hr
  have h5 : Irrational (Real.sqrt 5) := (by norm_num : Nat.Prime 5).irrational_sqrt
  refine h5 ⟨|r|, ?_⟩
  have hr' : ((r : ℝ)) ^ 2 = 5 := by exact_mod_cast hr
  rw [show ((|r| : ℚ) : ℝ) = |(r : ℝ)| by push_cast; rfl, ← Real.sqrt_sq_eq_abs, hr']

/-- The number field `ℚ(√5)` as `QuadraticAlgebra ℚ 5 0`. -/
abbrev K : Type := QuadraticAlgebra ℚ (5 : ℚ) 0

/-- The distinguished square root of `5`. -/
abbrev sqrtFive : K := QuadraticAlgebra.omega

/-- The golden ratio `φ = (1 + √5) / 2`, an algebraic integer of `K`. -/
abbrev goldenInteger : K := (1 + sqrtFive) / 2

/-- The field structure on `K`. -/
instance : Field K := by
  infer_instance

/-- The finite-dimensional `ℚ`-vector-space structure on `K`. -/
instance : FiniteDimensional ℚ K :=
  (QuadraticAlgebra.basis (5 : ℚ) (0 : ℚ)).finiteDimensional_of_finite

/-- The number-field structure on `K`. -/
instance : NumberField K :=
  NumberField.of_module_finite ℚ K

/-- The extension degree of `K = ℚ(√5)` over `ℚ` is `2`. -/
theorem degree_eq_two : Module.finrank ℚ K = 2 := by
  rw [Module.finrank_eq_card_basis (QuadraticAlgebra.basis (5 : ℚ) (0 : ℚ)), Fintype.card_fin]

/-- The generator satisfies `(√5)² = 5`. -/
theorem sqrtFive_sq : sqrtFive ^ 2 = 5 := by
  rw [sq, QuadraticAlgebra.omega_mul_omega_eq_add]
  simp

/-! ### The `AdjoinRoot` presentation -/

/-- The polynomial `X² - 5`, whose root is `√5`. -/
abbrev sqrtFivePolynomial : Polynomial ℚ :=
  Polynomial.X ^ 2 - Polynomial.C (5 : ℚ)

instance : Fact (Irreducible sqrtFivePolynomial) := by
  exact ⟨by
    sorry⟩

/-- The same field, now presented by adjoining a root of `X² - 5`. -/
abbrev KAdjoinRoot : Type := AdjoinRoot sqrtFivePolynomial

/-- The formal square root of `5` in the `AdjoinRoot` presentation. -/
abbrev sqrtFiveAdjoinRoot : KAdjoinRoot := AdjoinRoot.root sqrtFivePolynomial

theorem sqrtFiveAdjoinRoot_sq :
    sqrtFiveAdjoinRoot ^ 2 = (5 : KAdjoinRoot) := by
  sorry

/-- The `AdjoinRoot` presentation is equivalent to the quadratic-algebra model. -/
noncomputable def adjoinRootEquivQuadratic : KAdjoinRoot ≃ₐ[ℚ] K := by
  sorry

theorem adjoinRootEquivQuadratic_root :
    adjoinRootEquivQuadratic sqrtFiveAdjoinRoot = sqrtFive := by
  sorry

/-- The golden ratio satisfies its defining equation `φ² = φ + 1`. -/
theorem goldenInteger_sq : goldenInteger ^ 2 = goldenInteger + 1 := by
  have h := sqrtFive_sq
  rw [show goldenInteger = (1 + sqrtFive) / 2 from rfl]
  field_simp
  linear_combination h


end XYin.NumberField.New.SqrtFiveQuadraticAlgebra
