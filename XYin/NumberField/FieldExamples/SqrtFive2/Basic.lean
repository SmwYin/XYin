import Mathlib

/-!
# The field `ℚ(√5)` via `AdjoinRoot`

The real quadratic field `K = ℚ(√5)`, realised as `AdjoinRoot (X ^ 2 - 5)`, and its main
arithmetic invariants:

* degree `2`, integral basis `1, φ` with `φ = (1 + √5)/2` the golden ratio; the ring of
  integers is `ℤ[φ]`, strictly larger than `ℤ[√5]` (sections 1–2);
* discriminant `5` — the smallest discriminant of any real quadratic field (section 3);
* the norm form `x² + xy - y²` and its unit ("Pell/Fibonacci") equation (section 4);
* splitting of rational primes: `5` ramifies as `(√5)²`, `2` is inert, `11` splits with
  principal prime factors, and the splitting law `p` splits `↔ p ≡ ±1 (mod 5)` (section 5);
* unit group `{±1} × φ^ℤ`: totally real, signature `(2, 0)`, fundamental unit the golden
  ratio `φ` of norm `-1`, regulator `log φ` (section 6);
* class number one (section 7);
* the norm-Euclidean property (section 8);
* Galois over `ℚ` with group `ℤ/2` generated by the conjugation `√5 ↦ -√5` (section 9).
-/

noncomputable section

open Module Polynomial
open scoped NumberField nonZeroDivisors

namespace XYin.NumberField.SqrtFiveGoldenAdjoinRoot

/-! ## 1. Basics -/

/-- The polynomial `X^2 - 5` over `ℚ`, defining `ℚ(√5)`. -/
abbrev sqrtFivePolynomial : ℚ[X] := X ^ 2 - C (5 : ℚ)

/-- The polynomial `X^2 - X - 1`, whose root is the golden ratio `(1 + √5) / 2`. -/
abbrev goldenPolynomial : ℚ[X] :=
  C (1 : ℚ) * X ^ 2 + C (-1 : ℚ) * X + C (-1 : ℚ)

theorem goldenPolynomial_monic : goldenPolynomial.Monic := by
  rw [goldenPolynomial]
  monicity
  all_goals norm_num

theorem goldenPolynomial_natDegree : goldenPolynomial.natDegree = 2 := by
  rw [goldenPolynomial]
  exact natDegree_quadratic (by norm_num : (1 : ℚ) ≠ 0)

/-- The polynomial `X^2 - 5` is irreducible over `ℚ`: `5` is not a rational square. -/
instance : Fact (Irreducible sqrtFivePolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [sqrtFivePolynomial, Finset.mem_Icc]
    change 1 ≤ (X ^ 2 - C (5 : ℚ)).natDegree ∧ (X ^ 2 - C (5 : ℚ)).natDegree ≤ 3
    rw [natDegree_X_pow_sub_C]
    norm_num
  · intro x hx
    have hx2 : x ^ 2 = 5 := by
      have hzero : x ^ 2 - 5 = 0 := by
        simpa [sqrtFivePolynomial, IsRoot] using hx
      nlinarith
    have hsquare : IsSquare (5 : ℚ) := by
      rw [isSquare_iff_exists_sq]
      exact ⟨x, hx2.symm⟩
    norm_num at hsquare

instance : Fact (Irreducible goldenPolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [goldenPolynomial, Finset.mem_Icc, natDegree_quadratic (by norm_num : (1 : ℚ) ≠ 0)]
    norm_num
  · intro r hr
    have hzero : r ^ 2 + -r + -1 = 0 := by
      simpa [goldenPolynomial, IsRoot] using hr
    have hsquare : IsSquare (5 : ℚ) := by
      rw [isSquare_iff_exists_sq]
      refine ⟨2 * r - 1, ?_⟩
      nlinarith
    norm_num at hsquare

/-- The number field `ℚ(√5)` as an `AdjoinRoot`. -/
abbrev K : Type := AdjoinRoot sqrtFivePolynomial

/-- Compatibility alias for the older `SqrtFive2` API. -/
abbrev QSqrtFive : Type := K

/-- The distinguished square root of `5`. -/
abbrev sqrtFive : K := AdjoinRoot.root sqrtFivePolynomial

/-- Compatibility alias for the older `SqrtFive2` API. -/
abbrev sqrtFiveRoot : QSqrtFive := sqrtFive

/-- The golden ratio `φ = (1 + √5) / 2`, an algebraic integer of `K`. -/
abbrev goldenInteger : K := (1 + sqrtFive) / 2

/-- Compatibility alias for the older `SqrtFive2` API. -/
abbrev goldenRoot : QSqrtFive := goldenInteger

/-- The field structure on `K`. -/
instance : Field K := by
  infer_instance

/-- The number-field structure on `K`. -/
instance : NumberField K := by
  infer_instance

/-- The power basis `1, √5` of `K` over `ℚ`. -/
private noncomputable abbrev sqrtFivePB : PowerBasis ℚ K :=
  AdjoinRoot.powerBasis (f := sqrtFivePolynomial)
    ((Fact.out : Irreducible sqrtFivePolynomial).ne_zero)

private theorem sqrtFivePB_dim : sqrtFivePB.dim = 2 := by
  change sqrtFivePolynomial.natDegree = 2
  rw [sqrtFivePolynomial, natDegree_X_pow_sub_C]

private theorem sqrtFivePB_gen : sqrtFivePB.gen = sqrtFive := by
  simp [sqrtFivePB, sqrtFive]

/-- The extension degree of `K = ℚ(√5)` over `ℚ` is `2`. -/
theorem degree_eq_two : Module.finrank ℚ K = 2 := by
  rw [PowerBasis.finrank sqrtFivePB]
  exact sqrtFivePB_dim

/-- The generator satisfies `(√5)² = 5`. -/
theorem sqrtFive_sq : sqrtFive ^ 2 = 5 := by
  have hroot : sqrtFive ^ 2 - 5 = 0 := by
    simpa [sqrtFive, sqrtFivePolynomial] using (AdjoinRoot.eval₂_root sqrtFivePolynomial)
  linear_combination hroot

theorem sqrtFiveRoot_sq : sqrtFiveRoot ^ 2 = (5 : QSqrtFive) :=
  sqrtFive_sq

/-! ### The `QuadraticAlgebra ℚ 5 0` presentation -/

instance : Fact (∀ r : ℚ, r ^ 2 ≠ (5 : ℚ) + (0 : ℚ) * r) := by
  exact ⟨by
    sorry⟩

/-- The same field, now presented as the radical quadratic algebra `ℚ[√5]`. -/
abbrev KQuadratic : Type := QuadraticAlgebra ℚ (5 : ℚ) 0

/-- Compatibility alias for the older radical presentation name. -/
abbrev QSqrtFiveRadical : Type := KQuadratic

/-- The distinguished square root of `5` in the quadratic-algebra presentation. -/
abbrev sqrtFiveQuadratic : KQuadratic := QuadraticAlgebra.omega

/-- Compatibility alias for the older radical root name. -/
abbrev sqrtFiveRadicalRoot : QSqrtFiveRadical := sqrtFiveQuadratic

theorem sqrtFiveQuadratic_sq : sqrtFiveQuadratic ^ 2 = (5 : KQuadratic) := by
  sorry

theorem sqrtFiveRadicalRoot_sq :
    sqrtFiveRadicalRoot ^ 2 = (5 : QSqrtFiveRadical) :=
  sqrtFiveQuadratic_sq

/-- The radical quadratic-algebra presentation is equivalent to the `AdjoinRoot` model. -/
noncomputable def quadraticEquivAdjoinRoot : KQuadratic ≃ₐ[ℚ] K := by
  sorry

/-- Compatibility alias for the older equivalence name. -/
noncomputable def sqrtFiveRadicalEquivGolden :
    QSqrtFiveRadical ≃ₐ[ℚ] QSqrtFive :=
  quadraticEquivAdjoinRoot

theorem quadraticEquivAdjoinRoot_root :
    quadraticEquivAdjoinRoot sqrtFiveQuadratic = sqrtFive := by
  sorry

theorem sqrtFiveRadicalEquivGolden_root :
    sqrtFiveRadicalEquivGolden sqrtFiveRadicalRoot = sqrtFiveRoot :=
  quadraticEquivAdjoinRoot_root

/-- The golden ratio satisfies its defining equation `φ² = φ + 1`. -/
theorem goldenInteger_sq : goldenInteger ^ 2 = goldenInteger + 1 := by
  have h := sqrtFive_sq
  rw [show goldenInteger = (1 + sqrtFive) / 2 from rfl]
  field_simp
  linear_combination h

theorem goldenRoot_sq : goldenRoot ^ 2 = goldenRoot + 1 :=
  goldenInteger_sq

theorem goldenRoot_eq_half_sqrtFiveRoot_add_one :
    goldenRoot = (sqrtFiveRoot + 1) / 2 := by
  rw [goldenRoot, goldenInteger, sqrtFiveRoot]
  ring

theorem goldenRoot_isIntegral : IsIntegral ℤ goldenRoot := by
  refine ⟨Polynomial.X ^ 2 - Polynomial.X - 1, ?_, ?_⟩
  · monicity!
  · simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_one]
    linear_combination goldenRoot_sq


end XYin.NumberField.SqrtFiveGoldenAdjoinRoot
