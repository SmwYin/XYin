import Mathlib

/-!
# The field `ℚ(√5)` via `AdjoinRoot`

The integral generator for this field is the golden-ratio element

`φ = (1 + √5) / 2`,

which satisfies `φ ^ 2 = φ + 1`.  We therefore build the field as
`AdjoinRoot (X ^ 2 - X - 1)` and recover `√5` as `2φ - 1`. Main arithmetic invariants:

* degree `2`, golden generator `φ` (section 1);
* integral basis `1, φ`, ring of integers `ℤ[φ]` (section 2);
* discriminant `5` (section 3);
* the norm form `x² + xy - y²` and its Pell-type unit equation, solved by consecutive
  Fibonacci pairs (section 4);
* splitting of rational primes: `5` ramifies as `(√5)²`, `11` splits, `2` and `3` are inert,
  and the splitting law: `p ≠ 5` splits iff `p ≡ ±1 (mod 5)` (section 5);
* unit group `{±1} × φ^ℤ`, signature `(2, 0)`, regulator `log φ` (section 6);
* class number one (section 7);
* the norm-Euclidean property (section 8);
* Galois group `C₂`, generated by the conjugation `φ ↦ 1 - φ` (section 9).
-/

noncomputable section

attribute [-instance] DivisionRing.toRatAlgebra

open scoped NumberField nonZeroDivisors Real ENNReal

open Module NumberField Polynomial

namespace XYin.NumberField.SqrtFiveGoldenAdjoinRoot

/-! ## 1. Basics -/

/-- The polynomial `X^2 - X - 1`, whose root is `(1 + √5) / 2`. -/
abbrev goldenPolynomial : ℚ[X] :=
  C (1 : ℚ) * X ^ 2 + C (-1 : ℚ) * X + C (-1 : ℚ)

theorem goldenPolynomial_monic : goldenPolynomial.Monic := by
  rw [goldenPolynomial]
  monicity
  all_goals norm_num

theorem goldenPolynomial_natDegree : goldenPolynomial.natDegree = 2 := by
  rw [goldenPolynomial]
  exact natDegree_quadratic (by norm_num : (1 : ℚ) ≠ 0)

instance : Fact (Irreducible goldenPolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [goldenPolynomial, Finset.mem_Icc, natDegree_quadratic (by norm_num : (1 : ℚ) ≠ 0)]
    norm_num
  · intro r hr
    have hzero : r ^ 2 + -r + -1 = 0 := by
      simpa [goldenPolynomial, IsRoot] using hr
    have hsquare : IsSquare (5 : ℚ) := by
      rw [isSquare_iff_exists_sq]
      refine ⟨2 * r - 1, ?_⟩
      nlinarith
    norm_num at hsquare

/-- The real quadratic field `ℚ(√5)`, generated by `φ = (1 + √5) / 2`. -/
abbrev QSqrtFive : Type :=
  AdjoinRoot goldenPolynomial

example : Field QSqrtFive := by infer_instance

example : NumberField QSqrtFive := by infer_instance

/-- The golden-ratio generator `φ`, satisfying `φ ^ 2 = φ + 1`. -/
abbrev goldenRoot : QSqrtFive :=
  AdjoinRoot.root goldenPolynomial

theorem goldenRoot_sq : goldenRoot ^ 2 = goldenRoot + 1 := by
  have hroot : goldenRoot ^ 2 - goldenRoot - 1 = 0 := by
    simpa [goldenRoot, goldenPolynomial] using AdjoinRoot.eval₂_root goldenPolynomial
  calc
    goldenRoot ^ 2 = goldenRoot + 1 + (goldenRoot ^ 2 - goldenRoot - 1) := by ring
    _ = goldenRoot + 1 := by rw [hroot]; ring

/-- The square root of `5` recovered from `φ`: `√5 = 2φ - 1`. -/
abbrev sqrtFiveRoot : QSqrtFive :=
  2 * goldenRoot - 1

theorem sqrtFiveRoot_sq : sqrtFiveRoot ^ 2 = (5 : QSqrtFive) := by
  rw [sqrtFiveRoot]
  calc
    (2 * goldenRoot - 1) ^ 2 = 4 * goldenRoot ^ 2 - 4 * goldenRoot + 1 := by ring
    _ = 5 := by rw [goldenRoot_sq]; ring

theorem goldenRoot_eq_half_sqrtFiveRoot_add_one :
    goldenRoot = (sqrtFiveRoot + 1) / 2 := by
  rw [sqrtFiveRoot]
  field_simp
  ring

theorem goldenRoot_isIntegral : IsIntegral ℤ goldenRoot := by
  refine ⟨X ^ 2 - X - 1, ?_, ?_⟩
  · monicity
    norm_num
  · simp [goldenRoot_sq]

/-! ### The `QuadraticAlgebra ℚ 5 0` presentation -/

instance : Fact (∀ r : ℚ, r ^ 2 ≠ (5 : ℚ) + (0 : ℚ) * r) := by
  exact ⟨by
    sorry⟩

/-- The same field, now presented with a generator whose square is `5`. -/
abbrev QSqrtFiveRadical : Type := QuadraticAlgebra ℚ (5 : ℚ) 0

/-- The distinguished square root of `5` in the radical presentation. -/
abbrev sqrtFiveRadicalRoot : QSqrtFiveRadical := QuadraticAlgebra.omega

theorem sqrtFiveRadicalRoot_sq :
    sqrtFiveRadicalRoot ^ 2 = (5 : QSqrtFiveRadical) := by
  sorry

/-- The radical quadratic-algebra presentation is equivalent to the `AdjoinRoot` model. -/
noncomputable def sqrtFiveRadicalEquivGolden :
    QSqrtFiveRadical ≃ₐ[ℚ] QSqrtFive := by
  sorry

theorem sqrtFiveRadicalEquivGolden_root :
    sqrtFiveRadicalEquivGolden sqrtFiveRadicalRoot = sqrtFiveRoot := by
  sorry

/-- The extension degree of `ℚ(√5)` over `ℚ` is `2`. -/
theorem degree_eq_two : Module.finrank ℚ QSqrtFive = 2 := by
  sorry

instance : Algebra.IsQuadraticExtension ℚ QSqrtFive where
  finrank_eq_two' := by
    sorry

abbrev sqrtFiveFieldPowerBasisBase : PowerBasis ℚ QSqrtFive :=
  AdjoinRoot.powerBasis' goldenPolynomial_monic

theorem sqrtFiveFieldPowerBasisBase_dim :
    sqrtFiveFieldPowerBasisBase.dim = 2 := by
  rw [sqrtFiveFieldPowerBasisBase]
  exact goldenPolynomial_natDegree

/-- The field power basis `1, φ`, indexed by `Fin 2`. -/
abbrev goldenPowerBasis : PowerBasis ℚ QSqrtFive where
  gen := goldenRoot
  dim := 2
  basis := sqrtFiveFieldPowerBasisBase.basis.reindex
    (finCongr sqrtFiveFieldPowerBasisBase_dim)
  basis_eq_pow i := by
    rw [Basis.reindex_apply]
    rw [sqrtFiveFieldPowerBasisBase.basis_eq_pow]
    fin_cases i <;> rfl

theorem goldenPowerBasis_basis_zero :
    goldenPowerBasis.basis 0 = (1 : QSqrtFive) := by
  rw [goldenPowerBasis.basis_eq_pow]
  simp

theorem goldenPowerBasis_basis_one :
    goldenPowerBasis.basis 1 = goldenRoot := by
  rw [goldenPowerBasis.basis_eq_pow]
  simp [goldenPowerBasis]

@[simp]
theorem goldenPowerBasis_equivFun_one_zero :
    goldenPowerBasis.basis.equivFun (1 : QSqrtFive) 0 = 1 := by
  rw [← goldenPowerBasis_basis_zero]
  simp

@[simp]
theorem goldenPowerBasis_equivFun_one_one :
    goldenPowerBasis.basis.equivFun (1 : QSqrtFive) 1 = 0 := by
  rw [← goldenPowerBasis_basis_zero]
  simp

@[simp]
theorem goldenPowerBasis_equivFun_goldenRoot_zero :
    goldenPowerBasis.basis.equivFun goldenRoot 0 = 0 := by
  rw [← goldenPowerBasis_basis_one]
  simp

@[simp]
theorem goldenPowerBasis_equivFun_goldenRoot_one :
    goldenPowerBasis.basis.equivFun goldenRoot 1 = 1 := by
  rw [← goldenPowerBasis_basis_one]
  simp

@[simp]
theorem goldenPowerBasis_equivFun_rat_zero (q : ℚ) :
    goldenPowerBasis.basis.equivFun (algebraMap ℚ QSqrtFive q) 0 = q := by
  rw [Algebra.algebraMap_eq_smul_one]
  rw [← goldenPowerBasis_basis_zero]
  simp

@[simp]
theorem goldenPowerBasis_equivFun_rat_one (q : ℚ) :
    goldenPowerBasis.basis.equivFun (algebraMap ℚ QSqrtFive q) 1 = 0 := by
  rw [Algebra.algebraMap_eq_smul_one]
  rw [← goldenPowerBasis_basis_zero]
  simp

@[simp]
theorem goldenPowerBasis_equivFun_linear_zero (a b : ℚ) :
    goldenPowerBasis.basis.equivFun (a • (1 : QSqrtFive) + b • goldenRoot) 0 = a := by
  rw [← goldenPowerBasis_basis_zero, ← goldenPowerBasis_basis_one]
  simp

@[simp]
theorem goldenPowerBasis_equivFun_linear_one (a b : ℚ) :
    goldenPowerBasis.basis.equivFun (a • (1 : QSqrtFive) + b • goldenRoot) 1 = b := by
  rw [← goldenPowerBasis_basis_zero, ← goldenPowerBasis_basis_one]
  simp


end XYin.NumberField.SqrtFiveGoldenAdjoinRoot
