import Mathlib

/-!
# A small tour of mathlib's number field API

This file uses the third cyclotomic field

`K = CyclotomicField 3 ℚ`.

This is the imaginary quadratic field `ℚ(√-3)`, but it is a particularly convenient
model for examples because mathlib knows a lot about cyclotomic fields: their ring of
integers, integral power bases, discriminants, units, class groups, and Galois groups.
-/

noncomputable section

open scoped NumberField nonZeroDivisors Real ENNReal

open Module NumberField Polynomial

namespace XYin.NumberField.Experiment

/-! ## The field -/

/-- Our running example: the third cyclotomic field, i.e. `ℚ(√-3)`. -/
abbrev K : Type := CyclotomicField 3 ℚ

instance : IsCyclotomicExtension {3} ℚ K :=
  CyclotomicField.isCyclotomicExtension 3 ℚ

/-- A chosen primitive third root of unity. -/
abbrev ζ : K := IsCyclotomicExtension.zeta 3 ℚ K

theorem zeta_isPrimitiveRoot : IsPrimitiveRoot ζ 3 :=
  IsCyclotomicExtension.zeta_spec 3 ℚ K

example : Field K := by infer_instance

example : NumberField K := by infer_instance

example : IsCyclotomicExtension {3} ℚ K := by infer_instance

/-- The defining quadratic relation `ζ^2 + ζ + 1 = 0`. -/
example : ζ ^ 2 + ζ + 1 = 0 := by
  simpa using zeta_isPrimitiveRoot.isRoot_cyclotomic (by decide)

/-- The field is generated by this one element. -/
example : Algebra.adjoin ℚ ({ζ} : Set K) = ⊤ :=
  IsCyclotomicExtension.adjoin_primitive_root_eq_top zeta_isPrimitiveRoot

/-- Since `φ(3) = 2`, this cyclotomic field is quadratic over `ℚ`. -/
example : Module.finrank ℚ K = 2 := by
  rw [IsCyclotomicExtension.Rat.finrank 3 K]
  rw [Nat.totient_prime Nat.prime_three]

/-! ## An `AdjoinRoot` model of the same field -/

/--
The same quadratic field built directly by adjoining a root of `X^2 + X + 1`.
This polynomial is `Φ₃`, so adjoining one of its roots is adjoining a primitive
third root of unity.
-/
abbrev zetaThreePolynomial : ℚ[X] := X ^ 2 + X + 1

instance : Fact (Irreducible zetaThreePolynomial) := by
  refine ⟨?_⟩
  rw [zetaThreePolynomial, ← cyclotomic_three ℚ]
  exact cyclotomic.irreducible_rat (by norm_num : 0 < 3)

/-- The `AdjoinRoot` presentation of `ℚ(ζ₃)`. -/
abbrev KAdjoinRoot : Type := AdjoinRoot zetaThreePolynomial

example : Field KAdjoinRoot := by infer_instance

example : NumberField KAdjoinRoot := by infer_instance

/-- The explicit polynomial `X^2 + X + 1` is the minimal polynomial of `ζ`. -/
theorem zetaThreePolynomial_eq_minpoly : zetaThreePolynomial = minpoly ℚ ζ := by
  rw [zetaThreePolynomial, ← cyclotomic_three ℚ]
  exact
    zeta_isPrimitiveRoot.minpoly_eq_cyclotomic_of_irreducible
      (cyclotomic.irreducible_rat (by norm_num : 0 < 3))

/-- The cyclotomic model is obtained by adjoining a root of the minimal polynomial of `ζ`. -/
def zetaMinpolyAdjoinRootPresentation : IsAdjoinRoot K (minpoly ℚ ζ) :=
  IsAdjoinRoot.mkOfAdjoinEqTop
    ((IsCyclotomicExtension.integral {3} ℚ K).isIntegral ζ)
    (IsCyclotomicExtension.adjoin_primitive_root_eq_top zeta_isPrimitiveRoot)

/--
The two constructions are the same field, expressed as a `ℚ`-algebra equivalence.
In Lean this is the useful form of equality, because the constructions are different
types.
-/
abbrev adjoinRootEquivCyclotomic : KAdjoinRoot ≃ₐ[ℚ] K :=
  (AdjoinRoot.algEquivOfEq ℚ zetaThreePolynomial (minpoly ℚ ζ)
    zetaThreePolynomial_eq_minpoly).trans
    zetaMinpolyAdjoinRootPresentation.adjoinRootAlgEquiv

/-- Under the equivalence, the formal adjoining root is the cyclotomic root `ζ`. -/
theorem adjoinRootEquivCyclotomic_root :
    adjoinRootEquivCyclotomic (AdjoinRoot.root zetaThreePolynomial) = ζ := by
  change zetaMinpolyAdjoinRootPresentation.adjoinRootAlgEquiv
    ((AdjoinRoot.algEquivOfEq ℚ zetaThreePolynomial (minpoly ℚ ζ)
      zetaThreePolynomial_eq_minpoly) (AdjoinRoot.root zetaThreePolynomial)) = ζ
  rw [AdjoinRoot.algEquivOfEq_root]
  simp [zetaMinpolyAdjoinRootPresentation]

/--
This also explains the imaginary-quadratic description: in the cyclotomic model,
`2ζ + 1` is a square root of `-3`.
-/
example : (2 * ζ + 1) ^ 2 = (-3 : K) := by
  have hζ : ζ ^ 2 + ζ + 1 = 0 := by
    simpa using zeta_isPrimitiveRoot.isRoot_cyclotomic (by decide)
  calc
    (2 * ζ + 1) ^ 2 = 4 * (ζ ^ 2 + ζ + 1) - 3 := by ring
    _ = -3 := by rw [hζ]; ring

/-! ## The imaginary quadratic `AdjoinRoot` model -/

/-- The polynomial defining `ℚ(√-3)` as an `AdjoinRoot`. -/
abbrev sqrtNegThreePolynomial : ℚ[X] := X ^ 2 + 3

instance : Fact (Irreducible sqrtNegThreePolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [sqrtNegThreePolynomial, Finset.mem_Icc]
    change 1 ≤ (X ^ 2 + C (3 : ℚ)).natDegree ∧
      (X ^ 2 + C (3 : ℚ)).natDegree ≤ 3
    rw [natDegree_X_pow_add_C]
    norm_num
  · intro x hx
    have hpos : 0 < x ^ 2 + 3 := by nlinarith [sq_nonneg x]
    exact (ne_of_gt hpos) (by simpa [sqrtNegThreePolynomial, IsRoot] using hx)

/-- The field `ℚ(√-3)`, constructed by adjoining a root of `X^2 + 3`. -/
abbrev QSqrtNegThree : Type := AdjoinRoot sqrtNegThreePolynomial

example : Field QSqrtNegThree := by infer_instance

example : NumberField QSqrtNegThree := by infer_instance

/-- The formal square root of `-3` in the `AdjoinRoot` model. -/
abbrev sqrtNegThreeRoot : QSqrtNegThree := AdjoinRoot.root sqrtNegThreePolynomial

/-- The formal primitive third root in the `AdjoinRoot (X^2 + X + 1)` model. -/
abbrev zetaThreeRoot : KAdjoinRoot := AdjoinRoot.root zetaThreePolynomial

theorem sqrtNegThreeRoot_sq : sqrtNegThreeRoot ^ 2 = (-3 : QSqrtNegThree) := by
  have hroot : sqrtNegThreeRoot ^ 2 + 3 = 0 := by
    simpa [sqrtNegThreeRoot, sqrtNegThreePolynomial] using
      (AdjoinRoot.eval₂_root sqrtNegThreePolynomial)
  calc
    sqrtNegThreeRoot ^ 2 = sqrtNegThreeRoot ^ 2 + 3 - 3 := by ring
    _ = -3 := by rw [hroot]; ring

theorem zetaThreeRoot_relation : zetaThreeRoot ^ 2 + zetaThreeRoot + 1 = 0 := by
  simpa [zetaThreeRoot, zetaThreePolynomial] using
    (AdjoinRoot.eval₂_root zetaThreePolynomial)

/-- The map `ℚ(√-3) → ℚ(ζ₃)` in the two `AdjoinRoot` presentations. -/
def sqrtNegThreeToZetaThree : QSqrtNegThree →ₐ[ℚ] KAdjoinRoot :=
  AdjoinRoot.liftAlgHom sqrtNegThreePolynomial (Algebra.ofId ℚ KAdjoinRoot)
    (2 * zetaThreeRoot + 1) (by
      calc
        sqrtNegThreePolynomial.eval₂ (Algebra.ofId ℚ KAdjoinRoot) (2 * zetaThreeRoot + 1)
            = (2 * zetaThreeRoot + 1) ^ 2 + 3 := by
              simp [sqrtNegThreePolynomial]
        _ = 4 * (zetaThreeRoot ^ 2 + zetaThreeRoot + 1) := by ring
        _ = 0 := by rw [zetaThreeRoot_relation]; ring)

@[simp]
theorem sqrtNegThreeToZetaThree_root :
    sqrtNegThreeToZetaThree sqrtNegThreeRoot = 2 * zetaThreeRoot + 1 := by
  rw [sqrtNegThreeToZetaThree, sqrtNegThreeRoot]
  exact AdjoinRoot.liftAlgHom_root sqrtNegThreePolynomial (Algebra.ofId ℚ KAdjoinRoot)
    (2 * zetaThreeRoot + 1) _

/-- The inverse map sends `ζ` to `(√-3 - 1) / 2`. -/
def zetaThreeToSqrtNegThree : KAdjoinRoot →ₐ[ℚ] QSqrtNegThree :=
  AdjoinRoot.liftAlgHom zetaThreePolynomial (Algebra.ofId ℚ QSqrtNegThree)
    ((sqrtNegThreeRoot - 1) / 2) (by
      calc
        zetaThreePolynomial.eval₂ (Algebra.ofId ℚ QSqrtNegThree)
            ((sqrtNegThreeRoot - 1) / 2)
            = ((sqrtNegThreeRoot - 1) / 2) ^ 2 + (sqrtNegThreeRoot - 1) / 2 + 1 := by
              simp [zetaThreePolynomial]
        _ = (sqrtNegThreeRoot ^ 2 + 3) / 4 := by ring
        _ = 0 := by rw [sqrtNegThreeRoot_sq]; norm_num)

@[simp]
theorem zetaThreeToSqrtNegThree_root :
    zetaThreeToSqrtNegThree zetaThreeRoot = (sqrtNegThreeRoot - 1) / 2 := by
  rw [zetaThreeToSqrtNegThree, zetaThreeRoot]
  exact AdjoinRoot.liftAlgHom_root zetaThreePolynomial (Algebra.ofId ℚ QSqrtNegThree)
    ((sqrtNegThreeRoot - 1) / 2) _

/-- `AdjoinRoot (X^2 + 3)` and `AdjoinRoot (X^2 + X + 1)` are the same field. -/
def sqrtNegThreeEquivZetaThree : QSqrtNegThree ≃ₐ[ℚ] KAdjoinRoot where
  __ := sqrtNegThreeToZetaThree
  invFun := zetaThreeToSqrtNegThree
  left_inv x := by
    have hcomp :
        zetaThreeToSqrtNegThree.comp sqrtNegThreeToZetaThree =
          AlgHom.id ℚ QSqrtNegThree := by
      apply AdjoinRoot.algHom_ext
      change zetaThreeToSqrtNegThree (sqrtNegThreeToZetaThree sqrtNegThreeRoot) =
        sqrtNegThreeRoot
      rw [sqrtNegThreeToZetaThree_root]
      simp only [map_add, map_mul, map_one, map_ofNat, zetaThreeToSqrtNegThree_root]
      ring
    change (zetaThreeToSqrtNegThree.comp sqrtNegThreeToZetaThree) x =
      (AlgHom.id ℚ QSqrtNegThree) x
    rw [hcomp]
  right_inv x := by
    have hcomp :
        sqrtNegThreeToZetaThree.comp zetaThreeToSqrtNegThree =
          AlgHom.id ℚ KAdjoinRoot := by
      apply AdjoinRoot.algHom_ext
      change sqrtNegThreeToZetaThree (zetaThreeToSqrtNegThree zetaThreeRoot) =
        zetaThreeRoot
      rw [zetaThreeToSqrtNegThree_root]
      simp only [map_sub, map_div₀, map_one, map_ofNat, sqrtNegThreeToZetaThree_root]
      ring_nf
    change (sqrtNegThreeToZetaThree.comp zetaThreeToSqrtNegThree) x =
      (AlgHom.id ℚ KAdjoinRoot) x
    rw [hcomp]

@[simp]
theorem sqrtNegThreeEquivZetaThree_root :
    sqrtNegThreeEquivZetaThree sqrtNegThreeRoot = 2 * zetaThreeRoot + 1 :=
  sqrtNegThreeToZetaThree_root

/-- Therefore the `ℚ(√-3)` `AdjoinRoot` model is the cyclotomic field `K`. -/
def sqrtNegThreeEquivCyclotomic : QSqrtNegThree ≃ₐ[ℚ] K :=
  sqrtNegThreeEquivZetaThree.trans adjoinRootEquivCyclotomic

theorem sqrtNegThreeEquivCyclotomic_root :
    sqrtNegThreeEquivCyclotomic sqrtNegThreeRoot = 2 * ζ + 1 := by
  rw [sqrtNegThreeEquivCyclotomic, AlgEquiv.trans_apply]
  rw [sqrtNegThreeEquivZetaThree_root]
  simp only [map_add, map_mul, map_one, map_ofNat, adjoinRootEquivCyclotomic_root]

/-! ## The ring of integers and integral bases -/

/-- The ring of integers of `K`. -/
abbrev OK : Type := 𝓞 K

example : CommRing OK := by infer_instance

example : IsDomain OK := by infer_instance

example : Algebra OK K := by infer_instance

/-- Elements of `𝓞 K` are, by definition, integral over `ℤ`. -/
example (x : OK) : IsIntegral ℤ (x : K) :=
  x.2

/--
For cyclotomic fields, a primitive root of unity gives an explicit integral power basis
of the ring of integers.
-/
abbrev integralPowerBasis : PowerBasis ℤ OK :=
  zeta_isPrimitiveRoot.integralPowerBasis

example : integralPowerBasis.gen = zeta_isPrimitiveRoot.toInteger := by
  simp [integralPowerBasis]

example : integralPowerBasis.dim = 2 := by
  simp [integralPowerBasis, Nat.totient_prime Nat.prime_three]

example : Basis (Fin integralPowerBasis.dim) ℤ OK :=
  integralPowerBasis.basis

/-- The cyclotomic ring is another concrete model for the integral closure. -/
example : IsIntegralClosure (CyclotomicRing 3 ℤ ℚ) ℤ K :=
  IsCyclotomicExtension.Rat.cyclotomicRing_isIntegralClosure 3

/--
`IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton` says that the
`ℤ`-subalgebra `ℤ[ζ] = Algebra.adjoin ℤ {ζ}` generated by a single primitive root
inside `K` is already the full ring of integers `𝓞 K`.

Mathematically: **𝓞 K = ℤ[ζ]**.  Every algebraic integer in `K` is a `ℤ`-polynomial
in `ζ`; no further elements need to be adjoined.

This is the cyclotomic analog of `sqrtTwoInteger_adjoin_eq_top` — proved here in one
line, versus ~50 lines of Eisenstein machinery needed for `ℚ(√2)`.
-/
example : IsIntegralClosure (Algebra.adjoin ℤ ({ζ} : Set K)) ℤ K :=
  IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton zeta_isPrimitiveRoot

/--
As a consequence, the ring of integers is generated over `ℤ` by the primitive root:
`Algebra.adjoin ℤ {zeta_isPrimitiveRoot.toInteger} = ⊤` in `𝓞 K`.
This is the cyclotomic analog of `sqrtTwoInteger_adjoin_eq_top`.
-/
example : Algebra.adjoin ℤ ({integralPowerBasis.gen} : Set (𝓞 K)) = ⊤ :=
  integralPowerBasis.adjoin_gen_eq_top

/-! ## Discriminant and ramification-flavoured facts -/

/-- The absolute discriminant of `ℚ(ζ₃) = ℚ(√-3)` is `-3`. -/
example : NumberField.discr K = -3 := by
  rw [IsCyclotomicExtension.Rat.discr_prime 3 K]
  norm_num

/--
`NumberField.coe_discr` says `(NumberField.discr K : ℚ) = Algebra.discr ℚ (integralBasis K)`.
This bridges the integer-valued field discriminant to the concrete `Algebra.discr ℚ`
computed from mathlib's canonical `ℚ`-basis of `K`.
-/
example : Algebra.discr ℚ (NumberField.integralBasis K) = (-3 : ℚ) := by
  have h := NumberField.coe_discr K
  rw [show NumberField.discr K = -3 from by
        rw [IsCyclotomicExtension.Rat.discr_prime 3 K]; norm_num] at h
  simpa using h.symm

/--
`Algebra.discr_of_matrix_mulVec`: replacing basis `b` by `Pb` scales the discriminant by `det(P)²`.
This is the key formula behind the fact that all `ℤ`-bases of `𝓞 K` yield the same
`NumberField.discr K`: change-of-basis matrices between them are unimodular (`det = ±1`),
so `det(P)² = 1` and the discriminant is preserved.
-/
theorem discr_matrix_mulVec_K
    (P : Matrix (Free.ChooseBasisIndex ℤ (𝓞 K)) (Free.ChooseBasisIndex ℤ (𝓞 K)) ℚ) :
    Algebra.discr ℚ (Matrix.mulVec (P.map (algebraMap ℚ K)) (NumberField.integralBasis K)) =
      P.det ^ 2 * Algebra.discr ℚ (NumberField.integralBasis K) :=
  Algebra.discr_of_matrix_mulVec _ _

/-- Concretely: a unimodular change of basis preserves the discriminant `-3`. -/
example (P : Matrix (Free.ChooseBasisIndex ℤ (𝓞 K)) (Free.ChooseBasisIndex ℤ (𝓞 K)) ℚ)
    (hdet : P.det = 1 ∨ P.det = -1) :
    Algebra.discr ℚ (Matrix.mulVec (P.map (algebraMap ℚ K)) (NumberField.integralBasis K)) =
        (-3 : ℚ) := by
  have hdiscr : Algebra.discr ℚ (NumberField.integralBasis K) = -3 := by
    have h := NumberField.coe_discr K
    rw [show NumberField.discr K = -3 from by
          rw [IsCyclotomicExtension.Rat.discr_prime 3 K]; norm_num] at h
    simpa using h.symm
  rw [discr_matrix_mulVec_K, hdiscr]
  rcases hdet with h | h <;> simp [h]

/-- The element `ζ - 1` is a prime element of the ring of integers. -/
example : Prime (zeta_isPrimitiveRoot.toInteger - 1 : OK) :=
  zeta_isPrimitiveRoot.zeta_sub_one_prime'

/-- In this field, `ζ - 1` lies above `3`: it divides `3` in `𝓞 K`. -/
example : (zeta_isPrimitiveRoot.toInteger - 1 : OK) ∣ (3 : OK) :=
  zeta_isPrimitiveRoot.toInteger_sub_one_dvd_prime'

/-! ## Units -/

/-- The unit corresponding to `ζ`. -/
abbrev etaUnit : OKˣ :=
  (zeta_isPrimitiveRoot.toInteger_isPrimitiveRoot.isUnit (by decide)).unit

/--
The unit group is finite here: every unit is one of
`±1`, `±ζ`, `±ζ²`.
-/
example (u : OKˣ) : u ∈ ([1, -1, etaUnit, -etaUnit, etaUnit ^ 2, -etaUnit ^ 2] : List OKˣ) := by
  simpa [etaUnit] using IsCyclotomicExtension.Rat.Three.Units.mem zeta_isPrimitiveRoot u

/-- The torsion subgroup of the unit group has order `6`. -/
example : Units.torsionOrder K = 6 := by
  rw [IsCyclotomicExtension.Rat.torsionOrder_eq (n := 3) (K := K)]
  norm_num

/-- Dirichlet's unit rank is `0` for this imaginary quadratic field. -/
example : Units.rank K = 0 := by
  dsimp [Units.rank]
  rw [InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces,
    IsCyclotomicExtension.Rat.nrRealPlaces_eq_zero (n := 3) K (by norm_num),
    IsCyclotomicExtension.Rat.nrComplexPlaces_eq_totient_div_two (n := 3) K]
  rw [Nat.totient_prime Nat.prime_three]

/-! ## Minkowski bounds and class groups -/

/--
The convex-body version of the Minkowski bound in mathlib is attached to a fractional
ideal. For the trivial fractional ideal it is finite and positive.
-/
abbrev trivialFractionalIdeal : (FractionalIdeal OK⁰ K)ˣ :=
  1

example : 0 < mixedEmbedding.minkowskiBound K trivialFractionalIdeal :=
  mixedEmbedding.minkowskiBound_pos K trivialFractionalIdeal

example : mixedEmbedding.minkowskiBound K trivialFractionalIdeal < ⊤ :=
  mixedEmbedding.minkowskiBound_lt_top K trivialFractionalIdeal

/--
The class-number API presents the class group as a finite type and provides the map
from nonzero integral ideals to ideal classes.
-/
example : Fintype (ClassGroup OK) := by infer_instance

example (C : ClassGroup OK) : ∃ I : (Ideal OK)⁰, ClassGroup.mk0 I = C :=
  ClassGroup.mk0_surjective C

/-- The ring of integers is a PID, hence the class number is `1`. -/
example : IsPrincipalIdealRing OK :=
  IsCyclotomicExtension.Rat.three_pid K

example : NumberField.classNumber K = 1 :=
  NumberField.classNumber_eq_one_iff.mpr (IsCyclotomicExtension.Rat.three_pid K)

/-! ## Galois group -/

example : IsGalois ℚ K :=
  IsCyclotomicExtension.isGalois {3} ℚ K

/--
Cyclotomic Galois theory identifies `Gal(ℚ(ζ₃)/ℚ)` with `(ZMod 3)ˣ`.
An automorphism is recorded by the power to which it sends `ζ`.
-/
abbrev galEquivZMod : Gal(K / ℚ) ≃* (ZMod 3)ˣ :=
  IsCyclotomicExtension.Rat.galEquivZMod 3 K

example (σ : Gal(K/ℚ)) :
    σ ζ = ζ ^ (galEquivZMod σ).val.val :=
  IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq 3 K σ zeta_isPrimitiveRoot.pow_eq_one

/-! ## A non-cyclotomic quadratic example: `ℚ(√2)` -/

/-- The polynomial defining the real quadratic field `ℚ(√2)`. -/
abbrev sqrtTwoPolynomial : ℚ[X] := X ^ 2 - C (2 : ℚ)

instance : Fact (Irreducible sqrtTwoPolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [sqrtTwoPolynomial, Finset.mem_Icc]
    change 1 ≤ (X ^ 2 - C (2 : ℚ)).natDegree ∧
      (X ^ 2 - C (2 : ℚ)).natDegree ≤ 3
    rw [natDegree_X_pow_sub_C]
    norm_num
  · intro x hx
    have hx2 : x ^ 2 = 2 := by
      have hzero : x ^ 2 - 2 = 0 := by
        simpa [sqrtTwoPolynomial, IsRoot] using hx
      nlinarith
    have hsquare : IsSquare (2 : ℚ) := by
      rw [isSquare_iff_exists_sq]
      exact ⟨x, hx2.symm⟩
    norm_num at hsquare

/-- The real quadratic field `ℚ(√2)`, constructed directly as an `AdjoinRoot`. -/
abbrev QSqrtTwo : Type := AdjoinRoot sqrtTwoPolynomial

example : Field QSqrtTwo := by infer_instance

example : NumberField QSqrtTwo := by infer_instance

/-- The formal square root of `2`. -/
abbrev sqrtTwoRoot : QSqrtTwo := AdjoinRoot.root sqrtTwoPolynomial

theorem sqrtTwoRoot_sq : sqrtTwoRoot ^ 2 = (2 : QSqrtTwo) := by
  have hroot : sqrtTwoRoot ^ 2 - 2 = 0 := by
    simpa [sqrtTwoRoot, sqrtTwoPolynomial] using
      (AdjoinRoot.eval₂_root sqrtTwoPolynomial)
  calc
    sqrtTwoRoot ^ 2 = sqrtTwoRoot ^ 2 - 2 + 2 := by ring
    _ = 2 := by rw [hroot]; ring

/-- The usual power basis `1, √2`. -/
abbrev sqrtTwoPowerBasis : PowerBasis ℚ QSqrtTwo :=
  AdjoinRoot.powerBasis (f := sqrtTwoPolynomial)
    ((Fact.out : Irreducible sqrtTwoPolynomial).ne_zero)

example : sqrtTwoPowerBasis.gen = sqrtTwoRoot := by
  simp [sqrtTwoPowerBasis, sqrtTwoRoot]

example : sqrtTwoPowerBasis.dim = 2 := by
  change sqrtTwoPolynomial.natDegree = 2
  rw [sqrtTwoPolynomial, natDegree_X_pow_sub_C]

example : Module.finrank ℚ QSqrtTwo = 2 := by
  rw [PowerBasis.finrank sqrtTwoPowerBasis]
  change sqrtTwoPolynomial.natDegree = 2
  rw [sqrtTwoPolynomial, natDegree_X_pow_sub_C]

instance : Algebra.IsQuadraticExtension ℚ QSqrtTwo where
  finrank_eq_two' := by
    rw [PowerBasis.finrank sqrtTwoPowerBasis]
    change sqrtTwoPolynomial.natDegree = 2
    rw [sqrtTwoPolynomial, natDegree_X_pow_sub_C]

/-! ### A shifted generator: `1 + √2` -/

/--
The element `1 + √2` satisfies `X^2 - 2X - 1`.
This is a useful second presentation because `1 + √2` is a unit.
-/
abbrev sqrtTwoUnitPolynomial : ℚ[X] :=
  C (1 : ℚ) * X ^ 2 + C (-2 : ℚ) * X + C (-1 : ℚ)

instance : Fact (Irreducible sqrtTwoUnitPolynomial) := by
  refine ⟨?_⟩
  apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
  · rw [sqrtTwoUnitPolynomial, Finset.mem_Icc, natDegree_quadratic (by norm_num : (1 : ℚ) ≠ 0)]
    norm_num
  · intro x hx
    have hzero : x ^ 2 + -(2 * x) + -1 = 0 := by
      simpa [sqrtTwoUnitPolynomial, IsRoot] using hx
    have hsquare : IsSquare (2 : ℚ) := by
      rw [isSquare_iff_exists_sq]
      refine ⟨x - 1, ?_⟩
      nlinarith
    norm_num at hsquare

/-- The same field, now generated by a root of `X^2 - 2X - 1`. -/
abbrev QSqrtTwoUnitModel : Type := AdjoinRoot sqrtTwoUnitPolynomial

example : Field QSqrtTwoUnitModel := by infer_instance

example : NumberField QSqrtTwoUnitModel := by infer_instance

/-- The formal root corresponding to `1 + √2`. -/
abbrev sqrtTwoUnitRoot : QSqrtTwoUnitModel := AdjoinRoot.root sqrtTwoUnitPolynomial

theorem sqrtTwoUnitRoot_relation :
    sqrtTwoUnitRoot ^ 2 - 2 * sqrtTwoUnitRoot - 1 = 0 := by
  simpa [sqrtTwoUnitRoot, sqrtTwoUnitPolynomial] using
    (AdjoinRoot.eval₂_root sqrtTwoUnitPolynomial)

/-- The map from `ℚ(√2)` to the `1 + √2` presentation sends `√2` to `β - 1`. -/
def sqrtTwoToUnitModel : QSqrtTwo →ₐ[ℚ] QSqrtTwoUnitModel :=
  AdjoinRoot.liftAlgHom sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwoUnitModel)
    (sqrtTwoUnitRoot - 1) (by
      calc
        sqrtTwoPolynomial.eval₂ (Algebra.ofId ℚ QSqrtTwoUnitModel) (sqrtTwoUnitRoot - 1)
            = (sqrtTwoUnitRoot - 1) ^ 2 - 2 := by
              simp [sqrtTwoPolynomial]
        _ = sqrtTwoUnitRoot ^ 2 - 2 * sqrtTwoUnitRoot - 1 := by ring
        _ = 0 := sqrtTwoUnitRoot_relation)

@[simp]
theorem sqrtTwoToUnitModel_root :
    sqrtTwoToUnitModel sqrtTwoRoot = sqrtTwoUnitRoot - 1 := by
  rw [sqrtTwoToUnitModel, sqrtTwoRoot]
  exact AdjoinRoot.liftAlgHom_root sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwoUnitModel)
    (sqrtTwoUnitRoot - 1) _

/-- The inverse map sends the shifted generator to `√2 + 1`. -/
def unitModelToSqrtTwo : QSqrtTwoUnitModel →ₐ[ℚ] QSqrtTwo :=
  AdjoinRoot.liftAlgHom sqrtTwoUnitPolynomial (Algebra.ofId ℚ QSqrtTwo)
    (sqrtTwoRoot + 1) (by
      calc
        sqrtTwoUnitPolynomial.eval₂ (Algebra.ofId ℚ QSqrtTwo) (sqrtTwoRoot + 1)
            = (sqrtTwoRoot + 1) ^ 2 + -(2 * (sqrtTwoRoot + 1)) + -1 := by
              simp [sqrtTwoUnitPolynomial]
        _ = sqrtTwoRoot ^ 2 - 2 := by ring
        _ = 0 := by rw [sqrtTwoRoot_sq]; ring)

@[simp]
theorem unitModelToSqrtTwo_root :
    unitModelToSqrtTwo sqrtTwoUnitRoot = sqrtTwoRoot + 1 := by
  rw [unitModelToSqrtTwo, sqrtTwoUnitRoot]
  exact AdjoinRoot.liftAlgHom_root sqrtTwoUnitPolynomial (Algebra.ofId ℚ QSqrtTwo)
    (sqrtTwoRoot + 1) _

/-- The two `AdjoinRoot` presentations of `ℚ(√2)` are equivalent. -/
def sqrtTwoEquivUnitModel : QSqrtTwo ≃ₐ[ℚ] QSqrtTwoUnitModel where
  __ := sqrtTwoToUnitModel
  invFun := unitModelToSqrtTwo
  left_inv x := by
    have hcomp :
        unitModelToSqrtTwo.comp sqrtTwoToUnitModel = AlgHom.id ℚ QSqrtTwo := by
      apply AdjoinRoot.algHom_ext
      change unitModelToSqrtTwo (sqrtTwoToUnitModel sqrtTwoRoot) = sqrtTwoRoot
      rw [sqrtTwoToUnitModel_root]
      simp only [map_sub, map_one, unitModelToSqrtTwo_root]
      ring
    change (unitModelToSqrtTwo.comp sqrtTwoToUnitModel) x = (AlgHom.id ℚ QSqrtTwo) x
    rw [hcomp]
  right_inv x := by
    have hcomp :
        sqrtTwoToUnitModel.comp unitModelToSqrtTwo = AlgHom.id ℚ QSqrtTwoUnitModel := by
      apply AdjoinRoot.algHom_ext
      change sqrtTwoToUnitModel (unitModelToSqrtTwo sqrtTwoUnitRoot) = sqrtTwoUnitRoot
      rw [unitModelToSqrtTwo_root]
      simp only [map_add, map_one, sqrtTwoToUnitModel_root]
      ring
    change (sqrtTwoToUnitModel.comp unitModelToSqrtTwo) x =
      (AlgHom.id ℚ QSqrtTwoUnitModel) x
    rw [hcomp]

theorem sqrtTwoEquivUnitModel_root :
    sqrtTwoEquivUnitModel sqrtTwoRoot = sqrtTwoUnitRoot - 1 :=
  sqrtTwoToUnitModel_root

/-! ### Ring of integers, units, class group, and conjugation -/

/-- The ring of integers of `ℚ(√2)`. -/
abbrev O2 : Type := 𝓞 QSqrtTwo

example : CommRing O2 := by infer_instance

example : IsDomain O2 := by infer_instance

example : Algebra O2 QSqrtTwo := by infer_instance

theorem sqrtTwoRoot_isIntegral : IsIntegral ℤ sqrtTwoRoot := by
  refine ⟨X ^ 2 - C (2 : ℤ), ?_, ?_⟩
  · exact monic_X_pow_sub_C (2 : ℤ) (by norm_num : (2 : ℕ) ≠ 0)
  · simp [sqrtTwoRoot_sq]

/-- The algebraic integer `√2`. -/
abbrev sqrtTwoInteger : O2 :=
  ⟨sqrtTwoRoot, sqrtTwoRoot_isIntegral⟩

local notation "𝓟₂" => Submodule.span ℤ ({(2 : ℤ)} : Set ℤ)

/-- The same polynomial, now over `ℤ`. -/
abbrev sqrtTwoIntegerPolynomial : ℤ[X] := X ^ 2 - C (2 : ℤ)

/-- The rational minimal polynomial of the chosen root `√2`. -/
theorem sqrtTwo_minpoly_rat : minpoly ℚ sqrtTwoRoot = sqrtTwoPolynomial := by
  change minpoly ℚ (AdjoinRoot.root sqrtTwoPolynomial) = sqrtTwoPolynomial
  simpa [sqrtTwoPolynomial] using
    (AdjoinRoot.minpoly_root ((Fact.out : Irreducible sqrtTwoPolynomial).ne_zero) :
      minpoly ℚ (AdjoinRoot.root sqrtTwoPolynomial) =
        sqrtTwoPolynomial * C sqrtTwoPolynomial.leadingCoeff⁻¹)

/-- The integral minimal polynomial of `√2`, viewed as an element of the field. -/
theorem sqrtTwo_minpoly_int : minpoly ℤ sqrtTwoRoot = sqrtTwoIntegerPolynomial := by
  apply (Polynomial.map_injective (algebraMap ℤ ℚ) Int.cast_injective)
  rw [← minpoly.isIntegrallyClosed_eq_field_fractions' (K := ℚ) sqrtTwoRoot_isIntegral,
    sqrtTwo_minpoly_rat]
  change X ^ 2 - C (2 : ℚ) =
    map (algebraMap ℤ ℚ) (X ^ 2 - C (2 : ℤ))
  rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  rw [show (algebraMap ℤ ℚ) (2 : ℤ) = (2 : ℚ) by norm_num]

/-- The polynomial `X^2 - 2` is Eisenstein at `2`. -/
theorem sqrtTwo_minpoly_int_isEisenstein :
    (minpoly ℤ sqrtTwoRoot).IsEisensteinAt 𝓟₂ := by
  rw [sqrtTwo_minpoly_int]
  refine
    (monic_X_pow_sub_C (2 : ℤ)
      (by norm_num : (2 : ℕ) ≠ 0)).isEisensteinAt_of_mem_of_notMem ?_ ?_ ?_
  · rw [ne_eq, Ideal.eq_top_iff_one]
    simp [Ideal.submodule_span_eq, Ideal.mem_span_singleton]
  · intro n hn
    rw [natDegree_X_pow_sub_C] at hn
    interval_cases n <;>
      simp [Ideal.submodule_span_eq]
  · simp [Ideal.submodule_span_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]

/-- The discriminant of the order `ℤ[√2]` with basis `1, √2` is `8`. -/
theorem sqrtTwoPowerBasis_discr :
    Algebra.discr ℚ sqrtTwoPowerBasis.basis = (8 : ℚ) := by
  rw [Algebra.discr_powerBasis_eq_norm]
  have hdim : sqrtTwoPowerBasis.dim = 2 := by
    change sqrtTwoPolynomial.natDegree = 2
    rw [sqrtTwoPolynomial, natDegree_X_pow_sub_C]
  have hfin : Module.finrank ℚ QSqrtTwo = 2 := by
    rw [PowerBasis.finrank sqrtTwoPowerBasis]
    exact hdim
  have hgen : sqrtTwoPowerBasis.gen = sqrtTwoRoot := by
    simp [sqrtTwoPowerBasis, sqrtTwoRoot]
  have hnorm_two : Algebra.norm ℚ (1 + 1 : QSqrtTwo) = (4 : ℚ) := by
    rw [show (1 + 1 : QSqrtTwo) = algebraMap ℚ QSqrtTwo (2 : ℚ) by norm_num]
    rw [Algebra.norm_algebraMap, hfin]
    norm_num
  have hnorm_root : Algebra.norm ℚ sqrtTwoRoot = (-2 : ℚ) := by
    rw [← hgen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly sqrtTwoPowerBasis]
    rw [hdim, hgen, sqrtTwo_minpoly_rat]
    simp [sqrtTwoPolynomial]
  rw [hfin, hgen, sqrtTwo_minpoly_rat]
  simp [sqrtTwoRoot, sqrtTwoPolynomial, hnorm_two, hnorm_root]
  norm_num

/--
Every algebraic integer in `ℚ(√2)` lies in `ℤ[√2]`.

The proof uses the discriminant bound `8 • z ∈ ℤ[√2]`, then removes the factor
`2^3` with the Eisenstein theorem for `X^2 - 2`.
-/
theorem sqrtTwo_integral_mem_adjoin (z : QSqrtTwo) (hz : IsIntegral ℤ z) :
    z ∈ Algebra.adjoin ℤ ({sqrtTwoRoot} : Set QSqrtTwo) := by
  have hBint : IsIntegral ℤ sqrtTwoPowerBasis.gen := by
    simpa [sqrtTwoPowerBasis, sqrtTwoRoot] using sqrtTwoRoot_isIntegral
  have hdiscr :=
    Algebra.discr_mul_isIntegral_mem_adjoin (K := ℚ) (L := QSqrtTwo)
      (R := ℤ) (B := sqrtTwoPowerBasis) hBint hz
  have hpow :
      (2 : ℤ) ^ 3 • z ∈ Algebra.adjoin ℤ ({sqrtTwoPowerBasis.gen} : Set QSqrtTwo) := by
    convert hdiscr using 1
    rw [sqrtTwoPowerBasis_discr]
    norm_num [Algebra.smul_def]
  have hmem :
      z ∈ Algebra.adjoin ℤ ({sqrtTwoPowerBasis.gen} : Set QSqrtTwo) :=
    mem_adjoin_of_smul_prime_pow_smul_of_minpoly_isEisensteinAt
      (R := ℤ) (K := ℚ) (L := QSqrtTwo) (B := sqrtTwoPowerBasis)
      (p := (2 : ℤ)) (n := 3) Int.prime_two hBint hz hpow
      (by simpa [sqrtTwoPowerBasis, sqrtTwoRoot] using sqrtTwo_minpoly_int_isEisenstein)
  simpa [sqrtTwoPowerBasis, sqrtTwoRoot] using hmem

/-- The ring of integers of `ℚ(√2)` is generated over `ℤ` by `√2`. -/
theorem sqrtTwoInteger_adjoin_eq_top :
    Algebra.adjoin ℤ ({sqrtTwoInteger} : Set O2) = ⊤ := by
  apply le_antisymm le_top
  intro x hx
  have hfield :
      (x : QSqrtTwo) ∈ Algebra.adjoin ℤ ({sqrtTwoRoot} : Set QSqrtTwo) :=
    sqrtTwo_integral_mem_adjoin (x : QSqrtTwo) x.2
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hfield
  rcases hfield with ⟨P, hP⟩
  have hx_eq : x = aeval sqrtTwoInteger P := by
    ext
    change (x : QSqrtTwo) = ((aeval sqrtTwoInteger P : O2) : QSqrtTwo)
    rw [← hP]
    simpa [sqrtTwoInteger] using
      (Polynomial.aeval_algHom_apply
        (algebraMap O2 QSqrtTwo).toIntAlgHom sqrtTwoInteger P)
  rw [hx_eq]
  rw [Algebra.adjoin_singleton_eq_range_aeval]
  exact ⟨P, rfl⟩

/-- The integral minimal polynomial of `√2` as an element of `𝓞 ℚ(√2)`. -/
theorem sqrtTwoInteger_minpoly :
    minpoly ℤ sqrtTwoInteger = sqrtTwoIntegerPolynomial := by
  letI : IsScalarTower ℤ O2 QSqrtTwo :=
    IsScalarTower.of_algebraMap_eq fun z => by
      rfl
  have hint : IsIntegral ℤ sqrtTwoInteger := Algebra.IsIntegral.isIntegral sqrtTwoInteger
  have hfrac :
      minpoly ℚ ((algebraMap O2 QSqrtTwo) sqrtTwoInteger) =
        map (algebraMap ℤ ℚ) (minpoly ℤ sqrtTwoInteger) :=
    @minpoly.isIntegrallyClosed_eq_field_fractions ℤ O2
      inferInstance inferInstance inferInstance inferInstance
      ℚ QSqrtTwo inferInstance inferInstance inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance inferInstance this inferInstance inferInstance
      sqrtTwoInteger hint
  apply (Polynomial.map_injective (algebraMap ℤ ℚ) Int.cast_injective)
  rw [← hfrac]
  change minpoly ℚ sqrtTwoRoot = map (algebraMap ℤ ℚ) sqrtTwoIntegerPolynomial
  rw [sqrtTwo_minpoly_rat]
  change X ^ 2 - C (2 : ℚ) =
    map (algebraMap ℤ ℚ) (X ^ 2 - C (2 : ℤ))
  rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  rw [show (algebraMap ℤ ℚ) (2 : ℤ) = (2 : ℚ) by norm_num]

/--
An explicit integral power basis of `𝓞 ℚ(√2)`: the generator is the algebraic
integer `√2`.
-/
abbrev sqrtTwoExplicitIntegralPowerBasis : PowerBasis ℤ O2 :=
  PowerBasis.ofAdjoinEqTop'
    (Algebra.IsIntegral.isIntegral sqrtTwoInteger)
    sqrtTwoInteger_adjoin_eq_top

theorem sqrtTwoExplicitIntegralPowerBasis_gen :
    sqrtTwoExplicitIntegralPowerBasis.gen = sqrtTwoInteger := by
  exact PowerBasis.ofAdjoinEqTop'_gen
    (Algebra.IsIntegral.isIntegral sqrtTwoInteger)
    sqrtTwoInteger_adjoin_eq_top

theorem sqrtTwoExplicitIntegralPowerBasis_dim :
    sqrtTwoExplicitIntegralPowerBasis.dim = 2 := by
  rw [sqrtTwoExplicitIntegralPowerBasis, PowerBasis.ofAdjoinEqTop'_dim,
    sqrtTwoInteger_minpoly]
  change sqrtTwoIntegerPolynomial.natDegree = 2
  rw [sqrtTwoIntegerPolynomial, natDegree_X_pow_sub_C]

/-- The explicit integral basis `[1, √2]` of the ring of integers. -/
abbrev sqrtTwoExplicitIntegralBasis : Basis (Fin 2) ℤ O2 :=
  sqrtTwoExplicitIntegralPowerBasis.basis.reindex
    (finCongr sqrtTwoExplicitIntegralPowerBasis_dim)

/-- The first vector in the explicit integral basis is `1`. -/
theorem sqrtTwoExplicitIntegralBasis_zero :
    sqrtTwoExplicitIntegralBasis 0 = 1 := by
  rw [sqrtTwoExplicitIntegralBasis, Basis.reindex_apply]
  rw [sqrtTwoExplicitIntegralPowerBasis.basis_eq_pow]
  have hcoe :
      (((finCongr sqrtTwoExplicitIntegralPowerBasis_dim).symm (0 : Fin 2) :
        Fin sqrtTwoExplicitIntegralPowerBasis.dim) : ℕ) = 0 := rfl
  rw [hcoe]
  simp

example : sqrtTwoExplicitIntegralBasis 0 = 1 :=
  sqrtTwoExplicitIntegralBasis_zero

/-- The second vector in the explicit integral basis is `√2`. -/
theorem sqrtTwoExplicitIntegralBasis_one :
    sqrtTwoExplicitIntegralBasis 1 = sqrtTwoInteger := by
  rw [sqrtTwoExplicitIntegralBasis, Basis.reindex_apply]
  rw [sqrtTwoExplicitIntegralPowerBasis.basis_eq_pow]
  have hcoe :
      (((finCongr sqrtTwoExplicitIntegralPowerBasis_dim).symm (1 : Fin 2) :
        Fin sqrtTwoExplicitIntegralPowerBasis.dim) : ℕ) = 1 := rfl
  rw [hcoe]
  simp

example : sqrtTwoExplicitIntegralBasis 1 = sqrtTwoInteger :=
  sqrtTwoExplicitIntegralBasis_one

theorem sqrtTwoInteger_sq : sqrtTwoInteger ^ 2 = (2 : O2) := by
  ext
  change sqrtTwoRoot ^ 2 = (2 : QSqrtTwo)
  exact sqrtTwoRoot_sq

/-- The concrete quadratic order `ℤ[√2]` from mathlib's Pell API. -/
abbrev ZSqrtTwo : Type := Zsqrtd (2 : ℤ)

/-- The concrete `ℤ√2` model maps to the ring of integers by `√2 ↦ √2`. -/
abbrev zsqrtTwoToO2 : ZSqrtTwo →+* O2 :=
  Zsqrtd.lift ⟨sqrtTwoInteger, by simpa [sq] using sqrtTwoInteger_sq⟩

theorem zsqrtTwoToO2_apply (a b : ℤ) :
    zsqrtTwoToO2 (⟨a, b⟩ : ZSqrtTwo) =
      (a : O2) + b * sqrtTwoInteger := by
  simp [zsqrtTwoToO2]

theorem two_not_int_square : ∀ n : ℤ, (2 : ℤ) ≠ n * n := by
  intro n hn
  have hsquare : IsSquare (2 : ℤ) := ⟨n, hn⟩
  norm_num at hsquare

theorem zsqrtTwoToO2_injective : Function.Injective zsqrtTwoToO2 :=
  Zsqrtd.lift_injective
    ⟨sqrtTwoInteger, by simpa [sq] using sqrtTwoInteger_sq⟩
    two_not_int_square

theorem zsqrtTwoToO2_surjective : Function.Surjective zsqrtTwoToO2 := by
  intro x
  let a : ℤ := sqrtTwoExplicitIntegralBasis.repr x 0
  let b : ℤ := sqrtTwoExplicitIntegralBasis.repr x 1
  refine ⟨(⟨a, b⟩ : ZSqrtTwo), ?_⟩
  rw [zsqrtTwoToO2_apply]
  have hsum := sqrtTwoExplicitIntegralBasis.sum_repr x
  have h0 :
      sqrtTwoExplicitIntegralPowerBasis.basis
          ((finCongr sqrtTwoExplicitIntegralPowerBasis_dim).symm (0 : Fin 2)) =
        (1 : O2) := by
    simpa [sqrtTwoExplicitIntegralBasis, Basis.reindex_apply] using
      sqrtTwoExplicitIntegralBasis_zero
  have h1 :
      sqrtTwoExplicitIntegralPowerBasis.basis
          ((finCongr sqrtTwoExplicitIntegralPowerBasis_dim).symm (1 : Fin 2)) =
        sqrtTwoInteger := by
    simpa [sqrtTwoExplicitIntegralBasis, Basis.reindex_apply] using
      sqrtTwoExplicitIntegralBasis_one
  rw [show (a : O2) = (a : O2) * (1 : O2) by rw [mul_one]]
  rw [← h0, ← h1]
  simpa [a, b, Fin.sum_univ_two] using hsum

/-- The explicit ring equivalence `ℤ√2 ≃ 𝓞 ℚ(√2)`. -/
abbrev zsqrtTwoEquivO2 : ZSqrtTwo ≃+* O2 :=
  RingEquiv.ofBijective zsqrtTwoToO2
    ⟨zsqrtTwoToO2_injective, zsqrtTwoToO2_surjective⟩

/-- The unit `1 + √2` in the ring of integers. -/
abbrev sqrtTwoFundamentalUnit : O2ˣ where
  val := sqrtTwoInteger + 1
  inv := sqrtTwoInteger - 1
  val_inv := by
    ext
    calc
      (sqrtTwoRoot + 1) * (sqrtTwoRoot - 1) = sqrtTwoRoot ^ 2 - 1 := by ring
      _ = (1 : QSqrtTwo) := by rw [sqrtTwoRoot_sq]; ring
  inv_val := by
    ext
    calc
      (sqrtTwoRoot - 1) * (sqrtTwoRoot + 1) = sqrtTwoRoot ^ 2 - 1 := by ring
      _ = (1 : QSqrtTwo) := by rw [sqrtTwoRoot_sq]; ring

/-- The same unit `1 + √2`, but in mathlib's concrete `ℤ√2` model. -/
abbrev zsqrtTwoFundamentalUnit : ZSqrtTwoˣ where
  val := ⟨1, 1⟩
  inv := ⟨-1, 1⟩
  val_inv := by
    ext <;> norm_num
  inv_val := by
    ext <;> norm_num

theorem zsqrtTwoFundamentalUnit_norm :
    Zsqrtd.norm (zsqrtTwoFundamentalUnit : ZSqrtTwo) = -1 := by
  norm_num [zsqrtTwoFundamentalUnit, Zsqrtd.norm]

theorem zsqrtTwoEquivO2_fundamentalUnit :
    Units.mapEquiv zsqrtTwoEquivO2.toMulEquiv zsqrtTwoFundamentalUnit =
      sqrtTwoFundamentalUnit := by
  apply Units.ext
  change zsqrtTwoEquivO2 (⟨1, 1⟩ : ZSqrtTwo) = sqrtTwoInteger + 1
  change zsqrtTwoToO2 (⟨1, 1⟩ : ZSqrtTwo) = sqrtTwoInteger + 1
  rw [zsqrtTwoToO2_apply]
  ring

theorem zsqrtTwoEquivO2_unitsMap_neg (v : ZSqrtTwoˣ) :
    Units.mapEquiv zsqrtTwoEquivO2.toMulEquiv (-v) =
      -(Units.mapEquiv zsqrtTwoEquivO2.toMulEquiv v) := by
  apply Units.ext
  change zsqrtTwoEquivO2 (-(v : ZSqrtTwo)) =
    -zsqrtTwoEquivO2 (v : ZSqrtTwo)
  rw [map_neg]

/--
The square of `1 + √2` is `3 + 2√2`, a norm-one unit.
Mathlib's Pell API phrases "fundamental" for norm-one solutions, so this is
the Pell solution attached to the fundamental unit `1 + √2`.
-/
theorem sqrtTwoFundamentalUnit_sq :
    ((sqrtTwoFundamentalUnit ^ 2 : O2ˣ) : O2) =
      3 + 2 * sqrtTwoInteger := by
  ext
  calc
    (sqrtTwoRoot + 1) ^ 2 =
        sqrtTwoRoot ^ 2 + 2 * sqrtTwoRoot + 1 := by ring
    _ = (3 : QSqrtTwo) + 2 * sqrtTwoRoot := by rw [sqrtTwoRoot_sq]; ring

/-- The Pell solution `3 + 2√2`, i.e. `(1 + √2)^2`. -/
abbrev pellTwoFundamentalSolution : Pell.Solution₁ (2 : ℤ) :=
  Pell.Solution₁.mk 3 2 (by norm_num)

/--
`3 + 2√2` is the fundamental norm-one solution of Pell's equation
`x^2 - 2y^2 = 1`. Equivalently, the unit `1 + √2` is the usual fundamental
unit, with square equal to the fundamental positive norm-one unit.
-/
theorem pellTwoFundamentalSolution_isFundamental :
    Pell.IsFundamental pellTwoFundamentalSolution := by
  refine ⟨?_, ?_, ?_⟩
  · norm_num [pellTwoFundamentalSolution]
  · norm_num [pellTwoFundamentalSolution]
  · intro b hb
    by_contra hlt
    have hsmall : b.x < 3 := by
      have h := not_le.mp hlt
      simpa [pellTwoFundamentalSolution] using h
    have hx2 : b.x = 2 := by omega
    have hprop := b.prop
    rw [hx2] at hprop
    have hodd : 2 * b.y ^ 2 = 3 := by nlinarith
    omega

/-- Every norm-one Pell unit for `d = 2` is a signed power of `3 + 2√2`. -/
theorem pellTwoFundamentalSolution_generates_normOnePell
    (a : Pell.Solution₁ (2 : ℤ)) :
    ∃ n : ℤ, a = pellTwoFundamentalSolution ^ n ∨
      a = -pellTwoFundamentalSolution ^ n :=
  pellTwoFundamentalSolution_isFundamental.eq_zpow_or_neg_zpow a

theorem zsqrtTwoFundamentalUnit_sq_toPell :
    (Unitary.toUnits pellTwoFundamentalSolution : ZSqrtTwoˣ) =
      zsqrtTwoFundamentalUnit ^ 2 := by
  ext <;> norm_num [pellTwoFundamentalSolution, zsqrtTwoFundamentalUnit,
    pow_two]

theorem zsqrtTwo_normOneUnit_generated_by_square
    (u : ZSqrtTwoˣ) (hnorm : Zsqrtd.norm (u : ZSqrtTwo) = 1) :
    ∃ n : ℤ, u = zsqrtTwoFundamentalUnit ^ (2 * n) ∨
      u = -(zsqrtTwoFundamentalUnit ^ (2 * n)) := by
  let a : Pell.Solution₁ (2 : ℤ) :=
    ⟨(u : ZSqrtTwo), Zsqrtd.norm_eq_one_iff_mem_unitary.mp hnorm⟩
  have hua : u = Unitary.toUnits a := by
    apply Units.ext
    rfl
  obtain ⟨n, hn | hn⟩ := pellTwoFundamentalSolution_generates_normOnePell a
  · refine ⟨n, Or.inl ?_⟩
    calc
      u = Unitary.toUnits a := hua
      _ = Unitary.toUnits (pellTwoFundamentalSolution ^ n) := by rw [hn]
      _ = (Unitary.toUnits pellTwoFundamentalSolution : ZSqrtTwoˣ) ^ n := by
        exact (Unitary.toUnits : unitary ZSqrtTwo →* ZSqrtTwoˣ).map_zpow
          pellTwoFundamentalSolution n
      _ = (zsqrtTwoFundamentalUnit ^ 2) ^ n := by
        rw [zsqrtTwoFundamentalUnit_sq_toPell]
      _ = zsqrtTwoFundamentalUnit ^ (2 * n) :=
        (zpow_mul zsqrtTwoFundamentalUnit 2 n).symm
  · refine ⟨n, Or.inr ?_⟩
    calc
      u = Unitary.toUnits a := hua
      _ = Unitary.toUnits (-(pellTwoFundamentalSolution ^ n)) := by rw [hn]
      _ = -Unitary.toUnits (pellTwoFundamentalSolution ^ n) := by
        apply Units.ext
        rfl
      _ = -((Unitary.toUnits pellTwoFundamentalSolution : ZSqrtTwoˣ) ^ n) := by
        have hpow :
            Unitary.toUnits (pellTwoFundamentalSolution ^ n) =
              (Unitary.toUnits pellTwoFundamentalSolution : ZSqrtTwoˣ) ^ n :=
          (Unitary.toUnits : unitary ZSqrtTwo →* ZSqrtTwoˣ).map_zpow
            pellTwoFundamentalSolution n
        rw [hpow]
      _ = -(zsqrtTwoFundamentalUnit ^ (2 * n)) := by
        rw [zsqrtTwoFundamentalUnit_sq_toPell]
        exact congrArg Neg.neg
          (zpow_mul zsqrtTwoFundamentalUnit 2 n).symm

/-- Every unit of `ℤ√2` is a signed power of `1 + √2`. -/
theorem zsqrtTwo_units_generated_by_fundamental (u : ZSqrtTwoˣ) :
    ∃ n : ℤ, u = zsqrtTwoFundamentalUnit ^ n ∨
      u = -(zsqrtTwoFundamentalUnit ^ n) := by
  have hnormUnit : IsUnit (Zsqrtd.norm (u : ZSqrtTwo)) :=
    (Zsqrtd.isUnit_iff_norm_isUnit (u : ZSqrtTwo)).mp u.isUnit
  rcases Int.isUnit_eq_one_or hnormUnit with hnorm | hnorm
  · obtain ⟨n, hn | hn⟩ :=
      zsqrtTwo_normOneUnit_generated_by_square u hnorm
    · exact ⟨2 * n, Or.inl hn⟩
    · exact ⟨2 * n, Or.inr hn⟩
  · have hmulnorm :
        Zsqrtd.norm ((u * zsqrtTwoFundamentalUnit : ZSqrtTwoˣ) :
          ZSqrtTwo) = 1 := by
      rw [Units.val_mul, Zsqrtd.norm_mul, hnorm,
        zsqrtTwoFundamentalUnit_norm]
      norm_num
    obtain ⟨n, hn | hn⟩ :=
      zsqrtTwo_normOneUnit_generated_by_square
        (u * zsqrtTwoFundamentalUnit) hmulnorm
    · refine ⟨2 * n - 1, Or.inl ?_⟩
      calc
        u = (u * zsqrtTwoFundamentalUnit) *
            zsqrtTwoFundamentalUnit⁻¹ := by group
        _ = (zsqrtTwoFundamentalUnit ^ (2 * n)) *
            zsqrtTwoFundamentalUnit⁻¹ := by rw [hn]
        _ = zsqrtTwoFundamentalUnit ^ (2 * n - 1) := by
          rw [← zpow_neg_one zsqrtTwoFundamentalUnit, ← zpow_add]
          ring_nf
    · refine ⟨2 * n - 1, Or.inr ?_⟩
      calc
        u = (u * zsqrtTwoFundamentalUnit) *
            zsqrtTwoFundamentalUnit⁻¹ := by group
        _ = (-(zsqrtTwoFundamentalUnit ^ (2 * n))) *
            zsqrtTwoFundamentalUnit⁻¹ := by rw [hn]
        _ = -(zsqrtTwoFundamentalUnit ^ (2 * n - 1)) := by
          rw [neg_mul, ← zpow_neg_one zsqrtTwoFundamentalUnit, ← zpow_add]
          ring_nf

/-- Every unit of `𝓞 ℚ(√2)` is a signed power of the unit `1 + √2`. -/
theorem sqrtTwoFundamentalUnit_generates_unitGroup (u : O2ˣ) :
    ∃ n : ℤ, u = sqrtTwoFundamentalUnit ^ n ∨
      u = -(sqrtTwoFundamentalUnit ^ n) := by
  let e : ZSqrtTwoˣ ≃* O2ˣ :=
    Units.mapEquiv zsqrtTwoEquivO2.toMulEquiv
  obtain ⟨n, hn | hn⟩ :=
    zsqrtTwo_units_generated_by_fundamental (e.symm u)
  · refine ⟨n, Or.inl ?_⟩
    calc
      u = e (e.symm u) := (e.apply_symm_apply u).symm
      _ = e (zsqrtTwoFundamentalUnit ^ n) := by rw [hn]
      _ = e zsqrtTwoFundamentalUnit ^ n := by
        exact map_zpow e zsqrtTwoFundamentalUnit n
      _ = sqrtTwoFundamentalUnit ^ n := by
        rw [zsqrtTwoEquivO2_fundamentalUnit]
  · refine ⟨n, Or.inr ?_⟩
    calc
      u = e (e.symm u) := (e.apply_symm_apply u).symm
      _ = e (-(zsqrtTwoFundamentalUnit ^ n)) := by rw [hn]
      _ = -(e (zsqrtTwoFundamentalUnit ^ n)) := by
        exact zsqrtTwoEquivO2_unitsMap_neg (zsqrtTwoFundamentalUnit ^ n)
      _ = -(e zsqrtTwoFundamentalUnit ^ n) := by
        rw [map_zpow e zsqrtTwoFundamentalUnit n]
      _ = -(sqrtTwoFundamentalUnit ^ n) := by
        rw [zsqrtTwoEquivO2_fundamentalUnit]

/--
The unit `1 + √2` is fundamental, in the standard Pell normalization: its
square is the positive norm-one generator, and that generator produces all
norm-one Pell units up to sign.
-/
theorem sqrtTwoFundamentalUnit_isFundamental :
    ((sqrtTwoFundamentalUnit ^ 2 : O2ˣ) : O2) =
        3 + 2 * sqrtTwoInteger ∧
      ∀ a : Pell.Solution₁ (2 : ℤ), ∃ n : ℤ,
        a = pellTwoFundamentalSolution ^ n ∨
          a = -pellTwoFundamentalSolution ^ n := by
  exact ⟨sqrtTwoFundamentalUnit_sq,
    pellTwoFundamentalSolution_generates_normOnePell⟩

example : Fintype (ClassGroup O2) := by infer_instance

example (C : ClassGroup O2) : ∃ I : (Ideal O2)⁰, ClassGroup.mk0 I = C :=
  ClassGroup.mk0_surjective C

abbrev trivialFractionalIdealSqrtTwo : (FractionalIdeal O2⁰ QSqrtTwo)ˣ :=
  1

example : 0 < mixedEmbedding.minkowskiBound QSqrtTwo trivialFractionalIdealSqrtTwo :=
  mixedEmbedding.minkowskiBound_pos QSqrtTwo trivialFractionalIdealSqrtTwo

example : mixedEmbedding.minkowskiBound QSqrtTwo trivialFractionalIdealSqrtTwo < ⊤ :=
  mixedEmbedding.minkowskiBound_lt_top QSqrtTwo trivialFractionalIdealSqrtTwo

/-- The nontrivial conjugation automorphism sends `√2` to `-√2`. -/
def sqrtTwoConjHom : QSqrtTwo →ₐ[ℚ] QSqrtTwo :=
  AdjoinRoot.liftAlgHom sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwo)
    (-sqrtTwoRoot) (by
      calc
        sqrtTwoPolynomial.eval₂ (Algebra.ofId ℚ QSqrtTwo) (-sqrtTwoRoot)
            = (-sqrtTwoRoot) ^ 2 - 2 := by
              simp [sqrtTwoPolynomial]
        _ = sqrtTwoRoot ^ 2 - 2 := by ring
        _ = 0 := by rw [sqrtTwoRoot_sq]; ring)

@[simp]
theorem sqrtTwoConjHom_root : sqrtTwoConjHom sqrtTwoRoot = -sqrtTwoRoot := by
  change sqrtTwoConjHom (AdjoinRoot.root sqrtTwoPolynomial) = -sqrtTwoRoot
  rw [sqrtTwoConjHom]
  exact AdjoinRoot.liftAlgHom_root sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwo)
    (-sqrtTwoRoot) _

/-- The conjugation map is an involutive `ℚ`-algebra equivalence. -/
def sqrtTwoConj : QSqrtTwo ≃ₐ[ℚ] QSqrtTwo where
  __ := sqrtTwoConjHom
  invFun := sqrtTwoConjHom
  left_inv x := by
    have hcomp : sqrtTwoConjHom.comp sqrtTwoConjHom = AlgHom.id ℚ QSqrtTwo := by
      apply AdjoinRoot.algHom_ext
      change sqrtTwoConjHom (sqrtTwoConjHom sqrtTwoRoot) = sqrtTwoRoot
      rw [sqrtTwoConjHom_root]
      simp only [map_neg, sqrtTwoConjHom_root, neg_neg]
    change (sqrtTwoConjHom.comp sqrtTwoConjHom) x = (AlgHom.id ℚ QSqrtTwo) x
    rw [hcomp]
  right_inv x := by
    have hcomp : sqrtTwoConjHom.comp sqrtTwoConjHom = AlgHom.id ℚ QSqrtTwo := by
      apply AdjoinRoot.algHom_ext
      change sqrtTwoConjHom (sqrtTwoConjHom sqrtTwoRoot) = sqrtTwoRoot
      rw [sqrtTwoConjHom_root]
      simp only [map_neg, sqrtTwoConjHom_root, neg_neg]
    change (sqrtTwoConjHom.comp sqrtTwoConjHom) x = (AlgHom.id ℚ QSqrtTwo) x
    rw [hcomp]

example : sqrtTwoConj sqrtTwoRoot = -sqrtTwoRoot :=
  sqrtTwoConjHom_root

example : IsGalois ℚ QSqrtTwo := by infer_instance

/-! ## `QuadraticAlgebra` model of `ℚ(√2)` and equivalence with `AdjoinRoot`

`QuadraticAlgebra ℚ 2 0` stores elements as explicit pairs `⟨re, im⟩ : ℚ × ℚ` with
multiplication rule `ω² = 2 + 0·ω = 2`. This is more concrete than the polynomial quotient
`AdjoinRoot (X²-2)`: every element is literally a pair of rationals, and operations reduce
to arithmetic on those pairs.

We disable `DivisionRing.toRatAlgebra` locally to avoid a diamond on
`Algebra ℚ (QuadraticAlgebra ℚ 2 0)`.
-/

section
attribute [-instance] DivisionRing.toRatAlgebra

/-- `ℚ(√2)` modelled as `QuadraticAlgebra ℚ 2 0`, where `ω` satisfies `ω² = 2`. -/
abbrev QSqrtTwoQA : Type := QuadraticAlgebra ℚ 2 0

/-- `2` is not a perfect square in `ℚ`, so `QuadraticAlgebra ℚ 2 0` is a field. -/
instance : Fact (∀ r : ℚ, r ^ 2 ≠ (2 : ℚ) + 0 * r) :=
  ⟨fun r h => by
    simp only [zero_mul, add_zero] at h
    have : IsSquare (2 : ℚ) := by rw [isSquare_iff_exists_sq]; exact ⟨r, h.symm⟩
    norm_num at this⟩

example : Field QSqrtTwoQA := by infer_instance

/-- `QSqrtTwoQA` is 2-dimensional over `ℚ` with basis `{1, ω}`. -/
example : Module.finrank ℚ QSqrtTwoQA = 2 := QuadraticAlgebra.finrank_eq_two 2 0

/-- The generator `ω` satisfies `ω² = 2`. -/
theorem QSqrtTwoQA_omega_sq : (QuadraticAlgebra.omega : QSqrtTwoQA) ^ 2 = 2 := by
  rw [sq, QuadraticAlgebra.omega_mul_omega_eq_mk]; rfl

/-! ### Norm -/

/-- The norm of `⟨a, b⟩` is `a² - 2b²` — the standard norm for `ℚ(√2)`.
This is computed directly from the `re`/`im` components, with no need to unfold
a polynomial quotient. -/
theorem QSqrtTwoQA_norm (a b : ℚ) :
    QuadraticAlgebra.norm (⟨a, b⟩ : QSqrtTwoQA) = a ^ 2 - 2 * b ^ 2 := by
  simp [QuadraticAlgebra.norm_def]; ring

/-- The norm of the generator is `-2`. -/
theorem QSqrtTwoQA_norm_omega :
    QuadraticAlgebra.norm (QuadraticAlgebra.omega : QSqrtTwoQA) = -2 := by
  simp [QuadraticAlgebra.norm_def, QuadraticAlgebra.omega]

/-- The norm is multiplicative (this is a `MonoidHom`, already proved in Mathlib). -/
example (x y : QSqrtTwoQA) :
    QuadraticAlgebra.norm (x * y) = QuadraticAlgebra.norm x * QuadraticAlgebra.norm y :=
  map_mul QuadraticAlgebra.norm x y

/-! ### Conjugation (`star`) -/

/-- Conjugation in `QSqrtTwoQA` negates the imaginary part: `star ⟨a, b⟩ = ⟨a, -b⟩`.
This is the `ℚ(√2)` field conjugate `a + b√2 ↦ a - b√2`, given for free by the `StarRing`
instance on `QuadraticAlgebra`. -/
theorem QSqrtTwoQA_star (a b : ℚ) :
    star (⟨a, b⟩ : QSqrtTwoQA) = ⟨a, -b⟩ := by
  simp [QuadraticAlgebra.star_mk]

/-- In particular, `star ω = -ω`. -/
theorem QSqrtTwoQA_star_omega :
    star (QuadraticAlgebra.omega : QSqrtTwoQA) = -QuadraticAlgebra.omega := by
  simp [QuadraticAlgebra.omega_re, QuadraticAlgebra.omega_im, QuadraticAlgebra.ext_iff]

/-! ### Units -/

/-- `⟨a, b⟩ : QSqrtTwoQA` is a unit if and only if `a² - 2b² ≠ 0`.
This is an immediate corollary of `QuadraticAlgebra.isUnit_iff_norm_isUnit`. -/
theorem QSqrtTwoQA_isUnit_iff (a b : ℚ) :
    IsUnit (⟨a, b⟩ : QSqrtTwoQA) ↔ a ^ 2 - 2 * b ^ 2 ≠ 0 := by
  rw [QuadraticAlgebra.isUnit_iff_norm_isUnit, isUnit_iff_ne_zero, QSqrtTwoQA_norm]

/-- The generator `ω` is a unit (its norm `-2` is invertible in `ℚ`). -/
example : IsUnit (QuadraticAlgebra.omega : QSqrtTwoQA) := by
  rw [QuadraticAlgebra.isUnit_iff_norm_isUnit, QSqrtTwoQA_norm_omega]
  norm_num

/-! ### Equivalence with `AdjoinRoot` -/

/-- The `ℚ`-algebra map `QuadraticAlgebra ℚ 2 0 →ₐ[ℚ] AdjoinRoot (X²-2)`,
sending `ω ↦ sqrtTwoRoot`. Constructed via `QuadraticAlgebra.lift`, which requires
only a root of `u·u = 2·1 + 0·u`. -/
def QSqrtTwoQA_toAdjoinRoot : QSqrtTwoQA →ₐ[ℚ] QSqrtTwo :=
  QuadraticAlgebra.lift.toFun ⟨sqrtTwoRoot, by
    simp only [zero_smul, add_zero]
    rw [show (2 : ℚ) • (1 : QSqrtTwo) = 2 from by simp [Algebra.smul_def], ← sq]
    exact sqrtTwoRoot_sq⟩

@[simp]
theorem QSqrtTwoQA_toAdjoinRoot_omega :
    QSqrtTwoQA_toAdjoinRoot QuadraticAlgebra.omega = sqrtTwoRoot := by
  simp [QSqrtTwoQA_toAdjoinRoot]

/-- The `ℚ`-algebra map `AdjoinRoot (X²-2) →ₐ[ℚ] QuadraticAlgebra ℚ 2 0`,
sending `sqrtTwoRoot ↦ ω`. -/
def QSqrtTwoAdjoinRoot_toQA : QSqrtTwo →ₐ[ℚ] QSqrtTwoQA :=
  AdjoinRoot.liftAlgHom sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwoQA)
    QuadraticAlgebra.omega (by
      have : sqrtTwoPolynomial.eval₂ (Algebra.ofId ℚ QSqrtTwoQA) QuadraticAlgebra.omega =
          (QuadraticAlgebra.omega : QSqrtTwoQA) ^ 2 - 2 := by
        simp [sqrtTwoPolynomial]
      rw [this, QSqrtTwoQA_omega_sq, sub_self])

@[simp]
theorem QSqrtTwoAdjoinRoot_toQA_root :
    QSqrtTwoAdjoinRoot_toQA sqrtTwoRoot = QuadraticAlgebra.omega := by
  rw [QSqrtTwoAdjoinRoot_toQA, sqrtTwoRoot]
  exact AdjoinRoot.liftAlgHom_root sqrtTwoPolynomial (Algebra.ofId ℚ QSqrtTwoQA)
    QuadraticAlgebra.omega _

/-- `QuadraticAlgebra ℚ 2 0 ≃ₐ[ℚ] AdjoinRoot (X²-2)`:
the explicit-pair and polynomial-quotient constructions of `ℚ(√2)` are the same field. -/
def QSqrtTwoQA_equiv : QSqrtTwoQA ≃ₐ[ℚ] QSqrtTwo :=
  AlgEquiv.ofAlgHom QSqrtTwoQA_toAdjoinRoot QSqrtTwoAdjoinRoot_toQA
    (by
      apply AdjoinRoot.algHom_ext
      change QSqrtTwoQA_toAdjoinRoot (QSqrtTwoAdjoinRoot_toQA sqrtTwoRoot) = sqrtTwoRoot
      rw [QSqrtTwoAdjoinRoot_toQA_root, QSqrtTwoQA_toAdjoinRoot_omega])
    (by
      apply QuadraticAlgebra.algHom_ext
      change QSqrtTwoAdjoinRoot_toQA (QSqrtTwoQA_toAdjoinRoot QuadraticAlgebra.omega) =
        QuadraticAlgebra.omega
      rw [QSqrtTwoQA_toAdjoinRoot_omega, QSqrtTwoAdjoinRoot_toQA_root])

@[simp]
theorem QSqrtTwoQA_equiv_omega :
    QSqrtTwoQA_equiv QuadraticAlgebra.omega = sqrtTwoRoot :=
  QSqrtTwoQA_toAdjoinRoot_omega

-- Note: the correspondence `QSqrtTwoQA_equiv (star x) = sqrtTwoConj (QSqrtTwoQA_equiv x)` holds
-- morally (both send ω ↦ -ω and fix ℚ), but a formal proof inside this section is blocked
-- by the diamond on `Algebra ℚ QSqrtTwo` introduced by `attribute [-instance]` above.

end

