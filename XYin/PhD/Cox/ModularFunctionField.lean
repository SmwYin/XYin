import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import XYin.PhD.Cox.ModularPolynomial.Interpolation
import XYin.PhD.ModularFunctions.Algebra

/-!
# The bundled modular function field for `Γ₀(N)`

This file upgrades Cox Theorem 11.9(ii) from a guarded pointwise rational expression to an
equality between the subfield generated by bundled level-`N` modular functions and `ℂ(j)(j_N)`
inside the codiscrete meromorphic function field on the upper half-plane. Modular functions enter
this field through their canonical bundled representatives. At level one the field is `ℂ(j)`
itself (`gamma0ModularFunctionField_one`, Theorem 11.9(i) in field form).

Since `ℂ(j)` consists of modular functions for every subgroup of `SL₂(ℤ)`
(`algebraMap_ratFunc_mem_subfield`), both parts of Theorem 11.9 are also statements about the
fields `ModularFunction.subfield Γ` of all modular functions: the field of modular functions for
`SL₂(ℤ)` is `ℂ(j)` (`theorem_11_9_i_subfield`) and the field of modular functions for `Γ₀(N)` is
`ℂ(j, j_N)` (`theorem_11_9_ii_subfield`).

The element `j_N = j(Nτ)` of the function field appears under three names, related by
`toMeromorphicField_levelJModularFunction` and `rightCosetRoot_baseRightCoset`.
-/

open UpperHalfPlane UpperHalfPlane.MeromorphicField Filter
open scoped Manifold MatrixGroups Polynomial.Bivariate

noncomputable section

namespace Cox
namespace UpperHalfPlaneFunctionField

/-- The function `j(Nτ)`, bundled as a holomorphic function. -/
def levelJElement (N : ℕ+) : HolomorphicFunction :=
  ⟨levelJ N, levelJ_mdifferentiable N⟩

/-- Evaluate a bivariate complex polynomial at the holomorphic functions `j` and `j_N`. -/
def evalJLevelHol (N : ℕ+) : ℂ[X][Y] →+* HolomorphicFunction :=
  Polynomial.eval₂RingHom evalJ (levelJElement N)

/-- At level one, `j(Nτ)` is `j` itself. -/
theorem levelJElement_one : levelJElement 1 = jElement :=
  HolomorphicFunction.ext fun τ ↦
    (levelJ_apply 1 τ).trans (congrArg j (UpperHalfPlane.ext (by simp)))

/-- The holomorphic conjugate attached to the identity coset is `j(Nτ)`. -/
theorem rightCosetFunction_baseRightCoset (N : ℕ+) :
    rightCosetFunction N (baseRightCoset N) = levelJElement N :=
  HolomorphicFunction.ext (congrFun (rightCosetEval_baseRightCoset N))

/-- Pointwise, bundled bivariate evaluation substitutes analytic `j` and `j(Nτ)`. -/
@[simp]
theorem evalJLevelHol_apply (N : ℕ+) (P : ℂ[X][Y]) (τ : ℍ) :
    (evalJLevelHol N P).1 τ = P.evalEval (j τ) (levelJ N τ) := by
  change evaluation τ (Polynomial.eval₂ evalJ (levelJElement N) P) = _
  rw [Polynomial.hom_eval₂, evaluation_comp_evalJ, Polynomial.eval₂_evalRingHom]
  rfl

/-- Bivariate evaluation in the ambient analytic function field. -/
def evalJLevel (N : ℕ+) : ℂ[X][Y] →+* FunctionField :=
  (algebraMap HolomorphicFunction FunctionField).comp (evalJLevelHol N)

/-- The ambient function-field element represented by `j(Nτ)`. -/
def levelJFieldElement (N : ℕ+) : FunctionField :=
  algebraMap HolomorphicFunction FunctionField (levelJElement N)

/-- The conjugate root attached to the identity coset is `j(Nτ)`. -/
theorem rightCosetRoot_baseRightCoset (N : ℕ+) :
    rightCosetRoot N (baseRightCoset N) = levelJFieldElement N :=
  congrArg _ (rightCosetFunction_baseRightCoset N)

/-- Bivariate evaluation at `j` and `j_N` is evaluation at `j_N` over `ℂ(j)`. -/
theorem evalJLevel_eq_aeval (N : ℕ+) (P : ℂ[X][Y]) :
    evalJLevel N P = Polynomial.aeval (levelJFieldElement N)
      (P.map (algebraMap (Polynomial ℂ) (RatFunc ℂ))) := by
  rw [Polynomial.aeval_def, Polynomial.eval₂_map,
    show (algebraMap (RatFunc ℂ) FunctionField).comp (algebraMap (Polynomial ℂ) (RatFunc ℂ)) =
      evalJFracPoly from RingHom.ext ratFuncEvalJ_algebraMap]
  exact Polynomial.hom_eval₂ P evalJ (algebraMap HolomorphicFunction FunctionField) _

/-- A guarded pointwise quotient identifies the corresponding meromorphic field elements: the
identity `(f b - a) b = 0` holds at every point of `ℍ`, hence in the meromorphic field. -/
theorem toMeromorphicField_eq_div_of {Γ : Subgroup (GL (Fin 2) ℝ)}
    (f : ModularFunction Γ) (a b : HolomorphicFunction) (hb : b ≠ 0)
    (hf : ∀ τ : ℍ, b.1 τ ≠ 0 → f τ = a.1 τ / b.1 τ) :
    f.toMeromorphicField = algebraMap HolomorphicFunction FunctionField a /
      algebraMap HolomorphicFunction FunctionField b := by
  have hbmap : algebraMap HolomorphicFunction FunctionField b ≠ 0 :=
    (map_ne_zero_iff _ holomorphicToMeromorphic_injective).2 hb
  rw [eq_div_iff hbmap, ← sub_eq_zero, ← mul_eq_zero_iff_right hbmap,
    f.toMeromorphicField_eq_ofMeromorphic, algebraMap_eq_ofMeromorphic,
    algebraMap_eq_ofMeromorphic, ← ofMeromorphic_mul, ← ofMeromorphic_sub, ← ofMeromorphic_mul,
    ← ofMeromorphic_zero, ofMeromorphic_eq_iff]
  refine Eventually.of_forall fun τ ↦ ?_
  by_cases hτ : b.1 τ = 0
  · simp [hτ]
  · simp [hf τ hτ, div_mul_cancel₀ _ hτ]

/-- A guarded rational expression in `j` and `j_N` is equality in the meromorphic field. -/
theorem toMeromorphicField_eq_evalJLevel_div_of {Γ : Subgroup (GL (Fin 2) ℝ)}
    (N : ℕ+) (f : ModularFunction Γ) (P Q : ℂ[X][Y])
    (hQ : (fun τ : ℍ ↦ Q.evalEval (j τ) (levelJ N τ)) ≠ 0)
    (hf : ∀ τ : ℍ, Q.evalEval (j τ) (levelJ N τ) ≠ 0 →
      f τ = P.evalEval (j τ) (levelJ N τ) / Q.evalEval (j τ) (levelJ N τ)) :
    f.toMeromorphicField = evalJLevel N P / evalJLevel N Q := by
  apply toMeromorphicField_eq_div_of f (evalJLevelHol N P) (evalJLevelHol N Q)
  · refine fun hzero ↦ hQ (funext fun τ ↦ ?_)
    simpa only [evalJLevelHol_apply, Subring.coe_zero, Pi.zero_apply] using
      congrArg (·.1 τ) hzero
  · simpa only [evalJLevelHol_apply] using hf

/-- Cox Theorem 11.9(i) in the ambient field: a level-one modular function lies in `ℂ(j)`. -/
theorem toMeromorphicField_eq_ratFunc (f : ModularFunction 𝒮ℒ) :
    ∃ r : RatFunc ℂ, algebraMap (RatFunc ℂ) FunctionField r = f.toMeromorphicField := by
  obtain ⟨P, Q, hQ, hPQ⟩ := theorem_11_9_i f
  have hf := toMeromorphicField_eq_div_of f (evalJ P) (evalJ Q)
    ((map_ne_zero_iff _ evalJ_injective).2 hQ) (by simpa only [evalJ_apply] using hPQ)
  refine ⟨algebraMap (Polynomial ℂ) (RatFunc ℂ) P /
    algebraMap (Polynomial ℂ) (RatFunc ℂ) Q, ?_⟩
  rw [hf, algebraMap_ratFunc, map_div₀, ratFuncEvalJ_algebraMap, ratFuncEvalJ_algebraMap]
  rfl

/-- The images of all bundled level-`N` modular functions in the meromorphic field. -/
def modularRepresentatives (N : ℕ+) : Set FunctionField :=
  Set.range (ModularFunction.toMeromorphicField
    (Γ := CongruenceSubgroup.Gamma0 (N : ℕ)))

/-- The images of the level-`N` modular functions form the subfield of all modular functions for
`Γ₀(N)`. -/
theorem modularRepresentatives_eq (N : ℕ+) :
    modularRepresentatives N = ModularFunction.subfield (CongruenceSubgroup.Gamma0 (N : ℕ)) :=
  ModularFunction.range_toMeromorphicField

/-- The subfield generated by bundled level-`N` modular functions over `ℂ(j)`. -/
def gamma0ModularFunctionField (N : ℕ+) :
    IntermediateField (RatFunc ℂ) FunctionField :=
  IntermediateField.adjoin (RatFunc ℂ) (modularRepresentatives N)

/-- The simple extension `ℂ(j)(j(Nτ))` in the same ambient function field. -/
def jLevelFunctionField (N : ℕ+) : IntermediateField (RatFunc ℂ) FunctionField :=
  IntermediateField.adjoin (RatFunc ℂ) {levelJFieldElement N}

/-- Every bivariate polynomial in `j` and `j_N` belongs to `ℂ(j)(j_N)`. -/
theorem evalJLevel_mem_jLevelFunctionField (N : ℕ+) (P : ℂ[X][Y]) :
    evalJLevel N P ∈ jLevelFunctionField N := by
  rw [evalJLevel_eq_aeval]
  exact IntermediateField.algebra_adjoin_le_adjoin _ _
    (Polynomial.aeval_mem_adjoin_singleton _ _)

/-- Every bundled level-`N` modular function belongs to `ℂ(j)(j_N)`. -/
theorem toMeromorphicField_mem_jLevelFunctionField (N : ℕ+)
    (f : ModularFunction (CongruenceSubgroup.Gamma0 (N : ℕ))) :
    f.toMeromorphicField ∈ jLevelFunctionField N := by
  obtain ⟨P, Q, hQ, hPQ⟩ := theorem_11_9_ii_pointwise N f
  rw [toMeromorphicField_eq_evalJLevel_div_of N f P Q hQ hPQ]
  exact (jLevelFunctionField N).div_mem
    (evalJLevel_mem_jLevelFunctionField N P) (evalJLevel_mem_jLevelFunctionField N Q)

/-- The bundled `j_N` maps to its holomorphic germ. -/
@[simp]
theorem toMeromorphicField_levelJModularFunction (N : ℕ+) :
    (levelJModularFunction N).toMeromorphicField = levelJFieldElement N :=
  ModularFunction.toMeromorphicField_ofGamma0Holomorphic ..

/-- The rational functions in `j` are modular for every subgroup `Γ` of `SL₂(ℤ)`: `ℂ(j)` lies in
the field `ModularFunction.subfield Γ` of modular functions for `Γ`. -/
theorem algebraMap_ratFunc_mem_subfield {Γ : Subgroup (GL (Fin 2) ℝ)} [DiscreteTopology Γ]
    [Γ.HasDetOne] (hΓ : Γ ≤ 𝒮ℒ) (r : RatFunc ℂ) :
    algebraMap (RatFunc ℂ) FunctionField r ∈ ModularFunction.subfield Γ := by
  have hj : algebraMap HolomorphicFunction FunctionField jElement ∈ ModularFunction.subfield Γ := by
    have h : (jModularFunction.restrict hΓ).toMeromorphicField =
        algebraMap HolomorphicFunction FunctionField jElement :=
      ModularFunction.toMeromorphicField_eq_iff.2 (by simp [jElement])
    exact h ▸ (jModularFunction.restrict hΓ).isModular_toMeromorphicField
  have hpoly (P : Polynomial ℂ) : evalJFracPoly P ∈ ModularFunction.subfield Γ := by
    induction P using Polynomial.induction_on' with
    | add P Q hP hQ => exact map_add evalJFracPoly P Q ▸ add_mem hP hQ
    | monomial n c =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, evalJFracPoly,
        RingHom.comp_apply, RingHom.comp_apply, evalJ_C, evalJ_X]
      exact mul_mem (MeromorphicField.IsModular.algebraMap c) (pow_mem hj n)
  induction r using RatFunc.induction_on with
  | f p q _ =>
    simpa only [map_div₀, algebraMap_ratFunc, ratFuncEvalJ_algebraMap] using
      div_mem (hpoly p) (hpoly q)

end UpperHalfPlaneFunctionField

open UpperHalfPlaneFunctionField

/-- Cox Theorem 11.9(ii), as an equality of subfields of the meromorphic function field. -/
theorem theorem_11_9_ii (N : ℕ+) :
    gamma0ModularFunctionField N = jLevelFunctionField N := by
  apply le_antisymm
  · rw [gamma0ModularFunctionField, IntermediateField.adjoin_le_iff]
    rintro x ⟨f, rfl⟩
    exact toMeromorphicField_mem_jLevelFunctionField N f
  · rw [jLevelFunctionField, IntermediateField.adjoin_simple_le_iff]
    exact IntermediateField.subset_adjoin (RatFunc ℂ) (modularRepresentatives N)
      ⟨levelJModularFunction N, toMeromorphicField_levelJModularFunction N⟩

/-- Cox Theorem 11.9(i), field form: the level-one modular functions generate no more than
`ℂ(j)`. -/
theorem gamma0ModularFunctionField_one : gamma0ModularFunctionField 1 = ⊥ := by
  rw [theorem_11_9_ii, jLevelFunctionField, IntermediateField.adjoin_simple_eq_bot_iff,
    IntermediateField.mem_bot]
  refine ⟨RatFunc.X, ?_⟩
  rw [algebraMap_ratFunc, ← RatFunc.algebraMap_X, ratFuncEvalJ_algebraMap, evalJFracPoly,
    RingHom.comp_apply, evalJ_X, levelJFieldElement, levelJElement_one]

/-- Cox Theorem 11.9(i) as a statement about the field of modular functions: the modular
functions for `SL₂(ℤ)` are exactly the rational functions in `j`, i.e. the field
`ModularFunction.subfield 𝒮ℒ` of level-one modular functions is `ℂ(j)`. -/
theorem theorem_11_9_i_subfield :
    ModularFunction.subfield 𝒮ℒ = (algebraMap (RatFunc ℂ) FunctionField).fieldRange := by
  refine le_antisymm (fun a ha ↦ ?_) ?_
  · rw [← SetLike.mem_coe, ← ModularFunction.range_toMeromorphicField] at ha
    obtain ⟨f, rfl⟩ := ha
    exact RingHom.mem_fieldRange.2 (toMeromorphicField_eq_ratFunc f)
  · rintro _ ⟨r, rfl⟩
    exact algebraMap_ratFunc_mem_subfield le_rfl r

/-- Cox Theorem 11.9(ii) as a statement about the field of modular functions: the modular
functions for `Γ₀(N)` are exactly `ℂ(j, j_N)`, i.e. the field `ModularFunction.subfield Γ₀(N)` of
modular functions for `Γ₀(N)` is `ℂ(j)(j(Nτ))`. -/
theorem theorem_11_9_ii_subfield (N : ℕ+) :
    ModularFunction.subfield (CongruenceSubgroup.Gamma0 (N : ℕ)) =
      (IntermediateField.adjoin (RatFunc ℂ) {levelJFieldElement N}).toSubfield := by
  let K := (ModularFunction.subfield (CongruenceSubgroup.Gamma0 (N : ℕ))).toIntermediateField
    (algebraMap_ratFunc_mem_subfield (Subgroup.map_le_range ..))
  have hK : gamma0ModularFunctionField N = K := by
    rw [gamma0ModularFunctionField, modularRepresentatives_eq]
    exact IntermediateField.adjoin_self _ K
  change _ = (jLevelFunctionField N).toSubfield
  rw [← theorem_11_9_ii, hK]
  rfl

end Cox
