import Mathlib.Algebra.Polynomial.Bivariate
import XYin.PhD.Cox.LatticeJ
import XYin.PhD.jFunction.jLevelN

/-!
# Modular functions for `Γ₀(N)` and Cox Theorem 11.9

This file fixes a source-faithful predicate for weight-zero modular functions: meromorphic on
the upper half-plane, invariant under `Γ₀(N)`, and meromorphic at every cusp after applying an
arbitrary element of `SL₂(ℤ)`.
-/

open Complex Filter Function MatrixGroups ModularForm UpperHalfPlane
open scoped Manifold Polynomial.Bivariate

noncomputable section

namespace Cox

/-- The project's `τ ↦ j(Nτ)`, with positivity packaged by a positive natural level. -/
noncomputable def levelJ (N : ℕ+) : ℍ → ℂ :=
  @jN (N : ℕ) ⟨PNat.ne_zero N⟩

/-- A meromorphic weight-zero modular function for `Γ₀(N)`, including meromorphicity at every
cusp.  The cusp width `N` is deliberately explicit, matching Cox §11.B.
-/
def IsGamma0ModularFunction (N : ℕ+) (f : ℍ → ℂ) : Prop :=
  (∀ z : ℂ, 0 < z.im → MeromorphicAt (f ∘ UpperHalfPlane.ofComplex) z) ∧
  (∀ γ : CongruenceSubgroup.Gamma0 (N : ℕ), f ∣[(0 : ℤ)] (γ : SL(2, ℤ)) = f) ∧
  (∀ γ : SL(2, ℤ),
    MeromorphicAt (cuspFunction ((N : ℕ) : ℝ) (fun τ : ℍ ↦ f (γ • τ))) 0)

/-- Level-one modular functions. -/
abbrev IsLevelOneModularFunction (f : ℍ → ℂ) : Prop :=
  IsGamma0ModularFunction (1 : ℕ+) f

/-- Pointwise evaluation of a polynomial in a function. -/
def polynomialIn (P : Polynomial ℂ) (g : ℍ → ℂ) : ℍ → ℂ :=
  fun τ ↦ P.eval (g τ)

/-- A function belongs to the rational function field generated by one function.  Equality is
required away from the zero set of the chosen denominator, which is the appropriate pointwise
form of equality of meromorphic functions.
-/
def RationalIn (f g : ℍ → ℂ) : Prop :=
  ∃ P Q : Polynomial ℂ, Q ≠ 0 ∧
    ∀ τ : ℍ, Q.eval (g τ) ≠ 0 → f τ = P.eval (g τ) / Q.eval (g τ)

/-- A function belongs to the rational function field generated by two functions. -/
def RationalInTwo (f g h : ℍ → ℂ) : Prop :=
  ∃ P Q : ℂ[X][Y], Q ≠ 0 ∧
    ∀ τ : ℍ, Q.evalEval (g τ) (h τ) ≠ 0 →
      f τ = P.evalEval (g τ) (h τ) / Q.evalEval (g τ) (h τ)

/-- Cox's conjugation argument: after a modular transformation, a `Γ₀(N)`-modular function
has period `N`. -/
theorem periodic_comp_sl2 (N : ℕ+) {f : ℍ → ℂ}
    (hf : IsGamma0ModularFunction N f) (γ : SL(2, ℤ)) :
    Periodic (fun z : ℂ ↦ f (γ • UpperHalfPlane.ofComplex z)) ((N : ℕ) : ℂ) := by
  sorry

/-- Meromorphicity at a cusp means that the corresponding `q^(1/N)` Laurent expansion has a
finite principal part. -/
theorem cusp_laurent_finitePrincipalPart (N : ℕ+) {f : ℍ → ℂ}
    (hf : IsGamma0ModularFunction N f) (γ : SL(2, ℤ)) :
    ∃ k : ℤ, ∀ n < k,
      (laurentqExpansion ((N : ℕ) : ℝ) (fun τ : ℍ ↦ f (γ • τ))).coeff n = 0 := by
  sorry

/-- The analytic modular `j` is a level-one modular function. -/
theorem j_isLevelOneModularFunction : IsLevelOneModularFunction j := by
  sorry

/-- Restricting level-one invariance makes `j` a `Γ₀(N)`-modular function. -/
theorem j_isGamma0ModularFunction (N : ℕ+) : IsGamma0ModularFunction N j := by
  sorry

/-- The second generator `j(Nτ)` is a `Γ₀(N)`-modular function. -/
theorem levelJ_isGamma0ModularFunction (N : ℕ+) :
    IsGamma0ModularFunction N (levelJ N) := by
  sorry

/-- Cox Lemma 11.10(i): a level-one modular function holomorphic on `ℍ` and at `∞` is
constant. -/
theorem levelOne_constant_of_holomorphic {f : ℍ → ℂ}
    (hf : IsLevelOneModularFunction f) (hfH : MDiff f)
    (hf_cusp : AnalyticAt ℂ (cuspFunction 1 f) 0) :
    ∃ c : ℂ, f = fun _ ↦ c := by
  sorry

/-- Cox Lemma 11.10(ii): a level-one modular function holomorphic on `ℍ` is a polynomial
in `j`. -/
theorem levelOne_polynomialInJ_of_holomorphic {f : ℍ → ℂ}
    (hf : IsLevelOneModularFunction f) (hfH : MDiff f) :
    ∃ P : Polynomial ℂ, f = polynomialIn P j := by
  sorry

/-- Pole-clearing package for the proof of Theorem 11.9(i).  It includes the ordinary-point
case and the stabilizer corrections at `i` and `exp(2πi/3)` (orders divisible by two and three).
-/
theorem levelOne_exists_polynomial_clearing_poles {f : ℍ → ℂ}
    (hf : IsLevelOneModularFunction f) :
    ∃ P : Polynomial ℂ, P ≠ 0 ∧ MDiff (fun τ ↦ P.eval (j τ) * f τ) := by
  sorry

/-- Cox Theorem 11.9(i): the level-one modular function field is `ℂ(j)`. -/
theorem theorem_11_9_i {f : ℍ → ℂ} (hf : IsLevelOneModularFunction f) :
    RationalIn f j := by
  sorry

/-- Cox Theorem 11.9(ii): the `Γ₀(N)` modular function field is generated by `j(τ)` and
`j(Nτ)`.  The modular-polynomial and interpolation declarations supplying the proof live in
`ModularPolynomial.lean`.
-/
theorem theorem_11_9_ii (N : ℕ+) {f : ℍ → ℂ}
    (hf : IsGamma0ModularFunction N f) : RationalInTwo f j (levelJ N) := by
  sorry

end Cox
