import Mathlib.Algebra.Polynomial.Bivariate
import Mathlib.Analysis.Meromorphic.NormalForm
import Mathlib.Analysis.Meromorphic.TrailingCoefficient

import XYin.PhD.Cox.LatticeJ
import XYin.PhD.jFunction.jLevelN

/-!
# Modular functions for `Γ₀(N)` and Cox Theorem 11.9

This file fixes a source-faithful predicate for weight-zero modular functions: meromorphic on
the upper half-plane, invariant under `Γ₀(N)`, and meromorphic at every cusp after applying an
arbitrary element of `SL₂(ℤ)`.
-/

open Complex Filter Function MatrixGroups ModularForm UpperHalfPlane
open scoped Manifold Polynomial.Bivariate

noncomputable section

namespace Cox

/-- The project's `τ ↦ j(Nτ)`, with positivity packaged by a positive natural level. -/
noncomputable def levelJ (N : ℕ+) : ℍ → ℂ :=
  @jN (N : ℕ) ⟨PNat.ne_zero N⟩

/-- A meromorphic weight-zero modular function for `Γ₀(N)`, including meromorphicity at every
cusp.  The cusp width `N` is deliberately explicit, matching Cox §11.B.
-/
def IsGamma0ModularFunction (N : ℕ+) (f : ℍ → ℂ) : Prop :=
  (∀ z : ℂ, 0 < z.im → MeromorphicAt (f ∘ UpperHalfPlane.ofComplex) z) ∧
  (∀ γ : CongruenceSubgroup.Gamma0 (N : ℕ), f ∣[(0 : ℤ)] (γ : SL(2, ℤ)) = f) ∧
  (∀ γ : SL(2, ℤ),
    MeromorphicAt (cuspFunction ((N : ℕ) : ℝ) (fun τ : ℍ ↦ f (γ • τ))) 0)

/-- Level-one modular functions. -/
abbrev IsLevelOneModularFunction (f : ℍ → ℂ) : Prop :=
  IsGamma0ModularFunction (1 : ℕ+) f

/-- Pointwise evaluation of a polynomial in a function. -/
def polynomialIn (P : Polynomial ℂ) (g : ℍ → ℂ) : ℍ → ℂ :=
  fun τ ↦ P.eval (g τ)

/-- A function belongs to the rational function field generated by one function.  Equality is
required away from the zero set of the chosen denominator, which is the appropriate pointwise
form of equality of meromorphic functions.
-/
def RationalIn (f g : ℍ → ℂ) : Prop :=
  ∃ P Q : Polynomial ℂ, Q ≠ 0 ∧
    ∀ τ : ℍ, Q.eval (g τ) ≠ 0 → f τ = P.eval (g τ) / Q.eval (g τ)

/-- A function belongs to the rational function field generated by two functions. The
denominator must be nonzero after restriction to the parametrized curve; merely requiring the
formal bivariate polynomial to be nonzero would allow a defining equation of the curve and make
the predicate vacuous. -/
def RationalInTwo (f g h : ℍ → ℂ) : Prop :=
  ∃ P Q : ℂ[X][Y], (fun τ : ℍ ↦ Q.evalEval (g τ) (h τ)) ≠ 0 ∧
    ∀ τ : ℍ, Q.evalEval (g τ) (h τ) ≠ 0 →
      f τ = P.evalEval (g τ) (h τ) / Q.evalEval (g τ) (h τ)

private lemma periodic_comp_ofComplex_of_vadd {g : ℍ → ℂ} {h : ℝ}
    (hg : ∀ τ, g (h +ᵥ τ) = g τ) :
    Periodic (g ∘ UpperHalfPlane.ofComplex) (h : ℂ) := by
  intro z
  by_cases hz : 0 < z.im
  · have hzadd : 0 < (z + (h : ℂ)).im := by simpa using hz
    simp only [Function.comp_apply, UpperHalfPlane.ofComplex_apply_of_im_pos hzadd,
      UpperHalfPlane.ofComplex_apply_of_im_pos hz]
    convert hg ⟨z, hz⟩ using 2
    ext
    simp [UpperHalfPlane.coe_vadd, add_comm]
  · have hz' : z.im ≤ 0 := le_of_not_gt hz
    have hzadd : (z + (h : ℂ)).im ≤ 0 := by simpa using hz'
    simp [UpperHalfPlane.ofComplex_apply_of_im_nonpos hzadd,
      UpperHalfPlane.ofComplex_apply_of_im_nonpos hz']

private lemma conjugate_T_pow_mem_Gamma0 (N : ℕ+) (γ : SL(2, ℤ)) :
    γ * ModularGroup.T ^ (N : ℤ) * γ⁻¹ ∈ CongruenceSubgroup.Gamma0 (N : ℕ) := by
  rw [CongruenceSubgroup.Gamma0_mem]
  have hentry :
      ((γ * ModularGroup.T ^ (N : ℤ) * γ⁻¹ : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 0 =
        -(N : ℤ) * (γ 1 0) ^ 2 := by
    rw [Matrix.SpecialLinearGroup.SL2_inv_expl γ]
    change
      (γ.1 * (ModularGroup.T ^ (N : ℤ)).1 *
        (!![γ.1 1 1, -γ.1 0 1; -γ.1 1 0, γ.1 0 0] : Matrix (Fin 2) (Fin 2) ℤ))
          1 0 = _
    rw [ModularGroup.coe_T_zpow]
    simp [Matrix.mul_apply, Fin.sum_univ_two]
    ring
  rw [hentry]
  simp

/-- Cox's conjugation argument: after a modular transformation, a `Γ₀(N)`-modular function
has period `N`. -/
theorem periodic_comp_sl2 (N : ℕ+) {f : ℍ → ℂ}
    (hf : IsGamma0ModularFunction N f) (γ : SL(2, ℤ)) :
    Periodic (fun z : ℂ ↦ f (γ • UpperHalfPlane.ofComplex z)) ((N : ℕ) : ℂ) := by
  let t : SL(2, ℤ) := ModularGroup.T ^ (N : ℤ)
  let δ : SL(2, ℤ) := γ * t * γ⁻¹
  have hδ : δ ∈ CongruenceSubgroup.Gamma0 (N : ℕ) :=
    conjugate_T_pow_mem_Gamma0 N γ
  have hinv (τ : ℍ) : f (δ • τ) = f τ := by
    have h := congrFun (hf.2.1 ⟨δ, hδ⟩) τ
    simpa only [ModularForm.SL_slash_apply, neg_zero, zpow_zero, mul_one] using h
  have hperiod (τ : ℍ) :
      f (γ • (((N : ℕ) : ℝ) +ᵥ τ)) = f (γ • τ) := by
    have hT : t • τ = (((N : ℕ) : ℝ) +ᵥ τ) := by
      simpa only [t, Int.cast_natCast] using
        UpperHalfPlane.modular_T_zpow_smul τ (N : ℤ)
    rw [← hT]
    simpa only [δ, mul_smul, inv_smul_smul] using hinv (γ • τ)
  simpa only [Function.comp_def, ofReal_natCast] using
    periodic_comp_ofComplex_of_vadd (g := fun τ ↦ f (γ • τ)) hperiod

/-- Meromorphicity at a cusp means that the corresponding `q^(1/N)` Laurent expansion has a
finite principal part. -/
theorem cusp_laurent_finitePrincipalPart (N : ℕ+) {f : ℍ → ℂ}
    (hf : IsGamma0ModularFunction N f) (γ : SL(2, ℤ)) :
    ∃ k : ℤ, ∀ n < k,
      (laurentqExpansion ((N : ℕ) : ℝ) (fun τ : ℍ ↦ f (γ • τ))).coeff n = 0 := by
  have _hmeromorphic :
      MeromorphicAt
        (cuspFunction ((N : ℕ) : ℝ) (fun τ : ℍ ↦ f (γ • τ))) 0 :=
    hf.2.2 γ
  refine ⟨-(poleOrder ((N : ℕ) : ℝ) (fun τ : ℍ ↦ f (γ • τ)) : ℤ), ?_⟩
  intro n hn
  exact laurentqExpansion.coeff_eq_zero_of_lt hn

/-- The analytic modular function `j` is holomorphic on the upper half-plane. -/
theorem j_mdifferentiable : MDiff j := by
  rw [UpperHalfPlane.mdifferentiable_iff]
  intro z hz
  have hE4 : DifferentiableAt ℂ (E4 ∘ UpperHalfPlane.ofComplex) z :=
    UpperHalfPlane.mdifferentiableAt_iff.mp (ModularFormClass.holo E4 ⟨z, hz⟩)
  have hDelta : DifferentiableAt ℂ (Delta ∘ UpperHalfPlane.ofComplex) z :=
    UpperHalfPlane.mdifferentiableAt_iff.mp (ModularFormClass.holo Delta ⟨z, hz⟩)
  have hDelta0 : (Delta ∘ UpperHalfPlane.ofComplex) z ≠ 0 := by
    simpa [Function.comp_def, UpperHalfPlane.ofComplex_apply_of_im_pos hz, Delta_apply] using
      Δ_ne_zero (UpperHalfPlane.ofComplex z)
  have hj : DifferentiableAt ℂ (j ∘ UpperHalfPlane.ofComplex) z := by
    simpa [j, Function.comp_def] using (hE4.pow 3).div hDelta hDelta0
  exact hj.differentiableWithinAt

/-- The analytic `j`-function has period one. -/
theorem j_periodic : Periodic (j ∘ UpperHalfPlane.ofComplex) 1 := by
  have hperiod (τ : ℍ) : j ((1 : ℝ) +ᵥ τ) = j τ := by
    rw [← UpperHalfPlane.modular_T_smul]
    exact j_modularGroup_smul _ _
  simpa only [ofReal_one] using periodic_comp_ofComplex_of_vadd hperiod

private lemma j_meromorphicAt (z : ℂ) (hz : 0 < z.im) :
    MeromorphicAt (j ∘ UpperHalfPlane.ofComplex) z := by
  have hjdiff : DifferentiableOn ℂ (j ∘ UpperHalfPlane.ofComplex) {w | 0 < w.im} :=
    UpperHalfPlane.mdifferentiable_iff.mp j_mdifferentiable
  exact (hjdiff.analyticAt (UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds hz)).meromorphicAt

/-- Restricting level-one invariance makes `j` a `Γ₀(N)`-modular function. -/
theorem j_isGamma0ModularFunction (N : ℕ+) : IsGamma0ModularFunction N j := by
  refine ⟨j_meromorphicAt, ?_, ?_⟩
  · intro γ
    exact j_slash_invariant γ
  · intro γ
    have hfun : (fun τ : ℍ ↦ j (γ • τ)) = j := by
      funext τ
      exact j_modularGroup_smul γ τ
    rw [hfun]
    simpa using meromorphicAt_cuspFunction_nat_mul (m := (N : ℕ)) (h := 1)
      (PNat.ne_zero N) j_cuspFunction_meromorphicAt j_periodic

/-- The analytic modular `j` is a level-one modular function. -/
theorem j_isLevelOneModularFunction : IsLevelOneModularFunction j :=
  j_isGamma0ModularFunction 1

private def natScaleUpperHalfPlane (N : ℕ+) (τ : ℍ) : ℍ :=
  ⟨(N : ℂ) * (τ : ℂ), by
    rw [Complex.mul_im]
    simp only [Complex.natCast_re, Complex.natCast_im, zero_mul, add_zero]
    exact mul_pos (Nat.cast_pos.mpr (PNat.pos N)) τ.im_pos⟩

@[simp]
private lemma coe_natScaleUpperHalfPlane (N : ℕ+) (τ : ℍ) :
    ((natScaleUpperHalfPlane N τ : ℍ) : ℂ) = (N : ℂ) * (τ : ℂ) :=
  rfl

private def affineUpperHalfPlane (g s : ℕ) (hg : 0 < g) (hs : 0 < s)
    (r : ℤ) (τ : ℍ) : ℍ :=
  ((r : ℝ) / s) +ᵥ
    ((⟨(g : ℝ) / s, div_pos (Nat.cast_pos.mpr hg) (Nat.cast_pos.mpr hs)⟩ :
      {x : ℝ // 0 < x}) • τ)

@[simp]
private lemma coe_affineUpperHalfPlane (g s : ℕ) (hg : 0 < g) (hs : 0 < s)
    (r : ℤ) (τ : ℍ) :
    ((affineUpperHalfPlane g s hg hs r τ : ℍ) : ℂ) =
      ((r : ℝ) / s : ℂ) + ((g : ℝ) / s : ℂ) * (τ : ℂ) := by
  simp [affineUpperHalfPlane]

private lemma qParam_affineUpperHalfPlane (g s : ℕ) (hg : 0 < g) (hs : 0 < s)
    (r : ℤ) (τ : ℍ) :
    Periodic.qParam 1 (affineUpperHalfPlane g s hg hs r τ) =
      Complex.exp (2 * Real.pi * Complex.I * ((r : ℝ) / s)) *
        Periodic.qParam ((g * s : ℕ) : ℝ) τ ^ (g * g) := by
  rw [Periodic.qParam, Periodic.qParam, coe_affineUpperHalfPlane]
  simp only [Complex.ofReal_one, div_one]
  rw [show 2 * (Real.pi : ℂ) * Complex.I *
      (((r : ℝ) / s : ℂ) + ((g : ℝ) / s : ℂ) * (τ : ℂ)) =
      2 * (Real.pi : ℂ) * Complex.I * ((r : ℝ) / s) +
        2 * (Real.pi : ℂ) * Complex.I * (((g : ℝ) / s : ℂ) * (τ : ℂ)) by ring,
    Complex.exp_add, ← Complex.exp_nat_mul]
  congr 1
  congr 1
  field_simp [show (g : ℂ) ≠ 0 by exact_mod_cast hg.ne',
    show (s : ℂ) ≠ 0 by exact_mod_cast hs.ne']
  push_cast
  ring

private lemma complex_mobius_scale_eq_affine
    {n p q u v a b c d g r s z : ℂ}
    (hD : c * z + d ≠ 0) (hs : s ≠ 0)
    (h00 : p * (n * a) + q * c = g) (h01 : p * (n * b) + q * d = r)
    (h10 : u * (n * a) + v * c = 0) (h11 : u * (n * b) + v * d = s) :
    (p * (n * ((a * z + b) / (c * z + d))) + q) /
        (u * (n * ((a * z + b) / (c * z + d))) + v) =
      r / s + g / s * z := by
  let D := c * z + d
  have hD' : D ≠ 0 := by simpa [D] using hD
  have hnum : p * (n * ((a * z + b) / D)) + q = (g * z + r) / D := by
    field_simp [hD']
    linear_combination z * h00 + h01
  have hden : u * (n * ((a * z + b) / D)) + v = s / D := by
    field_simp [hD']
    linear_combination z * h10 + h11
  rw [show c * z + d = D from rfl, hnum, hden]
  field_simp [hD', hs]
  ring

private lemma coe_inv_smul_natScale_smul (N : ℕ+) (γ δ : SL(2, ℤ)) (τ : ℍ) :
    (((δ⁻¹ : SL(2, ℤ)) • natScaleUpperHalfPlane N (γ • τ) : ℍ) : ℂ) =
      ((((δ⁻¹ : SL(2, ℤ)) 0 0 : ℤ) : ℂ) *
          ((N : ℂ) *
            ((((γ 0 0 : ℤ) : ℂ) * (τ : ℂ) + (γ 0 1 : ℤ)) /
              (((γ 1 0 : ℤ) : ℂ) * (τ : ℂ) + (γ 1 1 : ℤ)))) +
        (((δ⁻¹ : SL(2, ℤ)) 0 1 : ℤ) : ℂ)) /
      ((((δ⁻¹ : SL(2, ℤ)) 1 0 : ℤ) : ℂ) *
          ((N : ℂ) *
            ((((γ 0 0 : ℤ) : ℂ) * (τ : ℂ) + (γ 0 1 : ℤ)) /
              (((γ 1 0 : ℤ) : ℂ) * (τ : ℂ) + (γ 1 1 : ℤ)))) +
        (((δ⁻¹ : SL(2, ℤ)) 1 1 : ℤ) : ℂ)) := by
  rw [UpperHalfPlane.coe_specialLinearGroup_apply, coe_natScaleUpperHalfPlane,
    UpperHalfPlane.coe_specialLinearGroup_apply]
  rfl

private lemma inv_smul_natScale_smul_eq_affine
    (N : ℕ+) (γ δ : SL(2, ℤ)) (g s : ℕ) (hg : 0 < g) (hs : 0 < s)
    (r : ℤ)
    (hmat : (δ⁻¹ : SL(2, ℤ)).1 *
        !![(N : ℤ) * γ 0 0, (N : ℤ) * γ 0 1; γ 1 0, γ 1 1] =
      !![(g : ℤ), r; 0, (s : ℤ)]) (τ : ℍ) :
    (δ⁻¹ : SL(2, ℤ)) • natScaleUpperHalfPlane N (γ • τ) =
      affineUpperHalfPlane g s hg hs r τ := by
  have h00 := congrArg (fun x : ℤ ↦ (x : ℂ)) (congrFun (congrFun hmat 0) 0)
  have h01 := congrArg (fun x : ℤ ↦ (x : ℂ)) (congrFun (congrFun hmat 0) 1)
  have h10 := congrArg (fun x : ℤ ↦ (x : ℂ)) (congrFun (congrFun hmat 1) 0)
  have h11 := congrArg (fun x : ℤ ↦ (x : ℂ)) (congrFun (congrFun hmat 1) 1)
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.of_apply, Matrix.cons_val_zero,
    Matrix.cons_val_one] at h00 h01 h10 h11
  push_cast at h00 h01 h10 h11
  have hD : (((γ 1 0 : ℤ) : ℂ) * (τ : ℂ) + (γ 1 1 : ℤ)) ≠ 0 := by
    simpa [ModularGroup.denom_apply, algebraMap_int_eq] using
      UpperHalfPlane.denom_ne_zero γ τ
  apply UpperHalfPlane.ext
  rw [coe_inv_smul_natScale_smul, coe_affineUpperHalfPlane]
  exact complex_mobius_scale_eq_affine hD (by exact_mod_cast hs.ne')
    h00 h01 h10 h11

private lemma cuspFunction_affine_j_eq (g s : ℕ) (hg : 0 < g) (hs : 0 < s)
    (r : ℤ) {q : ℂ} (hq0 : q ≠ 0) (hqnorm : ‖q‖ < 1) :
    cuspFunction (((g * s : ℕ) : ℝ))
        (fun τ : ℍ ↦ j (affineUpperHalfPlane g s hg hs r τ)) q =
      cuspFunction 1 j
        (Complex.exp (2 * Real.pi * Complex.I * ((r : ℝ) / s)) * q ^ (g * g)) := by
  have hgs : (0 : ℝ) < (g * s : ℕ) := by positivity
  have him := Periodic.im_invQParam_pos_of_norm_lt_one hgs hqnorm hq0
  let τ : ℍ := ⟨Periodic.invQParam ((g * s : ℕ) : ℝ) q, him⟩
  let w : ℍ := affineUpperHalfPlane g s hg hs r τ
  have hleft :
      cuspFunction (((g * s : ℕ) : ℝ))
          (fun z : ℍ ↦ j (affineUpperHalfPlane g s hg hs r z)) q = j w := by
    change Periodic.cuspFunction ((g * s : ℕ) : ℝ) _ q = j w
    rw [Periodic.cuspFunction_eq_of_nonzero _ _ hq0]
    simp only [Function.comp_apply]
    rw [UpperHalfPlane.ofComplex_apply_of_im_pos him]
  have hqparam :
      Periodic.qParam 1 w =
        Complex.exp (2 * Real.pi * Complex.I * ((r : ℝ) / s)) * q ^ (g * g) := by
    rw [show w = affineUpperHalfPlane g s hg hs r τ from rfl,
      qParam_affineUpperHalfPlane]
    rw [show Periodic.qParam ((g * s : ℕ) : ℝ) τ = q by
      simpa [τ] using Periodic.qParam_right_inv
        (show (((g * s : ℕ) : ℝ)) ≠ 0 by positivity) hq0]
  rw [hleft, ← hqparam]
  exact (UpperHalfPlane.eq_cuspFunction w one_ne_zero j_periodic).symm

private lemma first_column_ne_zero_of_det_ne_zero_aux
    {M : Matrix (Fin 2) (Fin 2) ℤ} (hM : M.det ≠ 0) :
    M 0 0 ≠ 0 ∨ M 1 0 ≠ 0 := by
  by_contra h
  push Not at h
  apply hM
  rw [Matrix.det_fin_two, h.1, h.2]
  ring

private lemma exists_sl2_inv_mul_first_column_gcd_aux
    (M : Matrix (Fin 2) (Fin 2) ℤ)
    (hG : (Int.gcd (M 0 0) (M 1 0) : ℤ) ≠ 0) :
    ∃ δ : SL(2, ℤ),
      (((δ⁻¹ : SL(2, ℤ)).1 * M) 0 0 = (Int.gcd (M 0 0) (M 1 0) : ℤ) ∧
        ((δ⁻¹ : SL(2, ℤ)).1 * M) 1 0 = 0) := by
  let A : ℤ := M 0 0
  let C : ℤ := M 1 0
  let G : ℤ := Int.gcd A C
  let u : ℤ := A / G
  let v : ℤ := C / G
  have huG : u * G = A :=
    Int.ediv_mul_cancel (by simpa [G] using Int.gcd_dvd_left A C)
  have hvG : v * G = C :=
    Int.ediv_mul_cancel (by simpa [G] using Int.gcd_dvd_right A C)
  have huv : IsCoprime u v := by
    simpa [u, v, G] using isCoprime_div_gcd_div_gcd_of_gcd_ne_zero (p := A) (q := C)
      (by exact_mod_cast (show G ≠ 0 by simpa [A, C, G] using hG))
  obtain ⟨δ, hδu, hδv⟩ := huv.exists_SL2_col 0
  have hδdet : u * δ 1 1 - δ 0 1 * v = 1 := by
    simpa only [Matrix.det_fin_two, hδu, hδv] using δ.prop
  refine ⟨δ, ?_, ?_⟩
  · rw [Matrix.mul_apply, Matrix.SpecialLinearGroup.SL2_inv_expl, Fin.sum_univ_two]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    change δ 1 1 * A + -δ 0 1 * C = G
    calc
      δ 1 1 * A + -δ 0 1 * C = (u * δ 1 1 - δ 0 1 * v) * G := by
        linear_combination -(δ 1 1) * huG + δ 0 1 * hvG
      _ = G := by rw [hδdet, one_mul]
  · rw [Matrix.mul_apply, Matrix.SpecialLinearGroup.SL2_inv_expl, Fin.sum_univ_two]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    rw [hδu, hδv]
    change -v * A + u * C = 0
    linear_combination v * huG - u * hvG

private lemma matrix_eq_upper_triangular_aux (B : Matrix (Fin 2) (Fin 2) ℤ) (G : ℤ)
    (h00 : B 0 0 = G) (h10 : B 1 0 = 0) : B = !![G, B 0 1; 0, B 1 1] := by
  ext i j
  fin_cases i <;> fin_cases j
  · exact h00
  · rfl
  · exact h10
  · rfl

private lemma exists_positive_upper_triangularization_aux (N : ℕ+)
    (M : Matrix (Fin 2) (Fin 2) ℤ) (hdet : M.det = (N : ℤ)) :
    ∃ (δ : SL(2, ℤ)) (g s : ℕ), 0 < g ∧ 0 < s ∧ g * s = (N : ℕ) ∧
      ∃ r : ℤ, (δ⁻¹ : SL(2, ℤ)).1 * M = !![(g : ℤ), r; 0, (s : ℤ)] := by
  have hMdet : M.det ≠ 0 := by rw [hdet]; positivity
  have hcol := first_column_ne_zero_of_det_ne_zero_aux hMdet
  let G : ℤ := Int.gcd (M 0 0) (M 1 0)
  have hGpos : 0 < G := by
    dsimp [G]
    exact_mod_cast hcol.elim (fun h ↦ Int.gcd_pos_of_ne_zero_left (M 1 0) h)
      (fun h ↦ Int.gcd_pos_of_ne_zero_right (M 0 0) h)
  obtain ⟨δ, h00, h10⟩ := exists_sl2_inv_mul_first_column_gcd_aux M
    (by simpa [G] using hGpos.ne')
  let B : Matrix (Fin 2) (Fin 2) ℤ := (δ⁻¹ : SL(2, ℤ)).1 * M
  have hB00 : B 0 0 = G := by simpa [B, G] using h00
  have hB10 : B 1 0 = 0 := by simpa [B] using h10
  have hdetB : B.det = (N : ℤ) := by
    change ((δ⁻¹ : SL(2, ℤ)).1 * M).det = (N : ℤ)
    rw [Matrix.det_mul, Matrix.SpecialLinearGroup.det_coe, one_mul, hdet]
  let S : ℤ := B 1 1
  have hGS : G * S = (N : ℤ) := by
    simpa [Matrix.det_fin_two, hB00, hB10, S] using hdetB
  have hSpos : 0 < S := Int.pos_of_mul_pos_right (hGS.symm ▸ (by positivity)) hGpos
  have hprod : G.natAbs * S.natAbs = (N : ℕ) := by
    apply Int.ofNat.inj
    simpa [Int.ofNat_natAbs_of_nonneg hGpos.le,
      Int.ofNat_natAbs_of_nonneg hSpos.le] using hGS
  refine ⟨δ, G.natAbs, S.natAbs, Int.natAbs_pos.mpr hGpos.ne',
    Int.natAbs_pos.mpr hSpos.ne', hprod, B 0 1, ?_⟩
  simpa [Int.ofNat_natAbs_of_nonneg hGpos.le,
    Int.ofNat_natAbs_of_nonneg hSpos.le] using
    matrix_eq_upper_triangular_aux B G hB00 hB10

private lemma exists_levelJ_cusp_normalization (N : ℕ+) (γ : SL(2, ℤ)) :
    ∃ (δ : SL(2, ℤ)) (g s : ℕ), 0 < g ∧ 0 < s ∧ g * s = (N : ℕ) ∧
      ∃ r : ℤ,
        (δ⁻¹ : SL(2, ℤ)).1 *
            !![(N : ℤ) * γ 0 0, (N : ℤ) * γ 0 1; γ 1 0, γ 1 1] =
          !![(g : ℤ), r; 0, (s : ℤ)] := by
  let M : Matrix (Fin 2) (Fin 2) ℤ :=
    !![(N : ℤ) * γ 0 0, (N : ℤ) * γ 0 1; γ 1 0, γ 1 1]
  have hγ := γ.prop
  rw [Matrix.det_fin_two] at hγ
  have hdet : M.det = (N : ℤ) := by
    change (!![(N : ℤ) * γ 0 0, (N : ℤ) * γ 0 1; γ 1 0, γ 1 1]).det = (N : ℤ)
    rw [Matrix.det_fin_two_of]
    linear_combination (N : ℤ) * hγ
  simpa [M] using exists_positive_upper_triangularization_aux N M hdet

private lemma levelJ_comp_eq_affine_of_normalization
    (N : ℕ+) (γ δ : SL(2, ℤ)) (g s : ℕ) (hg : 0 < g) (hs : 0 < s)
    (r : ℤ)
    (hmat :
      (δ⁻¹ : SL(2, ℤ)).1 *
          !![(N : ℤ) * γ 0 0, (N : ℤ) * γ 0 1; γ 1 0, γ 1 1] =
        !![(g : ℤ), r; 0, (s : ℤ)]) :
    (fun τ : ℍ ↦ levelJ N (γ • τ)) =
      fun τ : ℍ ↦ j (affineUpperHalfPlane g s hg hs r τ) := by
  funext τ
  change j (natScaleUpperHalfPlane N (γ • τ)) =
    j (affineUpperHalfPlane g s hg hs r τ)
  rw [← j_modularGroup_smul (δ⁻¹) (natScaleUpperHalfPlane N (γ • τ))]
  congr 1
  exact inv_smul_natScale_smul_eq_affine N γ δ g s hg hs r hmat τ

private lemma affine_j_cuspFunction_meromorphicAt
    (g s : ℕ) (hg : 0 < g) (hs : 0 < s) (r : ℤ) :
    MeromorphicAt
      (cuspFunction (((g * s : ℕ) : ℝ))
        (fun τ : ℍ ↦ j (affineUpperHalfPlane g s hg hs r τ))) 0 := by
  let ζ : ℂ := Complex.exp (2 * Real.pi * Complex.I * ((r : ℝ) / s))
  let φ : ℂ → ℂ := fun q ↦ ζ * q ^ (g * g)
  have hgg : g * g ≠ 0 := mul_ne_zero hg.ne' hg.ne'
  have hφ0 : φ 0 = 0 := by simp [φ, hgg]
  have hφan : AnalyticAt ℂ φ 0 := by
    exact analyticAt_const.mul (analyticAt_id.pow (g * g))
  have hbase : MeromorphicAt (cuspFunction 1 j) (φ 0) := by
    simpa [hφ0] using j_cuspFunction_meromorphicAt
  have hcomp : MeromorphicAt ((cuspFunction 1 j) ∘ φ) 0 :=
    hbase.comp_analyticAt hφan
  refine hcomp.congr ?_
  have hnorm : {q : ℂ | ‖q‖ < 1} ∈ nhdsWithin (0 : ℂ) ({0}ᶜ) :=
    nhdsWithin_le_nhds (by simpa [Metric.ball, dist_eq_norm]
      using Metric.ball_mem_nhds (0 : ℂ) zero_lt_one)
  filter_upwards [hnorm, self_mem_nhdsWithin] with q hqnorm hq
  have hq0 : q ≠ 0 := Set.mem_compl_singleton_iff.mp hq
  simpa [Function.comp_apply, φ, ζ] using
    (cuspFunction_affine_j_eq g s hg hs r hq0 hqnorm).symm

private lemma levelJ_meromorphicAt_cusp (N : ℕ+) (γ : SL(2, ℤ)) :
    MeromorphicAt
      (cuspFunction ((N : ℕ) : ℝ) (fun τ : ℍ ↦ levelJ N (γ • τ))) 0 := by
  obtain ⟨δ, g, s, hg, hs, hgs, r, hmat⟩ := exists_levelJ_cusp_normalization N γ
  have hfun := levelJ_comp_eq_affine_of_normalization N γ δ g s hg hs r hmat
  rw [hfun, ← hgs]
  exact affine_j_cuspFunction_meromorphicAt g s hg hs r

private lemma levelJ_meromorphicAt (N : ℕ+) (z : ℂ) (hz : 0 < z.im) :
    MeromorphicAt (levelJ N ∘ UpperHalfPlane.ofComplex) z := by
  have hdiff : DifferentiableOn ℂ
      (levelJ N ∘ UpperHalfPlane.ofComplex) {w | 0 < w.im} := by
    intro w hw
    have hw' : DifferentiableAt ℂ (levelJ N ∘ UpperHalfPlane.ofComplex) w := by
      simpa only [levelJ] using (jN_differentiableAt (N : ℕ) (z := ⟨w, hw⟩))
    exact hw'.differentiableWithinAt
  exact (hdiff.analyticAt (UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds hz)).meromorphicAt

/-- The second generator `j(Nτ)` is a `Γ₀(N)`-modular function. -/
theorem levelJ_isGamma0ModularFunction (N : ℕ+) :
    IsGamma0ModularFunction N (levelJ N) := by
  refine ⟨levelJ_meromorphicAt N, ?_, levelJ_meromorphicAt_cusp N⟩
  intro γ
  simpa only [levelJ] using jN_slash_invariant (N : ℕ) γ

/-- Cox Lemma 11.10(i): a level-one modular function holomorphic on `ℍ` and at `∞` is
constant. -/
theorem levelOne_constant_of_holomorphic {f : ℍ → ℂ}
    (hf : IsLevelOneModularFunction f) (hfH : MDiff f)
    (hf_cusp : AnalyticAt ℂ (cuspFunction 1 f) 0) :
    ∃ c : ℂ, f = fun _ ↦ c := by
  have hfper : Periodic (f ∘ UpperHalfPlane.ofComplex) 1 := by
    simpa [Function.comp_def] using periodic_comp_sl2 (1 : ℕ+) hf 1
  have hfbdd : IsBoundedAtImInfty f := by
    rw [IsBoundedAtImInfty, BoundedAtFilter]
    have hcomp :
        (cuspFunction 1 f ∘ fun τ : ℍ ↦ Periodic.qParam 1 (τ : ℂ)) = f := by
      funext τ
      exact eq_cuspFunction τ one_ne_zero hfper
    have htend : Tendsto f atImInfty (nhds (cuspFunction 1 f 0)) := by
      simpa only [hcomp] using
        hf_cusp.continuousAt.tendsto.comp (qParam_tendsto_atImInfty one_pos)
    exact htend.isBigO_one ℝ
  have hinv (γ : SL(2, ℤ)) : f ∣[(0 : ℤ)] γ = f := by
    let γ₀ : CongruenceSubgroup.Gamma0 1 :=
      ⟨γ, CongruenceSubgroup.Gamma0_mem.mpr (Subsingleton.elim _ _)⟩
    exact hf.2.1 γ₀
  let F : ModularForm (Matrix.SpecialLinearGroup.mapGL ℝ).range 0 :=
    { toFun := f
      slash_action_eq' := by
        rintro _ ⟨γ, rfl⟩
        exact hinv γ
      holo' := hfH
      bdd_at_cusps' := by
        intro c hc
        rw [OnePoint.isBoundedAt_iff_exists_SL2Z hc]
        obtain ⟨γ, hγ⟩ := isCusp_SL2Z_iff'.mp hc
        exact ⟨γ, hγ.symm, by simpa only [hinv γ] using hfbdd⟩ }
  simpa only [F, Function.const_def] using ModularFormClass.levelOne_weight_zero_const F

private lemma cuspFunction_sub_const_mul_pow_eventuallyEq
    (h : ℝ) (f g : ℍ → ℂ) (a : ℂ) (m : ℕ) :
    cuspFunction h (fun τ ↦ f τ - a * g τ ^ m) =ᶠ[nhdsWithin 0 ({0}ᶜ)]
      fun q ↦ cuspFunction h f q - a * cuspFunction h g q ^ m := by
  filter_upwards [self_mem_nhdsWithin] with q hq
  have hq0 : q ≠ 0 := Set.mem_compl_singleton_iff.mp hq
  simp only [UpperHalfPlane.cuspFunction]
  rw [Periodic.cuspFunction_eq_of_nonzero _ _ hq0,
    Periodic.cuspFunction_eq_of_nonzero _ _ hq0,
    Periodic.cuspFunction_eq_of_nonzero _ _ hq0]
  rfl

private lemma isGamma0ModularFunction_sub_const_mul_pow
    (N : ℕ+) {f g : ℍ → ℂ} (hf : IsGamma0ModularFunction N f)
    (hg : IsGamma0ModularFunction N g) (a : ℂ) (m : ℕ) :
    IsGamma0ModularFunction N (fun τ ↦ f τ - a * g τ ^ m) := by
  refine ⟨?_, ?_, ?_⟩
  · intro z hz
    simpa only [Function.comp_def] using
      (hf.1 z hz).sub ((MeromorphicAt.const a z).mul ((hg.1 z hz).pow m))
  · intro γ
    funext τ
    have hfτ := congrFun (hf.2.1 γ) τ
    have hgτ := congrFun (hg.2.1 γ) τ
    simpa only [ModularForm.SL_slash_apply, neg_zero, zpow_zero, mul_one] using
      congrArg₂ (fun x y : ℂ ↦ x - a * y ^ m) hfτ hgτ
  · intro γ
    have hmer := (hf.2.2 γ).sub
      ((MeromorphicAt.const a 0).mul ((hg.2.2 γ).pow m))
    refine hmer.congr ?_
    simpa only using (cuspFunction_sub_const_mul_pow_eventuallyEq
      ((N : ℕ) : ℝ) (fun τ ↦ f (γ • τ)) (fun τ ↦ g (γ • τ)) a m).symm

private lemma meromorphicOrderAt_sub_gt_of_eq_and_trailingCoeff_eq
    {f g : ℂ → ℂ} {x : ℂ} {n : ℤ}
    (hf : MeromorphicAt f x) (hg : MeromorphicAt g x)
    (hfn : meromorphicOrderAt f x = n) (hgn : meromorphicOrderAt g x = n)
    (htc : meromorphicTrailingCoeffAt f x = meromorphicTrailingCoeffAt g x) :
    (n : WithTop ℤ) < meromorphicOrderAt (fun z ↦ f z - g z) x := by
  obtain ⟨F, hFan, hF0, hFeq⟩ := (meromorphicOrderAt_eq_int_iff hf).mp hfn
  obtain ⟨G, hGan, hG0, hGeq⟩ := (meromorphicOrderAt_eq_int_iff hg).mp hgn
  have hFtc : meromorphicTrailingCoeffAt f x = F x :=
    hFan.meromorphicTrailingCoeffAt_of_ne_zero_of_eq_nhdsNE hF0 hFeq
  have hGtc : meromorphicTrailingCoeffAt g x = G x :=
    hGan.meromorphicTrailingCoeffAt_of_ne_zero_of_eq_nhdsNE hG0 hGeq
  let H : ℂ → ℂ := fun z ↦ F z - G z
  have hHan : AnalyticAt ℂ H x := hFan.sub hGan
  have hH0 : H x = 0 := by
    rw [show H x = F x - G x from rfl, sub_eq_zero, ← hFtc, ← hGtc]
    exact htc
  have hHne : meromorphicOrderAt H x ≠ 0 := by
    intro h
    exact (hHan.meromorphicNFAt.meromorphicOrderAt_eq_zero_iff.mp h) hH0
  have hHpos : 0 < meromorphicOrderAt H x :=
    lt_of_le_of_ne hHan.meromorphicOrderAt_nonneg (Ne.symm hHne)
  have heq : (fun z ↦ f z - g z) =ᶠ[nhdsWithin x ({x}ᶜ)]
      fun z ↦ (z - x) ^ n * H z := by
    filter_upwards [hFeq, hGeq] with z hfz hgz
    simp [hfz, hgz, H, smul_eq_mul, mul_sub]
  rw [meromorphicOrderAt_congr heq]
  change (n : WithTop ℤ) < meromorphicOrderAt (((· - x) ^ n) * H) x
  rw [meromorphicOrderAt_mul (by fun_prop) hHan.meromorphicAt,
    meromorphicOrderAt_zpow_id_sub_const]
  cases ho : meromorphicOrderAt H x with
  | top => simp
  | coe k =>
      have hk : 0 < k := by exact_mod_cast (by simpa [ho] using hHpos)
      simpa [ho, ← WithTop.coe_add] using lt_add_of_pos_right n hk

private lemma poleOrder_lt_of_neg_lt_meromorphicOrderAt
    {F : ℍ → ℂ} {m : ℕ} (hm : 0 < m)
    (hord : ((-(m : ℤ) : ℤ) : WithTop ℤ) <
      meromorphicOrderAt (cuspFunction 1 F) 0) :
    poleOrder 1 F < m := by
  rw [poleOrder_eq_toNat_neg_meromorphicOrderAt]
  cases ho : meromorphicOrderAt (cuspFunction 1 F) 0 with
  | top => simp [hm]
  | coe k =>
      rw [ho] at hord
      have hk : -(m : ℤ) < k := WithTop.coe_lt_coe.mp hord
      simp only [WithTop.untopD_coe]
      by_cases hk0 : k < 0
      · rw [Int.toNat_lt (by omega : 0 ≤ -k)]
        omega
      · rw [Int.toNat_of_nonpos (by omega : -k ≤ 0)]
        exact hm

private lemma exists_const_poleOrder_sub_mul_pow_lt
    {f g : ℍ → ℂ}
    (hfmer : MeromorphicAt (cuspFunction 1 f) 0)
    (hgmer : MeromorphicAt (cuspFunction 1 g) 0)
    (hgorder : poleOrder 1 g = 1) (hm : 0 < poleOrder 1 f) :
    ∃ a : ℂ, poleOrder 1
      (fun τ ↦ f τ - a * g τ ^ poleOrder 1 f) < poleOrder 1 f := by
  let m := poleOrder 1 f
  let F := cuspFunction 1 f
  let G := cuspFunction 1 g
  let cF := meromorphicTrailingCoeffAt F 0
  let cG := meromorphicTrailingCoeffAt G 0
  let a := cF / cG ^ m
  have hm0 : m ≠ 0 := by simpa [m] using hm.ne'
  have hForder : meromorphicOrderAt F 0 = -(m : ℤ) := by
    simpa [F, m] using meromorphicOrderAt_cuspFunction_eq_neg_poleOrder hm0
  have hGpole : poleOrder 1 g ≠ 0 := by simp [hgorder]
  have hGorder : meromorphicOrderAt G 0 = -(1 : ℤ) := by
    simpa [G, hgorder] using meromorphicOrderAt_cuspFunction_eq_neg_poleOrder hGpole
  have hFtc0 : cF ≠ 0 := by
    apply hfmer.meromorphicTrailingCoeffAt_ne_zero
    rw [hForder]
    exact WithTop.coe_ne_top
  have hGtc0 : cG ≠ 0 := by
    apply hgmer.meromorphicTrailingCoeffAt_ne_zero
    rw [hGorder]
    exact WithTop.coe_ne_top
  have ha0 : a ≠ 0 := div_ne_zero hFtc0 (pow_ne_zero m hGtc0)
  let Gm : ℂ → ℂ := fun q ↦ a * G q ^ m
  have hGmmer : MeromorphicAt Gm 0 := by
    exact (MeromorphicAt.const a 0).mul (hgmer.pow m)
  have hGmorder : meromorphicOrderAt Gm 0 = -(m : ℤ) := by
    change meromorphicOrderAt ((fun _ : ℂ ↦ a) * G ^ m) 0 = _
    rw [meromorphicOrderAt_mul_of_ne_zero analyticAt_const ha0,
      meromorphicOrderAt_pow hgmer, hGorder]
    norm_cast
    exact mul_neg_one (m : ℤ)
  have hGmtc : meromorphicTrailingCoeffAt Gm 0 = cF := by
    change meromorphicTrailingCoeffAt ((fun _ : ℂ ↦ a) * G ^ m) 0 = _
    rw [(MeromorphicAt.const a 0).meromorphicTrailingCoeffAt_mul (hgmer.pow m),
      meromorphicTrailingCoeffAt_const, hgmer.meromorphicTrailingCoeffAt_pow]
    change a * cG ^ m = cF
    exact div_mul_cancel₀ cF (pow_ne_zero m hGtc0)
  refine ⟨a, ?_⟩
  apply poleOrder_lt_of_neg_lt_meromorphicOrderAt (by simpa [m] using hm)
  rw [meromorphicOrderAt_congr
    (cuspFunction_sub_const_mul_pow_eventuallyEq 1 f g a m)]
  exact meromorphicOrderAt_sub_gt_of_eq_and_trailingCoeff_eq hfmer hGmmer
    hForder hGmorder hGmtc.symm

/-- Cox Lemma 11.10(ii): a level-one modular function holomorphic on `ℍ` is a polynomial
in `j`. -/
theorem levelOne_polynomialInJ_of_holomorphic {f : ℍ → ℂ}
    (hf : IsLevelOneModularFunction f) (hfH : MDiff f) :
    ∃ P : Polynomial ℂ, f = polynomialIn P j := by
  have main : ∀ m : ℕ, ∀ f : ℍ → ℂ, poleOrder 1 f = m →
      IsLevelOneModularFunction f → MDiff f →
        ∃ P : Polynomial ℂ, f = polynomialIn P j := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
        intro f hfm hf hfH
        have hfmer : MeromorphicAt (cuspFunction 1 f) 0 := by
          simpa using hf.2.2 (1 : SL(2, ℤ))
        by_cases hm0 : m = 0
        · have hfcusp : AnalyticAt ℂ (cuspFunction 1 f) 0 :=
            (analyticAt_cuspFunction_iff_poleOrder_eq_zero hfmer).2 (hfm.trans hm0)
          obtain ⟨c, hc⟩ := levelOne_constant_of_holomorphic hf hfH hfcusp
          refine ⟨Polynomial.C c, ?_⟩
          rw [hc]
          funext τ
          simp [polynomialIn]
        · have hmpos : 0 < poleOrder 1 f := by
            rw [hfm]
            exact Nat.pos_of_ne_zero hm0
          obtain ⟨a, ha⟩ := exists_const_poleOrder_sub_mul_pow_lt hfmer
            j_cuspFunction_meromorphicAt j_poleOrder hmpos
          let f' : ℍ → ℂ := fun τ ↦ f τ - a * j τ ^ poleOrder 1 f
          have hf' : IsLevelOneModularFunction f' :=
            isGamma0ModularFunction_sub_const_mul_pow 1 hf
              j_isLevelOneModularFunction a (poleOrder 1 f)
          have hf'H : MDiff f' := by
            simpa [f', smul_eq_mul] using
              hfH.sub (MDifferentiable.const_smul a
                (j_mdifferentiable.pow (poleOrder 1 f)))
          have hlt : poleOrder 1 f' < m := by
            simpa [f', hfm] using ha
          obtain ⟨P, hP⟩ := ih (poleOrder 1 f') hlt f' rfl hf' hf'H
          refine ⟨P + Polynomial.monomial m a, ?_⟩
          funext τ
          have hPτ := congrFun hP τ
          simp only [f', polynomialIn] at hPτ ⊢
          rw [hfm] at hPτ
          rw [Polynomial.eval_add, Polynomial.eval_monomial]
          linear_combination hPτ
  exact main (poleOrder 1 f) f rfl hf hfH

private lemma eventually_mdifferentiableAt_atImInfty
    {f : ℍ → ℂ} (hf : IsLevelOneModularFunction f) :
    ∀ᶠ τ in atImInfty, MDiffAt f τ := by
  have hper : Periodic (f ∘ UpperHalfPlane.ofComplex) 1 := by
    simpa [Function.comp_def] using periodic_comp_sl2 (1 : ℕ+) hf 1
  have hcusp : MeromorphicAt (cuspFunction 1 f) 0 := by
    simpa using hf.2.2 (1 : SL(2, ℤ))
  have hana : ∀ᶠ q in nhdsWithin (0 : ℂ) ({0}ᶜ),
      AnalyticAt ℂ (cuspFunction 1 f) q := hcusp.eventually_analyticAt
  have hq : Tendsto (fun τ : ℍ ↦ Periodic.qParam 1 (τ : ℂ)) atImInfty
      (nhdsWithin (0 : ℂ) ({0}ᶜ)) :=
    (Periodic.qParam_tendsto one_pos).comp tendsto_coe_atImInfty
  filter_upwards [hq.eventually hana] with τ hτ
  rw [UpperHalfPlane.mdifferentiableAt_iff]
  have hcomp : DifferentiableAt ℂ
      ((cuspFunction 1 f) ∘ Periodic.qParam 1) (τ : ℂ) :=
    hτ.differentiableAt.comp (τ : ℂ) Periodic.differentiable_qParam.differentiableAt
  refine hcomp.congr_of_eventuallyEq ?_
  filter_upwards [UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds τ.im_pos] with z hz
  change f (UpperHalfPlane.ofComplex z) = cuspFunction 1 f (Periodic.qParam 1 z)
  rw [UpperHalfPlane.ofComplex_apply_of_im_pos hz]
  exact (UpperHalfPlane.eq_cuspFunction ⟨z, hz⟩ one_ne_zero hper).symm

private lemma finite_not_mdifferentiableAt_truncatedFundamentalDomain
    {f : ℍ → ℂ} (hf : IsLevelOneModularFunction f) (y : ℝ) :
    {τ | τ ∈ ModularGroup.truncatedFundamentalDomain y ∧ ¬MDiffAt f τ}.Finite := by
  let K := ModularGroup.truncatedFundamentalDomain y
  let A : Set ℂ := {z | AnalyticAt ℂ (f ∘ UpperHalfPlane.ofComplex) z}
  have hmer : MeromorphicOn (f ∘ UpperHalfPlane.ofComplex)
      UpperHalfPlane.upperHalfPlaneSet := by
    intro z hz
    exact hf.1 z hz
  have hA : A ∈ codiscreteWithin UpperHalfPlane.upperHalfPlaneSet := by
    exact hmer.eventually_codiscreteWithin_analyticAt (f ∘ UpperHalfPlane.ofComplex)
  have hKsub : UpperHalfPlane.coe '' K ⊆ UpperHalfPlane.upperHalfPlaneSet := by
    rintro _ ⟨τ, _, rfl⟩
    exact τ.im_pos
  have hAK : A ∈ codiscreteWithin (UpperHalfPlane.coe '' K) :=
    (Filter.codiscreteWithin_mono hKsub) hA
  have hKcompact : IsCompact (UpperHalfPlane.coe '' K) :=
    UpperHalfPlane.isEmbedding_coe.isCompact_iff.mp
      (ModularGroup.isCompact_truncatedFundamentalDomain y)
  have hsingular : ((UpperHalfPlane.coe '' K) \ A).Finite :=
    hKcompact.finite_diff_of_mem_codiscreteWithin hAK
  apply Set.Finite.of_finite_image
    (hsingular.subset ?_) UpperHalfPlane.isEmbedding_coe.injective.injOn
  rintro _ ⟨τ, ⟨hτK, hτ⟩, rfl⟩
  refine ⟨⟨τ, hτK, rfl⟩, ?_⟩
  intro hτan
  exact hτ (UpperHalfPlane.mdifferentiableAt_iff.mpr hτan.differentiableAt)

private lemma exists_analyticAt_pow_succ_mul_of_meromorphicAt_of_analyticAt_zero
    {F J : ℂ → ℂ} {x : ℂ} (hF : MeromorphicAt F x)
    (hJ : AnalyticAt ℂ J x) (hJ0 : J x = 0) :
    ∃ n : ℕ, AnalyticAt ℂ (fun z ↦ J z ^ (n + 1) * F z) x := by
  obtain ⟨n, hA⟩ := hF
  obtain ⟨p, hp⟩ := hJ
  have hJan : AnalyticAt ℂ J x := ⟨p, hp⟩
  have hD : AnalyticAt ℂ (dslope J x) x :=
    ⟨p.fslope, hp.has_fpower_series_dslope_fslope⟩
  have hA' : AnalyticAt ℂ (fun z ↦ (z - x) ^ n * F z) x := by
    simpa only [smul_eq_mul] using hA
  refine ⟨n, ?_⟩
  have hR : AnalyticAt ℂ
      (fun z ↦ J z * dslope J x z ^ n * ((z - x) ^ n * F z)) x :=
    (hJan.mul (hD.pow n)).mul hA'
  have heq : (fun z ↦ J z ^ (n + 1) * F z) =
      fun z ↦ J z * dslope J x z ^ n * ((z - x) ^ n * F z) := by
    funext z
    have hz := sub_smul_dslope_of_zero hJ0 z
    simp only [smul_eq_mul] at hz
    rw [pow_succ', ← hz, mul_pow]
    ring
  rw [heq]
  exact hR

private lemma exists_mdifferentiableAt_j_sub_pow_succ_mul
    {f : ℍ → ℂ} (hf : IsLevelOneModularFunction f) (τ : ℍ) :
    ∃ n : ℕ, MDiffAt (fun z ↦ (j z - j τ) ^ (n + 1) * f z) τ := by
  let F : ℂ → ℂ := f ∘ UpperHalfPlane.ofComplex
  let J : ℂ → ℂ := fun z ↦ j (UpperHalfPlane.ofComplex z) - j τ
  have hF : MeromorphicAt F (τ : ℂ) := hf.1 τ τ.im_pos
  have hjdiff : DifferentiableOn ℂ (j ∘ UpperHalfPlane.ofComplex)
      UpperHalfPlane.upperHalfPlaneSet :=
    UpperHalfPlane.mdifferentiable_iff.mp j_mdifferentiable
  have hJ : AnalyticAt ℂ J (τ : ℂ) := by
    exact (hjdiff.analyticAt
      (UpperHalfPlane.isOpen_upperHalfPlaneSet.mem_nhds τ.im_pos)).sub analyticAt_const
  have hJ0 : J (τ : ℂ) = 0 := by
    simp [J]
  obtain ⟨n, hn⟩ :=
    exists_analyticAt_pow_succ_mul_of_meromorphicAt_of_analyticAt_zero hF hJ hJ0
  refine ⟨n, UpperHalfPlane.mdifferentiableAt_iff.mpr ?_⟩
  simpa only [F, J, Function.comp_def] using hn.differentiableAt

private lemma mdifferentiable_polynomialIn_j (P : Polynomial ℂ) :
    MDiff (polynomialIn P j) := by
  induction P using Polynomial.induction_on' with
  | add P Q hP hQ =>
      convert hP.add hQ using 1
      ext z
      simp [polynomialIn]
  | monomial n a =>
      convert (j_mdifferentiable.pow n).const_smul a using 1
      ext z
      simp [polynomialIn]

private lemma levelOne_invariant_apply {f : ℍ → ℂ}
    (hf : IsLevelOneModularFunction f) (γ : SL(2, ℤ)) (τ : ℍ) :
    f (γ • τ) = f τ := by
  let γ₀ : CongruenceSubgroup.Gamma0 1 :=
    ⟨γ, CongruenceSubgroup.Gamma0_mem.mpr (Subsingleton.elim _ _)⟩
  have h := congrFun (hf.2.1 γ₀) τ
  simpa only [ModularForm.SL_slash_apply, neg_zero, zpow_zero, mul_one] using h

private lemma exists_polynomial_clearing_poles_on_fd_aux {f : ℍ → ℂ}
    (hf : IsLevelOneModularFunction f) :
    ∃ P : Polynomial ℂ, P ≠ 0 ∧ ∀ τ ∈ ModularGroup.fd,
      MDiffAt (fun z ↦ P.eval (j z) * f z) τ := by
  classical
  have hevent := eventually_mdifferentiableAt_atImInfty hf
  change {τ : ℍ | MDiffAt f τ} ∈ atImInfty at hevent
  obtain ⟨y, hy⟩ := UpperHalfPlane.atImInfty_mem _ |>.mp hevent
  let Bad : Set ℍ := {τ | τ ∈ ModularGroup.truncatedFundamentalDomain y ∧ ¬MDiffAt f τ}
  have hBad : Bad.Finite := by
    simpa only [Bad] using finite_not_mdifferentiableAt_truncatedFundamentalDomain hf y
  let S : Finset ℍ := hBad.toFinset
  let e : ℍ → ℕ := fun τ ↦ Classical.choose
    (exists_mdifferentiableAt_j_sub_pow_succ_mul hf τ)
  have he (τ : ℍ) : MDiffAt (fun z ↦ (j z - j τ) ^ (e τ + 1) * f z) τ := by
    exact Classical.choose_spec (exists_mdifferentiableAt_j_sub_pow_succ_mul hf τ)
  let factor : ℍ → Polynomial ℂ := fun τ ↦
    (Polynomial.X - Polynomial.C (j τ)) ^ (e τ + 1)
  let P : Polynomial ℂ := S.prod factor
  have hP0 : P ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro τ hτ
    exact pow_ne_zero _ (Polynomial.X_sub_C_ne_zero (j τ))
  refine ⟨P, hP0, ?_⟩
  intro τ hτfd
  by_cases hτy : τ.im ≤ y
  · by_cases hτf : MDiffAt f τ
    · exact (mdifferentiable_polynomialIn_j P τ).mul hτf
    · have hτS : τ ∈ S := by
        simp only [S, Set.Finite.mem_toFinset, Bad]
        exact ⟨⟨hτfd, hτy⟩, hτf⟩
      let Q : Polynomial ℂ := (S.erase τ).prod factor
      have hP : P = factor τ * Q := (Finset.mul_prod_erase S factor hτS).symm
      have hmul := (mdifferentiable_polynomialIn_j Q τ).mul (he τ)
      have hfun : (fun z ↦ P.eval (j z) * f z) = fun z ↦
          polynomialIn Q j z * ((j z - j τ) ^ (e τ + 1) * f z) := by
        funext z
        simp only [hP, polynomialIn, Polynomial.eval_mul, factor, Polynomial.eval_pow,
          Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
        ring
      rw [hfun]
      exact hmul
  · have hτf : MDiffAt f τ := hy τ (le_of_not_ge hτy)
    exact (mdifferentiable_polynomialIn_j P τ).mul hτf

/-- A nonzero polynomial in `j` clears all poles of a level-one modular function. -/
theorem levelOne_exists_polynomial_clearing_poles {f : ℍ → ℂ}
    (hf : IsLevelOneModularFunction f) :
    ∃ P : Polynomial ℂ, P ≠ 0 ∧ MDiff (fun τ ↦ P.eval (j τ) * f τ) := by
  obtain ⟨P, hP0, hPfd⟩ := exists_polynomial_clearing_poles_on_fd_aux hf
  let H : ℍ → ℂ := fun τ ↦ P.eval (j τ) * f τ
  have hHinv (γ : SL(2, ℤ)) (τ : ℍ) : H (γ • τ) = H τ := by
    simp only [H, j_modularGroup_smul γ τ, levelOne_invariant_apply hf γ τ]
  refine ⟨P, hP0, ?_⟩
  intro τ
  obtain ⟨γ, hγ⟩ := ModularGroup.exists_smul_mem_fd τ
  have hcomp : MDiffAt (H ∘ fun z ↦ γ • z) τ :=
    (hPfd (γ • τ) hγ).comp τ
      ((UpperHalfPlane.mdifferentiable_smul (g := (γ : GL (Fin 2) ℝ)) (by simp)) τ)
  have hfun : (H ∘ fun z ↦ γ • z) = H := by
    funext z
    exact hHinv γ z
  rw [hfun] at hcomp
  exact hcomp

private lemma cuspFunction_mul_eventuallyEq (h : ℝ) (f g : ℍ → ℂ) :
    cuspFunction h (fun τ ↦ f τ * g τ) =ᶠ[nhdsWithin 0 ({0}ᶜ)]
      fun q ↦ cuspFunction h f q * cuspFunction h g q := by
  filter_upwards [self_mem_nhdsWithin] with q hq
  have hq0 : q ≠ 0 := Set.mem_compl_singleton_iff.mp hq
  simp only [UpperHalfPlane.cuspFunction]
  rw [Periodic.cuspFunction_eq_of_nonzero _ _ hq0,
    Periodic.cuspFunction_eq_of_nonzero _ _ hq0,
    Periodic.cuspFunction_eq_of_nonzero _ _ hq0]
  rfl

/-- The product of two `Γ₀(N)`-modular functions is again a `Γ₀(N)`-modular function. -/
theorem IsGamma0ModularFunction.mul {N : ℕ+} {f g : ℍ → ℂ}
    (hf : IsGamma0ModularFunction N f) (hg : IsGamma0ModularFunction N g) :
    IsGamma0ModularFunction N (fun τ ↦ f τ * g τ) := by
  refine ⟨?_, ?_, ?_⟩
  · intro z hz
    simpa [Function.comp_def] using (hf.1 z hz).mul (hg.1 z hz)
  · intro γ
    funext τ
    have hfγ := congrFun (hf.2.1 γ) τ
    have hgγ := congrFun (hg.2.1 γ) τ
    simpa only [ModularForm.SL_slash_apply, neg_zero, zpow_zero, mul_one] using
      congrArg₂ (fun x y : ℂ ↦ x * y) hfγ hgγ
  · intro γ
    apply ((hf.2.2 γ).mul (hg.2.2 γ)).congr
    simpa only using (cuspFunction_mul_eventuallyEq ((N : ℕ) : ℝ)
      (fun τ ↦ f (γ • τ)) (fun τ ↦ g (γ • τ))).symm

private lemma meromorphicAt_polynomial_eval {g : ℂ → ℂ} {z : ℂ}
    (hg : MeromorphicAt g z) (P : Polynomial ℂ) :
    MeromorphicAt (fun w ↦ P.eval (g w)) z := by
  induction P using Polynomial.induction_on' with
  | add P Q hP hQ =>
      simpa only [Polynomial.eval_add, Pi.add_apply] using hP.add hQ
  | monomial n a =>
      simpa only [Polynomial.eval_monomial, Pi.mul_apply, Pi.pow_apply] using
        (MeromorphicAt.const a z).mul (hg.pow n)

private lemma cuspFunction_polynomial_eval_eventuallyEq
    (h : ℝ) (g : ℍ → ℂ) (P : Polynomial ℂ) :
    cuspFunction h (fun τ ↦ P.eval (g τ)) =ᶠ[nhdsWithin 0 ({0}ᶜ)]
      fun q ↦ P.eval (cuspFunction h g q) := by
  filter_upwards [self_mem_nhdsWithin] with q hq
  have hq0 : q ≠ 0 := Set.mem_compl_singleton_iff.mp hq
  simp only [UpperHalfPlane.cuspFunction]
  rw [Periodic.cuspFunction_eq_of_nonzero _ _ hq0,
    Periodic.cuspFunction_eq_of_nonzero _ _ hq0]
  rfl

/-- Evaluating a polynomial at a `Γ₀(N)`-modular function preserves modularity. -/
theorem IsGamma0ModularFunction.polynomialIn {N : ℕ+} {f : ℍ → ℂ}
    (hf : IsGamma0ModularFunction N f) (P : Polynomial ℂ) :
    IsGamma0ModularFunction N (Cox.polynomialIn P f) := by
  refine ⟨?_, ?_, ?_⟩
  · intro z hz
    simpa only [polynomialIn, Function.comp_def] using
      meromorphicAt_polynomial_eval (hf.1 z hz) P
  · intro γ
    funext τ
    have hγ := congrFun (hf.2.1 γ) τ
    simpa only [ModularForm.SL_slash_apply, neg_zero, zpow_zero, mul_one, polynomialIn] using
      congrArg P.eval hγ
  · intro γ
    apply (meromorphicAt_polynomial_eval (hf.2.2 γ) P).congr
    simpa only [polynomialIn] using (cuspFunction_polynomial_eval_eventuallyEq
      ((N : ℕ) : ℝ) (fun τ ↦ f (γ • τ)) P).symm

/-- Cox Theorem 11.9(i): the level-one modular function field is `ℂ(j)`. -/
theorem theorem_11_9_i {f : ℍ → ℂ} (hf : IsLevelOneModularFunction f) :
    RationalIn f j := by
  obtain ⟨P, hP, hPdiff⟩ := levelOne_exists_polynomial_clearing_poles hf
  have hPmod : IsLevelOneModularFunction (fun τ ↦ P.eval (j τ) * f τ) := by
    simpa only [polynomialIn] using
      (j_isLevelOneModularFunction.polynomialIn P).mul hf
  obtain ⟨Q, hQ⟩ := levelOne_polynomialInJ_of_holomorphic hPmod hPdiff
  refine ⟨Q, P, hP, ?_⟩
  intro τ hPτ
  rw [eq_div_iff hPτ]
  simpa only [polynomialIn, mul_comm] using congrFun hQ τ

end Cox
