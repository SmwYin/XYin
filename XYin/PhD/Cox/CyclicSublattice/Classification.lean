import XYin.PhD.Cox.CyclicSublattice
import XYin.PhD.Cox.ModularPolynomial

/-!
# Classification of cyclic sublattices

This file proves Cox Lemma 11.24 and Theorem 11.23: cyclic index-`m` sublattices are
classified by canonical HNF representatives, and their `j`-invariants are exactly the roots
of the modular polynomial.
-/

open MatrixGroups UpperHalfPlane

noncomputable section

namespace PeriodPair

namespace CyclicSublattice

variable {L : PeriodPair} {m : ℕ+}

/-- Extract the unique Cox representative encoded by the HNF inclusion matrix. -/
noncomputable def toCoxMatrix (S : CyclicSublattice L m) : Cox.CoxMatrix m := by
  let h := S.hermiteNormalForm
  let A := h.matrix
  have hd : 0 < A 0 0 := h.isColumnHermiteNormalForm.diagonal_pos 0
  have ha : 0 < A 1 1 := h.isColumnHermiteNormalForm.diagonal_pos 1
  have hb : A 0 1 ∈ Set.Ico 0 (A 0 0) :=
    h.isColumnHermiteNormalForm.reduced 0 1 (by omega)
  have hz : A 1 0 = 0 :=
    h.isColumnHermiteNormalForm.belowDiagonal_eq_zero 1 0 (by omega)
  have hdet : A.det.natAbs = (m : ℕ) := by
    calc
      A.det.natAbs = S.carrier.toAddSubgroup.index :=
        h.index_eq_natAbs_det.symm
      _ = (m : ℕ) := S.index_eq
  have hmul : (A 1 1).natAbs * (A 0 0).natAbs = (m : ℕ) := by
    have hdetA : A.det = A 0 0 * A 1 1 := by
      rw [Matrix.det_fin_two, hz]
      ring
    simpa only [hdetA, Int.natAbs_mul, Nat.mul_comm] using hdet
  have hcontent : Matrix.rankTwoContent A = 1 :=
    h.quotient_isAddCyclic_iff_rankTwoContent_eq_one.mp S.cyclic
  have hprimitive :
      Nat.gcd (Nat.gcd (A 1 1).natAbs (A 0 1).natAbs)
        (A 0 0).natAbs = 1 := by
    simpa [Matrix.rankTwoContent, hz, Nat.gcd_comm, Nat.gcd_left_comm,
      Nat.gcd_assoc] using hcontent
  have haNatAbs : 0 < (A 1 1).natAbs :=
    Int.natAbs_pos.mpr ha.ne'
  have hbNatAbs : (A 0 1).natAbs < (A 0 0).natAbs := by
    rw [← Int.ofNat_lt]
    simpa only [Int.natAbs_of_nonneg hb.1,
      Int.natAbs_of_nonneg hd.le] using hb.2
  exact
    { a := (A 1 1).natAbs
      b := (A 0 1).natAbs
      d := (A 0 0).natAbs
      a_pos := haNatAbs
      determinant := hmul
      b_lt := hbNatAbs
      primitive := hprimitive }

/-- The HNF matrix of a cyclic sublattice is the inclusion matrix of its extracted Cox
representative. -/
theorem hermiteNormalForm_matrix_eq_inclusionMatrix (S : CyclicSublattice L m) :
    S.hermiteNormalForm.matrix = S.toCoxMatrix.inclusionMatrix := by
  let h := S.hermiteNormalForm
  let A := h.matrix
  have hd : 0 ≤ A 0 0 :=
    (h.isColumnHermiteNormalForm.diagonal_pos 0).le
  have ha : 0 ≤ A 1 1 :=
    (h.isColumnHermiteNormalForm.diagonal_pos 1).le
  have hb : 0 ≤ A 0 1 :=
    (h.isColumnHermiteNormalForm.reduced 0 1 (by omega)).1
  have hz : A 1 0 = 0 :=
    h.isColumnHermiteNormalForm.belowDiagonal_eq_zero 1 0 (by omega)
  rw [show S.hermiteNormalForm.matrix = A from rfl]
  ext i j
  fin_cases i <;> fin_cases j
  · simp [toCoxMatrix, Cox.CoxMatrix.inclusionMatrix, A, h,
      abs_of_nonneg hd]
  · simp [toCoxMatrix, Cox.CoxMatrix.inclusionMatrix, A, h,
      abs_of_nonneg hb]
  · simp [Cox.CoxMatrix.inclusionMatrix, hz]
  · simp [toCoxMatrix, Cox.CoxMatrix.inclusionMatrix, A, h,
      abs_of_nonneg ha]

@[simp]
theorem toCoxMatrix_inclusionMatrix (S : CyclicSublattice L m) :
    S.toCoxMatrix.inclusionMatrix = S.hermiteNormalForm.matrix :=
  S.hermiteNormalForm_matrix_eq_inclusionMatrix.symm

end CyclicSublattice

end PeriodPair

namespace Cox

namespace CoxMatrix

open PeriodPair PeriodPair.CyclicSublattice

variable {m : ℕ+}

private def inclusionLinearMap (σ : CoxMatrix m) (L : PeriodPair) :
    L.lattice →ₗ[ℤ] L.lattice :=
  Matrix.toLin L.latticeBasis L.latticeBasis σ.inclusionMatrix

private theorem inclusionLinearMap_injective (σ : CoxMatrix m) (L : PeriodPair) :
    Function.Injective (σ.inclusionLinearMap L) := by
  letI : Module.Free ℤ L.lattice := Module.Free.of_basis L.latticeBasis
  letI : Module.Finite ℤ L.lattice := Module.Finite.of_basis L.latticeBasis
  let f := σ.inclusionLinearMap L
  have hdet : LinearMap.det f ≠ 0 := by
    rw [← LinearMap.det_toMatrix L.latticeBasis,
      show LinearMap.toMatrix L.latticeBasis L.latticeBasis f =
        σ.inclusionMatrix by
          exact LinearMap.toMatrix_toLin _ _ _]
    rw [σ.inclusionMatrix_det]
    exact_mod_cast PNat.ne_zero m
  apply LinearMap.ker_eq_bot.mp
  by_contra hker
  exact hdet (LinearMap.det_eq_zero_iff_ker_ne_bot.mpr hker)

/-- The submodule generated by the columns of a Cox inclusion matrix in any period lattice. -/
def sublatticeOfPeriodPair (σ : CoxMatrix m) (L : PeriodPair) :
    Submodule ℤ L.lattice :=
  LinearMap.range (σ.inclusionLinearMap L)

private noncomputable def inclusionHermiteNormalForm (σ : CoxMatrix m)
    (L : PeriodPair) :
    Module.Basis.HermiteNormalForm L.latticeBasis
      (σ.sublatticeOfPeriodPair L) := by
  let f := σ.inclusionLinearMap L
  let e : L.lattice ≃ₗ[ℤ] LinearMap.range f :=
    LinearEquiv.ofInjective f (σ.inclusionLinearMap_injective L)
  let bN := L.latticeBasis.map e
  refine ⟨bN, σ.inclusionMatrix, ?_,
    σ.inclusionMatrix_isColumnHermiteNormalForm⟩
  change LinearMap.toMatrix (L.latticeBasis.map e) L.latticeBasis
    (LinearMap.range f).subtype = σ.inclusionMatrix
  rw [LinearMap.toMatrix_map_left]
  have hcomp : (LinearMap.range f).subtype.comp e.toLinearMap = f := by
    ext x
    rfl
  rw [hcomp]
  exact LinearMap.toMatrix_toLin _ _ _

/-- A Cox matrix produces a cyclic index-`m` sublattice in any period lattice. -/
noncomputable def toCyclicSublatticeOfPeriodPair (σ : CoxMatrix m)
    (L : PeriodPair) : PeriodPair.CyclicSublattice L m := by
  let h := σ.inclusionHermiteNormalForm L
  refine ⟨σ.sublatticeOfPeriodPair L, ?_, ?_⟩
  · calc
      (σ.sublatticeOfPeriodPair L).toAddSubgroup.index =
          h.matrix.det.natAbs := h.index_eq_natAbs_det
      _ = σ.inclusionMatrix.det.natAbs := rfl
      _ = (m : ℕ) := by rw [σ.inclusionMatrix_det]; simp
  · apply h.quotient_isAddCyclic_iff_rankTwoContent_eq_one.mpr
    change Matrix.rankTwoContent σ.inclusionMatrix = 1
    exact σ.inclusionMatrix_content_eq_one

@[simp]
theorem toCyclicSublatticeOfPeriodPair_toCoxMatrix
    (σ : CoxMatrix m) (L : PeriodPair) :
    (σ.toCyclicSublatticeOfPeriodPair L).toCoxMatrix = σ := by
  let S := σ.toCyclicSublatticeOfPeriodPair L
  have hmatrix : S.hermiteNormalForm.matrix = σ.inclusionMatrix :=
    S.hermiteNormalForm.matrix_eq (σ.inclusionHermiteNormalForm L)
  have hextracted := S.hermiteNormalForm_matrix_eq_inclusionMatrix
  have hinclusion : S.toCoxMatrix.inclusionMatrix = σ.inclusionMatrix :=
    hextracted.symm.trans hmatrix
  exact CoxMatrix.inclusionMatrix_injective hinclusion

@[simp]
theorem toCoxMatrix_toCyclicSublatticeOfPeriodPair
    (S : PeriodPair.CyclicSublattice L m) :
    S.toCoxMatrix.toCyclicSublatticeOfPeriodPair L = S := by
  apply PeriodPair.CyclicSublattice.ext
  change LinearMap.range
      (Matrix.toLin L.latticeBasis L.latticeBasis
        S.toCoxMatrix.inclusionMatrix) = S.carrier
  rw [← S.hermiteNormalForm_matrix_eq_inclusionMatrix]
  exact S.hermiteNormalForm.range_toLin_matrix_eq

end CoxMatrix

/-- Cyclic index-`m` sublattices of any period lattice are classified by Cox matrices. -/
noncomputable def cyclicSublatticeEquivCoxMatrixOfPeriodPair
    (L : PeriodPair) (m : ℕ+) :
    PeriodPair.CyclicSublattice L m ≃ CoxMatrix m where
  toFun := PeriodPair.CyclicSublattice.toCoxMatrix
  invFun := fun σ ↦ σ.toCyclicSublatticeOfPeriodPair L
  left_inv := CoxMatrix.toCoxMatrix_toCyclicSublatticeOfPeriodPair
  right_inv := fun σ ↦ CoxMatrix.toCyclicSublatticeOfPeriodPair_toCoxMatrix σ L

/-- The carrier `[d,aτ+b]` associated to a Cox representative. -/
noncomputable def CoxMatrix.sublattice {m : ℕ+} (σ : CoxMatrix m) (τ : ℍ) :
    Submodule ℤ (UpperHalfPlane.periodPair τ).lattice :=
  σ.sublatticeOfPeriodPair (UpperHalfPlane.periodPair τ)

/-- The converse half of Lemma 11.24: a Cox representative produces a cyclic index-`m`
sublattice. -/
noncomputable def CoxMatrix.toCyclicSublattice {m : ℕ+} (σ : CoxMatrix m) (τ : ℍ) :
    PeriodPair.CyclicSublattice (UpperHalfPlane.periodPair τ) m :=
  σ.toCyclicSublatticeOfPeriodPair (UpperHalfPlane.periodPair τ)

@[simp]
theorem CoxMatrix.toCyclicSublattice_carrier {m : ℕ+}
    (σ : CoxMatrix m) (τ : ℍ) :
    (σ.toCyclicSublattice τ).carrier = σ.sublattice τ := by
  rfl

private def CoxMatrix.sublatticeGenerators {m : ℕ+}
    (σ : CoxMatrix m) (τ : ℍ) :
    Fin 2 → (UpperHalfPlane.periodPair τ).lattice :=
  ![(σ.d : ℤ) • (UpperHalfPlane.periodPair τ).latticeBasis 0,
    (σ.b : ℤ) • (UpperHalfPlane.periodPair τ).latticeBasis 0 +
      (σ.a : ℤ) • (UpperHalfPlane.periodPair τ).latticeBasis 1]

private theorem CoxMatrix.sublattice_eq_span {m : ℕ+}
    (σ : CoxMatrix m) (τ : ℍ) :
    σ.sublattice τ =
      Submodule.span ℤ (Set.range (σ.sublatticeGenerators τ)) := by
  let L := UpperHalfPlane.periodPair τ
  let f := σ.inclusionLinearMap L
  change LinearMap.range f =
    Submodule.span ℤ (Set.range (σ.sublatticeGenerators τ))
  calc
    LinearMap.range f = Submodule.map f ⊤ := (Submodule.map_top f).symm
    _ = Submodule.map f (Submodule.span ℤ (Set.range L.latticeBasis)) := by
      rw [L.latticeBasis.span_eq]
    _ = Submodule.span ℤ (f '' Set.range L.latticeBasis) :=
      Submodule.map_span f (Set.range L.latticeBasis)
    _ = Submodule.span ℤ (Set.range (σ.sublatticeGenerators τ)) := by
      apply congrArg (Submodule.span ℤ)
      have hgen (i : Fin 2) :
          f (L.latticeBasis i) = σ.sublatticeGenerators τ i := by
        change Matrix.toLin L.latticeBasis L.latticeBasis
          σ.inclusionMatrix (L.latticeBasis i) = _
        rw [Matrix.toLin_self]
        fin_cases i <;>
          simp [CoxMatrix.inclusionMatrix, CoxMatrix.sublatticeGenerators, L]
      ext x
      constructor
      · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, (hgen i).symm⟩
      · rintro ⟨i, rfl⟩
        exact ⟨L.latticeBasis i, ⟨i, rfl⟩, hgen i⟩

private def CoxMatrix.complexSublatticeGenerators {m : ℕ+}
    (σ : CoxMatrix m) (τ : ℍ) : Fin 2 → ℂ :=
  ![(σ.d : ℂ), (σ.b : ℂ) + (σ.a : ℂ) * (τ : ℂ)]

private theorem CoxMatrix.coe_sublatticeGenerators {m : ℕ+}
    (σ : CoxMatrix m) (τ : ℍ) (i : Fin 2) :
    (((σ.sublatticeGenerators τ i :
      (UpperHalfPlane.periodPair τ).lattice) : ℂ)) =
      σ.complexSublatticeGenerators τ i := by
  let L := UpperHalfPlane.periodPair τ
  have hcoe_add (x y : L.lattice) : ((x + y : L.lattice) : ℂ) = x + y := rfl
  have hcoe_zsmul (z : ℤ) (x : L.lattice) :
      ((z • x : L.lattice) : ℂ) = z • (x : ℂ) := rfl
  fin_cases i
  · change ((((σ.d : ℤ) • L.latticeBasis 0 : L.lattice) : ℂ)) = _
    rw [hcoe_zsmul, PeriodPair.latticeBasis_zero]
    simp [CoxMatrix.complexSublatticeGenerators, L,
      UpperHalfPlane.periodPair, zsmul_eq_mul]
  · change (((((σ.b : ℤ) • L.latticeBasis 0 +
      (σ.a : ℤ) • L.latticeBasis 1 : L.lattice) : ℂ))) = _
    rw [hcoe_add, hcoe_zsmul, hcoe_zsmul,
      PeriodPair.latticeBasis_zero, PeriodPair.latticeBasis_one]
    simp [CoxMatrix.complexSublatticeGenerators, L,
      UpperHalfPlane.periodPair, zsmul_eq_mul]

private theorem CoxMatrix.sublattice_map_subtype {m : ℕ+}
    (σ : CoxMatrix m) (τ : ℍ) :
    (σ.sublattice τ).map (UpperHalfPlane.periodPair τ).lattice.subtype =
      Submodule.span ℤ (Set.range (σ.complexSublatticeGenerators τ)) := by
  rw [σ.sublattice_eq_span τ, Submodule.map_span]
  apply congrArg (Submodule.span ℤ)
  ext x
  constructor
  · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, (σ.coe_sublatticeGenerators τ i).symm⟩
  · rintro ⟨i, rfl⟩
    exact ⟨σ.sublatticeGenerators τ i, ⟨i, rfl⟩,
      σ.coe_sublatticeGenerators τ i⟩

private theorem CoxMatrix.range_complexSublatticeGenerators {m : ℕ+}
    (σ : CoxMatrix m) (τ : ℍ) :
    Set.range (σ.complexSublatticeGenerators τ) =
      ({(σ.d : ℂ), (σ.b : ℂ) + (σ.a : ℂ) * (τ : ℂ)} : Set ℂ) := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i <;>
      simp [CoxMatrix.complexSublatticeGenerators]
  · intro hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨0, by simp [CoxMatrix.complexSublatticeGenerators]⟩
    · exact ⟨1, by simp [CoxMatrix.complexSublatticeGenerators]⟩

private theorem CoxMatrix.complexSublatticeSpan_eq_scaledLattice
    {m : ℕ+} (σ : CoxMatrix m) (τ : ℍ) :
    Submodule.span ℤ (Set.range (σ.complexSublatticeGenerators τ)) =
      (((Units.mk0 (σ.d : ℂ) (by exact_mod_cast σ.d_pos.ne')) •
        UpperHalfPlane.periodPair (σ.act τ)).lattice) := by
  let u : ℂˣ := Units.mk0 (σ.d : ℂ) (by exact_mod_cast σ.d_pos.ne')
  have hd : (σ.d : ℂ) ≠ 0 := by exact_mod_cast σ.d_pos.ne'
  have homega₁ : (u • UpperHalfPlane.periodPair (σ.act τ)).ω₁ =
      (σ.d : ℂ) := by
    simp [u, UpperHalfPlane.periodPair]
  have homega₂ : (u • UpperHalfPlane.periodPair (σ.act τ)).ω₂ =
      (σ.b : ℂ) + (σ.a : ℂ) * (τ : ℂ) := by
    simp only [PeriodPair.smul_ω₂, u, Units.val_mk0,
      UpperHalfPlane.periodPair]
    rw [CoxMatrix.coe_act]
    field_simp [hd]
    ring
  ext x
  rw [σ.range_complexSublatticeGenerators τ,
    Submodule.mem_span_pair, PeriodPair.mem_lattice, homega₁, homega₂]
  simp only [zsmul_eq_mul]

/-- Cox Lemma 11.24: cyclic index-`m` sublattices of `[1,τ]` are uniquely classified by
`C(m)`. -/
noncomputable def cyclicSublatticeEquivCoxMatrix (m : ℕ+) (τ : ℍ) :
    PeriodPair.CyclicSublattice (UpperHalfPlane.periodPair τ) m ≃ CoxMatrix m :=
  cyclicSublatticeEquivCoxMatrixOfPeriodPair (UpperHalfPlane.periodPair τ) m

/-- The HNF inclusion matrix of a cyclic sublattice is `!![d,b;0,a]` for its unique Cox
representative. -/
theorem cyclicSublattice_hnf_matrix (m : ℕ+) (τ : ℍ)
    (S : PeriodPair.CyclicSublattice (UpperHalfPlane.periodPair τ) m) :
    S.hermiteNormalForm.matrix =
      (cyclicSublatticeEquivCoxMatrix m τ S).inclusionMatrix := by
  exact S.hermiteNormalForm_matrix_eq_inclusionMatrix

/-- The lattice of the sublattice classified by `σ` is `[d,aτ+b] = d[1,στ]`. -/
theorem coxMatrix_toPeriodPair_lattice (m : ℕ+) (τ : ℍ) (σ : CoxMatrix m) :
    (σ.toCyclicSublattice τ).toPeriodPair.lattice =
      (((Units.mk0 (σ.d : ℂ) (by exact_mod_cast σ.d_pos.ne')) •
        UpperHalfPlane.periodPair (σ.act τ)).lattice) := by
  calc
    (σ.toCyclicSublattice τ).toPeriodPair.lattice =
        (σ.sublattice τ).map
          (UpperHalfPlane.periodPair τ).lattice.subtype :=
      (σ.toCyclicSublattice τ).toPeriodPair_lattice
    _ = Submodule.span ℤ
        (Set.range (σ.complexSublatticeGenerators τ)) :=
      σ.sublattice_map_subtype τ
    _ = _ := σ.complexSublatticeSpan_eq_scaledLattice τ

/-- The cyclic sublattice attached to a Cox representative has the corresponding analytic
`j`-value. -/
theorem CoxMatrix.toCyclicSublattice_j {m : ℕ+} (σ : CoxMatrix m) (τ : ℍ) :
    (σ.toCyclicSublattice τ).j = j (σ.act τ) := by
  let a : ℂˣ := Units.mk0 (σ.d : ℂ) (by exact_mod_cast σ.d_pos.ne')
  calc
    (σ.toCyclicSublattice τ).j =
        (a • UpperHalfPlane.periodPair (σ.act τ)).j := by
      apply PeriodPair.j_congr
      simpa only [a] using coxMatrix_toPeriodPair_lattice m τ σ
    _ = (UpperHalfPlane.periodPair (σ.act τ)).j :=
      PeriodPair.j_smul (UpperHalfPlane.periodPair (σ.act τ)) a
    _ = j (σ.act τ) := (j_eq_periodPair_j _).symm

/-- Root classification over a normalized lattice, the local form of Theorem 11.23. -/
theorem modularPolynomialC_zero_iff_normalizedCyclicSublattice
    (m : ℕ+) (τ : ℍ) (u : ℂ) :
    (modularPolynomialC m).eval u (j τ) = 0 ↔
      ∃ S : PeriodPair.CyclicSublattice (UpperHalfPlane.periodPair τ) m,
        u = S.j := by
  classical
  rw [← BivariatePolynomial.specializeY_eval,
    modularPolynomialC_specializeY, coxPhiAtJ, Polynomial.eval_prod]
  simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C,
    Finset.prod_eq_zero_iff, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨σ, hσ⟩
    exact ⟨σ.toCyclicSublattice τ,
      (sub_eq_zero.mp hσ).trans (σ.toCyclicSublattice_j τ).symm⟩
  · rintro ⟨S, rfl⟩
    refine ⟨S.toCoxMatrix, sub_eq_zero.mpr ?_⟩
    rw [← S.toCoxMatrix.toCyclicSublattice_j τ]
    exact congrArg PeriodPair.CyclicSublattice.j
      (CoxMatrix.toCoxMatrix_toCyclicSublatticeOfPeriodPair S).symm

/-- Cox Theorem 11.23: zeros of `Φ_m` classify cyclic index-`m` lattice inclusions. -/
theorem theorem_11_23 (m : ℕ+) (u v : ℂ) :
    (BivariatePolynomial.map (Int.castRingHom ℂ) (modularPolynomial m)).eval u v = 0 ↔
      ∃ L : PeriodPair, ∃ S : PeriodPair.CyclicSublattice L m,
        u = S.j ∧ v = L.j := by
  rw [modularPolynomial_map_complex]
  constructor
  · intro h
    obtain ⟨τ, hτ⟩ := j_surjective v
    obtain ⟨S, hS⟩ :=
      (modularPolynomialC_zero_iff_normalizedCyclicSublattice m τ u).mp <| by
        simpa only [hτ] using h
    exact ⟨UpperHalfPlane.periodPair τ, S, hS,
      hτ.symm.trans (j_eq_periodPair_j τ)⟩
  · rintro ⟨L, S, rfl, rfl⟩
    obtain ⟨τ, a, ha⟩ := exists_homothetic_periodPair L
    let T : PeriodPair.CyclicSublattice (UpperHalfPlane.periodPair τ) m :=
      (S.scale a).ofLatticeEq ha
    have hTj : T.j = S.j :=
      ((S.scale a).j_ofLatticeEq ha).trans (S.j_scale a)
    have hLj : L.j = j τ :=
      (PeriodPair.j_eq_of_homothetic ⟨a, ha⟩).trans (j_eq_periodPair_j τ).symm
    rw [hLj]
    exact (modularPolynomialC_zero_iff_normalizedCyclicSublattice m τ S.j).mpr
      ⟨T, hTj.symm⟩

end Cox
