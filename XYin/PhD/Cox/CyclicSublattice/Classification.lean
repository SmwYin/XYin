import XYin.PhD.Cox.CyclicSublattice
import XYin.PhD.Cox.ModularPolynomial

/-!
# Classification of cyclic sublattices

This file proves Cox Lemma 11.24 and Theorem 11.23: cyclic index-`m` sublattices are
classified by canonical HNF representatives, and their `j`-invariants are exactly the roots
of the modular polynomial.
-/

open MatrixGroups UpperHalfPlane

noncomputable section

namespace PeriodPair

namespace CyclicSublattice

variable {L : PeriodPair} {m : ℕ+}

/-- Extract the unique Cox representative encoded by the HNF inclusion matrix. -/
noncomputable def toCoxMatrix (S : CyclicSublattice L m) : Cox.CoxMatrix m :=
  .ofColumnHNF S.hermiteNormalForm.matrix S.hermiteNormalForm.isColumnHermiteNormalForm
    S.det_hermiteNormalForm_matrix S.rankTwoContent_hermiteNormalForm_matrix

@[simp]
theorem toCoxMatrix_a (S : CyclicSublattice L m) :
    S.toCoxMatrix.a = (S.hermiteNormalForm.matrix 1 1).natAbs :=
  rfl

@[simp]
theorem toCoxMatrix_b (S : CyclicSublattice L m) :
    S.toCoxMatrix.b = (S.hermiteNormalForm.matrix 0 1).natAbs :=
  rfl

@[simp]
theorem toCoxMatrix_d (S : CyclicSublattice L m) :
    S.toCoxMatrix.d = (S.hermiteNormalForm.matrix 0 0).natAbs :=
  rfl

/-- The HNF matrix of a cyclic sublattice is the inclusion matrix of its extracted Cox
representative. -/
@[simp]
theorem toCoxMatrix_inclusionMatrix (S : CyclicSublattice L m) :
    S.toCoxMatrix.inclusionMatrix = S.hermiteNormalForm.matrix :=
  Cox.CoxMatrix.inclusionMatrix_ofColumnHNF ..

end CyclicSublattice

end PeriodPair

namespace Cox

namespace CoxMatrix

open PeriodPair PeriodPair.CyclicSublattice

variable {m : ℕ+}

/-- The submodule generated by the columns of a Cox inclusion matrix in any period lattice. -/
def sublatticeOfPeriodPair (σ : CoxMatrix m) (L : PeriodPair) :
    Submodule ℤ L.lattice :=
  LinearMap.range (Matrix.toLin L.latticeBasis L.latticeBasis σ.inclusionMatrix)

private noncomputable def inclusionHermiteNormalForm (σ : CoxMatrix m)
    (L : PeriodPair) :
    Module.Basis.HermiteNormalForm L.latticeBasis (σ.sublatticeOfPeriodPair L) :=
  .ofToLin L.latticeBasis σ.inclusionMatrix_isColumnHermiteNormalForm <|
    (Matrix.toLin_injective_iff_det_ne_zero _ _).mpr <| by
      rw [σ.inclusionMatrix_det]
      exact_mod_cast PNat.ne_zero m

/-- A Cox matrix produces a cyclic index-`m` sublattice in any period lattice. -/
noncomputable def toCyclicSublatticeOfPeriodPair (σ : CoxMatrix m)
    (L : PeriodPair) : PeriodPair.CyclicSublattice L m where
  carrier := σ.sublatticeOfPeriodPair L
  index_eq := (σ.inclusionHermiteNormalForm L).index_eq_natAbs_det.trans <| by
    change σ.inclusionMatrix.det.natAbs = _
    rw [σ.inclusionMatrix_det, Int.natAbs_natCast]
  cyclic := (σ.inclusionHermiteNormalForm L).quotient_isAddCyclic_iff_rankTwoContent_eq_one.mpr
    σ.inclusionMatrix_content_eq_one

@[simp]
theorem toCyclicSublatticeOfPeriodPair_hermiteNormalForm_matrix
    (σ : CoxMatrix m) (L : PeriodPair) :
    (σ.toCyclicSublatticeOfPeriodPair L).hermiteNormalForm.matrix = σ.inclusionMatrix :=
  (σ.toCyclicSublatticeOfPeriodPair L).hermiteNormalForm.matrix_eq
    (σ.inclusionHermiteNormalForm L)

@[simp]
theorem toCyclicSublatticeOfPeriodPair_toCoxMatrix
    (σ : CoxMatrix m) (L : PeriodPair) :
    (σ.toCyclicSublatticeOfPeriodPair L).toCoxMatrix = σ :=
  inclusionMatrix_injective <| by
    rw [toCoxMatrix_inclusionMatrix, toCyclicSublatticeOfPeriodPair_hermiteNormalForm_matrix]

@[simp]
theorem toCoxMatrix_toCyclicSublatticeOfPeriodPair
    (S : PeriodPair.CyclicSublattice L m) :
    S.toCoxMatrix.toCyclicSublatticeOfPeriodPair L = S := by
  apply PeriodPair.CyclicSublattice.ext
  change LinearMap.range
      (Matrix.toLin L.latticeBasis L.latticeBasis
        S.toCoxMatrix.inclusionMatrix) = S.carrier
  rw [toCoxMatrix_inclusionMatrix]
  exact S.hermiteNormalForm.range_toLin_matrix_eq

end CoxMatrix

/-- Cyclic index-`m` sublattices of any period lattice are classified by Cox matrices. -/
noncomputable def cyclicSublatticeEquivCoxMatrixOfPeriodPair
    (L : PeriodPair) (m : ℕ+) :
    PeriodPair.CyclicSublattice L m ≃ CoxMatrix m where
  toFun := PeriodPair.CyclicSublattice.toCoxMatrix
  invFun := fun σ ↦ σ.toCyclicSublatticeOfPeriodPair L
  left_inv := CoxMatrix.toCoxMatrix_toCyclicSublatticeOfPeriodPair
  right_inv := fun σ ↦ CoxMatrix.toCyclicSublatticeOfPeriodPair_toCoxMatrix σ L

/-- A period lattice has exactly `|C(m)|` cyclic sublattices of index `m`. -/
theorem nat_card_cyclicSublattice (L : PeriodPair) (m : ℕ+) :
    Nat.card (PeriodPair.CyclicSublattice L m) = Fintype.card (CoxMatrix m) :=
  (Nat.card_congr (cyclicSublatticeEquivCoxMatrixOfPeriodPair L m)).trans
    Nat.card_eq_fintype_card

/-- The converse half of Lemma 11.24: a Cox representative produces a cyclic index-`m`
sublattice. -/
noncomputable def CoxMatrix.toCyclicSublattice {m : ℕ+} (σ : CoxMatrix m) (τ : ℍ) :
    PeriodPair.CyclicSublattice (UpperHalfPlane.periodPair τ) m :=
  σ.toCyclicSublatticeOfPeriodPair (UpperHalfPlane.periodPair τ)

/-- Cox Lemma 11.24: cyclic index-`m` sublattices of `[1,τ]` are uniquely classified by
`C(m)`. -/
noncomputable def cyclicSublatticeEquivCoxMatrix (m : ℕ+) (τ : ℍ) :
    PeriodPair.CyclicSublattice (UpperHalfPlane.periodPair τ) m ≃ CoxMatrix m :=
  cyclicSublatticeEquivCoxMatrixOfPeriodPair (UpperHalfPlane.periodPair τ) m

/-- The entry `d` of a Cox matrix, as a unit of `ℂ`. -/
def CoxMatrix.dUnit {m : ℕ+} (σ : CoxMatrix m) : ℂˣ :=
  Units.mk0 (σ.d : ℂ) (by exact_mod_cast σ.d_pos.ne')

@[simp]
theorem CoxMatrix.coe_dUnit {m : ℕ+} (σ : CoxMatrix m) : (σ.dUnit : ℂ) = σ.d :=
  rfl

/-- The lattice of the sublattice classified by `σ` is `[d,aτ+b] = d[1,στ]`. -/
theorem coxMatrix_toPeriodPair_lattice (m : ℕ+) (τ : ℍ) (σ : CoxMatrix m) :
    (σ.toCyclicSublattice τ).toPeriodPair.lattice =
      (σ.dUnit • UpperHalfPlane.periodPair (σ.act τ)).lattice := by
  have hd : (σ.d : ℂ) ≠ 0 := by exact_mod_cast σ.d_pos.ne'
  have h₁ : (σ.toCyclicSublattice τ).toPeriodPair.ω₁ =
      (σ.dUnit • UpperHalfPlane.periodPair (σ.act τ)).ω₁ := by
    simp [CoxMatrix.toCyclicSublattice, PeriodPair.CyclicSublattice.toPeriodPair_ω₁,
      UpperHalfPlane.periodPair]
  have h₂ : (σ.toCyclicSublattice τ).toPeriodPair.ω₂ =
      (σ.dUnit • UpperHalfPlane.periodPair (σ.act τ)).ω₂ := by
    simp only [CoxMatrix.toCyclicSublattice, PeriodPair.CyclicSublattice.toPeriodPair_ω₂,
      CoxMatrix.toCyclicSublatticeOfPeriodPair_hermiteNormalForm_matrix,
      CoxMatrix.inclusionMatrix_zero_one, CoxMatrix.inclusionMatrix_one_one,
      PeriodPair.smul_ω₂, CoxMatrix.coe_dUnit, UpperHalfPlane.periodPair, CoxMatrix.coe_act,
      Int.cast_natCast]
    field_simp
    ring
  rw [PeriodPair.lattice, PeriodPair.lattice, h₁, h₂]

/-- The cyclic sublattice attached to a Cox representative has the corresponding analytic
`j`-value. -/
theorem CoxMatrix.toCyclicSublattice_j {m : ℕ+} (σ : CoxMatrix m) (τ : ℍ) :
    (σ.toCyclicSublattice τ).j = j (σ.act τ) :=
  (PeriodPair.j_congr (coxMatrix_toPeriodPair_lattice m τ σ)).trans
    ((PeriodPair.j_smul _ σ.dUnit).trans (j_eq_periodPair_j _).symm)

/-- Root classification over a normalized lattice, the local form of Theorem 11.23. -/
theorem modularPolynomialC_zero_iff_normalizedCyclicSublattice
    (m : ℕ+) (τ : ℍ) (u : ℂ) :
    (modularPolynomialC m).eval u (j τ) = 0 ↔
      ∃ S : PeriodPair.CyclicSublattice (UpperHalfPlane.periodPair τ) m,
        u = S.j := by
  rw [modularPolynomialC_eval_eq_zero_iff]
  constructor
  · rintro ⟨σ, rfl⟩
    exact ⟨σ.toCyclicSublattice τ, (σ.toCyclicSublattice_j τ).symm⟩
  · rintro ⟨S, rfl⟩
    refine ⟨S.toCoxMatrix, ?_⟩
    rw [← S.toCoxMatrix.toCyclicSublattice_j τ]
    exact congrArg PeriodPair.CyclicSublattice.j
      (CoxMatrix.toCoxMatrix_toCyclicSublatticeOfPeriodPair S).symm

/-- Cox Theorem 11.23: zeros of `Φ_m` classify cyclic index-`m` lattice inclusions. -/
theorem theorem_11_23 (m : ℕ+) (u v : ℂ) :
    (BivariatePolynomial.map (Int.castRingHom ℂ) (modularPolynomial m)).eval u v = 0 ↔
      ∃ L : PeriodPair, ∃ S : PeriodPair.CyclicSublattice L m,
        u = S.j ∧ v = L.j := by
  rw [modularPolynomial_map_complex]
  constructor
  · intro h
    obtain ⟨τ, hτ⟩ := j_surjective v
    obtain ⟨S, hS⟩ :=
      (modularPolynomialC_zero_iff_normalizedCyclicSublattice m τ u).mp <| by
        simpa only [hτ] using h
    exact ⟨UpperHalfPlane.periodPair τ, S, hS,
      hτ.symm.trans (j_eq_periodPair_j τ)⟩
  · rintro ⟨L, S, rfl, rfl⟩
    obtain ⟨τ, a, ha⟩ := exists_homothetic_periodPair L
    let T : PeriodPair.CyclicSublattice (UpperHalfPlane.periodPair τ) m :=
      (S.scale a).ofLatticeEq ha
    have hTj : T.j = S.j :=
      ((S.scale a).j_ofLatticeEq ha).trans (S.j_scale a)
    have hLj : L.j = j τ :=
      (PeriodPair.j_eq_of_homothetic ⟨a, ha⟩).trans (j_eq_periodPair_j τ).symm
    rw [hLj]
    exact (modularPolynomialC_zero_iff_normalizedCyclicSublattice m τ S.j).mpr
      ⟨T, hTj.symm⟩

end Cox
