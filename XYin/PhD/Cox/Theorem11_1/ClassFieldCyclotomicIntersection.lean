import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
import Mathlib.FieldTheory.LinearDisjoint

/-!
# Coprime rational cyclotomic intersection

Janusz V.5.4, printed161/PDF172, uses the rational cyclotomic intersection for coprime root orders.
Root integrality, rational degrees, and the degree of the actual supremum give linear disjointness
and that intersection.
-/

namespace Cox.ClassFieldTheory.CyclotomicIntersection

/-- A root of positive order is integral over every commutative base ring. -/
theorem isIntegral_of_primitiveRoot {R A : Type*}
    [CommRing R] [CommRing A] [Algebra R A]
    (n : ℕ) (hn : 0 < n) (ζ : A) (hζ : IsPrimitiveRoot ζ n) :
    IsIntegral R ζ := by
  exact (hζ.isIntegral hn).tower_top

/-- Adjoining a root of positive order gives a finite extension. -/
theorem finiteDimensional_adjoin_root {F Ω : Type*}
    [Field F] [Field Ω] [Algebra F Ω]
    (n : ℕ) (hn : 0 < n) (ζ : Ω) (hζ : IsPrimitiveRoot ζ n) :
    FiniteDimensional F (IntermediateField.adjoin F {ζ}) := by
  exact IntermediateField.adjoin.finiteDimensional (isIntegral_of_primitiveRoot n hn ζ hζ)

/-- The rational degree of a primitive root is the totient of its order. -/
theorem finrank_adjoin_root_rat {Ω : Type*} [Field Ω] [CharZero Ω]
    (n : ℕ) (hn : 0 < n) (ζ : Ω) (hζ : IsPrimitiveRoot ζ n) :
    Module.finrank ℚ (IntermediateField.adjoin ℚ {ζ}) = n.totient := by
  rw [IntermediateField.adjoin.finrank (isIntegral_of_primitiveRoot n hn ζ hζ),
    ← Polynomial.cyclotomic_eq_minpoly_rat hζ hn, Polynomial.natDegree_cyclotomic]

/-- The two roots give the lcm degree lower bound inside their actual supremum. -/
theorem lcm_totient_le_finrank_sup {F Ω : Type*}
    [Field F] [Field Ω] [Algebra F Ω]
    (m n : ℕ) (ζ ξ : Ω) (hζ : IsPrimitiveRoot ζ m) (hξ : IsPrimitiveRoot ξ n)
    [FiniteDimensional F (IntermediateField.adjoin F {ζ})]
    [FiniteDimensional F (IntermediateField.adjoin F {ξ})]
    (hirr : Irreducible (Polynomial.cyclotomic (m.lcm n) F)) :
    (m.lcm n).totient ≤ Module.finrank F
      ↥(IntermediateField.adjoin F {ζ} ⊔ IntermediateField.adjoin F {ξ}) := by
  set S := IntermediateField.adjoin F {ζ} ⊔ IntermediateField.adjoin F {ξ} with hS
  have hζS : ζ ∈ S := (le_sup_left : IntermediateField.adjoin F {ζ} ≤ S)
    (IntermediateField.mem_adjoin_simple_self F ζ)
  have hξS : ξ ∈ S := (le_sup_right : IntermediateField.adjoin F {ξ} ≤ S)
    (IntermediateField.mem_adjoin_simple_self F ξ)
  have hζ' : IsPrimitiveRoot (⟨ζ, hζS⟩ : S) m :=
    IsPrimitiveRoot.of_map_of_injective (f := S.val) hζ Subtype.val_injective
  have hξ' : IsPrimitiveRoot (⟨ξ, hξS⟩ : S) n :=
    IsPrimitiveRoot.of_map_of_injective (f := S.val) hξ Subtype.val_injective
  exact hζ'.lcm_totient_le_finrank hξ' hirr

/-- Coprime root orders give the product of the individual rational degrees. -/
theorem finrank_sup_of_coprime {Ω : Type*} [Field Ω] [CharZero Ω]
    (m n : ℕ) (hm : 0 < m) (hn : 0 < n) (hcop : m.Coprime n)
    (ζ ξ : Ω) (hζ : IsPrimitiveRoot ζ m) (hξ : IsPrimitiveRoot ξ n) :
    Module.finrank ℚ
      ↥(IntermediateField.adjoin ℚ {ζ} ⊔ IntermediateField.adjoin ℚ {ξ}) =
      Module.finrank ℚ (IntermediateField.adjoin ℚ {ζ}) *
        Module.finrank ℚ (IntermediateField.adjoin ℚ {ξ}) := by
  haveI := finiteDimensional_adjoin_root (F := ℚ) m hm ζ hζ
  haveI := finiteDimensional_adjoin_root (F := ℚ) n hn ξ hξ
  apply le_antisymm (IntermediateField.finrank_sup_le _ _)
  have hlow := lcm_totient_le_finrank_sup (F := ℚ) m n ζ ξ hζ hξ
    (Polynomial.cyclotomic.irreducible_rat (Nat.lcm_pos hm hn))
  rwa [hcop.lcm_eq_mul, Nat.totient_mul hcop, ← finrank_adjoin_root_rat m hm ζ hζ,
    ← finrank_adjoin_root_rat n hn ξ hξ] at hlow

/-- Rational fields generated by roots of coprime orders are linearly disjoint. -/
theorem linearDisjoint_of_coprime {Ω : Type*} [Field Ω] [CharZero Ω]
    (m n : ℕ) (hm : 0 < m) (hn : 0 < n) (hcop : m.Coprime n)
    (ζ ξ : Ω) (hζ : IsPrimitiveRoot ζ m) (hξ : IsPrimitiveRoot ξ n) :
    (IntermediateField.adjoin ℚ {ζ}).LinearDisjoint
      (IntermediateField.adjoin ℚ {ξ}) := by
  haveI := finiteDimensional_adjoin_root (F := ℚ) m hm ζ hζ
  haveI := finiteDimensional_adjoin_root (F := ℚ) n hn ξ hξ
  exact IntermediateField.LinearDisjoint.of_finrank_sup
    (finrank_sup_of_coprime m n hm hn hcop ζ ξ hζ hξ)

/-- Janusz V.5.4, printed161: the intersection of these rational root fields is ℚ. -/
theorem inf_eq_bot_of_coprime {Ω : Type*} [Field Ω] [CharZero Ω]
    (m n : ℕ) (hm : 0 < m) (hn : 0 < n) (hcop : m.Coprime n)
    (ζ ξ : Ω) (hζ : IsPrimitiveRoot ζ m) (hξ : IsPrimitiveRoot ξ n) :
    IntermediateField.adjoin ℚ {ζ} ⊓ IntermediateField.adjoin ℚ {ξ} = ⊥ := by
  exact (linearDisjoint_of_coprime m n hm hn hcop ζ ξ hζ hξ).inf_eq_bot

end Cox.ClassFieldTheory.CyclotomicIntersection
