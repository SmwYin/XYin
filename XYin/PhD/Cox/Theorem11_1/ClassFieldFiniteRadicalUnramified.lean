import XYin.PhD.Cox.Theorem11_1.ClassFieldGlobalRadicalGenerator
import XYin.PhD.Cox.Theorem11_1.ClassFieldUnramifiedDegreeOne
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.NumberTheory.RamificationInertia.Valuation

/-! # Finite unramified radical extensions

Source: Janusz V.8.2 and V.9.3. Adjoining finitely many radicals of local units, one
at a time, keeps every prime above `v` unramified.
-/

noncomputable section
namespace Cox.ClassFieldTheory
open NumberField IsDedekindDomain IntermediateField
attribute [local instance] completionIntegerAlgebra

/-- An extension generated by finitely many locally unit radicals is unramified. -/
theorem ramificationIdx_eq_one_of_finite_radical_generators
    (K L : Type*) [Field K] [Field L] [NumberField K] [NumberField L] [Algebra K L]
    (v : HeightOneSpectrum (𝓞 K)) (n : ℕ)
    (hn : IsUnit (n : v.adicCompletionIntegers K))
    (s : Finset L) (hgen : IntermediateField.adjoin K (s : Set L) = ⊤)
    (hs : ∀ x ∈ s, ∃ a : K, v.valuation K a = 1 ∧ x ^ n = algebraMap K L a)
    (w : HeightOneSpectrum (𝓞 L)) [w.asIdeal.LiesOver v.asIdeal] :
    Ideal.ramificationIdx v.asIdeal w.asIdeal = 1 := by
  let P : IntermediateField K L → Prop := fun M =>
    ∀ (u : HeightOneSpectrum (𝓞 M)), u.asIdeal.LiesOver v.asIdeal →
      Ideal.ramificationIdx v.asIdeal u.asIdeal = 1
  have hbase : P ⊥ := by
    intro u hu
    letI := hu
    exact ramificationIdx_eq_one_of_finrank_eq_one (𝓞 K) (𝓞 (⊥ : IntermediateField K L))
      K (⊥ : IntermediateField K L) v.asIdeal v.ne_bot u.asIdeal IntermediateField.finrank_bot
  have hstep (M : IntermediateField K L) (x : L) (hx : x ∈ s) (hM : P M) :
      P ((IntermediateField.adjoin M {x}).restrictScalars K) := by
    let N := IntermediateField.adjoin M {x}
    letI : NumberField N := NumberField.of_module_finite M N
    change ∀ z : HeightOneSpectrum (𝓞 N), z.asIdeal.LiesOver v.asIdeal →
      Ideal.ramificationIdx v.asIdeal z.asIdeal = 1
    intro z hz
    letI := hz
    let u : HeightOneSpectrum (𝓞 M) := z.under (𝓞 M)
    haveI : z.asIdeal.LiesOver u.asIdeal := ⟨rfl⟩
    haveI : u.asIdeal.LiesOver v.asIdeal := Ideal.LiesOver.tower_bot z.asIdeal u.asIdeal v.asIdeal
    have hlower := hM u inferInstance
    obtain ⟨a, ha, hxa⟩ := hs x hx
    have hanew : u.valuation M (algebraMap K M a) = 1 := by
      rw [← HeightOneSpectrum.valuation_liesOver M v u a, ha, one_pow]
    have hnnew : IsUnit (n : u.adicCompletionIntegers M) := by
      simpa only [map_natCast] using hn.map
        (algebraMap (v.adicCompletionIntegers K) (u.adicCompletionIntegers M))
    let y : N := AdjoinSimple.gen M x
    have hxint : IsIntegral M x := Algebra.IsIntegral.isIntegral x
    have hygen : Algebra.adjoin M {y} = ⊤ :=
      (IntermediateField.adjoin.powerBasis hxint).adjoin_gen_eq_top
    have hypow : y ^ n = algebraMap M N (algebraMap K M a) := by
      apply N.val.injective
      simpa only [map_pow, AlgHom.commutes, IsScalarTower.algebraMap_apply] using hxa
    have hupper := ramificationIdx_eq_one_of_radical_generator M N u z n hnnew
      (algebraMap K M a) hanew y hygen hypow
    rw [Ideal.ramificationIdx_algebra_tower' v.asIdeal u.asIdeal z.asIdeal,
      hlower, hupper, one_mul]
  have htop : P ⊤ := by
    rw [← hgen]
    exact IntermediateField.induction_on_adjoin_finset s P hbase hstep
  let u : HeightOneSpectrum (𝓞 (⊤ : IntermediateField K L)) :=
    w.under (𝓞 (⊤ : IntermediateField K L))
  haveI : w.asIdeal.LiesOver u.asIdeal := ⟨rfl⟩
  haveI : u.asIdeal.LiesOver v.asIdeal := Ideal.LiesOver.tower_bot w.asIdeal u.asIdeal v.asIdeal
  have hupper := ramificationIdx_eq_one_of_finrank_eq_one
    (𝓞 (⊤ : IntermediateField K L)) (𝓞 L) (⊤ : IntermediateField K L) L
    u.asIdeal u.ne_bot w.asIdeal IntermediateField.finrank_top
  rw [Ideal.ramificationIdx_algebra_tower' v.asIdeal u.asIdeal w.asIdeal,
    htop u inferInstance, hupper, one_mul]

end Cox.ClassFieldTheory
