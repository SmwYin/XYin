import XYin.PhD.Cox.Theorem11_1.ClassFieldUnitNormalization
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.RepresentationTheory.Intertwining

/-! # The normalized unit family's diagonal relation

The actual exponent map has the constant integer vectors as kernel. Its image is
exactly the group generated by the normalized units. The source quotient is the
permutation module modulo the all-ones line. Finite index and the Herbrand
calculation remain later steps.
-/

open NumberField IsDedekindDomain
open scoped nonZeroDivisors Pointwise
noncomputable section
namespace Cox.ClassFieldTheory

/-- An exact product relation can be shifted by the same integer at every coordinate. -/
theorem prod_zpow_sub_const {ι M : Type*} [Fintype ι] [CommGroup M]
    (u : ι → M) (a : ι → ℤ) (n : ℤ) :
    (∏ i, u i ^ (a i - n)) = (∏ i, u i ^ a i) / (∏ i, u i) ^ n := by
  simp only [zpow_sub, Finset.prod_mul_distrib, Finset.prod_inv_distrib, Finset.prod_zpow,
    div_eq_mul_inv]

/-- The normalized family has precisely the constant integral relations. -/
theorem unitRelation_iff_constant (L : Type*) [Field L] [NumberField L]
    (u : InfinitePlace L → (toPrincipalIdeal (𝓞 L) L).ker) (w₀ : InfinitePlace L)
    (hprod : (∏ w, u w) = 1)
    (hLI : LinearIndependent ℝ
      (fun j : {w : InfinitePlace L // w ≠ w₀} => fun v : InfinitePlace L =>
        (v.mult : ℝ) * Real.log (v ((u j.val : Lˣ) : L)))) (a : InfinitePlace L → ℤ) :
    (∏ w, u w ^ a w) = 1 ↔ ∃ n : ℤ, ∀ w, a w = n := by
  constructor
  · intro h
    refine ⟨a w₀, fun w => ?_⟩
    have h1 : (∏ w, u w ^ (a w - a w₀)) = 1 := by
      rw [prod_zpow_sub_const, h, hprod, one_zpow, div_one]
    have h2 : (∏ w, ((u w : Lˣ)) ^ (a w - a w₀)) = 1 := by
      have h3 := congrArg (fun x : (toPrincipalIdeal (𝓞 L) L).ker => (x : Lˣ)) h1
      push_cast at h3
      exact h3
    have hsum := relation_weightedLog_sum_eq_zero L (fun w => (u w : Lˣ))
      (fun w => a w - a w₀) h2
    have hz := coefficients_eq_zero_of_deleted_independent
      (fun w : InfinitePlace L => fun v : InfinitePlace L =>
        (v.mult : ℝ) * Real.log (v ((u w : Lˣ) : L))) w₀ hLI
      (fun w => ((a w - a w₀ : ℤ) : ℝ)) hsum (by simp)
    have h4 := congrFun hz w
    simp only [Pi.zero_apply, Int.cast_eq_zero] at h4
    omega
  · rintro ⟨n, hn⟩
    simp_rw [hn]
    rw [Finset.prod_zpow, hprod, one_zpow]

/-- One actual equivariant family has the unique diagonal relation; no finite index is asserted. -/
theorem exists_equivariant_unit_family_unique_relation (K L : Type*) [Field K] [Field L]
    [NumberField K] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] :
    ∃ u : InfinitePlace L → (toPrincipalIdeal (𝓞 L) L).ker,
      (∀ (σ : L ≃ₐ[K] L) w, σ • (u w : Lˣ) = (u (σ • w) : Lˣ)) ∧
      (∀ a : InfinitePlace L → ℤ,
        (∏ w, u w ^ a w) = 1 ↔ ∃ n : ℤ, ∀ w, a w = n) := by
  obtain ⟨u, hequiv, hprod, hLI⟩ := exists_normalized_equivariant_unit_family K L
  obtain ⟨w₀⟩ := (inferInstance : Nonempty (InfinitePlace L))
  exact ⟨u, hequiv, fun a => unitRelation_iff_constant L u w₀ hprod (hLI w₀) a⟩

/-- Evaluate the integer exponent vector as a linear combination of actual field units. -/
def unitExponentMap (L : Type*) [Field L] [NumberField L]
    (u : InfinitePlace L → (toPrincipalIdeal (𝓞 L) L).ker) :
    (InfinitePlace L →₀ ℤ) →ₗ[ℤ] Additive Lˣ :=
  Finsupp.linearCombination ℤ (fun w => Additive.ofMul (u w : Lˣ))

/-- The linear exponent map represents the actual finite product of integer powers. -/
theorem unitExponentMap_product (L : Type*) [Field L] [NumberField L]
    (u : InfinitePlace L → (toPrincipalIdeal (𝓞 L) L).ker) (f : InfinitePlace L →₀ ℤ) :
    Additive.toMul (unitExponentMap L u f) = ∏ w, (u w : Lˣ) ^ f w := by
  rw [unitExponentMap, Finsupp.linearCombination_apply, Finsupp.sum_fintype]
  · rw [toMul_sum]
    refine Finset.prod_congr rfl fun w _ => ?_
    rw [toMul_zsmul, toMul_ofMul]
  · intro i
    exact zero_smul ℤ _

/-- The diagonal vector is the sum of every basis vector of the finite permutation module. -/
def diagonalVector (R X : Type*) [Semiring R] [Fintype X] : X →₀ R :=
  ∑ x, Finsupp.single x 1

/-- Each coordinate of the diagonal vector is one. -/
theorem diagonalVector_apply (R X : Type*) [Semiring R] [Fintype X] (x : X) :
    diagonalVector R X x = 1 := by
  classical
  rw [diagonalVector, Finsupp.finsetSum_apply]
  simp [Finsupp.single_apply]

/-- The actual unit-evaluation kernel is the integral span of the diagonal vector. -/
theorem unitExponentMap_ker_eq_diagonal (L : Type*) [Field L] [NumberField L]
    (u : InfinitePlace L → (toPrincipalIdeal (𝓞 L) L).ker)
    (hrel : ∀ a : InfinitePlace L → ℤ,
      (∏ w, u w ^ a w) = 1 ↔ ∃ n : ℤ, ∀ w, a w = n) :
    LinearMap.ker (unitExponentMap L u) =
      Submodule.span ℤ {diagonalVector ℤ (InfinitePlace L)} := by
  ext f
  rw [LinearMap.mem_ker, Submodule.mem_span_singleton]
  have hiff : unitExponentMap L u f = 0 ↔ (∏ w, u w ^ f w) = 1 := by
    rw [← toMul_eq_one, unitExponentMap_product, ← OneMemClass.coe_eq_one]
    push_cast
    rfl
  rw [hiff, hrel]
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    ext w
    rw [Finsupp.smul_apply, diagonalVector_apply, smul_eq_mul, mul_one, hn]
  · rintro ⟨n, rfl⟩
    exact ⟨n, fun w => by rw [Finsupp.smul_apply, diagonalVector_apply, smul_eq_mul, mul_one]⟩

/-- The actual exponent map intertwines the place permutation and field-unit actions. -/
theorem unitExponentMap_equivariant (K L : Type*) [Field K] [Field L]
    [NumberField L] [Algebra K L]
    (u : InfinitePlace L → (toPrincipalIdeal (𝓞 L) L).ker)
    (hu : ∀ (σ : L ≃ₐ[K] L) w, σ • (u w : Lˣ) = (u (σ • w) : Lˣ))
    (σ : L ≃ₐ[K] L) (f : InfinitePlace L →₀ ℤ) :
    unitExponentMap L u ((Representation.ofMulAction ℤ (L ≃ₐ[K] L) (InfinitePlace L)) σ f) =
      (Representation.ofMulDistribMulAction (L ≃ₐ[K] L) Lˣ) σ (unitExponentMap L u f) := by
  have h : (unitExponentMap L u).comp
      ((Representation.ofMulAction ℤ (L ≃ₐ[K] L) (InfinitePlace L)) σ) =
      ((Representation.ofMulDistribMulAction (L ≃ₐ[K] L) Lˣ) σ).comp (unitExponentMap L u) := by
    apply Finsupp.lhom_ext
    intro w b
    simp only [LinearMap.comp_apply, Representation.ofMulAction_single, unitExponentMap,
      Finsupp.linearCombination_single, map_zsmul,
      Representation.ofMulDistribMulAction_apply_apply, toMul_ofMul, hu]
  exact LinearMap.congr_fun h f

/-- The exponent map has the actual generated field-unit subgroup as its additive range. -/
theorem unitExponentMap_range_eq_generated (L : Type*) [Field L] [NumberField L]
    (u : InfinitePlace L → (toPrincipalIdeal (𝓞 L) L).ker) :
    (LinearMap.range (unitExponentMap L u)).toAddSubgroup =
      (Subgroup.closure (Set.range (fun w => (u w : Lˣ)))).toAddSubgroup := by
  rw [unitExponentMap, Finsupp.range_linearCombination, Submodule.span_int_eq_addSubgroupClosure,
    Subgroup.toAddSubgroup_closure]
  congr 1

/-- The all-ones diagonal span is stable under every permutation action. -/
theorem diagonal_span_stable (R G X : Type*) [Semiring R] [Group G] [Fintype X]
    [MulAction G X] (γ : G) :
    Submodule.span R {diagonalVector R X} ≤
      (Submodule.span R {diagonalVector R X}).comap
        ((Representation.ofMulAction R G X) γ) := by
  rw [Submodule.span_le]
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  rw [SetLike.mem_coe, Submodule.mem_comap]
  have h : (Representation.ofMulAction R G X) γ (diagonalVector R X) = diagonalVector R X := by
    ext x
    rw [Representation.ofMulAction_apply, diagonalVector_apply, diagonalVector_apply]
  rw [h]
  exact Submodule.subset_span rfl

/-- One quotient equivalence has the specified representative map and equivariance. Its domain
is the permutation module modulo the diagonal line. -/
theorem exists_unitDiagonalQuotientEquiv (K L : Type*) [Field K] [Field L]
    [NumberField L] [Algebra K L]
    (u : InfinitePlace L → (toPrincipalIdeal (𝓞 L) L).ker)
    (hu : ∀ (σ : L ≃ₐ[K] L) w, σ • (u w : Lˣ) = (u (σ • w) : Lˣ))
    (hrel : ∀ a : InfinitePlace L → ℤ,
      (∏ w, u w ^ a w) = 1 ↔ ∃ n : ℤ, ∀ w, a w = n) :
    ∃ E : ((InfinitePlace L →₀ ℤ) ⧸
        Submodule.span ℤ {diagonalVector ℤ (InfinitePlace L)}) ≃ₗ[ℤ]
          LinearMap.range (unitExponentMap L u),
      (∀ f, (E (Submodule.Quotient.mk f) : Additive Lˣ) = unitExponentMap L u f) ∧
      ∀ (σ : L ≃ₐ[K] L) q,
        (E (((Representation.ofMulAction ℤ (L ≃ₐ[K] L) (InfinitePlace L)).quotient
          (Submodule.span ℤ {diagonalVector ℤ (InfinitePlace L)})
          (diagonal_span_stable ℤ (L ≃ₐ[K] L) (InfinitePlace L))) σ q) : Additive Lˣ) =
          (Representation.ofMulDistribMulAction (L ≃ₐ[K] L) Lˣ) σ (E q : Additive Lˣ) := by
  have hker := unitExponentMap_ker_eq_diagonal L u hrel
  refine ⟨(Submodule.quotEquivOfEq _ _ hker.symm).trans (unitExponentMap L u).quotKerEquivRange,
    fun f => rfl, ?_⟩
  intro σ q
  obtain ⟨f, rfl⟩ := Submodule.mkQ_surjective _ q
  exact unitExponentMap_equivariant K L u hu σ f

end Cox.ClassFieldTheory
