import XYin.PhD.Cox.Theorem11_1.ClassFieldGlobalUnramifiedGenerator
import Mathlib.FieldTheory.Separable

/-! # Unramified local radical extensions

Source: Janusz V.9.3 and its Hensel/local-degree prerequisites.
-/

noncomputable section
namespace Cox.ClassFieldTheory
open NumberField IsDedekindDomain Polynomial IsLocalRing

/-- A local extension generated by an nth root of a unit is unramified when n is a unit. -/
theorem ramificationIdx_eq_one_of_unit_radical_generator
    (R S K L : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [IsAdicComplete (maximalIdeal R) R]
    [CommRing S] [IsDedekindDomain S] [IsLocalRing S]
    [Algebra R S] [Module.Finite R S]
    [Field K] [Field L] [Algebra R K] [IsFractionRing R K]
    [Algebra S L] [IsFractionRing S L] [Algebra K L] [Algebra R L]
    [IsScalarTower R K L] [IsScalarTower R S L] [IsIntegralClosure S R L]
    (x : L) (hgen : Algebra.adjoin K {x} = ⊤)
    (n : ℕ) (hn : IsUnit (n : R)) (a : Rˣ)
    (hx : x ^ n = algebraMap R L (a : R)) :
    Ideal.ramificationIdx (maximalIdeal R) (maximalIdeal S) = 1 := by
  have hn0 : n ≠ 0 := by
    intro h
    simp [h] at hn
  apply ramificationIdx_eq_one_of_separable_reduction_fieldGenerator R S K L x hgen
    (X ^ n - C (a : R)) (monic_X_pow_sub_C _ hn0)
  · simp only [map_sub, map_pow, aeval_X, aeval_C, hx, sub_self]
  · exact (separable_X_pow_sub_C_unit a hn).map

end Cox.ClassFieldTheory
