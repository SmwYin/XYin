import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import Mathlib.NumberTheory.RamificationInertia.Galois
import XYin.PhD.Cox.Theorem11_1.Orders

/-!
# Independently defined ring class fields

The definition uses the conductor congruence subgroup and an Artin map characterized by arithmetic
Frobenius on residue fields. It does not mention a modular invariant or a splitting-prime criterion.
The existence theorem has the Janusz prerequisite development recorded in the accompanying source
ledger.
-/

open NumberField
open scoped nonZeroDivisors

noncomputable section

namespace Cox.ClassFieldTheory

variable (K : Type*) [Field K] [NumberField K]

/-- Integral ideals prime to a finite modulus, embedded in the fractional ideal group. -/
def coprimeGenerators (m : Ideal (𝓞 K)) : Set (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  {u | ∃ A : Ideal (𝓞 K), A ≠ ⊥ ∧ A ⊔ m = ⊤ ∧
    (u : FractionalIdeal (𝓞 K)⁰ K) = A}

/-- The group `I^m` of fractional ideals prime to a finite modulus. -/
def coprimeIdeals (m : Ideal (𝓞 K)) : Subgroup (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  Subgroup.closure (coprimeGenerators K m)

/-- Integral principal generators congruent to one modulo a finite modulus. -/
def rayGenerators (m : Ideal (𝓞 K)) : Set (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  {u | ∃ α : 𝓞 K, α ≠ 0 ∧ α - 1 ∈ m ∧
    (u : FractionalIdeal (𝓞 K)⁰ K) = FractionalIdeal.spanSingleton (𝓞 K)⁰ (α : K)}

/-- The finite ray principal subgroup of `I^m`. For totally complex fields no
archimedean positivity conditions are needed. -/
def raySubgroup (m : Ideal (𝓞 K)) : Subgroup (coprimeIdeals K m) :=
  (Subgroup.closure (rayGenerators K m)).comap (coprimeIdeals K m).subtype

/-- Janusz V.6: a congruence subgroup at a nonzero finite modulus. -/
structure CongruenceSubgroup where
  modulus : Ideal (𝓞 K)
  modulus_ne_bot : modulus ≠ ⊥
  subgroup : Subgroup (coprimeIdeals K modulus)
  contains_ray : raySubgroup K modulus ≤ subgroup

/-- A congruence subgroup viewed in the ambient fractional ideal group. -/
def CongruenceSubgroup.ambient (H : CongruenceSubgroup K) :
    Subgroup (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  H.subgroup.map (coprimeIdeals K H.modulus).subtype

/-- Janusz V.6: equivalence means equality after restricting to a common modulus. -/
def CongruenceEquivalent (H J : CongruenceSubgroup K) : Prop :=
  ∃ m : Ideal (𝓞 K), m ≠ ⊥ ∧ m ≤ H.modulus ∧ m ≤ J.modulus ∧
    H.ambient ⊓ coprimeIdeals K m = J.ambient ⊓ coprimeIdeals K m

section Extension

variable (m : Ideal (𝓞 K)) (L : Type*) [Field L] [Algebra K L]

/-- Complete splitting for nonzero prime ideals of an arbitrary number field. -/
def splittingIdeals : Set (Ideal (𝓞 K)) :=
  {q | q.IsPrime ∧ q ≠ ⊥ ∧ ∀ P ∈ q.primesOver (𝓞 L),
    Ideal.ramificationIdx q P = 1 ∧ Ideal.inertiaDeg q P = 1}

/-- No nonzero prime outside the finite modulus ramifies. -/
def IsUnramifiedAway : Prop :=
  ∀ q : Ideal (𝓞 K), q.IsPrime → q ≠ ⊥ → q ⊔ m = ⊤ →
    ∀ P ∈ q.primesOver (𝓞 L), Ideal.ramificationIdx q P = 1

/-- Prime-wise characterization of the arithmetic Artin homomorphism. -/
def IsArtinMap (φ : coprimeIdeals K m →* (L ≃ₐ[K] L)) : Prop :=
  ∀ (q : Ideal (𝓞 K)), q.IsPrime → q ≠ ⊥ → q ⊔ m = ⊤ →
    ∀ u : coprimeIdeals K m,
      ((u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K) = q →
      ∀ P ∈ q.primesOver (𝓞 L), ∀ x : 𝓞 L,
        RingOfIntegers.mapRingHom (φ u).toRingHom x - x ^ q.absNorm ∈ P

/-- A finite abelian extension with a surjective arithmetic Artin map and its prescribed
kernel. Fixed-modulus existence also requires the conductor support theorem. -/
structure HasArtinKernel (H : Subgroup (coprimeIdeals K m)) : Prop where
  finiteDimensional : FiniteDimensional K L
  isGalois : IsGalois K L
  commutative : IsMulCommutative (L ≃ₐ[K] L)
  unramified : IsUnramifiedAway K m L
  artin : ∃ φ : coprimeIdeals K m →* (L ≃ₐ[K] L),
    IsArtinMap K m L φ ∧ Function.Surjective φ ∧ φ.ker = H

end Extension

end Cox.ClassFieldTheory

namespace Cox.Order

variable {K : IntermediateField ℚ ℂ} [hNF : NumberField K]
variable (O : Subalgebra ℤ K) [hO : IsOrder O]

include hNF hO

/-- The integral ideal generated by the conductor; Cox, §7.C and §9.A. -/
def conductorIdeal : Ideal (𝓞 K) := Ideal.span {(conductor O : 𝓞 K)}

omit hNF in
/-- The conductor belongs to its principal ideal. -/
theorem conductor_mem_conductorIdeal : (conductor O : 𝓞 K) ∈ conductorIdeal O :=
  Ideal.mem_span_singleton_self _

/-- Integral ideals prime to the conductor, regarded as invertible fractional ideals. -/
def conductorCoprimeGenerators : Set (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  ClassFieldTheory.coprimeGenerators K (conductorIdeal O)

/-- Cox's `I_K(f)`: the group generated by integral ideals prime to the conductor. -/
def conductorCoprimeIdeals : Subgroup (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  ClassFieldTheory.coprimeIdeals K (conductorIdeal O)

/-- Every integral good-ideal generator lies in `I_K(f)`. -/
theorem mem_conductorCoprimeIdeals_of_generator
    {u : (FractionalIdeal (𝓞 K)⁰ K)ˣ} (hu : u ∈ conductorCoprimeGenerators O) :
    u ∈ conductorCoprimeIdeals O :=
  Subgroup.subset_closure hu

/-- Principal generators with a rational integer residue prime to the conductor. -/
def rationalPrincipalGenerators : Set (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  {u | ∃ α : 𝓞 K, α ≠ 0 ∧
    (∃ a : ℤ, a.natAbs.Coprime (conductor O) ∧
      α - (a : 𝓞 K) ∈ conductorIdeal O) ∧
    (u : FractionalIdeal (𝓞 K)⁰ K) = FractionalIdeal.spanSingleton (𝓞 K)⁰ (α : K)}

/-- The ambient subgroup generated by the principal congruence generators. -/
def rationalPrincipalAmbient : Subgroup (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  Subgroup.closure (rationalPrincipalGenerators O)

/-- Cox Proposition 7.22: rational-principal generators are prime to the conductor. -/
theorem rationalPrincipalAmbient_le :
    rationalPrincipalAmbient O ≤ conductorCoprimeIdeals O := by
  refine Subgroup.closure_le _ |>.mpr fun u hu => Subgroup.subset_closure ?_
  obtain ⟨α, hα, ⟨a, ha, hαa⟩, hu⟩ := hu
  refine ⟨Ideal.span {α}, by simpa using hα, ?_, ?_⟩
  · obtain ⟨s, t, hst⟩ : IsCoprime a (conductor O : ℤ) := Int.isCoprime_iff_gcd_eq_one.mpr ha
    rw [eq_top_iff, ← Ideal.span_singleton_one, Ideal.span_le, Set.singleton_subset_iff]
    have h1 : (1 : 𝓞 K) = (s : 𝓞 K) * α +
        ((t : 𝓞 K) * (conductor O : 𝓞 K) - (s : 𝓞 K) * (α - a)) := by
      have h := congrArg (Int.cast : ℤ → 𝓞 K) hst
      push_cast at h
      linear_combination -h
    rw [h1]
    exact Submodule.add_mem_sup (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self α))
      (Ideal.sub_mem _ (Ideal.mul_mem_left _ _ (conductor_mem_conductorIdeal O))
        (Ideal.mul_mem_left _ _ hαa))
  · rw [hu, FractionalIdeal.coeIdeal_span_singleton]

/-- Cox's `P_(K,ℤ)(f)`, as a subgroup of the actual domain `I_K(f)` of the Artin map. -/
def rationalPrincipalIdeals : Subgroup (conductorCoprimeIdeals O) :=
  (rationalPrincipalAmbient O).comap (conductorCoprimeIdeals O).subtype

/-- Membership in the restricted principal subgroup is ambient membership. -/
theorem mem_rationalPrincipalIdeals (u : conductorCoprimeIdeals O) :
    u ∈ rationalPrincipalIdeals O ↔ (u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) ∈
      rationalPrincipalAmbient O :=
  Iff.rfl

/-- Principal elements congruent to one give the ray subgroup for modulus `f O_K`. -/
def rayPrincipalGenerators : Set (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  ClassFieldTheory.rayGenerators K (conductorIdeal O)

/-- The ray principal subgroup, restricted to `I_K(f)`. -/
def rayPrincipalIdeals : Subgroup (conductorCoprimeIdeals O) :=
  ClassFieldTheory.raySubgroup K (conductorIdeal O)

/-- Cox (8.1): the ring-class subgroup is a congruence subgroup. -/
theorem rayPrincipalIdeals_le_rationalPrincipalIdeals :
    rayPrincipalIdeals O ≤ rationalPrincipalIdeals O :=
  Subgroup.comap_mono (Subgroup.closure_mono fun u ⟨α, hα, hα1, hu⟩ =>
    ⟨α, hα, ⟨1, Nat.coprime_one_left _, by simpa using hα1⟩, hu⟩)

section Extension

variable (L : Type*) [Field L] [Algebra K L]

/-- Ramification is confined to primes dividing the conductor modulus. -/
abbrev IsUnramifiedAwayConductor : Prop :=
  ClassFieldTheory.IsUnramifiedAway K (conductorIdeal O) L

/-- The defining prime-wise characterization of the arithmetic Artin homomorphism. -/
abbrev IsArtinMap (φ : conductorCoprimeIdeals O →* (L ≃ₐ[K] L)) : Prop :=
  ClassFieldTheory.IsArtinMap K (conductorIdeal O) L φ

/-- An abelian class field with the specified genuine Artin kernel. -/
abbrev HasArtinKernel (H : Subgroup (conductorCoprimeIdeals O)) : Prop :=
  ClassFieldTheory.HasArtinKernel K (conductorIdeal O) L H

end Extension

/-- A ring class field embedded in `ℂ`, defined independently by the Artin kernel.
The base-field algebra is always the one induced by the recorded literal inclusion. -/
structure IsRingClassField (L : IntermediateField ℚ ℂ) : Prop where
  numberField : NumberField L
  le : K ≤ L
  artinKernel :
    letI : Algebra K L := (IntermediateField.inclusion le).toRingHom.toAlgebra
    HasArtinKernel O L (rationalPrincipalIdeals O)

end Cox.Order
