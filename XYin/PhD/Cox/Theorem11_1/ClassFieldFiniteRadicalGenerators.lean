import XYin.PhD.Cox.Theorem11_1.ClassFieldKummer
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-! # The finite radical family

Janusz V.9.3 and its preceding finite radical reduction: a finite radical field is
generated by finitely many of its own radical elements.
-/
noncomputable section
open NumberField IsDedekindDomain IntermediateField
open scoped nonZeroDivisors
namespace Cox.ClassFieldTheory

/-- A generating set for an intermediate field generates its subtype through the actual
inclusion. -/
theorem adjoin_preimage_val_eq_top
    {K E : Type*} [Field K] [Field E] [Algebra K E]
    (L : IntermediateField K E) (s : Set E)
    (hs : IntermediateField.adjoin K s = L) :
    IntermediateField.adjoin K (L.val ⁻¹' s) = ⊤ := by
  apply IntermediateField.map_injective L.val
  have hsL : s ⊆ L := hs ▸ IntermediateField.subset_adjoin K s
  rw [IntermediateField.adjoin_map, ← AlgHom.fieldRange_eq_map, IntermediateField.fieldRange_val,
    Set.image_preimage_eq_of_subset (fun x hx => ⟨⟨x, hsL hx⟩, rfl⟩), hs]

/-- Choose finitely many actual radical-field elements generating the field and retaining their
base radicands. -/
theorem exists_finite_radical_generators
    (K : Type*) [Field K] [NumberField K]
    (n : ℕ) (hn : 0 < n) (W : Subgroup Kˣ)
    [Finite (W ⧸ (nthPowers K n).subgroupOf W)] :
    ∃ s : Finset (radicalField K n W),
      IntermediateField.adjoin K (s : Set (radicalField K n W)) = ⊤ ∧
      ∀ x ∈ s, ∃ a : W,
        x ^ n = algebraMap K (radicalField K n W) ((a : Kˣ) : K) := by
  obtain ⟨T, hT⟩ := Kummer.exists_finite_radicands K n hn W
  have ht := Kummer.finite_roots_of_radicands K n hn W T
  have hpre := ht.preimage (radicalField K n W).val.injective.injOn
  refine ⟨hpre.toFinset, ?_, ?_⟩
  · rw [Set.Finite.coe_toFinset]
    exact adjoin_preimage_val_eq_top (radicalField K n W) _ hT.symm
  · intro x hx
    rw [Set.Finite.mem_toFinset] at hx
    obtain ⟨w, -, hw⟩ := hx
    exact ⟨w, Subtype.ext (by simpa using hw)⟩

end Cox.ClassFieldTheory
