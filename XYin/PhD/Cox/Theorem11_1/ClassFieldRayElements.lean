import XYin.PhD.Cox.Theorem11_1.ClassFieldIdealGroups

open NumberField IsDedekindDomain
open scoped nonZeroDivisors
noncomputable section
namespace Cox.ClassFieldTheory
variable (K : Type*) [Field K] [NumberField K]

/-- Nonzero field elements locally congruent to one at a finite modulus, generated
using integral representatives. -/
def rayElements (m : Ideal (𝓞 K)) : Subgroup Kˣ :=
  Subgroup.closure {u : Kˣ | ∃ α : 𝓞 K, (α : K) = u ∧ α - 1 ∈ m}

/-- Products of integral ray generators remain integral ray generators. -/
theorem rayGenerators_mul_mem (m : Ideal (𝓞 K)) {u v : (FractionalIdeal (𝓞 K)⁰ K)ˣ}
    (hu : u ∈ rayGenerators K m) (hv : v ∈ rayGenerators K m) :
    u * v ∈ rayGenerators K m := by
  obtain ⟨a, ha0, ham, hau⟩ := hu
  obtain ⟨b, hb0, hbm, hbv⟩ := hv
  refine ⟨a * b, mul_ne_zero ha0 hb0, ?_, ?_⟩
  · have h : a * b - 1 = a * (b - 1) + (a - 1) := by ring
    rw [h]
    exact m.add_mem (m.mul_mem_left a hbm) ham
  · rw [Units.val_mul, hau, hbv, FractionalIdeal.spanSingleton_mul_spanSingleton]
    push_cast
    rfl

/-- The group generated by integral ray generators consists of their quotients. -/
theorem raySubgroup_mem_iff_fraction (m : Ideal (𝓞 K)) (u : coprimeIdeals K m) :
    u ∈ raySubgroup K m ↔ ∃ a b : 𝓞 K, a ≠ 0 ∧ b ≠ 0 ∧
      a - 1 ∈ m ∧ b - 1 ∈ m ∧
      ((u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K) =
        FractionalIdeal.spanSingleton (𝓞 K)⁰ (a : K) /
          FractionalIdeal.spanSingleton (𝓞 K)⁰ (b : K) := by
  have hcoe : ∀ a : 𝓞 K, a ≠ 0 → (a : K) ≠ 0 := fun a ha => by exact_mod_cast ha
  constructor
  · intro hu
    change (u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) ∈ Subgroup.closure (rayGenerators K m) at hu
    generalize (u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) = x at hu ⊢
    induction hu using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨α, hα0, hαm, hx⟩ := hx
      refine ⟨α, 1, hα0, one_ne_zero, hαm, by simp, ?_⟩
      rw [hx]
      simp [FractionalIdeal.spanSingleton_one]
    | one => exact ⟨1, 1, one_ne_zero, one_ne_zero, by simp, by simp, by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨a, b, ha, hb, ham, hbm, hx⟩ := hx
      obtain ⟨c, d, hc, hd, hcm, hdm, hy⟩ := hy
      refine ⟨a * c, b * d, mul_ne_zero ha hc, mul_ne_zero hb hd, ?_, ?_, ?_⟩
      · have h : a * c - 1 = a * (c - 1) + (a - 1) := by ring
        rw [h]
        exact m.add_mem (m.mul_mem_left a hcm) ham
      · have h : b * d - 1 = b * (d - 1) + (b - 1) := by ring
        rw [h]
        exact m.add_mem (m.mul_mem_left b hdm) hbm
      · rw [Units.val_mul, hx, hy, div_mul_div_comm,
          FractionalIdeal.spanSingleton_mul_spanSingleton,
          FractionalIdeal.spanSingleton_mul_spanSingleton]
        push_cast
        rfl
    | inv x _ hx =>
      obtain ⟨a, b, ha, hb, ham, hbm, hx⟩ := hx
      exact ⟨b, a, hb, ha, hbm, ham, by rw [Units.val_inv_eq_inv_val, hx, inv_div]⟩
  · rintro ⟨a, b, ha, hb, ham, hbm, hu⟩
    have hsa : FractionalIdeal.spanSingleton (𝓞 K)⁰ (a : K) ≠ 0 :=
      FractionalIdeal.spanSingleton_ne_zero_iff.mpr (hcoe a ha)
    have hsb : FractionalIdeal.spanSingleton (𝓞 K)⁰ (b : K) ≠ 0 :=
      FractionalIdeal.spanSingleton_ne_zero_iff.mpr (hcoe b hb)
    change (u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) ∈ Subgroup.closure (rayGenerators K m)
    have heq : (u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) = Units.mk0 _ hsa / Units.mk0 _ hsb :=
      Units.ext (by rw [Units.val_div_eq_div_val, Units.val_mk0, Units.val_mk0, hu])
    rw [heq]
    exact Subgroup.div_mem _ (Subgroup.subset_closure ⟨a, ha, ham, rfl⟩)
      (Subgroup.subset_closure ⟨b, hb, hbm, rfl⟩)

/-- Janusz's fractional congruence a/b=1 is generated by integral one-congruences. -/
theorem exists_integral_ray_fraction {R : Type*} [CommRing R] [IsDomain R]
    (F : Type*) [Field F] [Algebra R F] [IsFractionRing R F]
    (m : Ideal R) (a b : R) (ha : a ≠ 0) (hb : b ≠ 0)
    (hcong : a - b ∈ m) (hunit : IsUnit (Ideal.Quotient.mk m b)) :
    ∃ a' b' : R, a' ≠ 0 ∧ b' ≠ 0 ∧ a' - 1 ∈ m ∧ b' - 1 ∈ m ∧
      algebraMap R F a / algebraMap R F b =
        algebraMap R F a' / algebraMap R F b' := by
  by_cases hm : m = ⊤
  · subst hm
    exact ⟨a, b, ha, hb, Submodule.mem_top, Submodule.mem_top, rfl⟩
  · obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (↑(hunit.unit⁻¹) : R ⧸ m)
    have hbc : Ideal.Quotient.mk m (b * c) = 1 := by
      rw [map_mul, hc]
      exact hunit.mul_val_inv
    have hbc' : b * c - 1 ∈ m := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hbc, map_one, sub_self]
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [mul_zero, map_zero] at hbc
      haveI : Nontrivial (R ⧸ m) := Ideal.Quotient.nontrivial_iff.mpr hm
      exact zero_ne_one hbc
    refine ⟨a * c, b * c, mul_ne_zero ha hc0, mul_ne_zero hb hc0, ?_, hbc', ?_⟩
    · have h : a * c - 1 = (a - b) * c + (b * c - 1) := by ring
      rw [h]
      exact m.add_mem (m.mul_mem_right c hcong) hbc'
    · have hc' : algebraMap R F c ≠ 0 := by
        rw [ne_eq, ← map_zero (algebraMap R F), (IsFractionRing.injective R F).eq_iff]
        exact hc0
      rw [map_mul, map_mul, mul_div_mul_right _ _ hc']

/-- The good-ideal group is generated as fractions of good integral ideals. -/
theorem exists_coprime_integral_fraction (m : Ideal (𝓞 K)) (u : coprimeIdeals K m) :
    ∃ A B : Ideal (𝓞 K), A ≠ ⊥ ∧ B ≠ ⊥ ∧ A ⊔ m = ⊤ ∧ B ⊔ m = ⊤ ∧
      ((u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K) =
        (A : FractionalIdeal (𝓞 K)⁰ K) / B := by
  have hu : (u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) ∈ Subgroup.closure (coprimeGenerators K m) := u.2
  generalize (u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) = x at hu ⊢
  induction hu using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨A, hA0, hAm, hx⟩ := hx
    exact ⟨A, ⊤, hA0, top_ne_bot, hAm, top_sup_eq m, by
      rw [hx, FractionalIdeal.coeIdeal_top, div_one]⟩
  | one => exact ⟨⊤, ⊤, top_ne_bot, top_ne_bot, top_sup_eq m, top_sup_eq m, by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨A, B, hA, hB, hAm, hBm, hx⟩ := hx
    obtain ⟨C, D, hC, hD, hCm, hDm, hy⟩ := hy
    refine ⟨A * C, B * D, mul_ne_zero hA hC, mul_ne_zero hB hD, ?_, ?_, ?_⟩
    · rw [Ideal.mul_sup_eq_of_coprime_left hAm, hCm]
    · rw [Ideal.mul_sup_eq_of_coprime_left hBm, hDm]
    · rw [Units.val_mul, hx, hy, div_mul_div_comm, FractionalIdeal.coeIdeal_mul,
        FractionalIdeal.coeIdeal_mul]
  | inv x _ hx =>
    obtain ⟨A, B, hA, hB, hAm, hBm, hx⟩ := hx
    exact ⟨B, A, hB, hA, hBm, hAm, by rw [Units.val_inv_eq_inv_val, hx, inv_div]⟩

/-- Global ray elements have integral one-congruent numerator and denominator. -/
theorem mem_rayElements_iff_fraction (m : Ideal (𝓞 K)) (u : Kˣ) :
    u ∈ rayElements K m ↔ ∃ α β : 𝓞 K, α ≠ 0 ∧ β ≠ 0 ∧
      α - 1 ∈ m ∧ β - 1 ∈ m ∧ (u : K) = (α : K) / β := by
  have hcoe : ∀ a : 𝓞 K, a ≠ 0 → (a : K) ≠ 0 := fun a ha => by exact_mod_cast ha
  constructor
  · intro hu
    induction hu using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨α, hα, hαm⟩ := hx
      have hα0 : α ≠ 0 := by
        rintro rfl
        exact x.ne_zero (by rw [← hα]; simp)
      exact ⟨α, 1, hα0, one_ne_zero, hαm, by simp, by simp [hα]⟩
    | one => exact ⟨1, 1, one_ne_zero, one_ne_zero, by simp, by simp, by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨a, b, ha, hb, ham, hbm, hx⟩ := hx
      obtain ⟨c, d, hc, hd, hcm, hdm, hy⟩ := hy
      refine ⟨a * c, b * d, mul_ne_zero ha hc, mul_ne_zero hb hd, ?_, ?_, ?_⟩
      · have h : a * c - 1 = a * (c - 1) + (a - 1) := by ring
        rw [h]
        exact m.add_mem (m.mul_mem_left a hcm) ham
      · have h : b * d - 1 = b * (d - 1) + (b - 1) := by ring
        rw [h]
        exact m.add_mem (m.mul_mem_left b hdm) hbm
      · rw [Units.val_mul, hx, hy, div_mul_div_comm]
        push_cast
        rfl
    | inv x _ hx =>
      obtain ⟨a, b, ha, hb, ham, hbm, hx⟩ := hx
      exact ⟨b, a, hb, ha, hbm, ham, by rw [Units.val_inv_eq_inv_val, hx, inv_div]⟩
  · rintro ⟨a, b, ha, hb, ham, hbm, hu⟩
    have heq : u = Units.mk0 (a : K) (hcoe a ha) / Units.mk0 (b : K) (hcoe b hb) :=
      Units.ext (by rw [Units.val_div_eq_div_val, Units.val_mk0, Units.val_mk0, hu])
    rw [heq]
    exact Subgroup.div_mem _ (Subgroup.subset_closure ⟨a, rfl, ham⟩)
      (Subgroup.subset_closure ⟨b, rfl, hbm⟩)

/-- Taking principal ideals sends global ray elements into the ray ideal subgroup. -/
theorem principal_mem_ray_of_mem_rayElements (m : Ideal (𝓞 K))
    (u : Kˣ) (hu : u ∈ rayElements K m) :
    toPrincipalIdeal (𝓞 K) K u ∈
      (raySubgroup K m).map (coprimeIdeals K m).subtype := by
  have h1 : rayElements K m ≤
      (Subgroup.closure (rayGenerators K m)).comap (toPrincipalIdeal (𝓞 K) K) := by
    refine (Subgroup.closure_le _).mpr ?_
    rintro x ⟨α, hα, hαm⟩
    refine Subgroup.subset_closure ⟨α, ?_, hαm, ?_⟩
    · rintro rfl
      exact x.ne_zero (by rw [← hα]; simp)
    · rw [coe_toPrincipalIdeal, ← hα]
  have h2 := h1 hu
  have h3 : toPrincipalIdeal (𝓞 K) K u ∈ coprimeIdeals K m :=
    (Subgroup.closure_le _).mpr (rayGenerators_mem_coprimeIdeals K m) h2
  exact ⟨⟨_, h3⟩, h2, rfl⟩

/-- Ray elements have no prime-ideal factors at primes dividing their modulus. -/
theorem principal_mem_coprime_of_mem_rayElements (m : Ideal (𝓞 K))
    (u : Kˣ) (hu : u ∈ rayElements K m) :
    toPrincipalIdeal (𝓞 K) K u ∈ coprimeIdeals K m := by
  obtain ⟨x, _, hx⟩ := Subgroup.mem_map.mp (principal_mem_ray_of_mem_rayElements K m u hu)
  rw [← hx]
  exact x.2

end Cox.ClassFieldTheory
