import Mathlib.FieldTheory.Galois.Infinite
import Mathlib.FieldTheory.LinearDisjoint
import XYin.PhD.Cox.Theorem11_1.ClassFieldResidueIndependence

/-!
# The two-generator fixed field in Janusz V.5.5

The actual subgroup is the supremum of two cyclic subgroups. The actual field is its inverse image
under paired restriction, followed by `fixedField`. Cyclotomic choice, prime ramification, Frobenius
compatibility, and the final prime-splitting assertion remain separate obligations outside this
module.
-/

noncomputable section

namespace Cox.ClassFieldTheory.AuxiliaryFields

/-- Janusz V.5.5, printed161: the subgroup generated by the two displayed pairs. -/
def twoGeneratorGroup {G A : Type*} [Group G] [Group A]
    (σ ρ : G) (τ η : A) : Subgroup (G × A) :=
  Subgroup.zpowers (σ, τ) ⊔ Subgroup.zpowers (ρ, η)

/-- Janusz V.5.5, printed162: an element of H is a product of integer powers. -/
theorem mem_twoGeneratorGroup_iff {G A : Type*} [CommGroup G] [CommGroup A]
    (σ ρ : G) (τ η : A) (x : G × A) :
    x ∈ twoGeneratorGroup σ ρ τ η ↔ ∃ u v : ℤ, (σ, τ) ^ u * (ρ, η) ^ v = x := by
  unfold twoGeneratorGroup
  rw [Subgroup.mem_sup]
  constructor
  · rintro ⟨y, hy, z, hz, rfl⟩
    obtain ⟨u, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    obtain ⟨v, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
    exact ⟨u, v, rfl⟩
  · rintro ⟨u, v, rfl⟩
    exact ⟨_, Subgroup.zpow_mem_zpowers _ u, _, Subgroup.zpow_mem_zpowers _ v, rfl⟩

/-- Independence makes the first factor in an integer-power relation trivial. -/
theorem zpow_eq_one_of_relation {A : Type*} [Group A] (τ η : A)
    (h : Disjoint (Subgroup.zpowers τ) (Subgroup.zpowers η)) (u v : ℤ)
    (huv : τ ^ u * η ^ v = 1) : τ ^ u = 1 := by
  have h1 : τ ^ u = η ^ (-v) := by
    rw [zpow_neg, eq_inv_iff_mul_eq_one]
    exact huv
  rw [Subgroup.disjoint_def] at h
  exact h (Subgroup.zpow_mem_zpowers τ u)
    (by rw [h1]; exact Subgroup.zpow_mem_zpowers η (-v))

/-- Janusz V.5.5, printed162: H has trivial intersection with G × 1. -/
theorem twoGeneratorGroup_inf_ker_snd {G A : Type*} [CommGroup G] [CommGroup A]
    (σ ρ : G) (τ η : A) (hστ : orderOf σ ∣ orderOf τ)
    (hρη : orderOf ρ ∣ orderOf η)
    (h : Disjoint (Subgroup.zpowers τ) (Subgroup.zpowers η)) :
    twoGeneratorGroup σ ρ τ η ⊓ (MonoidHom.snd G A).ker = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  obtain ⟨hH, hK⟩ := Subgroup.mem_inf.mp hx
  obtain ⟨u, v, rfl⟩ := (mem_twoGeneratorGroup_iff σ ρ τ η x).mp hH
  rw [MonoidHom.mem_ker] at hK
  change τ ^ u * η ^ v = 1 at hK
  have hτ := zpow_eq_one_of_relation τ η h u v hK
  have hη : η ^ v = 1 := by rwa [hτ, one_mul] at hK
  have hσ := ResidueIndependence.zpow_eq_one_of_orderOf_dvd σ τ hστ u hτ
  have hρ := ResidueIndependence.zpow_eq_one_of_orderOf_dvd ρ η hρη v hη
  rw [Subgroup.mem_bot]
  ext <;> simp [hσ, hρ, hτ, hη]

/-- Janusz V.5.5, printed162: projection of H contains the generator σ. -/
theorem twoGeneratorGroup_map_fst {G A : Type*} [Group G] [Group A]
    (σ ρ : G) (τ η : A) (hσ : Subgroup.zpowers σ = ⊤) :
    (twoGeneratorGroup σ ρ τ η).map (MonoidHom.fst G A) = ⊤ := by
  rw [twoGeneratorGroup, Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]
  simp [hσ]

/-- The selected Frobenius pair is the second defining generator. -/
theorem second_mem_twoGeneratorGroup {G A : Type*} [Group G] [Group A]
    (σ ρ : G) (τ η : A) : (ρ, η) ∈ twoGeneratorGroup σ ρ τ η := by
  exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)

section Fields

variable {K M : Type*} [Field K] [Field M] [Algebra K M]

/-- Actual paired restriction to two normal intermediate fields. -/
def restrictionProd (L E : IntermediateField K M) [Normal K L] [Normal K E] :
    (M ≃ₐ[K] M) →* ((L ≃ₐ[K] L) × (E ≃ₐ[K] E)) :=
  (AlgEquiv.restrictNormalHom L).prod (AlgEquiv.restrictNormalHom E)

/-- First coordinate of paired restriction. -/
theorem restrictionProd_fst (L E : IntermediateField K M) [Normal K L] [Normal K E]
    (χ : M ≃ₐ[K] M) : (restrictionProd L E χ).1 = χ.restrictNormal L := by
  rfl

/-- Second coordinate of paired restriction. -/
theorem restrictionProd_snd (L E : IntermediateField K M) [Normal K L] [Normal K E]
    (χ : M ≃ₐ[K] M) : (restrictionProd L E χ).2 = χ.restrictNormal E := by
  rfl

/-- Automorphisms are determined on two intermediate fields generating the ambient field. -/
theorem restrictionProd_injective (L E : IntermediateField K M)
    [Normal K L] [Normal K E] (hSup : L ⊔ E = ⊤) :
    Function.Injective (restrictionProd L E) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro χ hχ
  rw [MonoidHom.mem_ker, Prod.ext_iff] at hχ
  have h1 : χ ∈ (AlgEquiv.restrictNormalHom L).ker := hχ.1
  have h2 : χ ∈ (AlgEquiv.restrictNormalHom E).ker := hχ.2
  rw [IntermediateField.restrictNormalHom_ker] at h1 h2
  have h3 : χ ∈ (L ⊔ E).fixingSubgroup := by
    rw [IntermediateField.fixingSubgroup_sup]
    exact ⟨h1, h2⟩
  rw [hSup, IntermediateField.fixingSubgroup_top] at h3
  exact h3

/-- Disjoint finite normal subfields admit independent restrictions from a Galois ambient field. -/
theorem restrictionProd_surjective [hfin : FiniteDimensional K M] [hgal : IsGalois K M]
    (L E : IntermediateField K M) [Normal K L] [Normal K E] (hInf : L ⊓ E = ⊥) :
    Function.Surjective (restrictionProd L E) := by
  rintro ⟨σ, τ⟩
  obtain ⟨χ, hχ⟩ := AlgEquiv.restrictNormalHom_surjective (F := K) (K₁ := L) M σ
  have hInf' : E ⊓ L = ⊥ := by rw [inf_comm]; exact hInf
  obtain ⟨ψ, hψ⟩ := IntermediateField.restrictRestrictAlgEquivMapHom_surjective E L hInf'
    (τ * (AlgEquiv.restrictNormalHom E χ)⁻¹)
  set ψ' : M ≃ₐ[K] M := MulSemiringAction.toAlgAut Gal(M/L) K M ψ
  have hψL : AlgEquiv.restrictNormalHom L ψ' = 1 := by
    rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker,
      IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact ψ.commutes ⟨x, hx⟩
  refine ⟨ψ' * χ, Prod.ext ?_ ?_⟩
  · change AlgEquiv.restrictNormalHom L (ψ' * χ) = σ
    rw [map_mul, hψL, one_mul, hχ]
  · change AlgEquiv.restrictNormalHom E (ψ' * χ) = τ
    rw [map_mul]
    change IntermediateField.restrictRestrictAlgEquivMapHom K E L M ψ *
      AlgEquiv.restrictNormalHom E χ = τ
    rw [hψ, inv_mul_cancel_right]

/-- Janusz V.5.5, printed161: the actual restriction is the direct-product isomorphism. -/
def restrictionEquiv [FiniteDimensional K M] [IsGalois K M]
    (L E : IntermediateField K M) [Normal K L] [Normal K E]
    (hSup : L ⊔ E = ⊤) (hInf : L ⊓ E = ⊥) :
    (M ≃ₐ[K] M) ≃* ((L ≃ₐ[K] L) × (E ≃ₐ[K] E)) :=
  MulEquiv.ofBijective (restrictionProd L E)
    ⟨restrictionProd_injective L E hSup, restrictionProd_surjective L E hInf⟩

/-- A trivial intersection with the restriction kernel makes the two fields generate M. -/
theorem fixedField_sup_eq_top_of_inf_ker_eq_bot
    [hfin : FiniteDimensional K M] [hgal : IsGalois K M]
    (E : IntermediateField K M) [Normal K E] (H : Subgroup (M ≃ₐ[K] M))
    (hH : H ⊓ (AlgEquiv.restrictNormalHom E).ker = ⊥) :
    IntermediateField.fixedField H ⊔ E = ⊤ := by
  rw [← IsGalois.fixedField_fixingSubgroup (IntermediateField.fixedField H ⊔ E),
    IntermediateField.fixingSubgroup_sup, IntermediateField.fixingSubgroup_fixedField,
    ← IntermediateField.restrictNormalHom_ker, hH, IntermediateField.fixedField_bot]

/-- Surjective restriction of a subgroup makes its fixed field disjoint from L. -/
theorem fixedField_inf_eq_bot_of_map_eq_top
    (L : IntermediateField K M) [hfin : FiniteDimensional K L] [hgal : IsGalois K L]
    (H : Subgroup (M ≃ₐ[K] M))
    (hH : H.map (AlgEquiv.restrictNormalHom L) = ⊤) :
    IntermediateField.fixedField H ⊓ L = ⊥ := by
  rw [InfiniteGalois.restrict_fixedField, hH, IsGalois.fixedField_top,
    IntermediateField.lift_bot]

/-- Janusz V.5.5: F is the actual fixed field of the pulled-back two-generator subgroup. -/
def auxiliaryFixedField (L E : IntermediateField K M) [Normal K L] [Normal K E]
    (σ ρ : L ≃ₐ[K] L) (τ η : E ≃ₐ[K] E) : IntermediateField K M :=
  IntermediateField.fixedField ((twoGeneratorGroup σ ρ τ η).comap (restrictionProd L E))

/-- Janusz V.5.5(iii): F E is the ambient compositum. -/
theorem auxiliaryFixedField_sup [hfin : FiniteDimensional K M] [hgal : IsGalois K M]
    (L E : IntermediateField K M) [Normal K L] [Normal K E]
    [hcommL : IsMulCommutative (L ≃ₐ[K] L)] [hcommE : IsMulCommutative (E ≃ₐ[K] E)]
    (hSup : L ⊔ E = ⊤) (σ ρ : L ≃ₐ[K] L) (τ η : E ≃ₐ[K] E)
    (hστ : orderOf σ ∣ orderOf τ) (hρη : orderOf ρ ∣ orderOf η)
    (h : Disjoint (Subgroup.zpowers τ) (Subgroup.zpowers η)) :
    auxiliaryFixedField L E σ ρ τ η ⊔ E = ⊤ := by
  unfold auxiliaryFixedField
  apply fixedField_sup_eq_top_of_inf_ker_eq_bot
  have hbot : twoGeneratorGroup σ ρ τ η ⊓ (MonoidHom.snd (L ≃ₐ[K] L) (E ≃ₐ[K] E)).ker = ⊥ := by
    open scoped IsMulCommutative in
    exact twoGeneratorGroup_inf_ker_snd σ ρ τ η hστ hρη h
  rw [eq_bot_iff]
  intro χ hχ
  obtain ⟨hH, hK⟩ := Subgroup.mem_inf.mp hχ
  have h1 : restrictionProd L E χ ∈
      twoGeneratorGroup σ ρ τ η ⊓ (MonoidHom.snd (L ≃ₐ[K] L) (E ≃ₐ[K] E)).ker :=
    Subgroup.mem_inf.mpr ⟨hH, hK⟩
  rw [hbot, Subgroup.mem_bot, ← map_one (restrictionProd L E)] at h1
  rw [Subgroup.mem_bot]
  exact restrictionProd_injective L E hSup h1

/-- Janusz V.5.5(i): F has trivial intersection with the original cyclic field. -/
theorem auxiliaryFixedField_inf [hfin : FiniteDimensional K M] [hgal : IsGalois K M]
    (L E : IntermediateField K M) [Normal K L] [Normal K E]
    (hInf : L ⊓ E = ⊥) (σ ρ : L ≃ₐ[K] L) (τ η : E ≃ₐ[K] E)
    (hσ : Subgroup.zpowers σ = ⊤) :
    auxiliaryFixedField L E σ ρ τ η ⊓ L = ⊥ := by
  have hsurj := restrictionProd_surjective L E hInf
  haveI : IsGalois K L := ⟨⟩
  unfold auxiliaryFixedField
  apply fixedField_inf_eq_bot_of_map_eq_top
  have hfac : AlgEquiv.restrictNormalHom L =
      (MonoidHom.fst _ _).comp (restrictionProd L E) := rfl
  rw [hfac, ← Subgroup.map_map, Subgroup.map_comap_eq_self_of_surjective hsurj,
    twoGeneratorGroup_map_fst σ ρ τ η hσ]

/-- Janusz V.5.5: an automorphism restricting to the Frobenius pair fixes F. -/
theorem mem_fixingSubgroup_auxiliaryFixedField (L E : IntermediateField K M)
    [Normal K L] [Normal K E] (σ ρ : L ≃ₐ[K] L) (τ η : E ≃ₐ[K] E)
    (χ : M ≃ₐ[K] M) (hχ : restrictionProd L E χ = (ρ, η)) :
    χ ∈ (auxiliaryFixedField L E σ ρ τ η).fixingSubgroup := by
  have hmem : χ ∈ (twoGeneratorGroup σ ρ τ η).comap (restrictionProd L E) := by
    rw [Subgroup.mem_comap, hχ]
    exact second_mem_twoGeneratorGroup σ ρ τ η
  exact ((IntermediateField.le_iff_le _ _).mp le_rfl) hmem

end Fields
end Cox.ClassFieldTheory.AuxiliaryFields
