import XYin.PhD.Cox.Theorem11_1.ClassFieldDefs
import XYin.PhD.Cox.Theorem11_1.OrderForms
import Mathlib.RingTheory.FractionalIdeal.Extended
import Mathlib.GroupTheory.MonoidLocalization.GrothendieckGroup

/-! # Cox's prime-to-conductor ideal-class quotient

The order is not assumed to be Dedekind. Cox 7.17–7.23 first restricts to
invertible ideals prime to the conductor, then extends them to the maximal order.
-/

open NumberField
open scoped nonZeroDivisors

noncomputable section
namespace Cox.Order

variable {K : IntermediateField ℚ ℂ} [hNF : NumberField K]
variable (O : Subalgebra ℤ K) [hO : IsOrder O] [hIQ : IsImaginaryQuadraticField K]
include hNF hO hIQ

/-- Cox p.143: the nonzero integral ideals prime to the conductor, in `I(O)`. -/
def orderCoprimeGenerators : Set (FractionalIdeal O⁰ K)ˣ :=
  {u | ∃ a : Ideal O, a ≠ ⊥ ∧ IsPrimeToConductor O a ∧
    (u : FractionalIdeal O⁰ K) = a}

/-- Cox p.143: the subgroup `I(O,f)` generated by good integral ideals. -/
def orderCoprimeIdeals : Subgroup (FractionalIdeal O⁰ K)ˣ :=
  Subgroup.closure (orderCoprimeGenerators O)

/-- Cox p.143: integral principal ideals with norm prime to the conductor. -/
def orderPrincipalGenerators : Set (FractionalIdeal O⁰ K)ˣ :=
  {u | ∃ α : O, α ≠ 0 ∧ (elementNorm O α).Coprime (conductor O) ∧
    (u : FractionalIdeal O⁰ K) = FractionalIdeal.spanSingleton O⁰ (α : K)}

/-- Cox p.143: the subgroup `P(O,f)` inside `I(O,f)`. -/
def orderPrincipalIdeals : Subgroup (orderCoprimeIdeals O) :=
  (Subgroup.closure (orderPrincipalGenerators O)).comap (orderCoprimeIdeals O).subtype

-- The unused section instances are kept: the planned signature includes them.
set_option linter.unusedSectionVars false in
/-- Cox p.143: the unit ideal is prime to every conductor. -/
theorem one_mem_orderCoprimeGenerators : 1 ∈ orderCoprimeGenerators O := by
  refine ⟨⊤, top_ne_bot, ?_, ?_⟩
  · rw [IsPrimeToConductor, idealNorm]
    haveI : Subsingleton (O ⧸ (⊤ : Ideal O)) := Ideal.Quotient.subsingleton_iff.mpr rfl
    rw [Nat.card_of_subsingleton (0 : O ⧸ (⊤ : Ideal O))]
    exact Nat.coprime_one_left _
  · rw [Units.val_one, FractionalIdeal.coeIdeal_top]

/-- Cox p.143, using 7.14(ii): good integral ideals are closed under product. -/
theorem mul_mem_orderCoprimeGenerators {u v : (FractionalIdeal O⁰ K)ˣ}
    (hu : u ∈ orderCoprimeGenerators O) (hv : v ∈ orderCoprimeGenerators O) :
    u * v ∈ orderCoprimeGenerators O := by
  obtain ⟨a, ha0, hap, hua⟩ := hu
  obtain ⟨b, hb0, hbp, hvb⟩ := hv
  have hau : IsUnit (a : FractionalIdeal O⁰ K) := hua ▸ u.isUnit
  have hbu : IsUnit (b : FractionalIdeal O⁰ K) := hvb ▸ v.isUnit
  refine ⟨a * b, mul_ne_zero ha0 hb0, ?_, ?_⟩
  · rw [IsPrimeToConductor, idealNorm_mul O a b hau hbu]
    exact Nat.coprime_mul_iff_left.mpr ⟨hap, hbp⟩
  · rw [Units.val_mul, hua, hvb, FractionalIdeal.coeIdeal_mul]

-- The unused section instances are kept: the planned signature includes them.
set_option linter.unusedSectionVars false in
/-- Cox p.143: principal generators are among the good integral generators. -/
theorem orderPrincipalGenerators_subset :
    orderPrincipalGenerators O ⊆ orderCoprimeGenerators O := by
  rintro u ⟨α, hα, hcop, hu⟩
  refine ⟨Ideal.span {α}, by rwa [Ne, Ideal.span_singleton_eq_bot], ?_, ?_⟩
  · rw [IsPrimeToConductor, idealNorm_span_singleton]
    exact hcop
  · rw [hu, FractionalIdeal.coeIdeal_span_singleton]
    rfl

/-- Cox 7.19, pp.143–144: write a fractional good ideal as a quotient of two integral ones. -/
theorem exists_orderCoprime_quotient (u : orderCoprimeIdeals O) :
    ∃ a b : (FractionalIdeal O⁰ K)ˣ,
      a ∈ orderCoprimeGenerators O ∧ b ∈ orderCoprimeGenerators O ∧
      (u : (FractionalIdeal O⁰ K)ˣ) = a / b := by
  have hu : (u : (FractionalIdeal O⁰ K)ˣ) ∈ Subgroup.closure (orderCoprimeGenerators O) := u.2
  generalize (u : (FractionalIdeal O⁰ K)ˣ) = x at hu ⊢
  induction hu using Subgroup.closure_induction with
  | mem x hx => exact ⟨x, 1, hx, one_mem_orderCoprimeGenerators O, (div_one x).symm⟩
  | one => exact ⟨1, 1, one_mem_orderCoprimeGenerators O, one_mem_orderCoprimeGenerators O,
      (div_one 1).symm⟩
  | mul x y _ _ hx hy =>
    obtain ⟨a, b, ha, hb, rfl⟩ := hx
    obtain ⟨c, d, hc, hd, rfl⟩ := hy
    exact ⟨a * c, b * d, mul_mem_orderCoprimeGenerators O ha hc,
      mul_mem_orderCoprimeGenerators O hb hd, div_mul_div_comm a b c d⟩
  | inv x _ hx =>
    obtain ⟨a, b, ha, hb, rfl⟩ := hx
    exact ⟨b, a, hb, ha, inv_div a b⟩

/-- Cox 7.19: restriction of the ordinary ideal-class homomorphism. -/
def orderCoprimeClassMap : orderCoprimeIdeals O →* ClassGroup O :=
  (ClassGroup.mk K).comp (orderCoprimeIdeals O).subtype

-- The unused section instances are kept: the planned signature includes them.
set_option linter.unusedSectionVars false in
/-- Cox 7.19: the restricted map still sends an ideal to its ordinary class. -/
theorem orderCoprimeClassMap_apply (u : orderCoprimeIdeals O) :
    orderCoprimeClassMap O u = idealClass O u := by
  rfl

/-- Cox 7.17, p.142: every ideal class has a good integral representative. -/
theorem exists_coprime_ideal_representative (c : ClassGroup O) :
    ∃ a : Ideal O, ∃ ha : IsUnit (a : FractionalIdeal O⁰ K),
      IsPrimeToConductor O a ∧ idealClass O (integralIdealUnit O a ha) = c := by
  refine ClassGroup.induction (K := K) (fun I => ?_) c
  obtain ⟨α, τ, A, B, C, hA, hlin, hq, hprim, hcoord⟩ := exists_positive_normalized_relation O I
  obtain ⟨x, y, hxy, hcop⟩ := BinaryQuadratic.exists_proper_coprime_value A B C hprim
    (conductor O) (conductor_pos O).ne'
  obtain ⟨a, ha, hcls, hnorm⟩ := exists_ideal_norm_of_proper_representation O I α τ A B C hA
    hlin hq hprim hcoord x y hxy
  refine ⟨a, ha, ?_, hcls⟩
  rw [IsPrimeToConductor, hnorm]
  exact hcop

/-- Cox 7.19: surjectivity is precisely the representative assertion 7.17. -/
theorem orderCoprimeClassMap_surjective :
    Function.Surjective (orderCoprimeClassMap O) := by
  intro c
  obtain ⟨a, ha, hap, hcls⟩ := exists_coprime_ideal_representative O c
  have ha0 : a ≠ ⊥ := fun h => by
    rw [h, FractionalIdeal.coeIdeal_bot] at ha
    exact not_isUnit_zero ha
  refine ⟨⟨integralIdealUnit O a ha,
    Subgroup.subset_closure ⟨a, ha0, hap, coe_integralIdealUnit O a ha⟩⟩, ?_⟩
  rw [orderCoprimeClassMap_apply]
  exact hcls

/-- Cox 7.19, p.144: if `αO·b = a` for good integral ideals, then `N(b)α` is an integral
generator whose norm is prime to the conductor. -/
theorem exists_integral_generator_of_principal_quotient (α : Kˣ) (a₀ b₀ : Ideal O)
    (hau : IsUnit (a₀ : FractionalIdeal O⁰ K)) (hbu : IsUnit (b₀ : FractionalIdeal O⁰ K))
    (hb0 : b₀ ≠ ⊥) (hap : IsPrimeToConductor O a₀) (hbp : IsPrimeToConductor O b₀)
    (h : FractionalIdeal.spanSingleton O⁰ (α : K) * b₀ = a₀) :
    ∃ β : O, β ≠ 0 ∧ (elementNorm O β).Coprime (conductor O) ∧
      (β : K) = (α : K) * (idealNorm O b₀ : K) := by
  obtain ⟨σ, hσ⟩ := exists_conjugation O
  obtain ⟨c₀, hbb⟩ : ∃ c₀ : Ideal O, b₀ * c₀ = Ideal.span {(idealNorm O b₀ : O)} :=
    ⟨_, ideal_mul_conjugate O b₀ hbu σ hσ⟩
  have hbp' : (idealNorm O b₀).Coprime (conductor O) := hbp
  have hm0 : idealNorm O b₀ ≠ 0 := (idealNorm_pos O b₀ hb0).ne'
  have hnc : idealNorm O b₀ * idealNorm O c₀ = idealNorm O b₀ ^ 2 := by
    have hcu : IsUnit (c₀ : FractionalIdeal O⁰ K) := by
      apply isUnit_of_mul_isUnit_right (x := (b₀ : FractionalIdeal O⁰ K))
      rw [← FractionalIdeal.coeIdeal_mul, hbb]
      have hu := (toPrincipalIdeal O K
        (Units.mk0 ((idealNorm O b₀ : ℕ) : K) (Nat.cast_ne_zero.mpr hm0))).isUnit
      rw [coe_toPrincipalIdeal, Units.val_mk0] at hu
      rwa [FractionalIdeal.coeIdeal_span_singleton, map_natCast]
    rw [← idealNorm_mul O b₀ c₀ hbu hcu, hbb, idealNorm_span_natCast]
  obtain ⟨m, hm⟩ : ∃ m : ℕ, idealNorm O b₀ = m := ⟨_, rfl⟩
  rw [hm] at hbb hbp' hm0 hnc ⊢
  have hmK : ((m : ℕ) : K) ≠ 0 := Nat.cast_ne_zero.mpr hm0
  have hcu : IsUnit (c₀ : FractionalIdeal O⁰ K) := by
    apply isUnit_of_mul_isUnit_right (x := (b₀ : FractionalIdeal O⁰ K))
    rw [← FractionalIdeal.coeIdeal_mul, hbb]
    have hu := (toPrincipalIdeal O K (Units.mk0 ((m : ℕ) : K) hmK)).isUnit
    rw [coe_toPrincipalIdeal, Units.val_mk0] at hu
    rwa [FractionalIdeal.coeIdeal_span_singleton, map_natCast]
  have hccop : (idealNorm O c₀).Coprime (conductor O) :=
    Nat.Coprime.coprime_dvd_left (Dvd.intro_left _ hnc) (Nat.Coprime.pow_left 2 hbp')
  have key : (a₀ : FractionalIdeal O⁰ K) * c₀ =
      FractionalIdeal.spanSingleton O⁰ ((α : K) * (m : K)) := by
    rw [← h, mul_assoc, ← FractionalIdeal.coeIdeal_mul, hbb,
      FractionalIdeal.coeIdeal_span_singleton, FractionalIdeal.spanSingleton_mul_spanSingleton,
      map_natCast]
  have hmem : (α : K) * (m : K) ∈ ((a₀ * c₀ : Ideal O) : FractionalIdeal O⁰ K) := by
    rw [FractionalIdeal.coeIdeal_mul, key]
    exact FractionalIdeal.mem_spanSingleton_self _ _
  obtain ⟨β, -, hβ⟩ := (FractionalIdeal.mem_coeIdeal O⁰).mp hmem
  have hβK : (β : K) = (α : K) * m := hβ
  have hβ0 : β ≠ 0 := by
    rintro rfl
    exact mul_ne_zero α.ne_zero hmK (by rw [← hβK]; rfl)
  have hspan : Ideal.span {β} = a₀ * c₀ := by
    apply FractionalIdeal.coeIdeal_injective (K := K)
    beta_reduce
    rw [FractionalIdeal.coeIdeal_mul, key, FractionalIdeal.coeIdeal_span_singleton, hβ]
  refine ⟨β, hβ0, ?_, hβK⟩
  rw [← idealNorm_span_singleton, hspan, idealNorm_mul O a₀ c₀ hau hcu]
  exact Nat.coprime_mul_iff_left.mpr ⟨hap, hccop⟩

/-- Cox 7.19, p.144: clear the denominator of a principal fractional good ideal. -/
theorem principal_mem_orderPrincipal_closure (u : orderCoprimeIdeals O)
    (hu : ClassGroup.mk K (u : (FractionalIdeal O⁰ K)ˣ) = 1) :
    (u : (FractionalIdeal O⁰ K)ˣ) ∈ Subgroup.closure (orderPrincipalGenerators O) := by
  obtain ⟨α, hα⟩ := (idealClass_eq_iff_exists_principal O 1 (u : (FractionalIdeal O⁰ K)ˣ)).mp
    (by change ClassGroup.mk K 1 = ClassGroup.mk K _; rw [map_one, hu])
  rw [one_mul] at hα
  obtain ⟨a, b, ⟨a₀, -, hap, hua⟩, ⟨b₀, hb0, hbp, hvb⟩, hab⟩ := exists_orderCoprime_quotient O u
  have hA : a = (u : (FractionalIdeal O⁰ K)ˣ) * b := (eq_div_iff_mul_eq'.mp hab).symm
  have h : FractionalIdeal.spanSingleton O⁰ (α : K) * b₀ = a₀ := by
    rw [← hua, hA, Units.val_mul, ← hα, coe_toPrincipalIdeal, hvb]
  have hau : IsUnit (a₀ : FractionalIdeal O⁰ K) := by
    rw [← hua]
    exact a.isUnit
  have hbu : IsUnit (b₀ : FractionalIdeal O⁰ K) := by
    rw [← hvb]
    exact b.isUnit
  obtain ⟨β, hβ0, hβcop, hβK⟩ :=
    exists_integral_generator_of_principal_quotient O α a₀ b₀ hau hbu hb0 hap hbp h
  have hm0 : idealNorm O b₀ ≠ 0 := (idealNorm_pos O b₀ hb0).ne'
  have hmK : ((idealNorm O b₀ : ℕ) : K) ≠ 0 := Nat.cast_ne_zero.mpr hm0
  have hβ0K : (β : K) ≠ 0 := by
    rw [hβK]
    exact mul_ne_zero α.ne_zero hmK
  have hmO : ((idealNorm O b₀ : ℕ) : O) ≠ 0 := by
    intro h0
    apply hmK
    have h' := congrArg (algebraMap O K) h0
    rwa [map_natCast, map_zero] at h'
  have hmcop : (elementNorm O (idealNorm O b₀ : O)).Coprime (conductor O) := by
    rw [← idealNorm_span_singleton, idealNorm_span_natCast]
    exact Nat.Coprime.pow_left 2 hbp
  have hfinal : (u : (FractionalIdeal O⁰ K)ˣ) =
      toPrincipalIdeal O K (Units.mk0 (β : K) hβ0K) *
        (toPrincipalIdeal O K (Units.mk0 ((idealNorm O b₀ : ℕ) : K) hmK))⁻¹ := by
    rw [← hα, ← map_inv, ← map_mul]
    congr 1
    ext
    rw [Units.val_mul, Units.val_mk0, Units.val_inv_eq_inv_val, Units.val_mk0, hβK]
    field_simp
  rw [hfinal]
  refine Subgroup.mul_mem _ (Subgroup.subset_closure ⟨β, hβ0, hβcop, ?_⟩)
    (Subgroup.inv_mem _ (Subgroup.subset_closure ⟨(idealNorm O b₀ : O), hmO, hmcop, ?_⟩))
  · rw [coe_toPrincipalIdeal, Units.val_mk0]
  · rw [coe_toPrincipalIdeal, Units.val_mk0]
    simp

/-- Cox 7.19: the kernel consists exactly of the prime-to-conductor principal ideals. -/
theorem orderCoprimeClassMap_ker :
    (orderCoprimeClassMap O).ker = orderPrincipalIdeals O := by
  ext u
  rw [MonoidHom.mem_ker]
  constructor
  · exact principal_mem_orderPrincipal_closure O u
  · intro hu
    change (u : (FractionalIdeal O⁰ K)ˣ) ∈ Subgroup.closure (orderPrincipalGenerators O) at hu
    have hle : Subgroup.closure (orderPrincipalGenerators O) ≤ (ClassGroup.mk K).ker := by
      refine (Subgroup.closure_le _).mpr fun v ⟨α, _, _, hv⟩ => ?_
      rw [SetLike.mem_coe, MonoidHom.mem_ker, ClassGroup.mk_eq_one_iff]
      exact ⟨⟨(α : K), by rw [hv, FractionalIdeal.coe_spanSingleton]⟩⟩
    exact hle hu

/-- Cox 7.19: quotient by that kernel recovers the ordinary ideal class group. -/
theorem classGroup_equiv_orderCoprimeQuotient :
    Nonempty (ClassGroup O ≃* (orderCoprimeIdeals O ⧸ orderPrincipalIdeals O)) := by
  exact ⟨((QuotientGroup.quotientMulEquivOfEq (orderCoprimeClassMap_ker O)).symm.trans
    (QuotientGroup.quotientKerEquivOfSurjective _ (orderCoprimeClassMap_surjective O))).symm⟩

/-- Cox 7.20: extension to `O_K`, using the existing fractional-ideal extension map. -/
def extendFractional : (FractionalIdeal O⁰ K)ˣ →* (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  Units.map (FractionalIdeal.extendedHom' (M := O⁰) (N := (𝓞 K)⁰) (K := K) K
    (f := toRingOfIntegers O)
    (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
      (toRingOfIntegers_injective O))).toMonoidHom

-- The unused section instances are kept: the planned signature includes them.
set_option linter.unusedSectionVars false in
/-- Cox 7.20(ii): on integral ideals the extension is the ordinary ideal map. -/
theorem extendFractional_integral (u : (FractionalIdeal O⁰ K)ˣ) (a : Ideal O)
    (hu : (u : FractionalIdeal O⁰ K) = a) :
    (extendFractional O u : FractionalIdeal (𝓞 K)⁰ K) = extendIdeal O a := by
  change FractionalIdeal.extended K _ (u : FractionalIdeal O⁰ K) = _
  rw [hu, FractionalIdeal.extended_coeIdeal_eq_map]
  rfl

-- The unused section instances are kept: the planned signature includes them.
set_option linter.unusedSectionVars false in
/-- Cox 7.22, p.145: extension of a principal ideal preserves its generator. -/
theorem extendFractional_principal (α : Kˣ) :
    extendFractional O (toPrincipalIdeal O K α) = toPrincipalIdeal (𝓞 K) K α := by
  have hf := nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
    (toRingOfIntegers_injective O)
  have hmap : ∀ x : K, IsLocalization.map (M := O⁰) (T := (𝓞 K)⁰) K
      (toRingOfIntegers O) hf x = x := by
    have h : IsLocalization.map (M := O⁰) (T := (𝓞 K)⁰) K (toRingOfIntegers O) hf =
        RingHom.id K :=
      IsLocalization.ringHom_ext O⁰ (RingHom.ext fun a => by
        rw [RingHom.comp_apply, IsLocalization.map_eq]
        rfl)
    exact fun x => by rw [h, RingHom.id_apply]
  ext1
  change FractionalIdeal.extended K _ ((toPrincipalIdeal O K α : FractionalIdeal O⁰ K)) = _
  rw [coe_toPrincipalIdeal, coe_toPrincipalIdeal]
  apply FractionalIdeal.coeToSubmodule_injective
  beta_reduce
  rw [FractionalIdeal.coe_extended_eq_span, FractionalIdeal.coe_spanSingleton]
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨x, hx, rfl⟩
    rw [SetLike.mem_coe, FractionalIdeal.mem_spanSingleton] at hx
    obtain ⟨o, rfl⟩ := hx
    rw [hmap, SetLike.mem_coe, Submodule.mem_span_singleton]
    exact ⟨toRingOfIntegers O o, rfl⟩
  · rw [Submodule.span_le, Set.singleton_subset_iff]
    exact Submodule.subset_span ⟨(α : K), FractionalIdeal.mem_spanSingleton_self _ _, hmap _⟩

/-- Cox 7.20(i): contraction provides a preimage for each good integral maximal-order ideal. -/
theorem exists_orderCoprime_generator_preimage
    (v : (FractionalIdeal (𝓞 K)⁰ K)ˣ) (hv : v ∈ conductorCoprimeGenerators O) :
    ∃ u ∈ orderCoprimeGenerators O, extendFractional O u = v := by
  obtain ⟨A, hA0, hAsup, hvA⟩ := hv
  have hcop : (Nat.card ((𝓞 K) ⧸ A)).Coprime (conductor O) := by
    have hfin : Finite ((𝓞 K) ⧸ A) := Ideal.finiteQuotientOfFreeOfNeBot A hA0
    exact (OrderCoprimality.sup_span_natCast_eq_top_iff_coprime_card A (conductor O)).mp hAsup
  have hp := isPrimeToConductor_contract O A hcop
  have ha0 : contractIdeal O A ≠ ⊥ := by
    intro h
    apply hA0
    rw [← extend_contract O A hcop, h, extendIdeal, Ideal.map_bot]
  have hunit := isUnit_of_isPrimeToConductor O _ hp ha0
  refine ⟨integralIdealUnit O _ hunit, ⟨_, ha0, hp, coe_integralIdealUnit O _ hunit⟩, ?_⟩
  ext1
  rw [extendFractional_integral O _ _ (coe_integralIdealUnit O _ hunit),
    extend_contract O A hcop, hvA]

/-- Cox 7.20(ii): extension preserves the prime-to-conductor subgroup. -/
theorem extendFractional_mem {u : (FractionalIdeal O⁰ K)ˣ}
    (hu : u ∈ orderCoprimeIdeals O) :
    extendFractional O u ∈ conductorCoprimeIdeals O := by
  have hle : orderCoprimeIdeals O ≤ (conductorCoprimeIdeals O).comap (extendFractional O) := by
    refine (Subgroup.closure_le _).mpr fun w ⟨a, ha0, hap, hwa⟩ => ?_
    refine mem_conductorCoprimeIdeals_of_generator O
      ⟨extendIdeal O a, ?_, ?_, extendFractional_integral O w a hwa⟩
    · rwa [extendIdeal, Ne, Ideal.map_eq_bot_iff_of_injective (toRingOfIntegers_injective O)]
    · have h := congrArg (Ideal.map (toRingOfIntegers O))
        ((isPrimeToConductor_iff_sup O a ha0).mp hap)
      rwa [Ideal.map_sup, Ideal.map_span, Set.image_singleton, map_natCast, Ideal.map_top] at h
  exact hle hu

/-- Cox 7.20(iii): restrict extension to the two good-ideal groups. -/
def orderCoprimeExtension : orderCoprimeIdeals O →* conductorCoprimeIdeals O :=
  ((extendFractional O).comp (orderCoprimeIdeals O).subtype).codRestrict _
    (fun u => extendFractional_mem O u.property)

/-- Cox 7.20(iii): the restricted map has the stated ambient value. -/
theorem orderCoprimeExtension_coe (u : orderCoprimeIdeals O) :
    ((orderCoprimeExtension O u : conductorCoprimeIdeals O) :
      (FractionalIdeal (𝓞 K)⁰ K)ˣ) = extendFractional O u := by
  rfl

/-- Cox (7.21): contraction recovers each integral generator, hence gives injectivity. -/
theorem orderCoprimeExtension_injective :
    Function.Injective (orderCoprimeExtension O) := by
  refine (injective_iff_map_eq_one _).mpr fun u hu => ?_
  obtain ⟨a, b, ⟨a₀, ha0, hap, hua⟩, ⟨b₀, hb0, hbp, hvb⟩, hab⟩ := exists_orderCoprime_quotient O u
  have h1 : extendFractional O (u : (FractionalIdeal O⁰ K)ˣ) = 1 := by
    rw [← orderCoprimeExtension_coe, hu]
    rfl
  rw [hab, map_div, div_eq_one] at h1
  have h2 : extendIdeal O a₀ = extendIdeal O b₀ := by
    apply FractionalIdeal.coeIdeal_injective (K := K)
    beta_reduce
    rw [← extendFractional_integral O a a₀ hua, ← extendFractional_integral O b b₀ hvb, h1]
  have h3 : a₀ = b₀ := by rw [← contract_extend O a₀ hap, h2, contract_extend O b₀ hbp]
  apply Subtype.ext
  rw [hab, OneMemClass.coe_one, div_eq_one]
  ext1
  rw [hua, hvb, h3]

/-- Cox 7.20(iii): integral-generator surjectivity extends to the generated groups. -/
theorem orderCoprimeExtension_surjective :
    Function.Surjective (orderCoprimeExtension O) := by
  have hle : conductorCoprimeIdeals O ≤ (orderCoprimeIdeals O).map (extendFractional O) := by
    refine (Subgroup.closure_le _).mpr fun v hv => ?_
    obtain ⟨u, hu, huv⟩ := exists_orderCoprime_generator_preimage O v hv
    exact ⟨u, Subgroup.subset_closure hu, huv⟩
  intro v
  obtain ⟨u, hu, huv⟩ := hle v.2
  exact ⟨⟨u, hu⟩, Subtype.ext huv⟩

/-- Cox 7.20(iii): the isomorphism between the prime-to-conductor groups. -/
def orderCoprimeEquiv : orderCoprimeIdeals O ≃* conductorCoprimeIdeals O :=
  MulEquiv.ofBijective (orderCoprimeExtension O)
    ⟨orderCoprimeExtension_injective O, orderCoprimeExtension_surjective O⟩

/-- Cox (7.23), p.146: norms of rational-residue elements are square residues modulo `f`. -/
theorem elementNorm_congr_int (α : O) (a : ℤ)
    (hα : toRingOfIntegers O α - (a : 𝓞 K) ∈ conductorIdeal O) :
    Int.ModEq (conductor O) (elementNorm O α : ℤ) (a ^ 2) := by
  obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp hα
  have hαK : (α : K) = a + (conductor O : K) * (β : K) := by
    have h := congrArg (algebraMap (𝓞 K) K) hβ
    rw [map_mul, map_sub, map_natCast, map_intCast] at h
    change (β : K) * (conductor O : K) = (α : K) - a at h
    linear_combination -h
  obtain ⟨⟨t, ht⟩, ⟨n, hn⟩⟩ := (isIntegral_iff_trace_norm_int (β : K)).mp
    (RingOfIntegers.isIntegral_coe β)
  have hαC : ((α : K) : ℂ) = (a : ℂ) + (conductor O : ℂ) * ((β : K) : ℂ) := by
    rw [hαK]
    push_cast
    rfl
  have hβstar : star ((β : K) : ℂ) = (t : ℂ) - ((β : K) : ℂ) := by
    rw [star_coe_eq_trace_sub, ht]
    push_cast
    rfl
  have hstarα : star ((α : K) : ℂ) = (a : ℂ) + (conductor O : ℂ) * star ((β : K) : ℂ) := by
    rw [hαC, star_add, star_mul', star_intCast, star_natCast]
  have hnC : (n : ℂ) = ((β : K) : ℂ) * ((t : ℂ) - ((β : K) : ℂ)) := by
    rw [← hβstar, ← fieldNorm_eq_mul_conj, hn]
    push_cast
    rfl
  have hNC : ((elementNorm O α : ℤ) : ℂ) =
      (a : ℂ) ^ 2 + (conductor O : ℂ) * ((a : ℂ) * t + (conductor O : ℂ) * n) := by
    have h1 : ((elementNorm O α : ℚ) : ℂ) = ((α : K) : ℂ) * star ((α : K) : ℂ) := by
      rw [elementNorm_eq_fieldNorm, fieldNorm_eq_mul_conj]
    have h2 : ((elementNorm O α : ℤ) : ℂ) = ((elementNorm O α : ℚ) : ℂ) := by norm_cast
    rw [h2, h1, hstarα, hβstar, hαC, hnC]
    ring
  have hZ : (elementNorm O α : ℤ) = a ^ 2 + conductor O * (a * t + conductor O * n) := by
    exact_mod_cast hNC
  rw [hZ, Int.modEq_iff_dvd]
  exact ⟨-(a * t + conductor O * n), by ring⟩

/-- Cox (7.23): the rational-residue condition equals membership in the order with good norm. -/
theorem rational_residue_iff_order_norm (α : 𝓞 K) :
    (∃ a : ℤ, a.natAbs.Coprime (conductor O) ∧
      α - (a : 𝓞 K) ∈ conductorIdeal O) ↔
    ∃ β : O, toRingOfIntegers O β = α ∧
      (elementNorm O β).Coprime (conductor O) := by
  constructor
  · rintro ⟨a, ha, hαa⟩
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hαa
    have hmem : (α : K) ∈ O := by
      rw [mem_iff_int_add_conductor]
      refine ⟨a, b, ?_⟩
      have h := congrArg (algebraMap (𝓞 K) K) hb
      rw [map_mul, map_sub, map_natCast, map_intCast] at h
      change (b : K) * (conductor O : K) = (α : K) - a at h
      linear_combination -h
    refine ⟨⟨α, hmem⟩, rfl, ?_⟩
    obtain ⟨k, hk⟩ := Int.modEq_iff_dvd.mp (elementNorm_congr_int O ⟨α, hmem⟩ a hαa)
    have h1 : (elementNorm O ⟨α, hmem⟩ : ℤ) = a ^ 2 + (conductor O : ℤ) * -k := by
      linear_combination -hk
    have hac : IsCoprime a (conductor O : ℤ) := Int.isCoprime_iff_gcd_eq_one.mpr ha
    have : IsCoprime (elementNorm O ⟨α, hmem⟩ : ℤ) (conductor O : ℤ) := by
      rw [h1]
      exact hac.pow_left.add_mul_left_left _
    exact Nat.isCoprime_iff_coprime.mp this
  · rintro ⟨β, rfl, hβ⟩
    obtain ⟨a, b, hab⟩ := (mem_iff_int_add_conductor O (β : K)).mp β.2
    have hαa : toRingOfIntegers O β - (a : 𝓞 K) ∈ conductorIdeal O := by
      refine Ideal.mem_span_singleton'.mpr ⟨b, ?_⟩
      apply RingOfIntegers.coe_injective
      change (b : K) * (conductor O : K) = (β : K) - a
      rw [hab]
      ring
    refine ⟨a, ?_, hαa⟩
    obtain ⟨k, hk⟩ := Int.modEq_iff_dvd.mp (elementNorm_congr_int O β a hαa)
    have hcop : IsCoprime (elementNorm O β : ℤ) (conductor O : ℤ) :=
      Nat.isCoprime_iff_coprime.mpr hβ
    have h1 : a ^ 2 = (elementNorm O β : ℤ) + (conductor O : ℤ) * k := by
      linear_combination hk
    have : IsCoprime (a ^ 2) (conductor O : ℤ) := by
      rw [h1]
      exact hcop.add_mul_left_left k
    exact Int.isCoprime_iff_gcd_eq_one.mp ((IsCoprime.pow_left_iff two_pos).mp this)

/-- Cox 7.22, p.146: corresponding principal generators generate corresponding subgroups. -/
theorem orderCoprimeEquiv_map_principal :
    (orderPrincipalIdeals O).map (orderCoprimeEquiv O).toMonoidHom =
      rationalPrincipalIdeals O := by
  have himage : extendFractional O '' orderPrincipalGenerators O =
      rationalPrincipalGenerators O := by
    ext v
    constructor
    · rintro ⟨u, ⟨α, hα0, hcop, hu⟩, rfl⟩
      have hαK : (α : K) ≠ 0 := fun h => hα0 (Subtype.ext h)
      have hu' : u = toPrincipalIdeal O K (Units.mk0 (α : K) hαK) :=
        Units.ext (by rw [hu, coe_toPrincipalIdeal, Units.val_mk0])
      refine ⟨toRingOfIntegers O α, ?_, (rational_residue_iff_order_norm O _).mpr
        ⟨α, rfl, hcop⟩, ?_⟩
      · exact fun h => hα0 (toRingOfIntegers_injective O (h.trans (map_zero _).symm))
      · rw [hu', extendFractional_principal, coe_toPrincipalIdeal, Units.val_mk0]
        rfl
    · rintro ⟨α', -, hres, hv⟩
      obtain ⟨β, hβ, hcop⟩ := (rational_residue_iff_order_norm O α').mp hres
      have hα'0 : (α' : K) ≠ 0 := by
        intro h
        have h' : (v : FractionalIdeal (𝓞 K)⁰ K) = 0 := by
          rw [hv, h, FractionalIdeal.spanSingleton_zero]
        exact v.ne_zero h'
      have hβK : (β : K) ≠ 0 := by
        rw [← toRingOfIntegers_coe, hβ]
        exact hα'0
      refine ⟨toPrincipalIdeal O K (Units.mk0 (β : K) hβK),
        ⟨β, fun h => hβK (by rw [h]; rfl), hcop, ?_⟩, ?_⟩
      · rw [coe_toPrincipalIdeal, Units.val_mk0]
      · ext1
        rw [extendFractional_principal, coe_toPrincipalIdeal, Units.val_mk0, hv, ← hβ]
        rfl
  have hS : Subgroup.closure (orderPrincipalGenerators O) ≤ orderCoprimeIdeals O :=
    Subgroup.closure_mono (orderPrincipalGenerators_subset O)
  ext w
  rw [mem_rationalPrincipalIdeals, rationalPrincipalAmbient, ← himage, ← MonoidHom.map_closure,
    Subgroup.mem_map, Subgroup.mem_map]
  constructor
  · rintro ⟨u, hu, rfl⟩
    exact ⟨u, hu, rfl⟩
  · rintro ⟨x, hx, hxw⟩
    exact ⟨⟨x, hS hx⟩, hx, Subtype.ext hxw⟩

end Cox.Order
