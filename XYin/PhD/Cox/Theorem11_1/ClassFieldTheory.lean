/-!
# Janusz's class-field prerequisites

The first layer records change of modulus, Artin restriction, fixed fields, and
classification order. Existence will require reciprocity, Kummer theory, local power indices,
and conductor support; none of these are assumptions of the Cox theorem.
-/

open NumberField
open scoped nonZeroDivisors

noncomputable section

namespace Cox.ClassFieldTheory

variable (K : Type*) [Field K] [NumberField K]

section Extension

variable (m : Ideal (𝓞 K)) (L : Type*) [Field L] [NumberField L] [Algebra K L]

/-- The norm image, generated by integral ideals above the prime-to-modulus group.
This avoids postulating a relative norm on fractional ideals. -/
def normImage [Module.Finite (𝓞 K) (𝓞 L)] : Subgroup (coprimeIdeals K m) :=
  Subgroup.closure {u | ∃ A : Ideal (𝓞 L), A ≠ ⊥ ∧
    A ⊔ m.map (algebraMap (𝓞 K) (𝓞 L)) = ⊤ ∧
    ((u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K) =
      (Ideal.relNorm (𝓞 K) A : FractionalIdeal (𝓞 K)⁰ K)}

/-- Arithmetic Frobenius uniquely specifies an Artin homomorphism. -/
theorem isArtinMap_unique [IsGalois K L]
    (hU : IsUnramifiedAway K m L)
    {φ ψ : coprimeIdeals K m →* (L ≃ₐ[K] L)}
    (hφ : IsArtinMap K m L φ) (hψ : IsArtinMap K m L ψ) : φ = ψ := by
  exact coprimeIdeals_hom_ext K m φ ψ fun q hq hq0 hmq u hu =>
    isArtinMap_prime_eq K m L hU φ ψ hφ hψ hq hq0 hmq u hu

-- The unused section instances are kept: the planned signature includes them.
set_option linter.unusedSectionVars false in
/-- Janusz III.2.4: arithmetic Artin maps commute with restriction to normal subfields. -/
theorem isArtinMap_restrict [IsGalois K L]
    (E : Type*) [Field E] [NumberField E] [Algebra K E] [Algebra E L]
    [IsScalarTower K E L] [Normal K E]
    (φ : coprimeIdeals K m →* (L ≃ₐ[K] L)) (hφ : IsArtinMap K m L φ) :
    IsArtinMap K m E ((AlgEquiv.restrictNormalHom E).comp φ) := by
  intro q hq hq0 hmq u hu P hP x
  haveI := hq
  obtain ⟨hPp, hPo⟩ := hP
  haveI := hPp
  haveI := hPo
  obtain ⟨Q, hQp, hQc⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := 𝓞 L) P (by simp)
  haveI := hQp
  haveI : Q.LiesOver P := ⟨hQc.symm⟩
  haveI : Q.LiesOver q := Ideal.LiesOver.trans Q P q
  have h := hφ q hq hq0 hmq u hu Q ⟨hQp, inferInstance⟩ (algebraMap (𝓞 E) (𝓞 L) x)
  have hcomm : algebraMap (𝓞 E) (𝓞 L)
      (RingOfIntegers.mapRingHom ((AlgEquiv.restrictNormalHom E) (φ u)).toRingHom x) =
        RingOfIntegers.mapRingHom (φ u).toRingHom (algebraMap (𝓞 E) (𝓞 L) x) :=
    RingOfIntegers.ext (AlgEquiv.restrictNormal_commutes (φ u) E (x : E))
  rw [Ideal.LiesOver.over (P := Q) (p := P), Ideal.under, Ideal.mem_comap, map_sub, map_pow,
    MonoidHom.comp_apply, hcomm]
  exact h

/-- Unramifiedness descends in a number field tower. -/
theorem isUnramifiedAway_subfield (E : IntermediateField K L)
    (hU : IsUnramifiedAway K m L) : IsUnramifiedAway K m E := by
  intro q hq hq0 hmq P hP
  haveI := hq
  obtain ⟨hPp, hPo⟩ := hP
  haveI := hPp
  haveI := hPo
  obtain ⟨Q, hQp, hQc⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := 𝓞 L) P (by simp)
  haveI := hQp
  haveI : Q.LiesOver P := ⟨hQc.symm⟩
  haveI : Q.LiesOver q := Ideal.LiesOver.trans Q P q
  have h1 := hU q hq hq0 hmq Q ⟨hQp, inferInstance⟩
  rw [Ideal.ramificationIdx_algebra_tower' q P Q] at h1
  exact Nat.eq_one_of_mul_eq_one_right h1

-- The unused section instances are kept: the planned signature includes them.
set_option linter.unusedSectionVars false in
/-- The restricted Artin kernel is the inverse image of the subgroup fixing the subfield. -/
theorem artin_restriction_ker [IsGalois K L]
    (E : IntermediateField K L) [Normal K E]
    (φ : coprimeIdeals K m →* (L ≃ₐ[K] L)) :
    ((AlgEquiv.restrictNormalHom E).comp φ).ker = E.fixingSubgroup.comap φ := by
  rw [← MonoidHom.comap_ker, IntermediateField.restrictNormalHom_ker]

/-- Janusz V.7.1: quotienting the Artin image realizes every larger kernel by a fixed field. -/
theorem hasArtinKernel_fixedField [IsAbelianGalois K L]
    (hU : IsUnramifiedAway K m L)
    (φ : coprimeIdeals K m →* (L ≃ₐ[K] L))
    (hφ : IsArtinMap K m L φ) (hsurj : Function.Surjective φ)
    (H : Subgroup (coprimeIdeals K m)) (hker : φ.ker ≤ H) :
    HasArtinKernel K m (IntermediateField.fixedField (H.map φ)) H := by
  set E := IntermediateField.fixedField (H.map φ) with hE
  refine ⟨inferInstance, inferInstance, inferInstance, isUnramifiedAway_subfield K m L E hU,
    (AlgEquiv.restrictNormalHom E).comp φ, isArtinMap_restrict K m L E φ hφ, ?_, ?_⟩
  · exact (AlgEquiv.restrictNormalHom_surjective (F := K) (K₁ := E) L).comp hsurj
  · rw [artin_restriction_ker K m L E φ, hE, IntermediateField.fixingSubgroup_fixedField,
      Subgroup.comap_map_eq_self hker]

/-- A good completely split prime is the norm of a prime above it; Janusz V.5.8. -/
theorem mem_normImage_of_splits [Module.Finite (𝓞 K) (𝓞 L)]
    {q : Ideal (𝓞 K)} (hq : q ∈ splittingIdeals K L) (hmq : q ⊔ m = ⊤)
    (u : coprimeIdeals K m)
    (hu : ((u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K) = q) :
    u ∈ normImage K m L := by
  obtain ⟨hqp, hq0, hsplit⟩ := hq
  haveI := hqp
  haveI : q.IsMaximal := hqp.isMaximal hq0
  obtain ⟨P, hPp, hPc⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := 𝓞 L) q (by simp)
  haveI := hPp
  haveI hPo : P.LiesOver q := ⟨hPc.symm⟩
  have hP0 : P ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot hq0 P
  haveI : P.IsMaximal := hPp.isMaximal hP0
  haveI : CharZero (FractionRing (𝓞 K)) := charZero_of_injective_algebraMap
    (IsFractionRing.injective (𝓞 K) (FractionRing (𝓞 K)))
  have hrel : Ideal.relNorm (𝓞 K) P = q := by
    rw [Ideal.relNorm_eq_pow_of_isMaximal P q, (hsplit P ⟨hPp, hPo⟩).2, pow_one]
  have hsup : P ⊔ m.map (algebraMap (𝓞 K) (𝓞 L)) = ⊤ := by
    have hle : q.map (algebraMap (𝓞 K) (𝓞 L)) ≤ P :=
      Ideal.map_le_iff_le_comap.mpr (le_of_eq (Ideal.over_def P q))
    have h := congrArg (Ideal.map (algebraMap (𝓞 K) (𝓞 L))) hmq
    rw [Ideal.map_sup, Ideal.map_top] at h
    exact top_unique (h ▸ sup_le_sup_right hle _)
  exact Subgroup.subset_closure ⟨P, hP0, hsup, by rw [hu, hrel]⟩

/-- Trivial arithmetic Frobenius is equivalent to complete splitting at a good prime. -/
theorem splits_iff_artin_eq_one [IsGalois K L]
    (hU : IsUnramifiedAway K m L)
    (φ : coprimeIdeals K m →* (L ≃ₐ[K] L)) (hφ : IsArtinMap K m L φ)
    {q : Ideal (𝓞 K)} (hq : q.IsPrime) (hq0 : q ≠ ⊥) (hmq : q ⊔ m = ⊤)
    (u : coprimeIdeals K m)
    (hu : ((u : (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K) = q) :
    q ∈ splittingIdeals K L ↔ φ u = 1 := by
  haveI := hq
  obtain ⟨P, hPp, hPc⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := 𝓞 L) q (by simp)
  have hP : P ∈ q.primesOver (𝓞 L) := ⟨hPp, ⟨hPc.symm⟩⟩
  constructor
  · rintro ⟨-, -, hsplit⟩
    rw [← orderOf_eq_one_iff, orderOf_artin_eq_inertiaDeg K m L hU φ hφ hq hq0 hmq u hu P hP]
    exact (hsplit P hP).2
  · intro h1
    refine ⟨hq, hq0, fun Q hQ => ⟨hU q hq hq0 hmq Q hQ, ?_⟩⟩
    rw [← orderOf_artin_eq_inertiaDeg K m L hU φ hφ hq hq0 hmq u hu Q hQ, h1, orderOf_one]

end Extension

section Embedded

variable {K} {Ω : Type*} [Field Ω] [Algebra K Ω]
variable (L E : IntermediateField K Ω) [NumberField L] [NumberField E]

/-- Janusz IV.5.5 compares the splitting densities of two normal extensions
and their compositum. -/
theorem le_of_splittingIdeals_almostSubset [IsGalois K L] [IsGalois K E]
    (h : AlmostSubset (splittingIdeals K E) (splittingIdeals K L)) : L ≤ E := by
  haveI : FiniteDimensional K L := Module.Finite.of_restrictScalars_finite ℚ K L
  haveI : FiniteDimensional K E := Module.Finite.of_restrictScalars_finite ℚ K E
  haveI : NumberField (L ⊔ E : IntermediateField K Ω) := NumberField.of_module_finite K _
  haveI : Normal K (L ⊔ E : IntermediateField K Ω) := IntermediateField.normal_sup K Ω L E
  haveI : IsGalois K (L ⊔ E : IntermediateField K Ω) := IsGalois.mk
  have hdiff := splitting_compositum_finite_diff K L E h
  have hdens := density_le_of_finite_diff K (density_splittingIdeals K E)
    (density_splittingIdeals K (L ⊔ E : IntermediateField K Ω)) hdiff
  have hposE : (0 : ℝ) < Module.finrank K E := by exact_mod_cast Module.finrank_pos
  have hposM : (0 : ℝ) < Module.finrank K (L ⊔ E : IntermediateField K Ω) := by
    exact_mod_cast Module.finrank_pos
  have hle : Module.finrank K (L ⊔ E : IntermediateField K Ω) ≤ Module.finrank K E := by
    exact_mod_cast (one_div_le_one_div hposE hposM).mp hdens
  have hEM : E = L ⊔ E := IntermediateField.eq_of_le_of_finrank_le le_sup_right hle
  rw [hEM]
  exact le_sup_left

/-- Janusz V.5.8: a norm subgroup contained in the Artin kernel forces field inclusion. -/
theorem le_of_normImage_le_artinKernel [IsGalois K L] [IsGalois K E]
    [Module.Finite (𝓞 K) (𝓞 E)] (m : Ideal (𝓞 K)) (hm : m ≠ ⊥)
    (hU : IsUnramifiedAway K m L)
    (φ : coprimeIdeals K m →* (L ≃ₐ[K] L)) (hφ : IsArtinMap K m L φ)
    (hNorm : normImage K m E ≤ φ.ker) : L ≤ E := by
  apply le_of_splittingIdeals_almostSubset L E
  apply (finite_primes_meeting_modulus K m hm).subset
  rintro q ⟨hqE, hqL⟩
  refine ⟨hqE.1, hqE.2.1, fun hmq => hqL ?_⟩
  obtain ⟨u, hu⟩ := exists_coprimeIdealUnit K m q hqE.2.1 hmq
  rw [splits_iff_artin_eq_one K m L hU φ hφ hqE.1 hqE.2.1 hmq u hu]
  exact hNorm (mem_normImage_of_splits K m E hqE hmq u hu)

/-- Order reversal for two embedded abelian extensions with fixed-modulus Artin kernels. -/
theorem le_iff_artinKernel_le (m : Ideal (𝓞 K)) (hm : m ≠ ⊥)
    {H J : Subgroup (coprimeIdeals K m)}
    (hL : HasArtinKernel K m L H) (hE : HasArtinKernel K m E J) :
    L ≤ E ↔ J ≤ H := by
  obtain ⟨hfdE, hGE, hcE, hUE, ψ, hψ, hψs, hψk⟩ := hE
  obtain ⟨hfdL, hGL, hcL, hUL, φ, hφ, hφs, hφk⟩ := hL
  constructor
  · intro hLE
    letI : Algebra L E := (IntermediateField.inclusion hLE).toAlgebra
    haveI : IsScalarTower K L E := IsScalarTower.of_algebraMap_eq fun x => rfl
    have hres := isArtinMap_restrict K m E L ψ hψ
    have huniq := isArtinMap_unique K m L hUL hres hφ
    rw [← hψk, ← hφk, ← huniq]
    intro x hx
    rw [MonoidHom.mem_ker] at hx ⊢
    rw [MonoidHom.comp_apply, hx, map_one]
  · intro hJH
    apply le_of_splittingIdeals_almostSubset L E
    apply (finite_primes_meeting_modulus K m hm).subset
    rintro q ⟨hqE, hqL⟩
    refine ⟨hqE.1, hqE.2.1, fun hmq => hqL ?_⟩
    obtain ⟨u, hu⟩ := exists_coprimeIdealUnit K m q hqE.2.1 hmq
    rw [splits_iff_artin_eq_one K m L hUL φ hφ hqE.1 hqE.2.1 hmq u hu]
    have hψu : ψ u = 1 :=
      (splits_iff_artin_eq_one K m E hUE ψ hψ hqE.1 hqE.2.1 hmq u hu).mp hqE
    have huJ : u ∈ J := by
      rw [← hψk]
      exact hψu
    have huH : u ∈ H := hJH huJ
    rw [← hφk] at huH
    exact huH

/-- Equal genuine Artin kernels uniquely determine an embedded abelian extension. -/
theorem eq_of_artinKernel_eq (m : Ideal (𝓞 K)) (hm : m ≠ ⊥)
    {H : Subgroup (coprimeIdeals K m)}
    (hL : HasArtinKernel K m L H) (hE : HasArtinKernel K m E H) : L = E := by
  exact le_antisymm ((le_iff_artinKernel_le L E m hm hL hE).mpr le_rfl)
    ((le_iff_artinKernel_le E L m hm hE hL).mpr le_rfl)

end Embedded

end Cox.ClassFieldTheory

namespace Cox.Order

/-- A negative integer cannot be the square of the image of a ring element in `ℝ`. -/
theorem isEmpty_realEmbedding_of_negative_square {F : Type*} [Ring F]
    (D : ℤ) (hD : D < 0) (r : F) (hr : r ^ 2 = (D : F)) : IsEmpty (F →+* ℝ) := by
  refine ⟨fun φ => ?_⟩
  have h := congrArg φ hr
  rw [map_pow, map_intCast] at h
  have hD' : (D : ℝ) < 0 := by exact_mod_cast hD
  nlinarith [sq_nonneg (φ r)]

/-- Every embedding of an imaginary quadratic field is nonreal, so its infinite places
require no positivity component in a class-field modulus. -/
theorem isTotallyComplex {K : IntermediateField ℚ ℂ}
    [IsImaginaryQuadraticField K] : NumberField.IsTotallyComplex K := by
  obtain ⟨D, r, hD, hr, -⟩ := exists_negative_square_generator (K := K)
  haveI := isEmpty_realEmbedding_of_negative_square D hD r hr
  refine ⟨fun w => ?_⟩
  rw [← NumberField.InfinitePlace.not_isReal_iff_isComplex]
  intro hw
  exact IsEmpty.false (NumberField.InfinitePlace.embedding_of_isReal hw)

end Cox.Order
