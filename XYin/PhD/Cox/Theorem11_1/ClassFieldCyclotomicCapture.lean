import Mathlib.FieldTheory.PrimitiveElement
import Mathlib.NumberTheory.Cyclotomic.Basic

/-!
# The finite cyclotomic capture in Janusz V.5.4

The finite set of realized intersections is covered by finitely many root fields. Least common
multiples combine those root fields inside the actual ambient field. No coprime-intersection or
change-of-base conclusion is made.
-/

namespace Cox.ClassFieldTheory.CyclotomicCapture

/-- A finite separable extension has finitely many intermediate fields. -/
theorem finite_intermediateFields_of_finite_separable (F T : Type*)
    [Field F] [Field T] [Algebra F T] [FiniteDimensional F T] [Algebra.IsSeparable F T] :
    Finite (IntermediateField F T) := by
  exact Field.finite_intermediateField_of_exists_primitive_element F T
    (Field.exists_primitive_element F T)

/-- The subfields below L in an arbitrary ambient extension form a finite set. -/
theorem finite_subfields_le {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (L : IntermediateField F Ω) [Finite (IntermediateField F L)] :
    {J : IntermediateField F Ω | J ≤ L}.Finite := by
  refine (Set.finite_range fun J : IntermediateField F L =>
    IntermediateField.lift (F := L) J).subset ?_
  intro J hJ
  exact ⟨IntermediateField.restrict hJ, IntermediateField.lift_restrict hJ⟩

/-- The existing roots combine to a primitive root of the least common multiple. -/
theorem exists_primitive_lcm {A : Type*} [CommMonoid A] (m n : ℕ)
    (hm : m ≠ 0) (hn : n ≠ 0) (ζ ξ : A)
    (hζ : IsPrimitiveRoot ζ m) (hξ : IsPrimitiveRoot ξ n) :
    ∃ η : A, IsPrimitiveRoot η (m.lcm n) := by
  exact ⟨_, hζ.pow_mul_pow_lcm hξ hm hn⟩

/-- A field generated by a lower-order root lies in a field with the divisible root order. -/
theorem adjoin_le_of_primitive_dvd {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (m n : ℕ) (hn : n ≠ 0) (ζ ξ : Ω)
    (hζ : IsPrimitiveRoot ζ m) (hξ : IsPrimitiveRoot ξ n) (h : m ∣ n) :
    IntermediateField.adjoin F {ζ} ≤ IntermediateField.adjoin F {ξ} := by
  haveI : NeZero n := ⟨hn⟩
  have hζn : ζ ^ n = 1 := (hζ.pow_eq_one_iff_dvd n).mpr h
  obtain ⟨i, -, rfl⟩ := hξ.eq_pow_of_pow_eq_one hζn
  rw [IntermediateField.adjoin_simple_le_iff]
  exact pow_mem (IntermediateField.mem_adjoin_simple_self F ξ) i

/-- Finitely many root fields are contained in one root field in the same ambient field. -/
theorem exists_finite_root_capture {F Ω I : Type*} [Field F] [Field Ω] [Algebra F Ω]
    [Finite I] (n : I → ℕ) (hn : ∀ i, 0 < n i) (ζ : I → Ω)
    (hζ : ∀ i, IsPrimitiveRoot (ζ i) (n i)) :
    ∃ M : ℕ, 0 < M ∧ ∃ ξ : Ω, IsPrimitiveRoot ξ M ∧
      ∀ i, IntermediateField.adjoin F {ζ i} ≤ IntermediateField.adjoin F {ξ} := by
  classical
  haveI := Fintype.ofFinite I
  suffices h : ∀ s : Finset I, ∃ M : ℕ, 0 < M ∧ ∃ ξ : Ω, IsPrimitiveRoot ξ M ∧
      ∀ i ∈ s, IntermediateField.adjoin F {ζ i} ≤ IntermediateField.adjoin F {ξ} by
    obtain ⟨M, hM, ξ, hξ, h⟩ := h Finset.univ
    exact ⟨M, hM, ξ, hξ, fun i => h i (Finset.mem_univ i)⟩
  intro s
  induction s using Finset.induction_on with
  | empty =>
    exact ⟨1, Nat.zero_lt_one, 1, IsPrimitiveRoot.one,
      fun i hi => absurd hi (Finset.notMem_empty i)⟩
  | insert j s hj ih =>
    obtain ⟨M, hM, ξ, hξ, hcap⟩ := ih
    obtain ⟨η, hη⟩ := exists_primitive_lcm (n j) M (hn j).ne' hM.ne' (ζ j) ξ (hζ j) hξ
    have hlpos : 0 < (n j).lcm M := Nat.lcm_pos (hn j) hM
    refine ⟨(n j).lcm M, hlpos, η, hη, fun i hi => ?_⟩
    rcases Finset.mem_insert.mp hi with rfl | hi
    · exact adjoin_le_of_primitive_dvd _ _ hlpos.ne' _ _ (hζ i) hη (Nat.dvd_lcm_left _ _)
    · exact (hcap i hi).trans
        (adjoin_le_of_primitive_dvd _ _ hlpos.ne' _ _ hξ hη (Nat.dvd_lcm_right _ _))

/-- Janusz V.5.4, printed161: one root field captures every cyclotomic intersection with L. -/
theorem exists_cyclotomic_intersection_capture {F Ω : Type*}
    [Field F] [Field Ω] [Algebra F Ω] (L : IntermediateField F Ω)
    [Finite (IntermediateField F L)] :
    ∃ M : ℕ, 0 < M ∧ ∃ ξ : Ω, IsPrimitiveRoot ξ M ∧
      ∀ m : ℕ, 0 < m → ∀ ζ : Ω, IsPrimitiveRoot ζ m →
        L ⊓ IntermediateField.adjoin F {ζ} ≤ IntermediateField.adjoin F {ξ} := by
  classical
  set S : Set (IntermediateField F Ω) := {J | ∃ m : ℕ, 0 < m ∧ ∃ ζ : Ω, IsPrimitiveRoot ζ m ∧
    J = L ⊓ IntermediateField.adjoin F {ζ}} with hS
  have hSfin : S.Finite := (finite_subfields_le L).subset fun J ⟨m, hm, ζ, hζ, hJ⟩ => by
    rw [Set.mem_setOf_eq, hJ]
    exact inf_le_left
  haveI : Finite S := hSfin.to_subtype
  have hex : ∀ J : S, ∃ m : ℕ, 0 < m ∧ ∃ ζ : Ω, IsPrimitiveRoot ζ m ∧
      (J : IntermediateField F Ω) = L ⊓ IntermediateField.adjoin F {ζ} := fun J => J.2
  choose n hn ζ hζ hJ using hex
  obtain ⟨M, hM, ξ, hξ, hcap⟩ := exists_finite_root_capture (F := F) n hn ζ hζ
  refine ⟨M, hM, ξ, hξ, fun m hm ζ' hζ' => ?_⟩
  have hmem : L ⊓ IntermediateField.adjoin F {ζ'} ∈ S := ⟨m, hm, ζ', hζ', rfl⟩
  calc L ⊓ IntermediateField.adjoin F {ζ'} = L ⊓ IntermediateField.adjoin F {ζ ⟨_, hmem⟩} :=
        hJ ⟨_, hmem⟩
    _ ≤ IntermediateField.adjoin F {ζ ⟨_, hmem⟩} := inf_le_right
    _ ≤ IntermediateField.adjoin F {ξ} := hcap _

end Cox.ClassFieldTheory.CyclotomicCapture
