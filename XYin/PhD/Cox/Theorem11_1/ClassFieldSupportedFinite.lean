import XYin.PhD.Cox.Theorem11_1.ClassFieldIdealGroups
import Mathlib.GroupTheory.Finiteness
import Mathlib.RingTheory.Finiteness.Basic

/-! # Finite generation of supported ideals

Janusz V.2.5 uses the free abelian group on the finite modulus support. These adapters transfer its
existing prime-generator description to finite generation as an integral module.
-/

open NumberField IsDedekindDomain
open scoped nonZeroDivisors
noncomputable section
namespace Cox.ClassFieldTheory

/-- A subgroup generated by a finite set is finite as an integral module. -/
theorem moduleFinite_subgroupClosure_of_finite {G : Type*} [CommGroup G]
    (S : Set G) (hS : S.Finite) :
    Module.Finite ℤ (Subgroup.closure S).toAddSubgroup.toIntSubmodule := by
  have hfg : (Subgroup.closure S).FG := ⟨hS.toFinset, by rw [Set.Finite.coe_toFinset]⟩
  rw [Module.Finite.iff_fg, Submodule.fg_iff_addSubgroup_fg,
    AddSubgroup.toIntSubmodule_toAddSubgroup]
  exact (Subgroup.fg_iff_add_fg _).mp hfg

/-- The prime divisors of a nonzero modulus generate a finite integral ideal module. -/
theorem modulusSupported_moduleFinite (K : Type*) [Field K] [NumberField K]
    (m : Ideal (𝓞 K)) (hm : m ≠ ⊥) :
    Module.Finite ℤ (modulusSupportedIdeals K m).toAddSubgroup.toIntSubmodule := by
  rw [modulusSupportedIdeals_eq_primeGeneratedGroup, primeGeneratedGroup]
  refine moduleFinite_subgroupClosure_of_finite _ (Set.Finite.image _ ?_)
  simpa only [Ideal.dvd_iff_le] using Ideal.finite_factors hm

end Cox.ClassFieldTheory
