import XYin.PhD.Cox.Theorem11_1.ClassFieldTheory
import XYin.PhD.Cox.Theorem11_1.ClassFieldCompletionNorm
import XYin.PhD.Cox.Theorem11_1.ClassFieldIdealProjection
import Mathlib.NumberTheory.NumberField.ClassNumber
import Mathlib.NumberTheory.NumberField.Completion.FinitePlace
import Mathlib.NumberTheory.NumberField.Units.DirichletTheorem
import Mathlib.NumberTheory.RamificationInertia.HilbertTheory
import Mathlib.NumberTheory.RamificationInertia.Valuation
import Mathlib.Data.ZMod.QuotientGroup

/-! # Arithmetic objects used before class-field existence

The definitions and completion-transport statements here do not depend on reciprocity
or class-field existence.
-/

open NumberField IsDedekindDomain
open scoped nonZeroDivisors Pointwise WithZero

noncomputable section
namespace Cox.ClassFieldTheory
variable (K : Type*) [Field K] [NumberField K]

/-- The subgroup of nonzero nth powers in the base field. -/
def nthPowers (n : ℕ) : Subgroup Kˣ := (powMonoidHom n).range

/-- Fractional ideals supported on a specified finite set of finite primes. -/
def supportedIdeals (S : Finset (HeightOneSpectrum (𝓞 K))) :
    Subgroup (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
  Subgroup.closure {u : (FractionalIdeal (𝓞 K)⁰ K)ˣ |
    ∃ v ∈ S, (u : FractionalIdeal (𝓞 K)⁰ K) = v.asIdeal}

/-- S-units, with all infinite places implicitly included in S. -/
def sUnits (S : Finset (HeightOneSpectrum (𝓞 K))) : Subgroup Kˣ :=
  (supportedIdeals K S).comap (toPrincipalIdeal (𝓞 K) K)

/-- The global power/congruence index `c(m)` in Janusz V.(9.11)–(9.15). -/
def powerCongruenceIndex (n : ℕ) (m : Ideal (𝓞 K)) : ℕ :=
  (nthPowers K n ⊔ rayElements K m).index

/-- The field generated by all nth roots of a multiplicative subgroup. -/
def radicalField (n : ℕ) (W : Subgroup Kˣ) : IntermediateField K (AlgebraicClosure K) :=
  IntermediateField.adjoin K {a : AlgebraicClosure K |
    ∃ w : Kˣ, w ∈ W ∧ a ^ n = algebraMap K (AlgebraicClosure K) (w : K)}

/-- The finite primes chosen in V.9 support representatives of all ideal classes. -/
def SupportsClassRepresentatives (S : Finset (HeightOneSpectrum (𝓞 K))) : Prop :=
  ∀ c : ClassGroup (𝓞 K), ∃ u : (FractionalIdeal (𝓞 K)⁰ K)ˣ,
    u ∈ supportedIdeals K S ∧ ClassGroup.mk K u = c

/-- All prime divisors of the radical exponent lie in the chosen support. -/
def CoversNthPrimes (n : ℕ) (S : Finset (HeightOneSpectrum (𝓞 K))) : Prop :=
  ∀ v : HeightOneSpectrum (𝓞 K), (n : 𝓞 K) ∈ v.asIdeal → v ∈ S

/-- A modulus with a fixed finite support and uniform positive prime exponents. -/
def supportModulus (S : Finset (HeightOneSpectrum (𝓞 K))) (t : ℕ) : Ideal (𝓞 K) :=
  ∏ v ∈ S, v.asIdeal ^ t

/-- The principal-unit filtration of the completed local integer ring. -/
def localUnitFiltration (v : HeightOneSpectrum (𝓞 K)) (t : ℕ) :
    Subgroup (v.adicCompletionIntegers K)ˣ :=
  (Units.map (Ideal.Quotient.mk
    (IsLocalRing.maximalIdeal (v.adicCompletionIntegers K) ^ t)).toMonoidHom).ker

/-- The completed principal-unit filtration, now viewed inside the completed field units.
At depth zero it is the entire local integer-unit group, as in Janusz V.12. -/
def localFieldUnitFiltration (v : HeightOneSpectrum (𝓞 K)) (b : ℕ) :
    Subgroup (v.adicCompletion K)ˣ :=
  (localUnitFiltration K v b).map
    (Units.map (v.adicCompletionIntegers K).subtype.toMonoidHom)

/-- At depth zero the reduction ring is the zero ring, so every integral unit lies
in the reduction kernel. -/
theorem localUnitFiltration_zero (v : HeightOneSpectrum (𝓞 K)) :
    localUnitFiltration K v 0 = ⊤ := by
  rw [eq_top_iff]
  intro u _
  rw [localUnitFiltration, MonoidHom.mem_ker]
  haveI : Subsingleton ((v.adicCompletionIntegers K) ⧸
      IsLocalRing.maximalIdeal (v.adicCompletionIntegers K) ^ 0) := by
    rw [pow_zero, Ideal.one_eq_top]
    exact Ideal.Quotient.subsingleton_iff.mpr rfl
  exact Subsingleton.elim _ _

/-- Depth-zero field units are exactly the kernel of normalized valuation. -/
theorem localFieldUnitFiltration_zero_eq_ker (v : HeightOneSpectrum (𝓞 K)) :
    localFieldUnitFiltration K v 0 = (localUnitValuation K v).ker := by
  rw [localFieldUnitFiltration, localUnitFiltration_zero, localUnitValuation_ker,
    MonoidHom.range_eq_map]

/-- A uniformizer section makes the integer-valued local valuation surjective. -/
theorem localUnitValuation_surjective (v : HeightOneSpectrum (𝓞 K)) :
    Function.Surjective (localUnitValuation K v) := by
  obtain ⟨s, hs⟩ := exists_localUnitValuation_section K v
  intro z
  exact ⟨s z, DFunLike.congr_fun hs z⟩

/-- The multiplicative form of the standard index of nℤ in ℤ. -/
theorem index_zpowers_multiplicative_int (n : ℕ) :
    (Subgroup.zpowers (Multiplicative.ofAdd (n : ℤ))).index = n := by
  have h : Subgroup.zpowers (Multiplicative.ofAdd (n : ℤ)) =
      AddSubgroup.toSubgroup (AddSubgroup.zmultiples (n : ℤ)) := by
    ext x
    rw [Subgroup.mem_zpowers_iff]
    change _ ↔ Multiplicative.toAdd x ∈ AddSubgroup.zmultiples (n : ℤ)
    rw [AddSubgroup.mem_zmultiples_iff]
    constructor
    · rintro ⟨k, rfl⟩
      exact ⟨k, by simp⟩
    · rintro ⟨k, hk⟩
      refine ⟨k, ?_⟩
      apply Multiplicative.toAdd.injective
      rw [toAdd_zpow, toAdd_ofAdd, hk]
  rw [h, AddSubgroup.index_toSubgroup, Int.index_zmultiples, Int.natAbs_natCast]

section NormIndex
variable (m : Ideal (𝓞 K)) (L : Type*) [Field L] [NumberField L] [Algebra K L]
variable [Module.Finite (𝓞 K) (𝓞 L)]

/-- Janusz's norm-and-ray subgroup, whose index is h_m(L/K). -/
def normRaySubgroup : Subgroup (coprimeIdeals K m) :=
  normImage K m L ⊔ raySubgroup K m


end NormIndex

section Completion
variable (L : Type*) [Field L] [NumberField L] [Algebra K L]
variable (v : HeightOneSpectrum (𝓞 K)) (w : HeightOneSpectrum (𝓞 L))
variable [hvw : w.asIdeal.LiesOver v.asIdeal]

include hvw

/-- The normalized integer-valued norm formula on the actual local field units. -/
theorem localUnitValuation_norm (x : (w.adicCompletion L)ˣ) :
    letI := completionAlgebra K L v w
    localUnitValuation K v (Units.map (Algebra.norm (v.adicCompletion K)) x) =
      localUnitValuation L w x ^ Ideal.inertiaDeg v.asIdeal w.asIdeal := by
  apply Multiplicative.toAdd.injective
  apply WithZero.exp_injective
  rw [localUnitValuation_apply, toAdd_pow, WithZero.exp_nsmul, localUnitValuation_apply,
    Units.coe_map]
  exact valuation_local_norm K L v w (x : w.adicCompletion L)

/-- Local norms have exactly the multiples of the residue degree as valuations. -/
theorem localNormGroup_map_valuation :
    (localNormGroup K L v w).map (localUnitValuation K v) =
      Subgroup.zpowers (Multiplicative.ofAdd (Ideal.inertiaDeg v.asIdeal w.asIdeal : ℤ)) := by
  ext y
  rw [Subgroup.mem_map, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
    refine ⟨Multiplicative.toAdd (localUnitValuation L w x), ?_⟩
    rw [localUnitValuation_norm K L v w x]
    apply Multiplicative.toAdd.injective
    simp [mul_comm]
  · rintro ⟨k, rfl⟩
    obtain ⟨x, hx⟩ := localUnitValuation_surjective L w (Multiplicative.ofAdd k)
    letI := completionAlgebra K L v w
    refine ⟨Units.map (Algebra.norm (v.adicCompletion K) :
      w.adicCompletion L →* v.adicCompletion K) x, ⟨x, rfl⟩, ?_⟩
    rw [localUnitValuation_norm K L v w x, hx]
    apply Multiplicative.toAdd.injective
    simp [mul_comm]

/-- Modulo local integer units, norms have index equal to the residue degree. -/
theorem localNormGroup_sup_units_index :
    (localNormGroup K L v w ⊔ localFieldUnitFiltration K v 0).index =
      Ideal.inertiaDeg v.asIdeal w.asIdeal := by
  have h := Subgroup.index_map (H := localNormGroup K L v w) (localUnitValuation K v)
  rw [localNormGroup_map_valuation, index_zpowers_multiplicative_int,
    MonoidHom.range_eq_top_of_surjective _ (localUnitValuation_surjective K v),
    Subgroup.index_top, mul_one, ← localFieldUnitFiltration_zero_eq_ker] at h
  exact h.symm

end Completion
end Cox.ClassFieldTheory
