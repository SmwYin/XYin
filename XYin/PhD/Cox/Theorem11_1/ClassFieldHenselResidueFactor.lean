import Mathlib.RingTheory.TensorProduct.Quotient

/-! # The residue factors of the lifted idempotent decomposition

Janusz II.3.5, printed p.83/PDF94, compares the actual reduced factors. The quotient by e selects
the first factor when its product image is (0,1).
-/

noncomputable section
namespace Cox.ClassFieldTheory

/-- The first projection kernel is generated by the complementary idempotent (0,1). -/
theorem ker_fst_eq_span_zero_one {B C : Type*} [CommRing B] [CommRing C] :
    RingHom.ker (RingHom.fst B C) = Ideal.span {((0, 1) : B × C)} := by
  ext x
  rw [RingHom.mem_ker, Ideal.mem_span_singleton]
  constructor
  · intro h
    have h1 : x.1 = 0 := h
    exact ⟨(0, x.2), by ext <;> simp [h1]⟩
  · rintro ⟨c, rfl⟩
    simp

/-- The actual first projection identifies the quotient by (0,1) with the first factor. -/
theorem exists_quotient_span_zero_one_algEquiv
    (R B C : Type*) [CommRing R] [CommRing B] [CommRing C]
    [Algebra R B] [Algebra R C] :
    ∃ E : ((B × C) ⧸ Ideal.span {((0, 1) : B × C)}) ≃ₐ[R] B,
      ∀ x : B × C, E (Ideal.Quotient.mk _ x) = x.1 := by
  have hsurj : Function.Surjective (AlgHom.fst R B C) := fun b => ⟨(b, 0), rfl⟩
  have hker : RingHom.ker (AlgHom.fst R B C) = Ideal.span {((0, 1) : B × C)} :=
    ker_fst_eq_span_zero_one
  exact ⟨(Ideal.quotientEquivAlgOfEq R hker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective hsurj), fun x => rfl⟩

/-- An actual product equivalence identifies the quotient by the corresponding complementary
element. -/
theorem exists_quotient_factor_algEquiv
    (R A B C : Type*) [CommRing R] [CommRing A] [CommRing B] [CommRing C]
    [Algebra R A] [Algebra R B] [Algebra R C]
    (E : A ≃ₐ[R] B × C) (e : A) (he : E e = (0, 1)) :
    ∃ F : (A ⧸ Ideal.span {e}) ≃ₐ[R] B,
      ∀ a : A, F (Ideal.Quotient.mk _ a) = (E a).1 := by
  obtain ⟨G, hG⟩ := exists_quotient_span_zero_one_algEquiv R B C
  have hmap : Ideal.span {((0, 1) : B × C)} = (Ideal.span {e}).map E := by
    rw [Ideal.map_span, Set.image_singleton, he]
  refine ⟨(Ideal.quotientEquivAlg _ _ E hmap).trans G, fun a => ?_⟩
  rw [AlgEquiv.trans_apply, Ideal.quotientEquivAlg_mk, hG]

/-- Coefficient reduction and quotienting by an element commute on the actual representatives. -/
theorem exists_residue_quotient_equiv
    (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]
    (I : Ideal R) (e : A) :
    ∃ E : ((A ⧸ Ideal.span {e}) ⧸
        I.map (algebraMap R (A ⧸ Ideal.span {e}))) ≃ₐ[R ⧸ I]
      ((A ⧸ I.map (algebraMap R A)) ⧸
        Ideal.span {Ideal.Quotient.mk (I.map (algebraMap R A)) e}),
      ∀ a : A, E (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ a)) =
        Ideal.Quotient.mk _ (Ideal.Quotient.mk _ a) := by
  set J : Ideal A := I.map (algebraMap R A) with hJ
  have h1 : I.map (algebraMap R (A ⧸ Ideal.span {e})) =
      J.map (Ideal.Quotient.mk (Ideal.span {e})) := by
    rw [hJ, Ideal.map_map, ← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_eq]
  have h2 : (Ideal.span {e}).map (Ideal.Quotient.mk J) = Ideal.span {Ideal.Quotient.mk J e} := by
    rw [Ideal.map_span, Set.image_singleton]
  let E₀ : ((A ⧸ Ideal.span {e}) ⧸ I.map (algebraMap R (A ⧸ Ideal.span {e}))) ≃+*
      ((A ⧸ J) ⧸ Ideal.span {Ideal.Quotient.mk J e}) :=
    (Ideal.quotEquivOfEq h1).trans
      ((DoubleQuot.quotQuotEquivComm (Ideal.span {e}) J).trans (Ideal.quotEquivOfEq h2))
  have hE₀ : ∀ a : A, E₀ (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ a)) =
      Ideal.Quotient.mk _ (Ideal.Quotient.mk _ a) := fun a => rfl
  refine ⟨AlgEquiv.ofRingEquiv (f := E₀) fun x => ?_, hE₀⟩
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact hE₀ (algebraMap R A r)

end Cox.ClassFieldTheory
