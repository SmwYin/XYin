import XYin.PhD.Cox.Theorem11_1.ClassFieldArtinAuxiliaryCore
import XYin.PhD.Cox.Theorem11_1.ClassFieldArtinAuxiliaryPartner

/-!
# The actual auxiliary fixed field in Janusz V.5.5

The shared witness is the fixed field of the subgroup generated by the chosen cyclic generator and
the actual Frobenius pair. Unramification of the entire compositum remains explicit. Cyclotomic
choice and ambient lifting are separate.
-/

open NumberField IntermediateField Polynomial Cox.Chebotarev
noncomputable section
namespace Cox.ClassFieldTheory.ArtinAuxiliary

/-- Janusz V.5.5: one actual fixed field satisfies the three required field properties. -/
theorem exists_auxiliary_fixedField
    (K M : Type*) [Field K] [NumberField K] [Field M] [NumberField M]
    [Algebra K M] [IsGalois K M]
    (L E : IntermediateField K M) [IsGalois K L] [IsCyclic Gal(L/K)]
    (m : ℕ) [NeZero m] [IsCyclotomicExtension {m} K E]
    (hirr : Irreducible (cyclotomic m K))
    (hSup : L ⊔ E = ⊤) (hInf : L ⊓ E = ⊥)
    (q : Ideal (𝓞 K)) [q.IsPrime] (hU : UnramifiedIn K M q)
    (hcop : q.absNorm.Coprime m) (u v : (ZMod m)ˣ)
    (hu : (u : ZMod m) = q.absNorm)
    (hnu : Nat.card Gal(L/K) ∣ orderOf u) (hnv : Nat.card Gal(L/K) ∣ orderOf v)
    (hind : Disjoint (Subgroup.zpowers u) (Subgroup.zpowers v)) :
    ∃ F : IntermediateField K M, L ⊓ F = ⊥ ∧ F ⊔ E = ⊤ ∧
      q ∈ splittingIdeals K F := by
  haveI : IsAbelianGalois K L := IsAbelianGalois.of_isCyclic K L
  haveI : IsAbelianGalois K E := IsCyclotomicExtension.isAbelianGalois {m} K E
  haveI : FiniteDimensional K M := Module.Finite.of_restrictScalars_finite ℚ K M
  haveI : IsAbelianGalois K M := isAbelianGalois_of_generating_fields L E hSup
  haveI : NumberField L := NumberField.of_module_finite K L
  haveI : NumberField E := NumberField.of_module_finite K E
  have hUE := Chebotarev.unramifiedIn_intermediateField K M E q hU
  obtain ⟨τ, hτn, hτind⟩ :=
    independent_frobenius_partner K E m hirr q hUE hcop (Nat.card Gal(L/K)) u v hu hnv hind
  have hηu : IsCyclotomicExtension.autEquivPow E hirr (frobeniusClass K E q).out = u := by
    rw [CyclotomicFrobenius.autEquivPow_frobeniusClass_out K E m hirr q hUE hcop]
    exact Units.ext (by rw [ZMod.coe_unitOfCoprime, hu])
  have hηn : Nat.card Gal(L/K) ∣ orderOf (frobeniusClass K E q).out := by
    rw [← MulEquiv.orderOf_eq (IsCyclotomicExtension.autEquivPow E hirr), hηu]
    exact hnu
  obtain ⟨σ, hσ⟩ := isCyclic_iff_exists_zpowers_eq_top.mp ‹IsCyclic Gal(L/K)›
  refine ⟨AuxiliaryFields.auxiliaryFixedField L E σ (frobeniusClass K L q).out τ
    (frobeniusClass K E q).out, ?_, ?_, ?_⟩
  · rw [inf_comm]
    exact AuxiliaryFields.auxiliaryFixedField_inf L E hInf σ _ τ _ hσ
  · exact AuxiliaryFields.auxiliaryFixedField_sup L E hSup σ _ τ _
      ((orderOf_dvd_natCard σ).trans hτn) ((orderOf_dvd_natCard _).trans hηn) hτind
  · have hUL := Chebotarev.unramifiedIn_intermediateField K M L q hU
    have h1 := frobeniusClass_out_restrict K L M q hU hUL
    have h2 := frobeniusClass_out_restrict K E M q hU hUE
    unfold AuxiliaryFields.auxiliaryFixedField
    apply splits_fixedField_of_frobenius_mem K M _ q hU
    rw [Subgroup.mem_comap]
    have h3 : AuxiliaryFields.restrictionProd L E (frobeniusClass K M q).out =
        ((frobeniusClass K L q).out, (frobeniusClass K E q).out) := Prod.ext h1 h2
    rw [h3]
    exact AuxiliaryFields.second_mem_twoGeneratorGroup _ _ _ _

end Cox.ClassFieldTheory.ArtinAuxiliary
