import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.LocalRing.Module
import Mathlib.Algebra.Module.Projective
import Mathlib.Algebra.Ring.Idempotent

/-! # The lifted idempotent factors in Hensel's lemma

Janusz II.3.5, printed p.83/PDF94, decomposes A into two complementary factors. The quotient A/(e)
corresponds to A(1-e), so the quotient order is recorded explicitly.
-/

noncomputable section
open Module
namespace Cox.ClassFieldTheory

/-- The ideals generated by e and 1-e are comaximal. -/
theorem isCoprime_span_one_sub {A : Type*} [CommRing A] (e : A) :
    IsCoprime (Ideal.span {e}) (Ideal.span {1 - e}) := by
  rw [Ideal.isCoprime_span_singleton_iff]
  exact ⟨1, 1, by ring⟩

/-- An idempotent annihilates its complementary factor ideal. -/
theorem span_mul_span_one_sub_eq_bot {A : Type*} [CommRing A]
    (e : A) (he : IsIdempotentElem e) :
    Ideal.span {e} * Ideal.span {1 - e} = ⊥ := by
  rw [Ideal.span_singleton_mul_span_singleton, he.mul_one_sub_self, Ideal.span_singleton_eq_bot]

/-- The actual quotient maps give the complementary idempotent decomposition. -/
theorem exists_idempotent_quotient_algEquiv
    (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]
    (e : A) (he : IsIdempotentElem e) :
    ∃ E : A ≃ₐ[R] (A ⧸ Ideal.span {e}) × (A ⧸ Ideal.span {1 - e}),
      ∀ a : A, E a = (Ideal.Quotient.mk (Ideal.span {e}) a,
        Ideal.Quotient.mk (Ideal.span {1 - e}) a) := by
  have hcop := isCoprime_span_one_sub e
  have hbot := span_mul_span_one_sub_eq_bot e he
  let E₀ : A ≃+* (A ⧸ Ideal.span {e}) × (A ⧸ Ideal.span {1 - e}) :=
    (RingEquiv.quotientBot A).symm.trans ((Ideal.quotEquivOfEq hbot.symm).trans
      (Ideal.quotientMulEquivQuotientProd _ _ hcop))
  have hE₀ : ∀ a : A, E₀ a = (Ideal.Quotient.mk _ a, Ideal.Quotient.mk _ a) := fun a => rfl
  exact ⟨AlgEquiv.ofRingEquiv (f := E₀) fun r => by rw [hE₀]; rfl, fun a => hE₀ a⟩

/-- A direct factor of a finite free module over a local ring is free. -/
theorem moduleFree_factor_of_linearEquiv_prod
    (R A B C : Type*) [CommRing R] [IsLocalRing R] [AddCommGroup A] [AddCommGroup B]
    [AddCommGroup C] [Module R A] [Module R B] [Module R C]
    [Module.Finite R A] [Module.Free R A] (E : A ≃ₗ[R] B × C) :
    Module.Free R B := by
  let p : A →ₗ[R] B := (LinearMap.fst R B C).comp E.toLinearMap
  let i : B →ₗ[R] A := E.symm.toLinearMap.comp (LinearMap.inl R B C)
  have hpi : p.comp i = LinearMap.id := by
    ext b
    simp [p, i]
  haveI : Module.Finite R B :=
    Module.Finite.of_surjective p fun b => ⟨i b, by simpa using congrArg (· b) hpi⟩
  haveI : Module.Projective R B := Module.Projective.of_split i p hpi
  exact Module.free_of_flat_of_isLocalRing

end Cox.ClassFieldTheory
