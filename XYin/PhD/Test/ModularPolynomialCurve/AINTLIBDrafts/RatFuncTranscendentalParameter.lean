module

public import Mathlib.FieldTheory.RatFunc.AsPolynomial

/-!
# Rational-function parameters from a transcendental field element

The canonical equivalence between k(X) and the field generated by a transcendental
element t, followed by the actual inclusion, gives a k-algebra map into the target
field. The X formula and polynomial restriction are the existing equivalence's
formulas composed with that inclusion. The supplied base-field algebra is preserved.

The fields may live in different universes. The two examples check the rational
indeterminate and independently specified base constants. This module constructs
no finite-dimensional, separable, or quotient-field structure.
-/

@[expose] public section

open scoped Polynomial RatFunc

universe u v

namespace RatFunc

variable {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]

noncomputable def algHomOfTranscendental (t : K) (ht : Transcendental k t) :
    k⟮X⟯ →ₐ[k] K :=
  (IntermediateField.adjoin k {t}).val.comp (algEquivOfTranscendental t ht).toAlgHom

@[simp]
theorem algHomOfTranscendental_X (t : K) (ht : Transcendental k t) :
    algHomOfTranscendental t ht (X : k⟮X⟯) = t := by
  simp [algHomOfTranscendental]

@[simp]
theorem algHomOfTranscendental_algebraMap (t : K) (ht : Transcendental k t) (p : k[X]) :
    algHomOfTranscendental t ht (algebraMap k[X] k⟮X⟯ p) = Polynomial.aeval t p := by
  simp [algHomOfTranscendental]

theorem algHomOfTranscendental_comp_algebraMap (t : K) (ht : Transcendental k t) :
    (algHomOfTranscendental t ht).comp (Algebra.algHom k k[X] k⟮X⟯) = Polynomial.aeval t := by
  apply AlgHom.ext
  intro p
  exact algHomOfTranscendental_algebraMap t ht p

example {k : Type u} [Field k] :
    algHomOfTranscendental (X : k⟮X⟯) transcendental_X (X : k⟮X⟯) = X :=
  algHomOfTranscendental_X _ _

example (t : K) (ht : Transcendental k t) (r : k) :
    algHomOfTranscendental t ht (C r) = algebraMap k K r :=
  (algHomOfTranscendental t ht).commutes r

#print axioms algHomOfTranscendental
#print axioms algHomOfTranscendental_X
#print axioms algHomOfTranscendental_algebraMap
#print axioms algHomOfTranscendental_comp_algebraMap
#print axioms algEquivOfTranscendental
#print axioms algEquivOfTranscendental_X
#print axioms algEquivOfTranscendental_algebraMap
#print axioms IntermediateField.AdjoinSimple.coe_aeval_gen_apply
#print axioms IntermediateField.val
#print axioms Algebra.algHom
#print axioms AlgHom.comp

end RatFunc
