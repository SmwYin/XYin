import XYin.NFIL.NumberField.FieldExamples.CyclotomicThree.Embeddings

/-!
# `ℚ(ζ₃)` RingOfIntegers

Integral basis, ring-of-integers description, and integral-coordinate norm forms.

This file is part of the reorganized `FieldExamples` case-study layout. The core files are
intended to import almost linearly:
`Basic → Galois → Embeddings → RingOfIntegers → Discriminant → PrimeSplitting →
ClassGroup → Units → Euclidean → LocalGlobal`, with a few field-specific special-topic files
kept separate.
-/

/-!
## Ring Of Integers
-/

noncomputable section

open scoped NumberField nonZeroDivisors Real ENNReal

open Module NumberField Polynomial

namespace NumberField.CyclotomicThree

/-- `ζ` as an element of the ring of integers `𝓞 K`. -/
noncomputable def zetaInt : 𝓞 K := zeta_isPrimitiveRoot.toInteger

/-- The chosen primitive cube root of unity satisfies `ζ³ = 1`. -/
theorem zeta_pow_three : ζ ^ 3 = 1 :=
  zeta_isPrimitiveRoot.pow_eq_one

/--
For cyclotomic fields, a primitive root of unity gives an explicit integral power basis
of the ring of integers.
-/
abbrev integralPowerBasis : PowerBasis ℤ (𝓞 K) :=
  zeta_isPrimitiveRoot.integralPowerBasis

/-- The integral power-basis generator is the chosen primitive root of unity in `𝓞 K`. -/
theorem integralPowerBasis_gen : integralPowerBasis.gen = zeta_isPrimitiveRoot.toInteger := by
  simp [integralPowerBasis]

theorem integralPowerBasis_dim : integralPowerBasis.dim = 2 := by
  simp [integralPowerBasis, Nat.totient_prime Nat.prime_three]

/-- The explicit `Fin 2` integral basis `[1, ζ]`. -/
abbrev zetaExplicitIntegralBasis : Basis (Fin 2) ℤ (𝓞 K) :=
  integralPowerBasis.basis.reindex (finCongr integralPowerBasis_dim)

theorem zetaExplicitIntegralBasis_zero :
    zetaExplicitIntegralBasis 0 = 1 := by
  rw [zetaExplicitIntegralBasis, Basis.reindex_apply]
  rw [integralPowerBasis.basis_eq_pow]
  have hcoe :
      (((finCongr integralPowerBasis_dim).symm (0 : Fin 2) : Fin integralPowerBasis.dim) : ℕ) = 0 :=
    rfl
  rw [hcoe]
  simp

theorem zetaExplicitIntegralBasis_one :
    zetaExplicitIntegralBasis 1 = zeta_isPrimitiveRoot.toInteger := by
  rw [zetaExplicitIntegralBasis, Basis.reindex_apply]
  rw [integralPowerBasis.basis_eq_pow]
  have hcoe :
      (((finCongr integralPowerBasis_dim).symm (1 : Fin 2) : Fin integralPowerBasis.dim) : ℕ) = 1 :=
    rfl
  rw [hcoe]
  simp [integralPowerBasis]

/-- The cyclotomic ring is another concrete model for the integral closure. -/
theorem cyclotomicRing_isIntegralClosure : IsIntegralClosure (CyclotomicRing 3 ℤ ℚ) ℤ K :=
  IsCyclotomicExtension.Rat.cyclotomicRing_isIntegralClosure 3

/--
`IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton` says that the
`ℤ`-subalgebra `ℤ[ζ] = Algebra.adjoin ℤ {ζ}` generated by a single primitive root
inside `K` is already the full ring of integers `𝓞 K`.
-/
theorem isIntegralClosure_adjoin_zeta :
    IsIntegralClosure (Algebra.adjoin ℤ ({ζ} : Set K)) ℤ K :=
  IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton zeta_isPrimitiveRoot

/--
As a consequence, the ring of integers is generated over `ℤ` by the primitive root:
`Algebra.adjoin ℤ {zeta_isPrimitiveRoot.toInteger} = ⊤` in `𝓞 K`.
-/
theorem integralPowerBasis_adjoin_gen_eq_top :
    Algebra.adjoin ℤ ({integralPowerBasis.gen} : Set (𝓞 K)) = ⊤ :=
  integralPowerBasis.adjoin_gen_eq_top


end NumberField.CyclotomicThree
