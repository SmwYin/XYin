import XYin.NFIL.NumberField.FieldExamples.CyclotomicFive.Galois

/-!
# `ℚ(ζ₅)` QuadraticSubfield

Quadratic subfield statements that are special to this field.

This file is part of the reorganized `FieldExamples` case-study layout. The core files are
intended to import almost linearly:
`Basic → Galois → Embeddings → RingOfIntegers → Discriminant → PrimeSplitting →
ClassGroup → Units → Euclidean → LocalGlobal`, with a few field-specific special-topic files
kept separate.
-/

noncomputable section

open Module Polynomial
open scoped NumberField nonZeroDivisors

namespace NumberField.CyclotomicFive

/-- The quadratic Gauss sum for `5`: `(1 + 2ζ + 2ζ⁴)² = 5`. Hence `√5 ∈ ℚ(ζ₅)` and `ℚ(√5)`
is the unique quadratic subfield (corresponding to the index-`2` subgroup of the cyclic
Galois group) — the simplest case of the Kronecker–Weber phenomenon. -/
theorem gaussSum_sq : (1 + 2 * ζ + 2 * ζ ^ 4) ^ 2 = 5 := by
  linear_combination (4 * ζ ^ 3 + 8) * zeta_pow_five + 4 * zeta_sum_eq_zero

/-- The polynomial defining `ℚ(√5)` as an `AdjoinRoot`. -/
abbrev sqrtFivePolynomial : ℚ[X] := Polynomial.X ^ 2 - Polynomial.C 5

instance : Fact (Irreducible sqrtFivePolynomial) where
  out := by
    apply Polynomial.irreducible_of_degree_le_three_of_not_isRoot
    · rw [sqrtFivePolynomial, Finset.mem_Icc]
      change 1 ≤ (Polynomial.X ^ 2 - Polynomial.C (5 : ℚ)).natDegree ∧
        (Polynomial.X ^ 2 - Polynomial.C (5 : ℚ)).natDegree ≤ 3
      rw [natDegree_X_pow_sub_C]
      norm_num
    · intro x hx
      have hx2 : x ^ 2 = 5 := by
        have hzero : x ^ 2 - 5 = 0 := by
          simpa [sqrtFivePolynomial, IsRoot] using hx
        nlinarith
      have hsquare : IsSquare (5 : ℚ) := by
        rw [isSquare_iff_exists_sq]
        exact ⟨x, hx2.symm⟩
      norm_num at hsquare

/-- The field `ℚ(√5)`, constructed by adjoining a root of `X^2 - 5`. -/
abbrev QSqrtFive : Type := AdjoinRoot sqrtFivePolynomial

/-- The formal square root of `5` in the `AdjoinRoot` model. -/
abbrev sqrtFiveRoot : QSqrtFive := AdjoinRoot.root sqrtFivePolynomial

/-- The formal square root satisfies `√5 ^ 2 = 5`. -/
theorem sqrtFiveRoot_sq : sqrtFiveRoot ^ 2 = (5 : QSqrtFive) := by
  have hroot : sqrtFiveRoot ^ 2 - 5 = 0 := by
    simpa [sqrtFiveRoot, sqrtFivePolynomial] using
      (AdjoinRoot.eval₂_root sqrtFivePolynomial)
  linear_combination hroot

/-- The Gauss sum, viewed as the distinguished square root of `5` inside `ℚ(ζ₅)`. -/
abbrev gaussSum : K := 1 + 2 * ζ + 2 * ζ ^ 4

/-- The quadratic subfield of `ℚ(ζ₅)` generated by the Gauss sum. -/
abbrev sqrtFiveSubfield : Subalgebra ℚ K := Algebra.adjoin ℚ ({gaussSum} : Set K)

/-- The embedding `ℚ(√5) → ℚ(ζ₅)` sending `√5` to the quadratic Gauss sum. -/
noncomputable def sqrtFiveToCyclotomic : QSqrtFive →ₐ[ℚ] K := by
  exact AdjoinRoot.liftAlgHom sqrtFivePolynomial (Algebra.ofId ℚ K) gaussSum (by
    simp [sqrtFivePolynomial, gaussSum, gaussSum_sq])

/-- The `AdjoinRoot` model `ℚ(√5)` is equivalent to the subfield generated by the Gauss sum. -/
noncomputable def sqrtFiveEquivSubfield : QSqrtFive ≃ₐ[ℚ] sqrtFiveSubfield := by
  let gs : sqrtFiveSubfield := ⟨gaussSum, Algebra.self_mem_adjoin_singleton ℚ gaussSum⟩
  let g : QSqrtFive →ₐ[ℚ] sqrtFiveSubfield :=
    AdjoinRoot.liftAlgHom sqrtFivePolynomial (Algebra.ofId ℚ sqrtFiveSubfield) gs (by
      ext
      simp [sqrtFivePolynomial, gs, gaussSum, gaussSum_sq])
  refine AlgEquiv.ofBijective g ⟨RingHom.injective g.toRingHom, ?_⟩
  intro y
  let p : (x : K) → x ∈ Algebra.adjoin ℚ ({gaussSum} : Set K) → Prop :=
    fun x hx => ∃ z : QSqrtFive, g z = ⟨x, hx⟩
  change p y.1 y.2
  refine Algebra.adjoin_induction (s := ({gaussSum} : Set K)) ?_ ?_ ?_ ?_ y.2
  · intro x hx
    rcases hx with rfl
    exact ⟨sqrtFiveRoot,
      AdjoinRoot.liftAlgHom_root sqrtFivePolynomial (Algebra.ofId ℚ sqrtFiveSubfield) gs _⟩
  · intro r
    exact ⟨algebraMap ℚ QSqrtFive r, g.commutes r⟩
  · intro x y hx hy hx' hy'
    rcases hx' with ⟨x', hxeq⟩
    rcases hy' with ⟨y', hyeq⟩
    refine ⟨x' + y', ?_⟩
    rw [map_add, hxeq, hyeq]
    ext
    rfl
  · intro x y hx hy hx' hy'
    rcases hx' with ⟨x', hxeq⟩
    rcases hy' with ⟨y', hyeq⟩
    refine ⟨x' * y', ?_⟩
    rw [map_mul, hxeq, hyeq]
    ext
    rfl

/-- Under the embedding, the formal square root maps to `1 + 2ζ + 2ζ⁴`. -/
theorem sqrtFiveToCyclotomic_root : sqrtFiveToCyclotomic sqrtFiveRoot = gaussSum := by
  exact AdjoinRoot.liftAlgHom_root sqrtFivePolynomial (Algebra.ofId ℚ K) gaussSum _

/-- Under the equivalence with the generated subfield, the formal square root is the Gauss sum. -/
theorem sqrtFiveEquivSubfield_root :
    ((sqrtFiveEquivSubfield sqrtFiveRoot : sqrtFiveSubfield) : K) = gaussSum := by
  rw [sqrtFiveEquivSubfield, sqrtFiveRoot]
  simpa using congrArg Subtype.val
    (AdjoinRoot.liftAlgHom_root sqrtFivePolynomial (Algebra.ofId ℚ sqrtFiveSubfield)
      ⟨gaussSum, Algebra.self_mem_adjoin_singleton ℚ gaussSum⟩ _)

/-- The `ℚ(√5)` model embeds as the quadratic subfield of `ℚ(ζ₅)`. -/
theorem sqrtFiveToCyclotomic_injective : Function.Injective sqrtFiveToCyclotomic := by
  exact RingHom.injective sqrtFiveToCyclotomic.toRingHom


end NumberField.CyclotomicFive
